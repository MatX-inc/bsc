package Mutants where

-- A target for every kind of hardware mutant: guards reading registers, rules a and b in a forced order
-- (y read, then written) sharing a last-caller register and each with a task, and a mux (rules c and d).
{-# verilog sysMutants #-}
sysMutants :: Module Empty
sysMutants = module
  x :: Reg (Bit 8) <- mkReg 0
  y :: Reg (Bit 8) <- mkReg 0
  z :: Reg (Bit 8) <- mkReg 0
  rules
    "a": when y > 3 ==> do
      x := y + 1
      $display "a %d" y
    "b": when True ==> do
      x := 7
      y := y + 2
      $display "b %d" y
    "c": when z == 0 ==> z := y
    "d": when z == 1 ==> z := x
