package GatedChild where

-- A gated clock made by a child (mkGatedClockFromCC): one family, but its gate is the child's
-- output, not an input of the module, so schedlean stops with that reason.
import Clocks

clockedBy :: (IsModule m mType) => Clock -> m a -> m a
clockedBy c = changeSpecialWires (Just c) Nothing Nothing

{-# verilog sysGatedChild #-}
sysGatedChild :: Module Empty
sysGatedChild = module
  gc :: GatedClockIfc <- mkGatedClockFromCC True
  a :: Reg (Bit 8) <- mkReg 0
  g :: Reg (Bit 8) <- clockedBy gc.new_clk $ mkReg 0
  rules
    "toggle": when True ==> do
      a := a + 1
      gc.setGateCond (a /= 3)
    "gated": when True ==> g := g + 1
