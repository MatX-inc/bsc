# Tests for the noreturn "panic" host operations of bs_host_ops:
# divide_by_zero (narrow and wide, unsigned and signed) and
# out_of_bounds (RegFile and BRAM reads and writes).
# The default host implementation prints a message to stderr and
# abort()s, so each simulation must exit nonzero with a
# deterministic message on every architecture (Bluesim only; the
# Verilog behavior of these constructs is unchanged and is tested
# elsewhere, e.g. bsc.misc/divmod).

set abrt [list SIGABRT 6 134]

proc test_panic { top } {
    global abrt
    global ctest
    if { $ctest == 1 } {
        compile_object_pass $top.bsv $top
        link_objects_pass $top $top
        sim_output_status $top $abrt
        compare_file $top.out
    }
}

test_panic sysDivZero
test_panic sysModZero
test_panic sysSignedDivZero
test_panic sysWideDivZero
test_panic sysWideModZero

test_panic sysRegFileOOBRead
test_panic sysRegFileOOBWrite
test_panic sysBRAMOOBRead
test_panic sysBRAMOOBWrite
test_panic sysBRAMOOBPortB

# Reset carve-out: an out-of-bounds access executed while a reset is
# asserted must NOT panic.  Rule bodies read RegFiles/BRAMs before
# their in-reset check, with address registers still at their
# undetermined 1010... pattern, so such accesses are silently clamped
# (reads return an undetermined value, writes are dropped) and the
# simulation proceeds.  The exact-output compare also checks that no
# warning is printed.
if { $ctest == 1 } {
    compile_object_pass sysRegFileOOBInReset.bsv sysRegFileOOBInReset
    link_objects_pass sysRegFileOOBInReset sysRegFileOOBInReset
    sim_output sysRegFileOOBInReset
    compare_file sysRegFileOOBInReset.out
}
