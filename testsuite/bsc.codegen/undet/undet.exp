
# Test undetermined value handling

# -------------------------
# Undet submodule arguments get assigned according to the unspecified-to flag
# when -no-opt-undetermined-vals

if { $vtest == 1 } {

compile_verilog_pass Undet_SubModArg.bsv sysUndet_SubModArg \
    {-unspecified-to 0 -no-opt-undetermined-vals}
move sysUndet_SubModArg.v sysUndet_SubModArg.0.v
find_n_strings sysUndet_SubModArg.0.v \
    {rg <= `BSV_ASSIGNMENT_DELAY 32'h0;} 1

compile_verilog_pass Undet_SubModArg.bsv sysUndet_SubModArg \
    {-unspecified-to 1 -no-opt-undetermined-vals}
move sysUndet_SubModArg.v sysUndet_SubModArg.1.v
find_n_strings sysUndet_SubModArg.1.v \
    {rg <= `BSV_ASSIGNMENT_DELAY 32'hFFFFFFFF;} 1

compile_verilog_pass Undet_SubModArg.bsv sysUndet_SubModArg \
    {-unspecified-to A -no-opt-undetermined-vals}
move sysUndet_SubModArg.v sysUndet_SubModArg.A.v
find_n_strings sysUndet_SubModArg.A.v \
    {rg <= `BSV_ASSIGNMENT_DELAY 32'hAAAAAAAA;} 1

}

# -------------------------
# Undet submodule arguments get assigned according to the unspecified-to flag
# when -opt-undetermined-vals

if { $vtest == 1 } {

compile_verilog_pass Undet_SubModArg.bsv sysUndet_SubModArg \
    {-unspecified-to 0 -opt-undetermined-vals}
move sysUndet_SubModArg.v sysUndet_SubModArg.0-opt.v
find_n_strings sysUndet_SubModArg.0-opt.v \
    {rg <= `BSV_ASSIGNMENT_DELAY 32'b0 /* unspecified value */ ;} 1

compile_verilog_pass Undet_SubModArg.bsv sysUndet_SubModArg \
    {-unspecified-to 1 -opt-undetermined-vals}
move sysUndet_SubModArg.v sysUndet_SubModArg.1-opt.v
find_n_strings sysUndet_SubModArg.1-opt.v \
    {32'b11111111111111111111111111111111 /* unspecified value */ ;} 1

compile_verilog_pass Undet_SubModArg.bsv sysUndet_SubModArg \
    {-unspecified-to A -opt-undetermined-vals}
move sysUndet_SubModArg.v sysUndet_SubModArg.A-opt.v
find_n_strings sysUndet_SubModArg.A-opt.v \
    {rg <= `BSV_ASSIGNMENT_DELAY 32'hAAAAAAAA /* unspecified value */ ;} 1

compile_verilog_pass Undet_SubModArg.bsv sysUndet_SubModArg \
    {-unspecified-to X -opt-undetermined-vals}
move sysUndet_SubModArg.v sysUndet_SubModArg.X-opt.v
find_n_strings sysUndet_SubModArg.X-opt.v \
    {32'bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx /* unspecified value */ ;} 1

compile_verilog_pass Undet_SubModArg.bsv sysUndet_SubModArg \
    {-unspecified-to Z -opt-undetermined-vals}
move sysUndet_SubModArg.v sysUndet_SubModArg.Z-opt.v
find_n_strings sysUndet_SubModArg.Z-opt.v \
    {32'bzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz /* unspecified value */ ;} 1

}

# -------------------------

# Under -split-undetermined-vals, undetermined bits in an arm of an
# if-expression take the value of the same bits in the other arm, so those
# bits leave the mux.  The values are picked once, before the backends
# split, and Bluesim and Verilog agree on them here, where the other arm is
# always valid.

test_c_veri_bsv_modules_options Undet_FillMuxBits {mkUndet_FillMuxBits} \
    {-split-undetermined-vals}

if { $vtest == 1 } {
move mkUndet_FillMuxBits.v mkUndet_FillMuxBits.split.v
find_n_strings mkUndet_FillMuxBits.split.v \
    {assign out1 = { out1_c ? 3'b001 : out1_x[4:2], out1_x[1:0] } ;} 1
}

# The flag is off by default: the undetermined bits are set by
# -unspecified-to and stay in the mux, in both backends

touch Undet_FillMuxBits.bsv
test_c_veri_bsv_modules_options Undet_FillMuxBits {mkUndet_FillMuxBits} {} \
    sysUndet_FillMuxBits-default.out.expected

if { $vtest == 1 } {
move mkUndet_FillMuxBits.v mkUndet_FillMuxBits.default.v
find_n_strings mkUndet_FillMuxBits.default.v \
    {assign out1 = out1_c ? 5'b00110 : out1_x ;} 1
}

# The flag also applies under -opt-undetermined-vals with a 2-state
# -unspecified-to, but not with X or Z, which leave the bits to synthesis

if { $vtest == 1 } {

compile_verilog_pass Undet_FillMuxBits.bsv mkUndet_FillMuxBits \
    {-split-undetermined-vals -opt-undetermined-vals -unspecified-to 0}
move mkUndet_FillMuxBits.v mkUndet_FillMuxBits.0-opt.v
find_n_strings mkUndet_FillMuxBits.0-opt.v \
    {assign out1 = { out1_c ? 3'b001 : out1_x[4:2], out1_x[1:0] } ;} 1

compile_verilog_pass Undet_FillMuxBits.bsv mkUndet_FillMuxBits \
    {-split-undetermined-vals -opt-undetermined-vals -unspecified-to X}
move mkUndet_FillMuxBits.v mkUndet_FillMuxBits.X-opt.v
find_n_strings mkUndet_FillMuxBits.X-opt.v \
    {out1_c ? { 3'b001, 2'bxx /* unspecified value */  } : out1_x ;} 1

compile_verilog_pass Undet_FillMuxBits.bsv mkUndet_FillMuxBits \
    {-split-undetermined-vals -opt-undetermined-vals -unspecified-to Z}
move mkUndet_FillMuxBits.v mkUndet_FillMuxBits.Z-opt.v
find_n_strings mkUndet_FillMuxBits.Z-opt.v \
    {out1_c ? { 3'b001, 2'bzz /* unspecified value */  } : out1_x ;} 1

}

# -------------------------
# The undetermined bits are not taken from the result of an ActionValue
# method, unless -opt-undetermined-vals is given (for Verilog)

if { $vtest == 1 } {

compile_verilog_pass Undet_FillActionValue.bsv sysUndet_FillActionValue \
    {-split-undetermined-vals}
move sysUndet_FillActionValue.v sysUndet_FillActionValue.noopt.v
find_n_strings sysUndet_FillActionValue.noopt.v \
    {assign x$D_IN = cnt[0] ? { 3'b110, s$get } : 8'b00101010 ;} 1

compile_verilog_pass Undet_FillActionValue.bsv sysUndet_FillActionValue \
    {-split-undetermined-vals -opt-undetermined-vals}
move sysUndet_FillActionValue.v sysUndet_FillActionValue.opt.v
find_n_strings sysUndet_FillActionValue.opt.v \
    {assign x$D_IN = { cnt[0] ? 3'b110 : 3'b001, s$get } ;} 1

}

# -------------------------
# The fill can leave an if-chain inside a concatenation, which Bluesim
# converts to a case-expression only at the top of a def.  That choice
# follows the flags that each .ba was compiled with, so the link can be
# given different flags.

# Compiled with the flag and linked without it (the gen options are not
# given to the link)
test_c_veri_bsv_modules_options Undet_FillCaseChain {} \
    {-split-undetermined-vals}

# Compiled without the flag and linked with it, which gives the same
# Bluesim code as a link without it
touch Undet_FillCaseChain.bsv
test_c_veri_bsv_modules_options Undet_FillCaseChain {} {} \
    sysUndet_FillCaseChain-default.out.expected "" "" \
    {-split-undetermined-vals}

# (an up-to-date Bluesim object is reused, so remove it before each link)
if { $ctest == 1 } {
erase sysUndet_FillCaseChain.o
link_objects_pass {sysUndet_FillCaseChain} sysUndet_FillCaseChain \
    {-split-undetermined-vals}
move sysUndet_FillCaseChain.cxx sysUndet_FillCaseChain.linkflag.cxx
erase sysUndet_FillCaseChain.o
link_objects_pass {sysUndet_FillCaseChain} sysUndet_FillCaseChain
compare_file sysUndet_FillCaseChain.linkflag.cxx sysUndet_FillCaseChain.cxx
}

# -------------------------
