package TupleExpand() where

-- two top-level structs built from each other's fields: compiling the
-- package (nothing is elaborated) must not follow the cycle
struct My_pair1 = {fst :: Bit 16; snd :: Bit 16}
  deriving(Eq, Bits)

y :: My_pair1
y = My_pair1 {fst=z.fst;snd=z.snd}

z :: My_pair1
z = My_pair1 {fst=y.fst;snd=y.snd}
