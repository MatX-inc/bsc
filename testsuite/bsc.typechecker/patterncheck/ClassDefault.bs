package ClassDefault where

-- the incomplete match in the default is not reported: neither at the class
-- declaration (the typechecker does not return typed defaults) nor for the
-- instances that inherit it
class MyClass a where
  conv :: a -> Maybe Bool -> Bool
  conv _ m = case m of
               Just x -> x

data T = T
data U = U

instance MyClass T where {}
instance MyClass U where {}

useit :: T -> U -> Bool
useit t u = conv t (Just True) && conv u (Just False)
