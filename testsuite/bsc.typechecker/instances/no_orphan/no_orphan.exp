# Tests for orphan instances.  An orphan instance of a class is an error
# (T0127) unless the class is declared "orphan", which makes it a warning.
# The "orphan" annotation may come before or after "coherent"/"incoherent".
#
# A source compiled twice has the output of its -demote-errors run moved
# to <source>.demote.bsc-out, so that it does not replace the output (or
# the differences) of the first run.

# ----------
# Classic

# Classes not declared orphan; an instance in the class's own package is
# not an orphan
compile_pass_no_warning NoOrphanClasses.bs

# An orphan instance of each class is an error ...
compile_fail_error NoOrphanInsts.bs T0127 3
compare_file NoOrphanInsts.bs.bsc-out
# ... which cannot be demoted (S0094 reports the refused demotion)
compile_fail_error NoOrphanInsts.bs T0127 3 {-demote-errors T0127}
move NoOrphanInsts.bs.bsc-out NoOrphanInsts.bs.demote.bsc-out
compare_file NoOrphanInsts.bs.demote.bsc-out

# "orphan" alone and in either order with a coherence annotation: an
# orphan instance of each class is a warning
compile_pass_no_warning OrphanClasses.bs
compile_pass_warning OrphanInsts.bs T0127 5
compare_file OrphanInsts.bs.bsc-out

# An instance in the package that defines its type is not an orphan
compile_pass_no_warning NoOrphanTypeInst.bs

# ... even when the package does not export the type
compile_pass_no_warning NoOrphanHiddenTypeInst.bs
compare_file NoOrphanHiddenTypeInst.bs.bsc-out

# A class exported abstractly (without its methods) still rejects orphans
compile_pass_no_warning NoOrphanAbstract.bs
compile_fail_error NoOrphanAbstractInst.bs T0127
compare_file NoOrphanAbstractInst.bs.bsc-out

# An orphan instance is an error even if the package does not export it
# (here because its head names types that the package does not export)
compile_fail_error NoOrphanHidden.bs T0127 2
compare_file NoOrphanHidden.bs.bsc-out

# With several dependencies, the package must define one of the source
# types of each dependency
compile_fail_error NoOrphanMultiDep.bs T0127
compare_file NoOrphanMultiDep.bs.bsc-out

# The orphan error is reported along with export errors
compile_fail_error NoOrphanExportError.bs T0010
compare_file NoOrphanExportError.bs.bsc-out

# The error comes before code generation, so no Verilog file is written
if { $vtest == 1 } {
    erase mkNoOrphanSynth.v
    compile_verilog_fail_error NoOrphanSynth.bs T0127
    if { [file exists [join [concat $subdir mkNoOrphanSynth.v] "/"]] } {
        fail "mkNoOrphanSynth.v should not exist"
    } else {
        pass "mkNoOrphanSynth.v does not exist"
    }
}

# With -continue-after-errors, the error does not stop the compile:
# NoOrphanContinue.bo is written, with the instance poisoned, and the
# package that imports it is compiled (and reports its own error)
erase NoOrphanContinue.bo
compile_fail_error NoOrphanContinueUse.bs T0020 1 {-continue-after-errors}
compare_file NoOrphanContinueUse.bs.bsc-out

# Without -continue-after-errors, importing the poisoned package is an
# error
compile_fail_error NoOrphanContinueOk.bs G0088

# With -continue-after-errors, code generation comes first, so its errors
# are reported along with the export and orphan errors
compile_fail_error NoOrphanContinueElab.bs T0010 1 {-verilog -continue-after-errors}
compare_file NoOrphanContinueElab.bs.bsc-out

# The coherence annotation keeps its meaning in either order
compile_fail_error OrphanCoherent.bs T0030 2 {-incoherent-instance-matches}
compile_pass OrphanIncoherent.bs

# Each annotation may be given at most once
compile_fail_error OrphanTwice.bs P0005
compare_file OrphanTwice.bs.bsc-out

# ----------
# BSV

compile_pass_no_warning NoOrphanClassesBSV.bsv

compile_fail_error NoOrphanInstsBSV.bsv T0127 3
compare_file NoOrphanInstsBSV.bsv.bsc-out
compile_fail_error NoOrphanInstsBSV.bsv T0127 3 {-demote-errors T0127}
move NoOrphanInstsBSV.bsv.bsc-out NoOrphanInstsBSV.bsv.demote.bsc-out
compare_file NoOrphanInstsBSV.bsv.demote.bsc-out

compile_pass_no_warning OrphanClassesBSV.bsv
compile_pass_warning OrphanInstsBSV.bsv T0127 5
compare_file OrphanInstsBSV.bsv.bsc-out

compile_fail_error OrphanCoherentBSV.bsv T0030 2 {-incoherent-instance-matches}
compile_pass OrphanIncoherentBSV.bsv

compile_fail_error OrphanTwiceBSV.bsv P0005
compare_file OrphanTwiceBSV.bsv.bsc-out

# ----------
# Bits is not declared orphan.  For now, an orphan Bits instance is an
# error that can be demoted (unlike for other classes).

compile_pass_no_warning NoBitsType.bs
compile_fail_error BitsOrphan.bs T0127
compare_file BitsOrphan.bs.bsc-out
compile_pass_warning BitsOrphan.bs T0127 1 {-demote-errors T0127}
move BitsOrphan.bs.bsc-out BitsOrphan.bs.demote.bsc-out
compare_file BitsOrphan.bs.demote.bsc-out

# Nor is SplitPorts, and this error cannot be demoted
compile_fail_error SplitPortsOrphan.bs T0127
compare_file SplitPortsOrphan.bs.bsc-out
compile_fail_error SplitPortsOrphan.bs T0127 1 {-demote-errors T0127}
move SplitPortsOrphan.bs.bsc-out SplitPortsOrphan.bs.demote.bsc-out
compare_file SplitPortsOrphan.bs.demote.bsc-out
