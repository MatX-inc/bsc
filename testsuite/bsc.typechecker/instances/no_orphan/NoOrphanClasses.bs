package NoOrphanClasses where

-- Classes not declared "orphan", with and without a coherence annotation

class NoOrphan a where
  noOrphan :: a -> Bool

class coherent CoherentNoOrphan a where
  coherentNoOrphan :: a -> Bool

class incoherent IncoherentNoOrphan a where
  incoherentNoOrphan :: a -> Bool

-- An instance in the class's own package is not an orphan
instance NoOrphan Bool where
  noOrphan = id
