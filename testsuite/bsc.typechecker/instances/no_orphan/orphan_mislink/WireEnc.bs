package WireEnc where

import MsgDefs

-- An orphan instance: Bits, Msg and Hdr are all defined in other packages.
-- It is strictly more specific than the derived Bits (Msg t) instance from
-- MsgDefs, so the duplicate-instance check (T0099) never fires for it.
-- Same width (33 bits) as the derived layout, with valid moved to the MSB.
instance Bits (Msg Hdr) 33 where
    pack m   = pack m.valid ++ pack m.payload
    unpack b = Msg { valid = unpack b[32:32]; payload = unpack b[31:0]; }
