# The orphan-defining packages from the reproduction in B-Lang-org/bsc#1061
# (testsuite/bsc.typechecker/instances/orphan_mislink on the
# orphan-instance-mislink-repro branch of nanavati/bsc).  Each defines an
# orphan instance of a Prelude class not declared orphan, so none of them
# compiles.

# The packages they import
compile_pass_no_warning MsgDefs.bs
compile_pass_no_warning LaneDefs.bs
compile_pass_no_warning ReqDefs.bs

# Orphan Bits instances
compile_fail_error WireEnc.bs T0127
compile_fail_error WireEnc2.bs T0127

# WireEnc's instance in a package that re-exports MsgDefs (not from the
# issue).  Known bug: the orphan check treats a re-exported type as
# local, so this compiles with no T0127 at all, and the expected output
# records that.  Once fixed, it should fail with T0127 like WireEnc.
compile_pass WireEncReexport.bs
compare_file WireEncReexport.bs.bsc-out

# Orphan SplitPorts instances
compile_fail_error SplitFwd.bs T0127
compile_fail_error SplitRev.bs T0127
compile_fail_error ReqSplit.bs T0127
