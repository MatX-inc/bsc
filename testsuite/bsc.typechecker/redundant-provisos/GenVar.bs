package GenVar where

class Render a where
  render :: a -> String

class Render' r where
  render' :: r -> String

instance (Generic a r, Render' r) => Render a where
  render x = render' (from x)

instance Render (Bit n) where
  render _ = "bits"

instance (Render' r) => Render' (Meta m r) where
  render' (Meta x) = render' x

instance (Render a) => Render' (Conc a) where
  render' (Conc x) = render x

-- The argument type is headed by a type-constructor variable, so the
-- generic instance reduces this to Generic (f n Bool) r, Render' r with a
-- fresh r.  The definition never renders.
mkRelay :: (IsModule m c, Bits (f n Bool) sz, Render (f n Bool)) =>
           Reg (f n Bool) -> m (Reg (f n Bool))
mkRelay r = return r

-- Plain type variable: Generic a r, Render' r.
relay2 :: (Render a) => a -> a
relay2 x = x
