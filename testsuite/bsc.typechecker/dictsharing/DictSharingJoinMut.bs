package DictSharingJoinMut where

-- The joinctx shape (a walk with joins, replayed when nested) followed
-- by definitions with the mutrec shape (a recursive dictionary group of
-- two mutually recursive data types whose projection binders are
-- referenced twice): the first definitions' nested re-walks force, on
-- the compiler without sharing, the spellings of their residual
-- dictionary variables at the join; the counter restarts per
-- definition, so the same spellings name members of the later
-- definitions' recursive groups, which IConv orders by ordinal.  The
-- padding (1 + 2 + 3 + 4) shifts the later definitions' numbers.

class Count a where
  count :: a -> UInt 8

instance Count (UInt 8) where
  count x = x

instance Count Bool where
  count b = if b then 1 else 0

instance (Generic a r, Count' r) => Count a where
  count x = count' (from x)

class Count' r where
  count' :: r -> UInt 8

instance (Count' r1, Count' r2) => Count' (r1, r2) where
  count' (x, y) = count' x + count' y

instance (Count' r1, Count' r2) => Count' (Either r1 r2) where
  count' (Left x) = count' x
  count' (Right y) = count' y

instance Count' () where
  count' () = 0

instance (Count' r) => Count' (Meta m r) where
  count' (Meta x) = count' x

instance (Count a) => Count' (Conc a) where
  count' (Conc x) = count x

class Fix1 d f | d -> f where
  fix1 :: d -> f

instance Fix1 Bool (UInt 8) where
  fix1 b = if b then 1 else 0

instance Fix1 (UInt 8) Bool where
  fix1 x = x > 0

class Fix2 f a e | f -> a e where
  fix2a :: f -> a
  fix2e :: f -> e

instance Fix2 (UInt 8) Bool Bool where
  fix2a x = x > 1
  fix2e x = x > 2

instance Fix2 Bool (UInt 8) (UInt 8) where
  fix2a b = if b then 2 else 3
  fix2e b = if b then 4 else 5

class Pick a b k | a k -> b where
  pick :: k -> a -> b

instance Pick Bool (UInt 8) (UInt 8) where
  pick k b = if b then k else 0

instance Pick (UInt 8) Bool (UInt 8) where
  pick k x = x > k

class ToU b where
  toU :: b -> UInt 8

instance ToU (UInt 8) where
  toU x = x

instance ToU Bool where
  toU b = if b then 1 else 0

data T d = T d

instance (Pick a b (UInt 8), Pick e c (UInt 8), Fix2 f a e, Fix1 d f, ToU b, ToU c) => Count (T d) where
  count (T d) = toU (pick (2 :: UInt 8) (fix2a (fix1 d))) + toU (pick (3 :: UInt 8) (fix2e (fix1 d)))

data Wrap = Wrap (T Bool) (T Bool)

data Wrap3 = Wrap3 (T (UInt 8)) Wrap (T Bool)

struct Pair =
  p0 :: UInt 8
  p1 :: Bool
 deriving (Bits, Eq)

struct Triple =
  t0 :: UInt 8
  t1 :: Bool
  t2 :: Pair
 deriving (Bits, Eq)

pair :: Pair
pair = Pair { p0 = 1; p1 = True }

triple :: Triple
triple = Triple { t0 = 2; t1 = False; t2 = pair }

data A = AN | AC Pair B A

data B = BN | BC Pair A B

useBoth :: UInt 8
useBoth = count (T True) + count (Wrap (T True) (T True)) + count (Wrap3 (T 1) (Wrap (T True) (T True)) (T True))
          + count (T (0 :: UInt 8)) + count (Wrap3 (T 2) (Wrap (T True) (T True)) (T True))

useMore :: UInt 8 -> UInt 8
useMore x = count (T (x > 1)) + count (Wrap (T (x > 2)) (T True)) + count (Wrap3 (T x) (Wrap (T True) (T True)) (T True))
            + count (T x) + count (Wrap3 (T 2) (Wrap (T (x > 3)) (T True)) (T (x > 4)))

mutA :: A -> UInt 8
mutA a = let z :: UInt 8
             z = 1 + 2 + 3 + 4
         in  count a + z

mutB :: B -> B -> UInt 8
mutB x y = let z :: UInt 8
               z = 1 + 2 + 3 + 4
           in  count x + count y + z

mutBoth :: A -> B -> UInt 8
mutBoth a b = let z :: UInt 8
                  z = 1 + 2 + 3 + 4
              in  count a + count b + count (AC pair b a) + z

interface Ifc =
  get :: UInt 8
  put :: Pair -> Action

mkMut :: Module Ifc
mkMut =
  module
    r :: Reg Pair <- mkReg pair
    s :: Reg Triple <- mkReg triple
    c :: Reg (UInt 8) <- mkReg 0
    rules
      "count": when r.p1 ==> do
        let z :: UInt 8
            z = 1 + 2 + 3 + 4
        c := c + z + count (AC r (BC s.t2 AN BN) (AC pair BN AN)) + count (BC r (AC s.t2 BN AN) BN)
      "other": when (not r.p1) ==> c := c + count (AC r BN AN) + useMore c
    interface
      get = let n :: UInt 8
                n = count (AC r (BC r AN BN) AN) + count r + count s
                (x, y) = (r.p0, s.t0)
                (u, v) = (s.t2.p0, c)
                a = x + y
                b = u + v
            in  ((a & b) | (a ^ b)) + n + useBoth
      put x = r := x

mkMut2 :: Module Ifc
mkMut2 =
  module
    r :: Reg Pair <- mkReg pair
    s :: Reg Triple <- mkReg triple
    c :: Reg (UInt 8) <- mkReg 0
    rules
      "count": when r.p1 ==> do
        let z :: UInt 8
            z = 1 + 2 + 3 + 4
        c := c + z + count (BC r (AC s.t2 (BC r AN BN) AN) (BC pair AN BN))
    interface
      get = let m :: UInt 8
                m = count (BC r AN (BC s.t2 AN BN)) + count (AC r BN AN)
                (x, y) = (r.p0, s.t0)
                (u, v) = (s.t2.p0, c)
                a = x + y
                b = u + v
            in  ((a & b) | (a ^ b)) + m
      put x = r := x

sysMut :: Module Empty
sysMut =
  module
    n1 :: Ifc <- mkMut
    n2 :: Ifc <- mkMut2
    rules
      when True ==> do
        $display "get: " n1.get n2.get
        $finish
      when True ==> do
        n1.put pair
        n2.put pair
