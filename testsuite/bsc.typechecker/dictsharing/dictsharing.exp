# Reuse of the derivation of equal ground predicates within one satisfy
# call (TCMisc.sat, replaySolvedBinds): a Generic-representation
# traversal with a catch-all instance, over nested structs whose fields
# repeat a few types, derives the traversal of a field type once per
# satisfy call and replays it for the other field occurrences, under the
# dictionary ids and type variables the walk would draw.

# The traversal computes the same value with the shared dictionaries
test_c_veri DictSharing

# The mechanism: -trace-tc-dict-share prints one line per satisfy call
# that replayed a derivation (two for a definition, whose predicates are
# solved once while its body is checked and once more by tiExpl), with
# the counter numbers the replays drew, and the typecheck dump holds the
# same bindings as the derivation without reuse: one Generic dictionary
# per field occurrence (585), since a hit replays the recorded bindings
# instead of deriving them
compile_pass DictSharing.bs {-trace-tc-dict-share -dtypecheck=typecheck_%p.out} 1
find_n_strings typecheck_DictSharing.out {:: Prelude.Generic } 585
find_n_strings DictSharing.bs.bsc-out {satisfy: 80 derivations recorded, 21 replayed, 20802 counter numbers drawn by the replays} 2

# A small definition: the pinned line counts the ground predicates the
# call recorded, the later occurrences that replayed them and the
# numbers the replays drew
compile_pass DictSharingTrace.bs {-trace-tc-dict-share} 1
find_n_strings DictSharingTrace.bs.bsc-out {satisfy: 19 derivations recorded, 2 replayed, 54 counter numbers drawn by the replays} 2

# A replay leaves the typechecked program and the fresh-name counter
# where the walk would have left them: the typecheck dump of that
# definition, and the sequence of counter draws -trace-tcvar prints for
# the package, are the files the compiler without this reuse writes
# (both .expected files were written by that compiler, the dump with
# its trailing whitespace trimmed, which compare_file ignores); a reuse
# that drew other numbers for the replayed bindings would renumber
# every _tcdictN and _tctyvarN after the first hit
compile_pass DictSharingTrace.bs {-dtypecheck=typecheck_%p.out} 1
compare_file typecheck_DictSharingTrace.out
compile_pass DictSharingTrace.bs {-trace-tcvar} 1
compare_file DictSharingTrace.bs.bsc-out tcvar_DictSharingTrace.bsc-out.expected

# Never shared: a recursive or an incoherent result.  The recursive-Bits
# error (T0115) keeps its position and the incoherent-match diagnostics
# their count; see bsc.compile/letrec, bsc.typechecker/deriving
# (RecDeriveStructManyFields) and bsc.typechecker/typeclasses/coherence.

# A ground goal solved inside a partial reduction that satisfy puts aside
# is dropped with it (its bindings were solved under a substitution the
# retry does not keep), so a later equal predicate derives its own
compile_pass DictSharingRetry.bs {-trace-tc-dict-share} 1
find_n_strings DictSharingRetry.bs.bsc-out {satisfy:} 0

# The order in which the generated dictionary binders of a package are
# first interned reaches the .bo: IConv orders the independent
# projection binders of a recursive dictionary group by the interning
# ordinal of their spelling, and the typechecker's counter restarts per
# definition, so a spelling recurs and keeps the ordinal of its first
# interning.  A replay evaluates no identifier of a recorded derivation
# (SolvedBinds.Deriv names the walk's dictionaries by number), so the
# consumer of a replayed block interns the same spellings in the same
# order as it interns the walk's own.  The generated names of the .bo,
# in the order the .bo stream first writes them, are pinned to the list
# the compiler without this reuse writes (the .tcnames.out.expected file was
# written by that compiler; the numbers depend on the Prelude's instance
# set, as typecheck_DictSharingTrace.out.expected's do); a reuse that
# evaluated the recorded identifiers at the hit moves two of them.
proc bo_generated_names { bo out {pat {_tc(dict|temp)[0-9]+}} } {
    global srcdir
    global subdir
    set here [absolute $srcdir]
    cd [file join $here $subdir]
    set status [catch {exec sh -c "tr -c '\[:print:\]' '\\n' < $bo | grep -oE '$pat' > $out"}]
    cd $here
    return $status
}
compile_pass DictSharingMutRec.bs {-trace-tc-dict-share} 1
find_n_strings DictSharingMutRec.bs.bsc-out {satisfy:} 31
bo_generated_names DictSharingMutRec.bo DictSharingMutRec.tcnames.out
compare_file DictSharingMutRec.tcnames.out

# The same list with the reuse switched off: the derivations recorded
# beside the bindings change nothing by themselves
compile_pass DictSharingMutRec.bs {-no-tc-dict-share} 1
find_n_strings DictSharingMutRec.bs.bsc-out {satisfy:} 0
bo_generated_names DictSharingMutRec.bo DictSharingMutRec.tcnames.out
compare_file DictSharingMutRec.tcnames.out

# A walk in which joinCtxs joined two residual predicates is never
# recorded (SolvedBinds.derivWhole): the join compares the dictionary
# variables of every residual of the walk, which interns their spellings
# at that moment, and a replay of the walk would leave them to be
# interned later, in another order.  The instance context of Count (T d)
# poses two Pick and two ToU predicates whose first arguments are bound
# at once by Fix2, so the walk joins the Picks and then the ToUs; Count
# (T Bool) is posed again inside the walks of the Generic traversal of
# Wrap, Wrap2 and Wrap3.  The walks the modules' calls replay are
# walks without a join: in 69 of the 75 replaying satisfy calls only
# leaf instances, which draw no counter number (a reuse that replayed
# the joined walks drew numbers in every one of them).  The generated
# names of the .bo are pinned as DictSharingMutRec's are; the .bo is
# erased first, since the Verilog compile passes -u
erase DictSharingJoinCtx.bo
compile_verilog_pass DictSharingJoinCtx.bs mkJoin {-g mkJoin2 -g sysJoin -trace-tc-dict-share}
find_n_strings DictSharingJoinCtx.bs.bsc-vcomp-out {satisfy:} 75
find_n_strings DictSharingJoinCtx.bs.bsc-vcomp-out {, 0 counter numbers drawn by the replays} 69
bo_generated_names DictSharingJoinCtx.bo DictSharingJoinCtx.tcnames.out
compare_file DictSharingJoinCtx.tcnames.out

# The same joins before definitions with the recursive dictionary group
# of DictSharingMutRec: the counter restarts per definition, so the
# spellings of the residuals joined in the earlier definitions' nested
# walks name projection binders of the later definitions' groups.  The
# generated names of the .bo, in the order the .bo stream first writes
# them, are pinned to the list the compiler without this reuse writes
# (the .tcnames.out.expected file was written by that compiler); a reuse
# that replayed the joined walks moved two of them.
erase DictSharingJoinMut.bo
compile_verilog_pass DictSharingJoinMut.bs mkMut {-g mkMut2 -g sysMut}
bo_generated_names DictSharingJoinMut.bo DictSharingJoinMut.tcnames.out
compare_file DictSharingJoinMut.tcnames.out

# The same list with the reuse switched off
erase DictSharingJoinMut.bo
compile_verilog_pass DictSharingJoinMut.bs mkMut {-g mkMut2 -g sysMut -no-tc-dict-share}
bo_generated_names DictSharingJoinMut.bo DictSharingJoinMut.tcnames.out
compare_file DictSharingJoinMut.tcnames.out

# A nested associated type function application that the derived
# Generic instance keeps unreduced (the outer function's tag is a
# parameter of the data type): inside the walk of Count (Holder TagX
# LitA), expTFun expands Slot TagX (Pred Bool (LitPred LitA)) into
# class predicates with fresh type variables, and the concreteness
# order solves the SlotEnc predicate while the inner function's result
# variable is still free, so the walk resolves Slot for a nonground
# argument.  sat records no such result (it is never consulted, and it
# would carry the definition's type variables into the .bo, where the
# type function cache is written in the interning order of its keys'
# spellings; a replay re-records the walk's results under renumbered
# variables, in another order).  The generated dictionary names of the
# .bo are pinned as DictSharingMutRec's are, and so are its generated
# type variable names (the binders of its polymorphic definitions,
# none from the type function cache; the .tyvars.out.expected files
# were written by the compiler without reuse that records only ground
# results).  The ground results are still delivered to elaboration.
erase DictSharingAtfParam.bo
compile_verilog_pass DictSharingAtfParam.bs mkNest {-g mkNest2 -g sysNest -trace-tc-dict-share}
find_n_strings DictSharingAtfParam.bs.bsc-vcomp-out {satisfy:} 289
bo_generated_names DictSharingAtfParam.bo DictSharingAtfParam.tcnames.out
compare_file DictSharingAtfParam.tcnames.out
bo_generated_names DictSharingAtfParam.bo DictSharingAtfParam.tyvars.out {_tctyvar[0-9]+}
compare_file DictSharingAtfParam.tyvars.out
erase DictSharingAtfParam.bo
compile_verilog_pass DictSharingAtfParam.bs mkNest {-g mkNest2 -g sysNest -trace-atf-cache}
find_regexp DictSharingAtfParam.bs.bsc-vcomp-out {ATF cache hit: .DictSharingAtfParam.Slot,}
find_n_strings DictSharingAtfParam.bs.bsc-vcomp-out {ATF cache miss} 0

# An importer of that package reads its .bo and walks the same
# predicates in its own modules: the same two lists of its own .bo
erase DictSharingAtfUse.bo
compile_verilog_pass DictSharingAtfUse.bs mkUse {-g sysUse -trace-tc-dict-share}
find_n_strings DictSharingAtfUse.bs.bsc-vcomp-out {satisfy:} 30
bo_generated_names DictSharingAtfUse.bo DictSharingAtfUse.tcnames.out
compare_file DictSharingAtfUse.tcnames.out
bo_generated_names DictSharingAtfUse.bo DictSharingAtfUse.tyvars.out {_tctyvar[0-9]+}
compare_file DictSharingAtfUse.tyvars.out
