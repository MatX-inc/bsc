package PassBVI(sysPassBVI) where

interface VPass w =
    write :: Bit w -> PrimAction
    read  :: Bit w

vMkPass :: Module (VPass w)
vMkPass =
    module verilog "mkPass" (("w", valueOf w)) "CLK" "RST_N" {
        read  = "_read"{reg};
        write = "_write_1"{reg} "EN__write";
    } [ read <> read,
        read <> write,
        write << write ]

mkPassBVI :: Module (Reg (Bit w))
mkPassBVI =
  module
    _r :: VPass w <- vMkPass
    interface
      _write x = fromPrimAction (_r.write x)
      _read = _r.read

{-# verilog sysPassBVI #-}
sysPassBVI :: Module Empty
sysPassBVI =
  module
    r1  :: Reg (Bit 1)  <- mkPassBVI
    r8  :: Reg (Bit 8)  <- mkPassBVI
    r17 :: Reg (Bit 17) <- mkPassBVI
    r32 :: Reg (Bit 32) <- mkPassBVI
    r64 :: Reg (Bit 64) <- mkPassBVI

    cycle :: Reg (Bit 8) <- mkReg 0

    rules
      "step": when True ==> do
        cycle := cycle + 1
        r1  := truncate cycle
        r8  := cycle + 0x10
        r17 := zeroExtend cycle + 0x10000
        r32 := zeroExtend cycle + 0xCAFE0000
        r64 := zeroExtend cycle + 0x0123456789ABCDEF
        if cycle > 0 then
          $display "cycle=%0d r1=%0d r8=%0h r17=%0h r32=%0h r64=%0h" cycle r1 r8 r17 r32 r64
        else
          noAction
        if cycle == 4 then $finish 0 else noAction
