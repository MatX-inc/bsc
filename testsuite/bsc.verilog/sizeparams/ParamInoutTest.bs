package ParamInoutTest where

interface ParamInoutIfc w =
    io_out :: Inout (Bit w)
    widthTag :: Bit w

{-# verilog mkParamInoutPassthrough #-}
mkParamInoutPassthrough :: (Add 1 _w w) => Inout (Bit w) -> Module (ParamInoutIfc w)
mkParamInoutPassthrough io_in =
    module
        rTag :: Reg (Bit w) <- mkReg (fromInteger (valueOf w))
        interface
            io_out = io_in
            widthTag = rTag

interface TopInoutBundle =
    io1  :: Inout (Bit 1)
    io8  :: Inout (Bit 8)
    io32 :: Inout (Bit 32)
    tags :: Bit 41

{-# verilog mkTopInoutBundle #-}
mkTopInoutBundle :: Inout (Bit 1) -> Inout (Bit 8) -> Inout (Bit 32) -> Module TopInoutBundle
mkTopInoutBundle p1 p8 p32 =
    module
        u1  :: ParamInoutIfc 1  <- mkParamInoutPassthrough p1
        u8  :: ParamInoutIfc 8  <- mkParamInoutPassthrough p8
        u32 :: ParamInoutIfc 32 <- mkParamInoutPassthrough p32
        interface
            io1  = u1.io_out
            io8  = u8.io_out
            io32 = u32.io_out
            tags = u1.widthTag ++ u8.widthTag ++ u32.widthTag
