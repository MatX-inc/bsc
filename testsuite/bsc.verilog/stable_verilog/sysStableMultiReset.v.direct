//
// Generated by Bluespec Compiler
//
//
// Ports:
// Name                         I/O  size props
// CLK                            I     1 clock
// RST_N                          I     1 reset
//
// No combinational paths from inputs to outputs
//
//

`ifdef BSV_ASSIGNMENT_DELAY
`else
  `define BSV_ASSIGNMENT_DELAY
`endif

`ifdef BSV_POSITIVE_RESET
  `define BSV_RESET_VALUE 1'b1
  `define BSV_RESET_EDGE posedge
`else
  `define BSV_RESET_VALUE 1'b0
  `define BSV_RESET_EDGE negedge
`endif

module sysStableMultiReset(CLK,
			   RST_N);
  input  CLK;
  input  RST_N;

  // register a
  reg [7 : 0] a;
  wire [7 : 0] a$D_IN;
  wire a$EN;

  // register b
  reg [7 : 0] b;
  wire [7 : 0] b$D_IN;
  wire b$EN;

  // register c
  reg [7 : 0] c;
  wire [7 : 0] c$D_IN;
  wire c$EN;

  // ports of submodule r1
  wire r1$OUT_RST;

  // ports of submodule r2
  wire r2$OUT_RST;

  // submodule r1
  SyncReset #(.RSTDELAY(32'd1)) r1(.CLK(CLK),
				   .IN_RST(RST_N),
				   .OUT_RST(r1$OUT_RST));

  // submodule r2
  SyncResetA #(.RSTDELAY(32'd1)) r2(.CLK(CLK),
				    .IN_RST(RST_N),
				    .OUT_RST(r2$OUT_RST));

  // register a
  assign a$D_IN = a + 8'd1 ;
  assign a$EN = 1'd1 ;

  // register b
  assign b$D_IN = b + a ;
  assign b$EN = 1'd1 ;

  // register c
  assign c$D_IN = c + b ;
  assign c$EN = 1'd1 ;

  // handling of inlined registers

  always@(posedge CLK)
  begin
    if (RST_N == `BSV_RESET_VALUE)
      begin
        a <= `BSV_ASSIGNMENT_DELAY 8'd0;
      end
    else
      begin
        if (a$EN) a <= `BSV_ASSIGNMENT_DELAY a$D_IN;
      end
    if (r1$OUT_RST == `BSV_RESET_VALUE)
      begin
        b <= `BSV_ASSIGNMENT_DELAY 8'd1;
      end
    else
      begin
        if (b$EN) b <= `BSV_ASSIGNMENT_DELAY b$D_IN;
      end
    if (r2$OUT_RST == `BSV_RESET_VALUE)
      begin
        c <= `BSV_ASSIGNMENT_DELAY 8'd2;
      end
    else
      begin
        if (c$EN) c <= `BSV_ASSIGNMENT_DELAY c$D_IN;
      end
  end

  // synopsys translate_off
  `ifdef BSV_NO_INITIAL_BLOCKS
  `else // not BSV_NO_INITIAL_BLOCKS
  initial
  begin
    a = 8'hAA;
    b = 8'hAA;
    c = 8'hAA;
  end
  `endif // BSV_NO_INITIAL_BLOCKS
  // synopsys translate_on
endmodule  // sysStableMultiReset

