`ifdef BSV_ASSIGNMENT_DELAY
`else
  `define BSV_ASSIGNMENT_DELAY
`endif

`ifdef BSV_POSITIVE_RESET
  `define BSV_RESET_VALUE 1'b1
  `define BSV_RESET_EDGE posedge
`else
  `define BSV_RESET_VALUE 1'b0
  `define BSV_RESET_EDGE negedge
`endif

module sysStableTasks(CLK,
		      RST_N);
  input  CLK;
  input  RST_N;

  // register x
  reg [15 : 0] x;
  wire [15 : 0] x$D_IN;
  wire x$EN;

  // register y
  reg [15 : 0] y;
  wire [15 : 0] y$D_IN;
  wire y$EN;

  // remaining internal signals
  wire [31 : 0] x_MUL_y___d1;

  // register x
  assign x$D_IN = x + y ;
  assign x$EN = 1'd1 ;

  // register y
  assign y$D_IN = x_MUL_y___d1[15:0] ;
  assign y$EN = 1'd1 ;

  // remaining internal signals
  assign x_MUL_y___d1 = x * y ;

  // handling of inlined registers

  always@(posedge CLK)
  begin
    if (RST_N == `BSV_RESET_VALUE)
      begin
        x <= `BSV_ASSIGNMENT_DELAY 16'd0;
	y <= `BSV_ASSIGNMENT_DELAY 16'd1;
      end
    else
      begin
        if (x$EN) x <= `BSV_ASSIGNMENT_DELAY x$D_IN;
	if (y$EN) y <= `BSV_ASSIGNMENT_DELAY y$D_IN;
      end
  end

  // synopsys translate_off
  `ifdef BSV_NO_INITIAL_BLOCKS
  `else // not BSV_NO_INITIAL_BLOCKS
  initial
  begin
    x = 16'hAAAA;
    y = 16'hAAAA;
  end
  `endif // BSV_NO_INITIAL_BLOCKS
  // synopsys translate_on

  // handling of system tasks

  // synopsys translate_off
  always@(negedge CLK)
  begin
    #0;
    if (RST_N != `BSV_RESET_VALUE) $display("s=%0d", $unsigned(x + y));
    if (RST_N != `BSV_RESET_VALUE)
      $display("p=%0d", $unsigned(x_MUL_y___d1[15:0]));
    if (RST_N != `BSV_RESET_VALUE)
      $write("x=%0d y=%0d", $unsigned(x), $unsigned(y));
    if (RST_N != `BSV_RESET_VALUE) if (x > 16'd100) $finish(32'd0);
  end
  // synopsys translate_on
endmodule  // sysStableTasks

