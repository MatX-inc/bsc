`ifdef BSV_ASSIGNMENT_DELAY
`else
  `define BSV_ASSIGNMENT_DELAY
`endif

`ifdef BSV_POSITIVE_RESET
  `define BSV_RESET_VALUE 1'b1
  `define BSV_RESET_EDGE posedge
`else
  `define BSV_RESET_VALUE 1'b0
  `define BSV_RESET_EDGE negedge
`endif

module sysStableOptionsPragma(CLK,
			      RST_N);
  input  CLK;
  input  RST_N;

  // register a
  reg [7 : 0] a;
  wire [7 : 0] a$D_IN;
  wire a$EN;

  // register b
  reg [7 : 0] b;
  wire [7 : 0] b$D_IN;
  wire b$EN;

  // rule scheduling signals
  wire CAN_FIRE_RL_r1, CAN_FIRE_RL_r2, WILL_FIRE_RL_r1, WILL_FIRE_RL_r2;

  // rule RL_r1
  assign CAN_FIRE_RL_r1 = a < 8'd100 ;
  assign WILL_FIRE_RL_r1 = CAN_FIRE_RL_r1 ;

  // rule RL_r2
  assign CAN_FIRE_RL_r2 = b < 8'd50 ;
  assign WILL_FIRE_RL_r2 = CAN_FIRE_RL_r2 ;

  // register a
  assign a$D_IN = a + b ;
  assign a$EN = CAN_FIRE_RL_r1 ;

  // register b
  assign b$D_IN = b + 8'd1 ;
  assign b$EN = CAN_FIRE_RL_r2 ;

  // handling of inlined registers

  always@(posedge CLK)
  begin
    if (RST_N == `BSV_RESET_VALUE)
      begin
        a <= `BSV_ASSIGNMENT_DELAY 8'd0;
	b <= `BSV_ASSIGNMENT_DELAY 8'd1;
      end
    else
      begin
        if (a$EN) a <= `BSV_ASSIGNMENT_DELAY a$D_IN;
	if (b$EN) b <= `BSV_ASSIGNMENT_DELAY b$D_IN;
      end
  end

  // synopsys translate_off
  `ifdef BSV_NO_INITIAL_BLOCKS
  `else // not BSV_NO_INITIAL_BLOCKS
  initial
  begin
    a = 8'hAA;
    b = 8'hAA;
  end
  `endif // BSV_NO_INITIAL_BLOCKS
  // synopsys translate_on
endmodule  // sysStableOptionsPragma

