// Generated by Bluespec Compiler
//
//
// Ports:
// Name                         I/O  size props
// CLK                            I     1 clock
// RST_N                          I     1 reset
//
// No combinational paths from inputs to outputs
//
//

`ifdef BSV_ASSIGNMENT_DELAY
`else
  `define BSV_ASSIGNMENT_DELAY
`endif

`ifdef BSV_POSITIVE_RESET
  `define BSV_RESET_VALUE 1'b1
  `define BSV_RESET_EDGE posedge
`else
  `define BSV_RESET_VALUE 1'b0
  `define BSV_RESET_EDGE negedge
`endif

module sysStableOptIfMux(CLK,
			 RST_N);
  input  CLK;
  input  RST_N;

  // register p
  reg p;
  wire p$D_IN, p$EN;

  // register q
  reg q;
  wire q$D_IN, q$EN;

  // register r
  reg [7 : 0] r;
  reg [7 : 0] r$D_IN;
  wire r$EN;

  // register s
  reg s;
  wire s$D_IN, s$EN;

  // register p
  assign p$D_IN = !q ;
  assign p$EN = 1'd1 ;

  // register q
  assign q$D_IN = !s ;
  assign q$EN = 1'd1 ;

  // register r
  always@(p or q or r or s)
  case (1'b1)
    p && q: r$D_IN = r + 8'd1;
    s: r$D_IN = r + 8'd2;
    default: r$D_IN = r + 8'd3;
  endcase
  assign r$EN = 1'd1 ;

  // register s
  assign s$D_IN = !p ;
  assign s$EN = 1'd1 ;

  // handling of inlined registers

  always@(posedge CLK)
  begin
    if (RST_N == `BSV_RESET_VALUE)
      begin
        p <= `BSV_ASSIGNMENT_DELAY 1'd0;
	q <= `BSV_ASSIGNMENT_DELAY 1'd1;
	r <= `BSV_ASSIGNMENT_DELAY 8'd0;
	s <= `BSV_ASSIGNMENT_DELAY 1'd0;
      end
    else
      begin
        if (p$EN) p <= `BSV_ASSIGNMENT_DELAY p$D_IN;
	if (q$EN) q <= `BSV_ASSIGNMENT_DELAY q$D_IN;
	if (r$EN) r <= `BSV_ASSIGNMENT_DELAY r$D_IN;
	if (s$EN) s <= `BSV_ASSIGNMENT_DELAY s$D_IN;
      end
  end

  // synopsys translate_off
  `ifdef BSV_NO_INITIAL_BLOCKS
  `else // not BSV_NO_INITIAL_BLOCKS
  initial
  begin
    p = 1'h0;
    q = 1'h0;
    r = 8'hAA;
    s = 1'h0;
  end
  `endif // BSV_NO_INITIAL_BLOCKS
  // synopsys translate_on
endmodule  // sysStableOptIfMux

