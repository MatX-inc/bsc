# ----------
# Tests for noinline functions

# -----

# basic test?
test_c_veri_bs_modules NoInline {module_testAdd}

# basic test for noinline function of no arguments
test_c_veri_bsv NoInline_NoArgs

# -----

# test for bug 488
# (This also tests for the naming of noinline arguments, as mentioned
# in bug 1395.)

compile_verilog_pass MulSize.bsv
# The naming of the arguments in the RTL is checked here
compare_verilog module_test.v

# Also test that the arguments are stored in the struct declaration,
# so that things like the "workstation" will report the proper argument
# names for the interface, etc

if { ($vtest == 1) && [do_internal_checks] } {
find_regexp [make_dumpbo_output_name MulSize.bo] \
    {\{\-\# arg_names \= \[a\,\s*b\,\s*c\] \#\-\}}
}

# Test that the naming of arguments works in Classic when there are less
# patterns than there are argument types
test_c_veri_bs_modules \
  NoInline_LessPatternsThanArgs module_testLessPatterns

# Test in BSV for less arg names than the type, using a typedef and using
# direct "function" syntax

test_c_veri_bsv_modules \
  NoInline_LessPatternsThanArgs_BSV_Function \
  module_testLessPatternsBSVFunction \
  sysNoInline_LessPatternsThanArgs.out.expected

compile_verilog_pass NoInline_LessPatternsThanArgs_BSV_TypeDef.bsv

# -----

# test for noinline in rule conditions
# (was a codegen issue for Bluesim)
test_c_veri_bsv_modules NoInlineInSched {module_inv}

# -----

# One call of a noinline function is one instance of the function's
# module, whatever the result of the call defines: the argument of
# several register writes or submodule methods, the enable or the
# condition of several method calls, the result of several value
# methods.  Each of those signals used to get a copy of the call, and
# the Verilog backend wrote an instance for each copy, all with the one
# instance name of the call (which is not legal Verilog).
#
# So count the instances, and link and simulate the design.

set multiuse_mods [list module_multiUseEncode module_multiUsePick \
                       module_multiUseFold mkNoInlineMultiUse_Sub]

proc noinline_multiuse_count_instances {} {
    global vtest

    if { $vtest == 1 } {
        # the top module has two calls of each of these
        find_n_strings sysNoInlineMultiUse.v \
            {module_multiUseEncode instance_multiUseEncode_} 2
        find_n_strings sysNoInlineMultiUse.v \
            {module_multiUsePick instance_multiUsePick_} 2
        find_n_strings mkNoInlineMultiUse_Sub.v \
            {module_multiUseFold instance_multiUseFold_} 1
    }
}

# With the default flags, identical definitions are joined again after
# the copying, which hid the copies, except a copy in a method enable
# that came before every definition the others could be joined to (an
# enable is never that definition)
test_c_veri_bsv_modules NoInlineMultiUse $multiuse_mods
noinline_multiuse_count_instances

# Other flags expose other copies:
#  * a condition signal of -keep-method-conds is, like an enable, never
#    the definition that the others are joined to
#  * with -no-opt-join-defs, nothing is joined
#  * with -keep-fires, the CAN_FIRE and WILL_FIRE of a rule are two more
#    signals that the rule's condition defines
foreach multiuse_opts { {-keep-method-conds}
                        {-no-opt-join-defs}
                        {-keep-fires -keep-method-conds -no-opt-join-defs} } {
    # erase to force recompile with different options
    erase NoInlineMultiUse.bo
    erase sysNoInlineMultiUse.v
    erase mkNoInlineMultiUse_Sub.v

    test_veri_only_bsv_modules_options \
        NoInlineMultiUse $multiuse_mods $multiuse_opts
    noinline_multiuse_count_instances
}

# A Classic foreign function bound to a module is instantiated in the
# same way, so one call of it is one instance too
if { $vtest == 1 } {
compile_verilog_pass ForeignMultiUse.bs {} {-no-opt-join-defs}
find_n_strings sysForeignMultiUse.v {Dup instance_vdup_} 1
}

# -----

# Test for error conditions when trying to synthesize functions
# whose types cannot be synthesized.

if { $vtest == 1 } {

# two T0043s: the definition-level report (with the module name) and the
# unresolved Bits residual rooted back to the interface method (with the
# method position)
compile_verilog_fail_error NoInline_ArgNotInBits.bsv T0043 2
# compare for good measure, since the error has a configurable string
compare_file NoInline_ArgNotInBits.bsv.bsc-vcomp-out

# the combined tree reports the interface-method residual through the
# WrapMethod proviso chain (T0032) instead of a third T0043; detection
# is intact and richer (same adjustment as release-2026.07.rc3)
compile_verilog_fail_error NoInline_ResNotInBits.bsv T0043 2
# compare for good measure, since the error has a configurable string
compare_file NoInline_ResNotInBits.bsv.bsc-vcomp-out

compile_verilog_fail_error NoInline_ResAction.bsv T0109

compile_verilog_fail_error NoInline_ResActionValue.bsv T0109

compile_verilog_fail NoInline_PredNotReducible.bsv T0110

compile_verilog_pass NoInline_PredReducible.bsv

compile_verilog_fail NoInline_Polymorphic.bsv T0111

# A foreign function bound to a module must use a bare type variable or
# a literal for every bit width (widths become instance parameters named
# by the type variables; a type-function width has no name to pass)
compile_verilog_fail BadForeignWidth.bs T0162

# Numeric provisos on foreign functions are permitted (checked at each
# application, then erased); anything else is rejected
compile_verilog_pass ForeignCtxGood.bs
find_regexp sysForeignCtxGood.v {Dup #\(\.iw\(8\), \.ow\(16\)\)}
compile_verilog_fail ForeignCtxViolated.bs T0031
compile_verilog_fail ForeignCtxBad.bs T0163
}

