package ForeignMultiUse(sysForeignMultiUse, Ifc) where

{-# verilog sysForeignMultiUse #-}

-- A foreign function bound to a module is instantiated like a noinline
-- function: one call is one instance, whatever the result defines
-- (here, the result of two value methods).  Only compiled: there is
-- no module Dup to link with.
foreign vdup :: Bit 8 -> Bit 16 = "Dup",("i","o")

interface Ifc =
  get1 :: Bit 16
  get2 :: Bit 16

sysForeignMultiUse :: Module Ifc
sysForeignMultiUse =
  module
    r :: Reg (Bit 8) <- mkReg 0
    let v = vdup r
    interface
      get1 = v
      get2 = v
