# -trace-intern-table writes the SpeedyString table when bsc exits, as
# one JSON document with one entry per line, to the file named by
# BSC_INTERN_DUMP or else to <package>.intern.json beside the .bo.  Two
# compiles of one source by one bsc must leave identical tables, and the
# table starts at id 0.

erase InternTable.bo
compile_backend_pass InternTable.bs {-trace-intern-table}
find_regexp InternTable.intern.json {^\{"internNextId":[1-9][0-9]*,"internEntries":\[\n\[0,"}
find_regexp InternTable.intern.json {^\]\}$}
move InternTable.intern.json InternTable.default.intern.json

erase InternTable.bo
set ::env(BSC_INTERN_DUMP) "InternTable.env.intern.json"
compile_backend_pass InternTable.bs {-trace-intern-table}
unset ::env(BSC_INTERN_DUMP)
compare_file InternTable.env.intern.json InternTable.default.intern.json

# A program against the bsc library restores snapshots in fresh processes:
# RestoreReject.hs runs the restore's rejection cases, one process each.
# Untested without bluehs.
foreach mode {invalid late noted empty generated lazycount} {
    bluehs_run_pass RestoreReject.hs [list $mode] RestoreReject.hs.$mode.bluehs-out
}

# The table read back with InternRestore (util/bluehs/bsc-json) restores in
# a fresh process, and the table it then writes is the same bytes.
# ReadInternTable.hs checks the reader's strictness and writes a table of
# awkward spellings for a second round trip.
if {[bluehs_run_pass RestoreRoundTrip.hs {InternTable.default.intern.json InternTable.restored.intern.json}]} {
    compare_file InternTable.restored.intern.json InternTable.default.intern.json
}
if {[bluehs_run_pass ReadInternTable.hs {InternTable.default.intern.json Awkward.intern.json}]} {
    if {[bluehs_run_pass RestoreRoundTrip.hs {Awkward.intern.json Awkward.restored.intern.json} RestoreRoundTrip.hs.awkward.bluehs-out]} {
        compare_file Awkward.restored.intern.json Awkward.intern.json
    }
}
