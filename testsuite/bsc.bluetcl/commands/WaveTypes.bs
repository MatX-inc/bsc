package WaveTypes where

-- A design whose waveform carries every kind of signal the dumper
-- names: registers of struct, union, enum, Maybe and Vector types and
-- of types with hand-written Bits instances, a wire, a FIFO, rule
-- fires, a synthesized submodule and an inlined one.  One shared core,
-- instantiated by a separate top module per link configuration.

import FIFO
import DReg
import Vector

data Color = Red | Green | Blue
  deriving (Bits, Eq)

struct Pixel =
  { x :: UInt 8
  ; y :: UInt 8
  ; color :: Color }
  deriving (Bits, Eq)

data Cell = Px Pixel | Idx (UInt 16) | Empty
  deriving (Bits, Eq)

-- Hand-written Bits instances: a sparse encoding in which the payload
-- shares the bits that tell the arms apart, and a prefix code whose
-- short arm is not right-aligned
data Source = Zeros | Alu (Bit 1) | VecMem | Other
  deriving (Eq)

instance Bits Source 3 where
  pack s = case s of
    Zeros -> 0
    Alu 0 -> 1
    Alu 1 -> 2
    VecMem -> 3
    Other -> 4
  unpack b = case b of
    0 -> Zeros
    1 -> Alu 0
    2 -> Alu 1
    3 -> VecMem
    _ -> Other

data Packet = Wide (Bit 8) | Narrow (Bit 6)
  deriving (Eq)

instance Bits Packet 9 where
  pack p = case p of
    Wide f -> (0 :: Bit 1) ++ f
    Narrow f -> (1 :: Bit 1) ++ f ++ (0 :: Bit 2)
  unpack b = if b[8:8] == 0 then Wide b[7:0] else Narrow b[7:2]

interface Pair =
  bump :: Action
  total :: UInt 8

-- A module that is not synthesized separately: its contents are
-- inlined into the module instantiating it, and appear in a dump
-- under its instance name.  mkDReg is a library module whose only
-- content is a register.
mkPair :: Module Pair
mkPair =
  module
    lo :: Reg (UInt 4) <- mkReg 0
    hi :: Reg (UInt 4) <- mkReg 0
    d :: Reg (UInt 4) <- mkDReg 0
    rules
      "carry": when lo == 15 ==> hi := hi + 1
    interface
      bump = do
        lo := lo + 1
        d := lo
      total = zeroExtend hi * 16 + zeroExtend lo

interface Stash =
  push :: Pixel -> Action
  top :: Pixel
  depth :: UInt 8

{-# verilog mkStash #-}
mkStash :: Module Stash
mkStash =
  module
    q :: FIFO Pixel <- mkFIFO
    cnt :: Reg (UInt 8) <- mkReg 0
    last :: Reg Pixel <- mkReg (Pixel { x = 0; y = 0; color = Red })
    rules
      "drain": when True ==> do
        last := q.first
        q.deq
        cnt := cnt + 1
    interface
      push p = q.enq p
      top = last
      depth = cnt

{-# verilog mkWaveTypesCore #-}
mkWaveTypesCore :: Module Empty
mkWaveTypesCore =
  module
    stash :: Stash <- mkStash
    cell :: Reg Cell <- mkReg Empty
    maybeIdx :: Reg (Maybe (UInt 16)) <- mkReg Invalid
    palette :: Reg (Vector 4 Color) <- mkReg (replicate Red)
    tick :: Reg (UInt 16) <- mkReg 0
    w :: RWire (UInt 16) <- mkRWire
    source :: Reg Source <- mkReg Zeros
    packet :: Reg Packet <- mkReg (Wide 0)
    pair :: Pair <- mkPair
    rules
      "step": when True ==> do
        tick := tick + 1
        pair.bump
        source := unpack (truncate (pack tick))
        packet := if (pack tick)[0:0] == 1 then Narrow (truncate (pack tick)) else Wide (truncate (pack tick))
        stash.push (Pixel { x = truncate tick; y = truncate (tick + 1); color = Green })
        cell := Idx tick
        maybeIdx := Valid tick
        w.wset tick
        palette := rotate palette
      "done": when tick == 20 ==> $finish 0

{-# verilog sysWaveTypes #-}
sysWaveTypes :: Module Empty
sysWaveTypes =
  module
    core :: Empty <- mkWaveTypesCore

{-# verilog sysWaveTypesTrim #-}
sysWaveTypesTrim :: Module Empty
sysWaveTypesTrim =
  module
    core :: Empty <- mkWaveTypesCore
