=== dumpSAL (MergeIf2 sysMergeIf2):
CTX_sysMergeIf2 : CONTEXT =
BEGIN
  
  STATE : TYPE =
    [# inst_w : CTX_RegN{17}!STATE
     , inst_x : CTX_RegN{17}!STATE
     , inst_y : CTX_RegN{17}!STATE
     , inst_z : CTX_RegN{17}!STATE
     , inst_c1 : CTX_RegN{1}!STATE
     , inst_c2 : CTX_RegN{1}!STATE
     , inst_c3 : CTX_RegN{1}!STATE
     , inst_c4 : CTX_RegN{1}!STATE
     #] ;
  
  ctor : STATE =
    (# inst_w := CTX_RegN{17}!ctor(Bit{17}!mkConst(0))
     , inst_x := CTX_RegN{17}!ctor(Bit{17}!mkConst(0))
     , inst_y := CTX_RegN{17}!ctor(Bit{17}!mkConst(5))
     , inst_z := CTX_RegN{17}!ctor(Bit{17}!mkConst(5))
     , inst_c1 := CTX_RegN{1}!ctor(Bit{1}!mkConst(0))
     , inst_c2 := CTX_RegN{1}!ctor(Bit{1}!mkConst(0))
     , inst_c3 := CTX_RegN{1}!ctor(Bit{1}!mkConst(0))
     , inst_c4 := CTX_RegN{1}!ctor(Bit{1}!mkConst(0))
     #) ;
  
  rule_RL_r (state0 : STATE) : [ BOOLEAN, STATE ] =
    LET def_c2_hrnqm : Bit{1}!T = CTX_RegN{1}!meth_read(state0.inst_c2)
    IN LET def_c1_hgmom : Bit{1}!T = CTX_RegN{1}!meth_read(state0.inst_c1)
    IN LET def_c3_huw5l : Bit{1}!T = CTX_RegN{1}!meth_read(state0.inst_c3)
    IN LET def_c3_AND_NOT_c2_hfl6c : BOOLEAN =
	     Prim!bitToBool(def_c3_huw5l) AND (NOT Prim!bitToBool(def_c2_hrnqm))
    IN LET def_c4_h0td5 : Bit{1}!T = CTX_RegN{1}!meth_read(state0.inst_c4)
    IN LET def_c2_AND_c3_h670w : BOOLEAN = Prim!bitToBool(def_c2_hrnqm) AND Prim!bitToBool(def_c3_huw5l)
    IN LET def_c2_AND_c3_AND_c4_hrt6h : BOOLEAN = def_c2_AND_c3_h670w AND Prim!bitToBool(def_c4_h0td5)
    IN LET def_c4_AND_NOT_c1_hij9c : BOOLEAN =
	     Prim!bitToBool(def_c4_h0td5) AND (NOT Prim!bitToBool(def_c1_hgmom))
    IN LET def_c4_AND_NOT_c1_AND_c3_hgotn : BOOLEAN =
	     def_c4_AND_NOT_c1_hij9c AND Prim!bitToBool(def_c3_huw5l)
    IN LET def_c1_AND_c2_hka6d : BOOLEAN = Prim!bitToBool(def_c1_hgmom) AND Prim!bitToBool(def_c2_hrnqm)
    IN LET def_c3_AND_NOT_c2_AND_NOT_c1_hkj2q : BOOLEAN =
	     def_c3_AND_NOT_c2_hfl6c AND (NOT Prim!bitToBool(def_c1_hgmom))
    IN LET def_c2_AND_c3_AND_c4_AND_c1_hc6dd : BOOLEAN =
	     def_c2_AND_c3_AND_c4_hrt6h AND Prim!bitToBool(def_c1_hgmom)
    IN LET def_c4_AND_NOT_c1_AND_c3_AND_NOT_c2_hdunb : BOOLEAN =
	     def_c4_AND_NOT_c1_AND_c3_hgotn AND (NOT Prim!bitToBool(def_c2_hrnqm))
    IN LET act1 : [ CTX_RegN{17}!STATE, Unit!T ] =
	     CTX_RegN{17}!meth_write(Bit{17}!mkConst(0), state0.inst_w)
    IN LET state1 : STATE = IF def_c1_AND_c2_hka6d THEN state0 WITH .inst_w := act1.1 ELSE state0 ENDIF
    IN LET act2 : [ CTX_RegN{17}!STATE, Unit!T ] =
	     CTX_RegN{17}!meth_write(Bit{17}!mkConst(1), state1.inst_x)
    IN LET state2 : STATE =
	     IF def_c3_AND_NOT_c2_AND_NOT_c1_hkj2q THEN state1 WITH .inst_x := act2.1 ELSE state1 ENDIF
    IN LET act3 : [ CTX_RegN{17}!STATE, Unit!T ] =
	     CTX_RegN{17}!meth_write(Bit{17}!mkConst(2), state2.inst_y)
    IN LET state3 : STATE =
	     IF def_c2_AND_c3_AND_c4_AND_c1_hc6dd THEN state2 WITH .inst_y := act3.1 ELSE state2 ENDIF
    IN LET act4 : [ CTX_RegN{17}!STATE, Unit!T ] =
	     CTX_RegN{17}!meth_write(Bit{17}!mkConst(3), state3.inst_z)
    IN LET state4 : STATE =
	     IF def_c4_AND_NOT_c1_AND_c3_AND_NOT_c2_hdunb THEN state3 WITH .inst_z := act4.1 ELSE state3 ENDIF
    IN ( TRUE, state4 ) ;
  
END

