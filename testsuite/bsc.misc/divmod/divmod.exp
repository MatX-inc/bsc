# Due to bugs in iverilog, we must use -no-use-negate and cannot do
# wide division.

# Verilator 5.048 mis-evaluates $display("%d", $signed(bus[31:16])) when
# bus is a 64-bit submodule output carrying a runtime value: the 16-bit
# part-selects in the lower 32-bit word print as unsigned 32-bit windows
# (e.g. 4293656577 = {d,q} instead of q).  The hardware itself computes
# correctly (the design's own check prints OK/PASSED); only the display
# arguments are corrupted.  Confirmed a Verilator bug with a standalone
# non-BSC repro; upstream-report candidate.  iverilog and Bluesim agree
# with the golden.
set verilator_signed_sel_bug {}
if { $verilog_compiler == "verilator" } {
    set verilator_signed_sel_bug $verilog_compiler
}

test_c_veri_bsv SimpleTest sysSimpleTest.out.expected

test_c_veri_bsv_modules_options DivMod {} "-no-use-negate" {} {} $verilator_signed_sel_bug

test_c_veri_bsv_modules_options DivModWide {} "-no-use-negate" sysDivModWide.out.expected

# Bluesim is 2-state and has no X, so a runtime divide-by-zero is
# defined to produce all ones for both the quotient and the remainder.
# It must not raise SIGFPE (which used to happen on the wide path, and
# on the narrow path at low optimization levels) and must not be
# undefined behavior (which is what the narrow path used to be: the
# result varied with target and optimization level, and on aarch64 it
# silently produced 0 -- GitHub #688).

# Narrow (<= 64 bit) path
compile_object_pass DivideByZero.bsv sysDivideByZero
link_objects_pass sysDivideByZero sysDivideByZero
sim_output sysDivideByZero
compare_file sysDivideByZero.out sysDivideByZero.out.expected

# In Verilog it silently produces x's
test_veri_only_bsv DivideByZero sysDivideByZero.v.out.expected

# Wide (> 64 bit) path
compile_object_pass DivideByZeroWide.bsv sysDivideByZeroWide
link_objects_pass sysDivideByZeroWide sysDivideByZeroWide
sim_output sysDivideByZeroWide
compare_file sysDivideByZeroWide.out sysDivideByZeroWide.out.expected

# In Verilog it silently produces x's
test_veri_only_bsv DivideByZeroWide sysDivideByZeroWide.v.out.expected

# All ones at every width, on both paths.  Covers widths that are not
# multiples of the 32-bit word size, to check the masking of the top
# partial word.  Bluesim only; Verilog produces x for all of these.
compile_object_pass DivideByZeroWidths.bsv sysDivideByZeroWidths
link_objects_pass sysDivideByZeroWidths sysDivideByZeroWidths
sim_output sysDivideByZeroWidths
compare_file sysDivideByZeroWidths.out sysDivideByZeroWidths.out.expected

# A divide-by-zero that the design guards against, but which Bluesim
# evaluates anyway because the guard is in the rule body rather than on
# the rule.  Both backends must agree that the guarded register keeps
# its initial value.  This is the case that made a fatal error or a
# runtime warning untenable: it happens in correct designs.
test_c_veri_bsv DivideByZeroGuarded sysDivideByZeroGuarded.out.expected

# Division with operands of different widths, which BSC permits
# (primQuot :: Bit k -> Bit n -> Bit k).  A wide operand paired with a
# narrow one used to fail to compile, and two wide operands with the
# dividend wider than the divisor used to hang.  Bluesim only, because
# iverilog cannot do wide division.
compile_object_pass DivMixedWidth.bsv sysDivMixedWidth
link_objects_pass sysDivMixedWidth sysDivMixedWidth
sim_output sysDivMixedWidth
compare_file sysDivMixedWidth.out sysDivMixedWidth.out.expected

# Divide-by-zero at mixed widths: the quotient is all ones at the
# dividend's width and the remainder all ones at the divisor's width,
# which are not the same width and are not the width the division is
# computed at.  Bluesim only; Verilog produces x.
compile_object_pass DivideByZeroMixedWidth.bsv sysDivideByZeroMixedWidth
link_objects_pass sysDivideByZeroMixedWidth sysDivideByZeroMixedWidth
sim_output sysDivideByZeroMixedWidth
compare_file sysDivideByZeroMixedWidth.out sysDivideByZeroMixedWidth.out.expected

# Test that compile-time divide-by-zero produces a compile-time failure
compile_object_fail_error DivideByZeroStatic.bsv G0059 1 sysDivideByZeroStatic

