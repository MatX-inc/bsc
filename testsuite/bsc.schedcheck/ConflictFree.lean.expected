def arm_tasks_0 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Wires (KI .tasks).M V :=
  ⟨fun t => (tenT.get t.val) V ops E oc, fun t => (targT.get t.val) V ops E oc⟩
def arms_reg : Tab ((V : Type) → Ops V → EqC V → OC V → Wires Empty V → Wires (KI .reg).M V) :=
  (.node 4 (.node 2 (.node 1 (.leaf (arm_reg_0))
  (.leaf (arm_reg_1)))
  (.node 3 (.leaf (arm_reg_2))
  (.leaf (arm_reg_3))))
  (.node 6 (.node 5 (.leaf (arm_reg_4))
  (.leaf (arm_reg_5)))
  (.node 7 (.leaf (arm_reg_6))
  (.node 8 (.leaf (arm_reg_7))
  (.leaf (arm_reg_8))))))
def arms_f2 : Tab ((V : Type) → Ops V → EqC V → OC V → Wires Empty V → Wires (KI .f2).M V) :=
  (.leaf (arm_f2_0))
def arms_rwC : Tab ((V : Type) → Ops V → EqC V → OC V → Wires Empty V → Wires (KI .rwC).M V) :=
  (.node 12 (.node 6 (.node 3 (.node 1 (.leaf (arm_rwC_0))
  (.node 2 (.leaf (arm_rwC_1))
  (.leaf (arm_rwC_2))))
  (.node 4 (.leaf (arm_rwC_3))
  (.node 5 (.leaf (arm_rwC_4))
  (.leaf (arm_rwC_5)))))
  (.node 9 (.node 7 (.leaf (arm_rwC_6))
  (.node 8 (.leaf (arm_rwC_7))
  (.leaf (arm_rwC_8))))
  (.node 10 (.leaf (arm_rwC_9))
  (.node 11 (.leaf (arm_rwC_10))
  (.leaf (arm_rwC_11))))))
  (.node 18 (.node 15 (.node 13 (.leaf (arm_rwC_12))
  (.node 14 (.leaf (arm_rwC_13))
  (.leaf (arm_rwC_14))))
  (.node 16 (.leaf (arm_rwC_15))
  (.node 17 (.leaf (arm_rwC_16))
  (.leaf (arm_rwC_17)))))
  (.node 21 (.node 19 (.leaf (arm_rwC_18))
  (.node 20 (.leaf (arm_rwC_19))
  (.leaf (arm_rwC_20))))
  (.node 23 (.node 22 (.leaf (arm_rwC_21))
  (.leaf (arm_rwC_22)))
  (.node 24 (.leaf (arm_rwC_23))
  (.leaf (arm_rwC_24)))))))
def arms_tasks : Tab ((V : Type) → Ops V → EqC V → OC V → Wires Empty V → Wires (KI .tasks).M V) :=
  (.leaf (arm_tasks_0))
section
variable {V : Type}
def arms : (κ : Kind) → Tab ((V : Type) → Ops V → EqC V → OC V → Wires Empty V → Wires (KI κ).M V)
  | .reg => arms_reg
  | .f2 => arms_f2
  | .rwC => arms_rwC
  | .tasks => arms_tasks

/-- The parent's combinational logic: children through the arm tables; a method's RDY is its
    CAN_FIRE, its result the result expression. -/
def comb (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : ((j : I) → Wires (CI j).M V) × Outs Empty V :=
  (fun j => (arms j.1).get j.2.val V ops E oc w, ⟨fun e => e.elim, fun e => e.elim⟩)
/-- The parallel muxes' selectors are one-hot. -/
def onehotP (ops : Ops V) (E : EqC V) (oc : OC V) : Prop :=
  amoChain false ((mlist_0 V ops E oc).map Prod.fst) ∧ amoChain false ((mlist_1 V ops E oc).map Prod.fst) ∧ amoChain false ((mlist_2 V ops E oc).map Prod.fst) ∧ amoChain false ((mlist_3 V ops E oc).map Prod.fst) ∧ amoChain false ((mlist_4 V ops E oc).map Prod.fst) ∧ True

/-- **The family**: each step's program is `runSites v … v` of its own skipped values `v`. -/
abbrev F (ops : Ops V) (E : EqC V) : ParentU V where
  I := I
  decI := inferInstance
  kids := allKids [.reg, .f2, .rwC, .tasks] nk
  kids_nodup := allKids_nodup nk _ (by decide)
  kids_all := mem_allKids _ nk (fun κ => by cases κ <;> simp)
  CI := CI
  X := X
  PR := Fin nR
  body := fun m _ _ => m.elim
  rbody := fun r v => runSites v ((resT.get r.val) V ops E ops.z) (sitesF (siteR ops E r.val) (kR r.val)) 0 v
  comb := comb ops E
  asm := fun oc _ => asmP ops E oc
  onehot := fun oc _ => onehotP ops E oc
  toB := ops.toB

/-- The parent at skipped values `u` (step `s` sees only `u s`). -/
abbrev P (ops : Ops V) (E : EqC V) (u : St → Nat → V) : Parent V := (F ops E).at u
/-- Each step's program takes its skipped values only through `runSites`; its sites and result
    do not receive them (design §18 trust point 7, checked by `rfl`). -/
theorem F_sites (ops : Ops V) (E : EqC V) : F ops E = withRuleSites (F ops E)
    (fun r => sitesF (siteR ops E r.val) (kR r.val)) (fun r => (resT.get r.val) V ops E ops.z) := rfl
end

section
variable {V : Type}
/-- Hyps, facts 0 to 9. -/
structure HypsG0 (ops : Ops V) (E : EqC V) : Prop where
  /-- escape RL_emitA → RL_emitB: outQ.enq then outQ.enq (confirmed by the solver with the conflict_free checks naming these steps assumed: under `asmP`) -/
  esc_0 : ∀ oc : OC V, asmP ops E oc → WF ops E oc 0 = true → WF ops E oc 1 = true → ops.g 0 ((oc (iReg 0)).ret Reg.read) = true → ops.g 6 ((oc (iReg 1)).ret Reg.read) = true → False
  /-- escape RL_r1 → RL_r2: rs_0.write then rs_0.read (bsc: confirmed RL_r1 / RL_r2: rs_0.write then rs_0.read; these conditions imply bsc's) -/
  esc_1 : ∀ oc : OC V, WF ops E oc 2 = true → WF ops E oc 3 = true → ops.g 11 ((oc (iReg 7)).ret Reg.read) = true → ops.g 25 ((oc (iReg 7)).ret Reg.read) = true → False
  /-- escape RL_r1 → RL_r2: rs_1.write then rs_1.read (bsc: confirmed RL_r1 / RL_r2: rs_1.write then rs_1.read; these conditions imply bsc's) -/
  esc_2 : ∀ oc : OC V, WF ops E oc 2 = true → WF ops E oc 3 = true → ops.g 12 ((oc (iReg 7)).ret Reg.read) = true → ops.g 26 ((oc (iReg 7)).ret Reg.read) = true → False
  /-- escape RL_r1 → RL_r2: rs_2.write then rs_2.read (bsc: confirmed RL_r1 / RL_r2: rs_2.write then rs_2.read; these conditions imply bsc's) -/
  esc_3 : ∀ oc : OC V, WF ops E oc 2 = true → WF ops E oc 3 = true → ops.g 13 ((oc (iReg 7)).ret Reg.read) = true → ops.g 27 ((oc (iReg 7)).ret Reg.read) = true → False
  /-- escape RL_r1 → RL_r2: rs_3.write then rs_3.read (bsc: confirmed RL_r1 / RL_r2: rs_3.write then rs_3.read; these conditions imply bsc's) -/
  esc_4 : ∀ oc : OC V, WF ops E oc 2 = true → WF ops E oc 3 = true → ops.g 14 ((oc (iReg 7)).ret Reg.read) = true → ops.g 28 ((oc (iReg 7)).ret Reg.read) = true → False
  /-- callers of one port never both call: RL_r1, RL_r2 (solver, with the conflict_free checks naming them assumed: under `asmP`) -/
  cx_0 : ∀ oc : OC V, asmP ops E oc → WF ops E oc 2 = true → ops.g 11 ((oc (iReg 7)).ret Reg.read) = true → WF ops E oc 3 = true → ops.g 29 ((oc (iReg 7)).ret Reg.read) = true → False
  /-- callers of one port never both call: RL_r1, RL_r2 (solver, with the conflict_free checks naming them assumed: under `asmP`) -/
  cx_1 : ∀ oc : OC V, asmP ops E oc → WF ops E oc 2 = true → ops.g 12 ((oc (iReg 7)).ret Reg.read) = true → WF ops E oc 3 = true → ops.g 30 ((oc (iReg 7)).ret Reg.read) = true → False
  /-- callers of one port never both call: RL_r1, RL_r2 (solver, with the conflict_free checks naming them assumed: under `asmP`) -/
  cx_2 : ∀ oc : OC V, asmP ops E oc → WF ops E oc 2 = true → ops.g 13 ((oc (iReg 7)).ret Reg.read) = true → WF ops E oc 3 = true → ops.g 31 ((oc (iReg 7)).ret Reg.read) = true → False
  /-- callers of one port never both call: RL_r1, RL_r2 (solver, with the conflict_free checks naming them assumed: under `asmP`) -/
  cx_3 : ∀ oc : OC V, asmP ops E oc → WF ops E oc 2 = true → ops.g 14 ((oc (iReg 7)).ret Reg.read) = true → WF ops E oc 3 = true → ops.g 32 ((oc (iReg 7)).ret Reg.read) = true → False
  /-- callers of one port never both call: RL_emitA, RL_emitB (solver, with the conflict_free checks naming them assumed: under `asmP`) -/
  cx_4 : ∀ oc : OC V, asmP ops E oc → WF ops E oc 0 = true → ops.g 0 ((oc (iReg 0)).ret Reg.read) = true → WF ops E oc 1 = true → ops.g 6 ((oc (iReg 1)).ret Reg.read) = true → False
/-- bsc's solver verdicts, hypotheses as today: disjointness (CAN_FIRE of each pair); the
    use-level readiness facts over R_seq, each escape's dynamic exclusion and the callers'
    exclusivity at a mux, as confirmed by the solver over schedcheck's conditions (in groups `gK`). -/
structure Hyps (ops : Ops V) (E : EqC V) : Prop where
  disj : ∀ (oc : OC V) (d : Nat), Nat.blt d nD = true → (CF ops E oc (dAT.get d) && CF ops E oc (dBT.get d)) = false
  tob : ∀ b, ops.toB (ops.ofBool b) = b
  g0 : HypsG0 ops E

theorem meX (ops : Ops V) (E : EqC V) (oc : OC V) (hA : asmP ops E oc) (c p : Nat) {y : Nat}
    (hc : Nat.blt c nC = true) (hp : (chkLst.get c)[p]? = some y)
    (h1 : WF ops E oc (chkHead.get c) = true) (h2 : WF ops E oc y = true) : False :=
  me_excl (hA.2.1 c hc) h1 (p := p) (by rw [List.getElem?_map, hp]; rfl) h2
theorem meG (ops : Ops V) (E : EqC V) (oc : OC V) (hA : asmP ops E oc) (g a b : Nat) {x y : Nat}
    (hg : Nat.blt g nG = true) (hx : (grpT.get g)[a]? = some x) (hy : (grpT.get g)[b]? = some y)
    (hab : Nat.blt a b = true) (h1 : WF ops E oc x = true) (h2 : WF ops E oc y = true) : False :=
  sufAsm_excl (hA.1 g hg) hx hy hab h1 h2
theorem dX (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (oc : OC V) (d : Nat) (hd : Nat.blt d nD = true)
    (h1 : WF ops E oc (dAT.get d) = true) (h2 : WF ops E oc (dBT.get d) = true) : False :=
  disj_excl (hy.disj oc d hd) (cf_of_wf h1) (cf_of_wf h2)
end

/-! ## Site facts: reads before, dummy arguments -/

def fxF (κ c : Nat) : Bool := match κ, c with
  | 0, 0 => true
  | 1, 2 => true
  | 1, 3 => true
  | 1, 4 => true
  | 1, 5 => true
  | 1, 6 => true
  | 2, 1 => true
  | 2, 2 => true
  | _, _ => false
def kindN : Kind → Nat
  | .reg => 0
  | .f2 => 1
  | .rwC => 2
  | .tasks => 3
def codeK : (κ : Kind) → (KI κ).M → Nat

  | .reg => fun m => match m with | .rd _ => 0 | .wr _ => 1
  | .f2 => fun m => match m with | .enq => 0 | .deq => 1 | .first => 2 | .notEmpty => 3 | .notFull => 4 | .i_notEmpty => 5 | .i_notFull => 6 | .clear => 7
  | .rwC => fun m => match m with | .wset => 0 | .wget => 1 | .whas => 2
  | .tasks => fun _ => 0
def npK : Kind → Nat
  | .reg => 2
  | .f2 => 8
  | .rwC => 3
  | .tasks => 1
def offK : Kind → Nat
  | .reg => 0
  | .f2 => 18
  | .rwC => 26
  | .tasks => 101
def baseOf (j : I) : Nat := offK j.1 + j.2.val * npK j.1
def fxP (p : Σ j : I, (CI j).M) : Bool := fxF (kindN p.1.1) (codeK p.1.1 p.2)

section
variable {V : Type}
/-- Site `i` of step `k`: it reads only earlier sites, and a flagged port's call carries `z`. -/
def SQ (ops : Ops V) (E : EqC V) (k i : Nat) (F : (V : Type) → Ops V → EqC V → V → SF V) : Prop :=
  ∀ x : V, SFReads i (F V ops E x) ∧ (fxP ((keyT.get k).get i) = true → ∀ ρ, (F V ops E x).2 ρ = ops.z)
def SQT (ops : Ops V) (E : EqC V) (k : Nat) (t : Tab ((V : Type) → Ops V → EqC V → V → SF V)) : Prop :=
  Tab.AllR (SQ ops E k) t 0 (kT.get k)

theorem sq_0 (ops : Ops V) (E : EqC V) : SQT ops E 0 sf_0 :=
  ⟨⟨⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩)⟩,
  ⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 0) (h 1 (by decide)), congrArg (ops.f 0) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩⟩,
  ⟨⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩)⟩,
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 1) (h 1 (by decide))⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩)⟩⟩⟩
theorem sq_1 (ops : Ops V) (E : EqC V) : SQT ops E 1 sf_1 :=
  ⟨⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  ⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 6) (h 0 (by decide)), congrArg (ops.f 2) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩⟩,
  ⟨⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 3) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩,
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩)⟩⟩⟩
theorem sq_2 (ops : Ops V) (E : EqC V) : SQT ops E 2 sf_2 :=
  ⟨⟨⟨⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩)⟩,
  ⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩)⟩⟩,
  ⟨⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 11) (h 0 (by decide)), congrArg (ops.f 4) (congr2 ops.tup (h 0 (by decide)) (congr2 ops.tup (h 1 (by decide)) (congr2 ops.tup (h 2 (by decide)) (congr2 ops.tup (h 3 (by decide)) (h 4 (by decide))))))⟩, fun h => absurd h (by decide)⟩)⟩,
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 12) (h 0 (by decide)), congrArg (ops.f 4) (congr2 ops.tup (h 0 (by decide)) (congr2 ops.tup (h 1 (by decide)) (congr2 ops.tup (h 2 (by decide)) (congr2 ops.tup (h 3 (by decide)) (h 4 (by decide))))))⟩, fun h => absurd h (by decide)⟩),
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 13) (h 0 (by decide)), congrArg (ops.f 4) (congr2 ops.tup (h 0 (by decide)) (congr2 ops.tup (h 1 (by decide)) (congr2 ops.tup (h 2 (by decide)) (congr2 ops.tup (h 3 (by decide)) (h 4 (by decide))))))⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 14) (h 0 (by decide)), congrArg (ops.f 4) (congr2 ops.tup (h 0 (by decide)) (congr2 ops.tup (h 1 (by decide)) (congr2 ops.tup (h 2 (by decide)) (congr2 ops.tup (h 3 (by decide)) (h 4 (by decide))))))⟩, fun h => absurd h (by decide)⟩)⟩⟩⟩⟩,
  ⟨⟨⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 5) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩,
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 6) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩⟩,
  ⟨⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 7) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩,
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 8) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩)⟩⟩⟩⟩⟩
theorem sq_3 (ops : Ops V) (E : EqC V) : SQT ops E 3 sf_3 :=
  ⟨⟨⟨⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 25) (h 0 (by decide)), rfl⟩, fun _ _ => rfl⟩)⟩,
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 26) (h 0 (by decide)), rfl⟩, fun _ _ => rfl⟩),
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 27) (h 0 (by decide)), rfl⟩, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 28) (h 0 (by decide)), rfl⟩, fun _ _ => rfl⟩)⟩⟩⟩,
  ⟨⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 29) (h 0 (by decide)), cond_congr (congr2 and (congrArg (ops.g 25) (h 0 (by decide))) (congr2 and (congrArg (ops.g 26) (h 0 (by decide))) (congr2 and (congrArg (ops.g 27) (h 0 (by decide))) (congrArg (ops.g 28) (h 0 (by decide)))))) (congrArg (ops.f 9) (congr2 ops.tup (h 0 (by decide)) (congr2 ops.tup (h 1 (by decide)) (congr2 ops.tup (h 2 (by decide)) (congr2 ops.tup (h 3 (by decide)) (h 4 (by decide))))))) (congrArg (ops.f 10) (h 0 (by decide)))⟩, fun h => absurd h (by decide)⟩),
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 30) (h 0 (by decide)), cond_congr (congr2 and (congrArg (ops.g 25) (h 0 (by decide))) (congr2 and (congrArg (ops.g 26) (h 0 (by decide))) (congr2 and (congrArg (ops.g 27) (h 0 (by decide))) (congrArg (ops.g 28) (h 0 (by decide)))))) (congrArg (ops.f 9) (congr2 ops.tup (h 0 (by decide)) (congr2 ops.tup (h 1 (by decide)) (congr2 ops.tup (h 2 (by decide)) (congr2 ops.tup (h 3 (by decide)) (h 4 (by decide))))))) (congrArg (ops.f 10) (h 0 (by decide)))⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 31) (h 0 (by decide)), cond_congr (congr2 and (congrArg (ops.g 25) (h 0 (by decide))) (congr2 and (congrArg (ops.g 26) (h 0 (by decide))) (congr2 and (congrArg (ops.g 27) (h 0 (by decide))) (congrArg (ops.g 28) (h 0 (by decide)))))) (congrArg (ops.f 9) (congr2 ops.tup (h 0 (by decide)) (congr2 ops.tup (h 1 (by decide)) (congr2 ops.tup (h 2 (by decide)) (congr2 ops.tup (h 3 (by decide)) (h 4 (by decide))))))) (congrArg (ops.f 10) (h 0 (by decide)))⟩, fun h => absurd h (by decide)⟩)⟩⟩,
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨congrArg (ops.g 32) (h 0 (by decide)), cond_congr (congr2 and (congrArg (ops.g 25) (h 0 (by decide))) (congr2 and (congrArg (ops.g 26) (h 0 (by decide))) (congr2 and (congrArg (ops.g 27) (h 0 (by decide))) (congrArg (ops.g 28) (h 0 (by decide)))))) (congrArg (ops.f 9) (congr2 ops.tup (h 0 (by decide)) (congr2 ops.tup (h 1 (by decide)) (congr2 ops.tup (h 2 (by decide)) (congr2 ops.tup (h 3 (by decide)) (h 4 (by decide))))))) (congrArg (ops.f 10) (h 0 (by decide)))⟩, fun h => absurd h (by decide)⟩),
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 11) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩⟩⟩⟩,
  ⟨⟨⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 12) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩,
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 13) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩)⟩⟩⟩,
  ⟨⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 14) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩),
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩)⟩⟩,
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩)⟩⟩⟩⟩⟩
theorem sq_4 (ops : Ops V) (E : EqC V) : SQT ops E 4 sf_4 :=
  ⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  ⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 15) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩⟩
theorem sq_5 (ops : Ops V) (E : EqC V) : SQT ops E 5 sf_5 :=
  ⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  ⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 0) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩⟩
theorem sq_6 (ops : Ops V) (E : EqC V) : SQT ops E 6 sf_6 :=
  ⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  ⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 16) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩⟩
theorem sq_7 (ops : Ops V) (E : EqC V) : SQT ops E 7 sf_7 :=
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, rfl⟩, fun h => absurd h (by decide)⟩)
theorem sq_8 (ops : Ops V) (E : EqC V) : SQT ops E 8 sf_8 :=
  ⟨⟨⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩)⟩,
  ⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩)⟩⟩,
  ⟨⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 17) (h 1 (by decide))⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 18) (h 0 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩,
  ⟨Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 19) (h 3 (by decide))⟩, fun h => absurd h (by decide)⟩),
  Tab.one (fun x => ⟨fun ρ ρ' h => ⟨rfl, congrArg (ops.f 20) (h 2 (by decide))⟩, fun h => absurd h (by decide)⟩)⟩⟩⟩
theorem sq_9 (ops : Ops V) (E : EqC V) : SQT ops E 9 sf_9 :=
  ⟨Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩),
  Tab.one (fun x => ⟨sfr_const _ _, fun _ _ => rfl⟩)⟩
theorem sqT (ops : Ops V) (E : EqC V) : Tab.AllR (SQT ops E) sfT 0 nS :=
  ⟨⟨⟨Tab.one (sq_0 ops E),
  Tab.one (sq_1 ops E)⟩,
  ⟨Tab.one (sq_2 ops E),
  ⟨Tab.one (sq_3 ops E),
  Tab.one (sq_4 ops E)⟩⟩⟩,
  ⟨⟨Tab.one (sq_5 ops E),
  Tab.one (sq_6 ops E)⟩,
  ⟨Tab.one (sq_7 ops E),
  ⟨Tab.one (sq_8 ops E),
  Tab.one (sq_9 ops E)⟩⟩⟩⟩
theorem sqR (ops : Ops V) (E : EqC V) (k : Nat) (hk : k < nS) : Tab.AllR (SQ ops E k) (sfT.get k) 0 (kR k) :=
  Tab.get_allR _ 0 nS (sqT ops E) k (Nat.zero_le _) hk
theorem hOK (ops : Ops V) (E : EqC V) (k : Nat) (hk : k < nS) (x : V) : ∀ i, i < kR k → ReadsBefore i (siteS ops E k x i) :=
  fun i hi => ((Tab.get_allR _ 0 (kR k) (sqR ops E k hk) i (Nat.zero_le _) hi) x).1

/-- The environment of step `k`'s sites at argument `x`, the hardware's values. -/
abbrev envS (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (k : Nat) (x : V) : Nat → V :=
  envHw v oc (sitesF (siteS ops E k x) (kR k)) 0 v
abbrev envR (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (k : Nat) : Nat → V := envS ops E v oc k ops.z

theorem trR_eq (ops : Ops V) (E : EqC V) (u : St → Nat → V) (oc : OC V) (r : Fin nR) :
    trR (P ops E u) oc r = (callsOf (envR ops E (u (.inr r)) oc r.val) (sitesF (siteR ops E r.val) (kR r.val)),
      (resT.get r.val) V ops E ops.z (envR ops E (u (.inr r)) oc r.val)) :=
  trace_fn (u (.inr r)) oc _ (siteR ops E r.val) (kR r.val) (hOK ops E r.val (rlt r) ops.z)
theorem trS_eq (ops : Ops V) (E : EqC V) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V) (r : Fin nR) :
    trS (P ops E u) oc w (.inr r) = callsOf (envR ops E (u (.inr r)) oc r.val) (sitesF (siteR ops E r.val) (kR r.val)) :=
  congrArg Prod.fst (trR_eq ops E u oc r)
theorem envS_at (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (k : Nat) (hk : k < nS) (x : V) (i : Nat) (hi : i < kR k) :
    envS ops E v oc k x i = if (siteS ops E k x i).cond (envS ops E v oc k x) then (oc (siteS ops E k x i).j).ret (siteS ops E k x i).m else v i :=
  envHw_fn v oc (siteS ops E k x) (kR k) (hOK ops E k hk x) i hi
theorem envR_at (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (k : Nat) (hk : k < nS) (i : Nat) (hi : i < kR k) :
    envR ops E v oc k i = if (siteR ops E k i).cond (envR ops E v oc k) then (oc (siteR ops E k i).j).ret (siteR ops E k i).m else v i :=
  envS_at ops E v oc k hk ops.z i hi
end

section
variable {V : Type}

theorem ev_0_0 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 0 x 0 = (oc (iReg 2)).ret Reg.read :=
  (envS_at ops E v oc 0 (by decide) x 0 (by decide)).trans rfl
theorem ev_0_1 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 0 x 1 = (oc (iReg 0)).ret Reg.read :=
  (envS_at ops E v oc 0 (by decide) x 1 (by decide)).trans rfl
theorem ev_0_2 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 0 x 2 = (oc (iF2 0)).ret FifoM.i_notFull :=
  (envS_at ops E v oc 0 (by decide) x 2 (by decide)).trans rfl
theorem ev_1_0 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 1 x 0 = (oc (iReg 1)).ret Reg.read :=
  (envS_at ops E v oc 1 (by decide) x 0 (by decide)).trans rfl
theorem ev_1_1 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 1 x 1 = (oc (iF2 0)).ret FifoM.i_notFull :=
  (envS_at ops E v oc 1 (by decide) x 1 (by decide)).trans rfl
theorem ev_2_0 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 2 x 0 = (oc (iReg 7)).ret Reg.read :=
  (envS_at ops E v oc 2 (by decide) x 0 (by decide)).trans rfl
theorem ev_2_1 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 2 x 1 = (oc (iReg 3)).ret Reg.read :=
  (envS_at ops E v oc 2 (by decide) x 1 (by decide)).trans rfl
theorem ev_2_2 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 2 x 2 = (oc (iReg 4)).ret Reg.read :=
  (envS_at ops E v oc 2 (by decide) x 2 (by decide)).trans rfl
theorem ev_2_3 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 2 x 3 = (oc (iReg 5)).ret Reg.read :=
  (envS_at ops E v oc 2 (by decide) x 3 (by decide)).trans rfl
theorem ev_2_4 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 2 x 4 = (oc (iReg 6)).ret Reg.read :=
  (envS_at ops E v oc 2 (by decide) x 4 (by decide)).trans rfl
theorem ev_3_0 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 3 x 0 = (oc (iReg 7)).ret Reg.read :=
  (envS_at ops E v oc 3 (by decide) x 0 (by decide)).trans rfl
theorem ev_4_0 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 4 x 0 = (oc (iReg 8)).ret Reg.read :=
  (envS_at ops E v oc 4 (by decide) x 0 (by decide)).trans rfl
theorem ev_4_1 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 4 x 1 = (oc (iReg 0)).ret Reg.read :=
  (envS_at ops E v oc 4 (by decide) x 1 (by decide)).trans rfl
theorem ev_5_0 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 5 x 0 = (oc (iReg 2)).ret Reg.read :=
  (envS_at ops E v oc 5 (by decide) x 0 (by decide)).trans rfl
theorem ev_5_1 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 5 x 1 = (oc (iReg 1)).ret Reg.read :=
  (envS_at ops E v oc 5 (by decide) x 1 (by decide)).trans rfl
theorem ev_6_0 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 6 x 0 = (oc (iReg 8)).ret Reg.read :=
  (envS_at ops E v oc 6 (by decide) x 0 (by decide)).trans rfl
theorem ev_6_1 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 6 x 1 = (oc (iReg 2)).ret Reg.read :=
  (envS_at ops E v oc 6 (by decide) x 1 (by decide)).trans rfl
theorem ev_8_0 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 8 x 0 = (oc (iReg 2)).ret Reg.read :=
  (envS_at ops E v oc 8 (by decide) x 0 (by decide)).trans rfl
theorem ev_8_1 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 8 x 1 = (oc (iReg 7)).ret Reg.read :=
  (envS_at ops E v oc 8 (by decide) x 1 (by decide)).trans rfl
theorem ev_8_2 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 8 x 2 = (oc (iReg 1)).ret Reg.read :=
  (envS_at ops E v oc 8 (by decide) x 2 (by decide)).trans rfl
theorem ev_8_3 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 8 x 3 = (oc (iReg 0)).ret Reg.read :=
  (envS_at ops E v oc 8 (by decide) x 3 (by decide)).trans rfl
theorem ev_9_0 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) : envS ops E v oc 9 x 0 = (oc (iF2 0)).ret FifoM.i_notEmpty :=
  (envS_at ops E v oc 9 (by decide) x 0 (by decide)).trans rfl
theorem evc_3_1 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) (h : ops.g 25 ((oc (iReg 7)).ret Reg.read) = true) : envS ops E v oc 3 x 1 = (oc (iReg 3)).ret Reg.read :=
  (envS_at ops E v oc 3 (by decide) x 1 (by decide)).trans (if_pos ((congrArg (ops.g 25) (ev_3_0 ops E v oc x)).trans h))
theorem evc_3_2 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) (h : ops.g 26 ((oc (iReg 7)).ret Reg.read) = true) : envS ops E v oc 3 x 2 = (oc (iReg 4)).ret Reg.read :=
  (envS_at ops E v oc 3 (by decide) x 2 (by decide)).trans (if_pos ((congrArg (ops.g 26) (ev_3_0 ops E v oc x)).trans h))
theorem evc_3_3 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) (h : ops.g 27 ((oc (iReg 7)).ret Reg.read) = true) : envS ops E v oc 3 x 3 = (oc (iReg 5)).ret Reg.read :=
  (envS_at ops E v oc 3 (by decide) x 3 (by decide)).trans (if_pos ((congrArg (ops.g 27) (ev_3_0 ops E v oc x)).trans h))
theorem evc_3_4 (ops : Ops V) (E : EqC V) (v : Nat → V) (oc : OC V) (x : V) (h : ops.g 28 ((oc (iReg 7)).ret Reg.read) = true) : envS ops E v oc 3 x 4 = (oc (iReg 6)).ret Reg.read :=
  (envS_at ops E v oc 3 (by decide) x 4 (by decide)).trans (if_pos ((congrArg (ops.g 28) (ev_3_0 ops E v oc x)).trans h))
end

section
variable {V : Type}
theorem res_some (z : V) {b : Bool} (h : b = true) : (bif b then some z else none).isSome = true := by
  rw [h]; rfl
theorem res_eq {b : Bool} {r r' : V} (hb : b = true) (hr : r = r') : (bif b then some r else none) = some r' := by
  subst hb hr; rfl
/-- A step's run-time precondition: a rule fires, a method can fire. -/
def PRE (ops : Ops V) (E : EqC V) (oc : OC V) (k : Nat) : Bool := bif Nat.blt k nR then WF ops E oc k else CF ops E oc k
theorem pre_r {ops : Ops V} {E : EqC V} {oc : OC V} {r : Fin nR} (h : WF ops E oc r.val = true) : PRE ops E oc r.val = true := by
  unfold PRE; rw [show Nat.blt r.val nR = true from Nat.blt_eq.mpr r.isLt]; exact h
/-- Rule `k`'s result is defined when it fires (its guard read at its position). -/
def RQ (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (k : Nat) (g : (V : Type) → Ops V → EqC V → OC V → Bool) : Prop :=
  ∀ (v : Nat → V) (oc : OC V), PRE ops E oc k = true → ((resT.get k) V ops E ops.z (envR ops E v oc k)).isSome = true

theorem rqT (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : Tab.AllR (RQ ops E hy) gT 0 nS :=
  ⟨⟨⟨Tab.one ((fun v oc hf => res_some _ ((congrArg (ops.g 5) (congr2 ops.tup (ev_0_1 ops E v oc ops.z) (ev_0_2 ops E v oc ops.z))).trans (((Bool.and_eq_true _ _).mp (g_of_cf (cf_of_wf hf))).1)) : RQ ops E hy 0 G_0)),
  Tab.one ((fun v oc hf => res_some _ ((congrArg (ops.g 10) (congr2 ops.tup (ev_1_0 ops E v oc ops.z) (ev_1_1 ops E v oc ops.z))).trans (((Bool.and_eq_true _ _).mp (g_of_cf (cf_of_wf hf))).1)) : RQ ops E hy 1 G_1))⟩,
  ⟨Tab.one ((fun v oc hf => res_some _ ((congrArg (ops.g 24) (rfl)).trans (g_of_cf (cf_of_wf hf))) : RQ ops E hy 2 G_2)),
  ⟨Tab.one ((fun v oc hf => res_some _ ((congrArg (ops.g 42) (rfl)).trans (g_of_cf (cf_of_wf hf))) : RQ ops E hy 3 G_3)),
  Tab.one ((fun v oc hf => res_some _ ((congrArg (ops.g 43) (ev_4_1 ops E v oc ops.z)).trans (g_of_cf (cf_of_wf hf))) : RQ ops E hy 4 G_4))⟩⟩⟩,
  ⟨⟨Tab.one ((fun v oc hf => res_some _ ((congrArg (ops.g 44) (ev_5_1 ops E v oc ops.z)).trans (g_of_cf (cf_of_wf hf))) : RQ ops E hy 5 G_5)),
  Tab.one ((fun v oc hf => res_some _ ((congrArg (ops.g 45) (ev_6_1 ops E v oc ops.z)).trans (g_of_cf (cf_of_wf hf))) : RQ ops E hy 6 G_6))⟩,
  ⟨Tab.one ((fun _ _ _ => rfl : RQ ops E hy 7 G_7)),
  ⟨Tab.one ((fun v oc hf => res_some _ ((congrArg (ops.g 46) (rfl)).trans (g_of_cf (cf_of_wf hf))) : RQ ops E hy 8 G_8)),
  Tab.one ((fun v oc hf => res_some _ ((congrArg (ops.g 47) (ev_9_0 ops E v oc ops.z)).trans (g_of_cf (cf_of_wf hf))) : RQ ops E hy 9 G_9))⟩⟩⟩⟩
theorem resR_ok (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V) (r : Fin nR)
    (hf : fire ops E oc w r = true) : (trR (P ops E u) oc r).2.isSome = true := by
  rw [trR_eq]
  exact Tab.get_allR _ 0 nS (rqT ops E hy) r.val (Nat.zero_le _) (rlt r) (u (.inr r)) oc (pre_r hf)

end

/-! ## Each step's calls at every skipped value (`CertU.trU`) -/

section
variable {V : Type}
/-- Site `i` of step `k`, when the step may run, agrees at any two skipped values of its step:
    its condition, and its argument where taken. -/
def HQ (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (k i : Nat) (F : (V : Type) → Ops V → EqC V → V → SF V) : Prop :=
  ∀ (oc : OC V) (v v' : Nat → V) (x : V), PRE ops E oc k = true →
    (F V ops E x).1 (envS ops E v oc k x) = (F V ops E x).1 (envS ops E v' oc k x) ∧
    ((F V ops E x).1 (envS ops E v oc k x) = true → (F V ops E x).2 (envS ops E v oc k x) = (F V ops E x).2 (envS ops E v' oc k x))
def HQT (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (k : Nat) (t : Tab ((V : Type) → Ops V → EqC V → V → SF V)) : Prop :=
  Tab.AllR (HQ ops E hy k) t 0 (kT.get k)

theorem hq_0 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : HQT ops E hy 0 sf_0 :=
  ⟨⟨⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩)⟩,
  ⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun oc v v' x hf => ⟨(congrArg (ops.g 0) (ev_0_1 ops E v oc x)).trans (congrArg (ops.g 0) (ev_0_1 ops E v' oc x)).symm, fun _ => (congrArg (ops.f 0) (ev_0_0 ops E v oc x)).trans (congrArg (ops.f 0) (ev_0_0 ops E v' oc x)).symm⟩)⟩⟩,
  ⟨⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩)⟩,
  ⟨Tab.one (fun oc v v' x hf => ⟨rfl, fun _ => (congrArg (ops.f 1) (ev_0_1 ops E v oc x)).trans (congrArg (ops.f 1) (ev_0_1 ops E v' oc x)).symm⟩),
  Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩)⟩⟩⟩
theorem hq_1 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : HQT ops E hy 1 sf_1 :=
  ⟨⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  ⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun oc v v' x hf => ⟨(congrArg (ops.g 6) (ev_1_0 ops E v oc x)).trans (congrArg (ops.g 6) (ev_1_0 ops E v' oc x)).symm, fun _ => (congrArg (ops.f 2) (ev_1_0 ops E v oc x)).trans (congrArg (ops.f 2) (ev_1_0 ops E v' oc x)).symm⟩)⟩⟩,
  ⟨⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun oc v v' x hf => ⟨rfl, fun _ => (congrArg (ops.f 3) (ev_1_0 ops E v oc x)).trans (congrArg (ops.f 3) (ev_1_0 ops E v' oc x)).symm⟩)⟩,
  ⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun oc v v' x hf => ⟨rfl, fun _ => rfl⟩)⟩⟩⟩
theorem hq_2 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : HQT ops E hy 2 sf_2 :=
  ⟨⟨⟨⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩)⟩,
  ⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩)⟩⟩,
  ⟨⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun oc v v' x hf => ⟨(congrArg (ops.g 11) (ev_2_0 ops E v oc x)).trans (congrArg (ops.g 11) (ev_2_0 ops E v' oc x)).symm, fun _ => (congrArg (ops.f 4) (congr2 ops.tup (ev_2_0 ops E v oc x) (congr2 ops.tup (ev_2_1 ops E v oc x) (congr2 ops.tup (ev_2_2 ops E v oc x) (congr2 ops.tup (ev_2_3 ops E v oc x) (ev_2_4 ops E v oc x)))))).trans (congrArg (ops.f 4) (congr2 ops.tup (ev_2_0 ops E v' oc x) (congr2 ops.tup (ev_2_1 ops E v' oc x) (congr2 ops.tup (ev_2_2 ops E v' oc x) (congr2 ops.tup (ev_2_3 ops E v' oc x) (ev_2_4 ops E v' oc x)))))).symm⟩)⟩,
  ⟨Tab.one (fun oc v v' x hf => ⟨(congrArg (ops.g 12) (ev_2_0 ops E v oc x)).trans (congrArg (ops.g 12) (ev_2_0 ops E v' oc x)).symm, fun _ => (congrArg (ops.f 4) (congr2 ops.tup (ev_2_0 ops E v oc x) (congr2 ops.tup (ev_2_1 ops E v oc x) (congr2 ops.tup (ev_2_2 ops E v oc x) (congr2 ops.tup (ev_2_3 ops E v oc x) (ev_2_4 ops E v oc x)))))).trans (congrArg (ops.f 4) (congr2 ops.tup (ev_2_0 ops E v' oc x) (congr2 ops.tup (ev_2_1 ops E v' oc x) (congr2 ops.tup (ev_2_2 ops E v' oc x) (congr2 ops.tup (ev_2_3 ops E v' oc x) (ev_2_4 ops E v' oc x)))))).symm⟩),
  ⟨Tab.one (fun oc v v' x hf => ⟨(congrArg (ops.g 13) (ev_2_0 ops E v oc x)).trans (congrArg (ops.g 13) (ev_2_0 ops E v' oc x)).symm, fun _ => (congrArg (ops.f 4) (congr2 ops.tup (ev_2_0 ops E v oc x) (congr2 ops.tup (ev_2_1 ops E v oc x) (congr2 ops.tup (ev_2_2 ops E v oc x) (congr2 ops.tup (ev_2_3 ops E v oc x) (ev_2_4 ops E v oc x)))))).trans (congrArg (ops.f 4) (congr2 ops.tup (ev_2_0 ops E v' oc x) (congr2 ops.tup (ev_2_1 ops E v' oc x) (congr2 ops.tup (ev_2_2 ops E v' oc x) (congr2 ops.tup (ev_2_3 ops E v' oc x) (ev_2_4 ops E v' oc x)))))).symm⟩),
  Tab.one (fun oc v v' x hf => ⟨(congrArg (ops.g 14) (ev_2_0 ops E v oc x)).trans (congrArg (ops.g 14) (ev_2_0 ops E v' oc x)).symm, fun _ => (congrArg (ops.f 4) (congr2 ops.tup (ev_2_0 ops E v oc x) (congr2 ops.tup (ev_2_1 ops E v oc x) (congr2 ops.tup (ev_2_2 ops E v oc x) (congr2 ops.tup (ev_2_3 ops E v oc x) (ev_2_4 ops E v oc x)))))).trans (congrArg (ops.f 4) (congr2 ops.tup (ev_2_0 ops E v' oc x) (congr2 ops.tup (ev_2_1 ops E v' oc x) (congr2 ops.tup (ev_2_2 ops E v' oc x) (congr2 ops.tup (ev_2_3 ops E v' oc x) (ev_2_4 ops E v' oc x)))))).symm⟩)⟩⟩⟩⟩,
  ⟨⟨⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun oc v v' x hf => ⟨rfl, fun _ => (congrArg (ops.f 5) (ev_2_0 ops E v oc x)).trans (congrArg (ops.f 5) (ev_2_0 ops E v' oc x)).symm⟩)⟩,
  ⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun oc v v' x hf => ⟨rfl, fun _ => (congrArg (ops.f 6) (ev_2_0 ops E v oc x)).trans (congrArg (ops.f 6) (ev_2_0 ops E v' oc x)).symm⟩)⟩⟩,
  ⟨⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun oc v v' x hf => ⟨rfl, fun _ => (congrArg (ops.f 7) (ev_2_0 ops E v oc x)).trans (congrArg (ops.f 7) (ev_2_0 ops E v' oc x)).symm⟩)⟩,
  ⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  ⟨Tab.one (fun oc v v' x hf => ⟨rfl, fun _ => (congrArg (ops.f 8) (ev_2_0 ops E v oc x)).trans (congrArg (ops.f 8) (ev_2_0 ops E v' oc x)).symm⟩),
  Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩)⟩⟩⟩⟩⟩
theorem hq_3 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : HQT ops E hy 3 sf_3 :=
  ⟨⟨⟨⟨Tab.one (fun _ _ _ _ _ => ⟨rfl, fun _ => rfl⟩),
  Tab.one (fun oc v v' x hf => ⟨(congrArg (ops.g 25) (ev_3_0 ops E v oc x)).trans (congrArg (ops.g 25) (ev_3_0 ops E v' oc x)).symm, fun _ => rfl⟩)⟩,
  ⟨Tab.one (fun oc v v' x hf => ⟨(congrArg (ops.g 26) (ev_3_0 ops E v oc x)).trans (congrArg (ops.g 26) (ev_3_0 ops E v' oc x)).symm, fun _ => rfl⟩),
  ⟨Tab.one (fun oc v v' x hf => ⟨(congrArg (ops.g 27) (ev_3_0 ops E v oc x)).trans (congrArg (ops.g 27) (ev_3_0 ops E v' oc x)).symm, fun _ => rfl⟩),
  Tab.one (fun oc v v' x hf => ⟨(congrArg (ops.g 28) (ev_3_0 ops E v oc x)).trans (congrArg (ops.g 28) (ev_3_0 ops E v' oc x)).symm, fun _ => rfl⟩)⟩⟩⟩,
