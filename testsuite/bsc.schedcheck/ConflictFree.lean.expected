/-- Task statement `t`: its enable (the statement's condition, `WILL_FIRE` included) and arguments. -/
def tenT : Tab ((V : Type) → Ops V → EqC V → OC V → Bool) :=
  (.node 3 (.node 1 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => WF ops E oc 1 && cfL_0 V ops E oc))
  (.node 2 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => WF ops E oc 3 && cfL_1 V ops E oc))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => WF ops E oc 3 && cfL_2 V ops E oc))))
  (.node 4 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => WF ops E oc 3 && cfL_3 V ops E oc))
  (.node 5 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => WF ops E oc 3 && cfL_4 V ops E oc))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => WF ops E oc 7 && (gT.get 7) V ops E oc)))))
def targT : Tab ((V : Type) → Ops V → EqC V → OC V → V) :=
  (.node 3 (.node 1 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => ops.k 12))
  (.node 2 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => ops.k 13))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => ops.k 14))))
  (.node 4 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => ops.k 15))
  (.node 5 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => ops.k 16))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => ops.k 17)))))
