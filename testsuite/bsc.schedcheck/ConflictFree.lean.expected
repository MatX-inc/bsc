section
variable {V : Type}
/-- Step `k`'s sites at argument `x` (a method's argument; rules pass `z`). -/
def siteS (ops : Ops V) (E : EqC V) (k : Nat) (x : V) : Nat → Site I (fun j => (CI j).M) V :=
  mkSite (keyT.get k).get (fun i => (sfT.get k).get i V ops E x)
abbrev siteR (ops : Ops V) (E : EqC V) (k : Nat) : Nat → Site I (fun j => (CI j).M) V := siteS ops E k ops.z
end

/-- Each step's result: its explicit guard, read at its position (run-time check rules: `some z`);
    a method returns its result expression. -/
def resT : Tab ((V : Type) → Ops V → EqC V → V → (Nat → V) → Option V) :=
  (.node 5 (.node 2 (.node 1 (.leaf (fun V (ops : Ops V) (E : EqC V) (x : V) (ρ : Nat → V) => bif ops.g 5 (ops.tup (ρ 1) (ρ 2)) then some (ops.z) else none))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (x : V) (ρ : Nat → V) => bif ops.g 10 (ops.tup (ρ 0) (ρ 1)) then some (ops.z) else none)))
  (.node 3 (.leaf (fun V (ops : Ops V) (E : EqC V) (x : V) (ρ : Nat → V) => bif ops.g 24 (ops.z) then some (ops.z) else none))
  (.node 4 (.leaf (fun V (ops : Ops V) (E : EqC V) (x : V) (ρ : Nat → V) => bif ops.g 42 (ops.z) then some (ops.z) else none))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (x : V) (ρ : Nat → V) => bif ops.g 43 (ρ 1) then some (ops.z) else none)))))
  (.node 7 (.node 6 (.leaf (fun V (ops : Ops V) (E : EqC V) (x : V) (ρ : Nat → V) => bif ops.g 44 (ρ 1) then some (ops.z) else none))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (x : V) (ρ : Nat → V) => bif ops.g 45 (ρ 1) then some (ops.z) else none)))
  (.node 8 (.leaf (fun V (ops : Ops V) (E : EqC V) (x : V) (ρ : Nat → V) => some (ops.z)))
  (.node 9 (.leaf (fun V (ops : Ops V) (E : EqC V) (x : V) (ρ : Nat → V) => bif ops.g 46 (ops.z) then some (ops.z) else none))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (x : V) (ρ : Nat → V) => bif ops.g 47 (ρ 0) then some (ops.z) else none))))))
/-! ## The hardware: guards, firing, run-time checks -/

def ucT : Tab Nat :=
  (.node 5 (.node 2 (.node 1 (.leaf (8))
  (.leaf (4)))
  (.node 3 (.leaf (0))
  (.node 4 (.leaf (0))
  (.leaf (0)))))
  (.node 7 (.node 6 (.leaf (0))
  (.leaf (0)))
  (.node 8 (.leaf (0))
  (.node 9 (.leaf (0))
  (.leaf (0))))))
def alwaysRdyB (p : Σ j : I, (CI j).M) : Bool := (CI p.1).ann.alwaysRdy p.2

section
variable {V : Type}
/-- The ready signals of a step's unconditional guarded sites, ANDed into its CAN_FIRE (a conditional
    guarded call's readiness is in its guard `G`, a readiness read's comes from the child's alias). -/
@[irreducible] def RD (oc : OC V) (k : Nat) : Bool :=
  (List.range' 0 (kR k)).all (fun i => alwaysRdyB ((keyT.get k).get i) || (ucT.get k).testBit i ||
    (oc ((keyT.get k).get i).1).rdy ((keyT.get k).get i).2)

def G_0 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := (ops.g 5 (ops.tup ((oc (iReg 0)).ret Reg.read) ((oc (iF2 0)).ret FifoM.i_notFull))) && (((!(ops.g 0 ((oc (iReg 0)).ret Reg.read)) || (oc (iF2 0)).rdy FifoM.enq)) && (true))
def G_1 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := (ops.g 10 (ops.tup ((oc (iReg 1)).ret Reg.read) ((oc (iF2 0)).ret FifoM.i_notFull))) && (((!(ops.g 6 ((oc (iReg 1)).ret Reg.read)) || (oc (iF2 0)).rdy FifoM.enq)) && (true))
def G_2 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := ops.g 24 (ops.z)
def G_3 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := ops.g 42 (ops.z)
def G_4 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := ops.g 43 ((oc (iReg 0)).ret Reg.read)
def G_5 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := ops.g 44 ((oc (iReg 1)).ret Reg.read)
def G_6 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := ops.g 45 ((oc (iReg 2)).ret Reg.read)
def G_8 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := ops.g 46 (ops.z)
def G_9 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := ops.g 47 ((oc (iF2 0)).ret FifoM.i_notEmpty)
def bTrue (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := true
def WFd_0 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := (RD oc 0 && G_0 V ops E oc) && bTrue V ops E oc
def WFd_1 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := (RD oc 1 && G_1 V ops E oc) && bTrue V ops E oc
def WFd_2 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := (RD oc 2 && G_2 V ops E oc) && bTrue V ops E oc
def WFd_3 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := (RD oc 3 && G_3 V ops E oc) && bTrue V ops E oc
def WFd_4 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := (RD oc 4 && G_4 V ops E oc) && bTrue V ops E oc
def WFd_5 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := (RD oc 5 && G_5 V ops E oc) && bTrue V ops E oc
def WFd_6 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := (RD oc 6 && G_6 V ops E oc) && bTrue V ops E oc
def WFd_8 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := (RD oc 8 && G_8 V ops E oc) && bTrue V ops E oc
def WFd_9 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := (RD oc 9 && G_9 V ops E oc) && bTrue V ops E oc
end

/-- bsc's `mutually_exclusive` groups whose checks are suffixes (`SufAsm`), in bsc's order. -/
def grpT : Tab (List Nat) :=
  (.leaf ([]))
section
variable {V : Type}

def G_7 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool := orL [WFd_4 V ops E oc, WFd_5 V ops E oc] && orL [WFd_6 V ops E oc]
end

def gT : Tab ((V : Type) → Ops V → EqC V → OC V → Bool) :=
  (.node 5 (.node 2 (.node 1 (.leaf (G_0))
  (.leaf (G_1)))
  (.node 3 (.leaf (G_2))
  (.node 4 (.leaf (G_3))
  (.leaf (G_4)))))
  (.node 7 (.node 6 (.leaf (G_5))
  (.leaf (G_6)))
  (.node 8 (.leaf (G_7))
  (.node 9 (.leaf (G_8))
  (.leaf (G_9))))))
def bT : Tab ((V : Type) → Ops V → EqC V → OC V → Bool) :=
  (.node 5 (.node 2 (.node 1 (.leaf (bTrue))
  (.leaf (bTrue)))
  (.node 3 (.leaf (bTrue))
  (.node 4 (.leaf (bTrue))
  (.leaf (bTrue)))))
  (.node 7 (.node 6 (.leaf (bTrue))
  (.leaf (bTrue)))
  (.node 8 (.leaf (bTrue))
  (.node 9 (.leaf (bTrue))
  (.leaf (bTrue))))))
def chkHead : Tab Nat :=
  (.node 1 (.leaf (4))
  (.leaf (5)))
def chkLst : Tab (List Nat) :=
  (.node 1 (.leaf ([6]))
  (.leaf ([6])))
abbrev nC : Nat := 2
abbrev nG : Nat := 0
def dAT : Tab Nat :=
  (.leaf (0))
def dBT : Tab Nat :=
  (.leaf (0))
abbrev nD : Nat := 0

section
variable {V : Type}
/-- CAN_FIRE: the guarded calls' ready signals and the step's guard. -/
def CF (ops : Ops V) (E : EqC V) (oc : OC V) (k : Nat) : Bool := RD oc k && (gT.get k) V ops E oc
/-- WILL_FIRE: CAN_FIRE and not blocked by a more urgent rule (a method's is its CAN_FIRE). -/
def WF (ops : Ops V) (E : EqC V) (oc : OC V) (k : Nat) : Bool := CF ops E oc k && (bT.get k) V ops E oc
def fire (ops : Ops V) (E : EqC V) : OC V → Wires Empty V → Fin nR → Bool := fun oc _ r => WF ops E oc r.val
def stepOn (ops : Ops V) (E : EqC V) (oc : OC V) : St → Bool
  | .inl e => e.elim
  | .inr r => WF ops E oc r.val
/-! bsc's `conflict_free` checks (design §5): check `c` in rule `cfR.get c` is `!(WF R && cfL_c)`, `cfL_c`
    its line with each instrumentation wire read as its one unconditional writer's argument (a condition
    over that writer's reads; trust point 3). -/
/-- In RL_emitB, bsc's line `WILL_FIRE_RL_emitA && limit_EQ_9___d8 && _enq_RL_emitA$EN_outQ.wget`. -/
def cfL_0 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool :=
  WF ops E oc 0 && ops.g 6 ((oc (iReg 1)).ret Reg.read) && ops.g 0 ((oc (iReg 0)).ret Reg.read)
/-- In RL_r2, bsc's line `WILL_FIRE_RL_r1 && (i_1_PLUS_1___d23 == 2'd0) && _write_RL_r1$EN_rs_0.wget`. -/
def cfL_1 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool :=
  WF ops E oc 2 && ops.g 48 ((oc (iReg 7)).ret Reg.read) && ops.g 11 ((oc (iReg 7)).ret Reg.read)
/-- In RL_r2, bsc's line `WILL_FIRE_RL_r1 && (i_1_PLUS_1___d23 == 2'd1) && _write_RL_r1$EN_rs_1.wget`. -/
def cfL_2 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool :=
  WF ops E oc 2 && ops.g 49 ((oc (iReg 7)).ret Reg.read) && ops.g 12 ((oc (iReg 7)).ret Reg.read)
/-- In RL_r2, bsc's line `WILL_FIRE_RL_r1 && (i_1_PLUS_1___d23 == 2'd2) && _write_RL_r1$EN_rs_2.wget`. -/
def cfL_3 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool :=
  WF ops E oc 2 && ops.g 50 ((oc (iReg 7)).ret Reg.read) && ops.g 13 ((oc (iReg 7)).ret Reg.read)
/-- In RL_r2, bsc's line `WILL_FIRE_RL_r1 && (i_1_PLUS_1___d23 == 2'd3) && _write_RL_r1$EN_rs_3.wget`. -/
def cfL_4 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : Bool :=
  WF ops E oc 2 && ops.g 51 ((oc (iReg 7)).ret Reg.read) && ops.g 14 ((oc (iReg 7)).ret Reg.read)
def cfR : Tab Nat :=
  (.node 2 (.node 1 (.leaf (1))
  (.leaf (3)))
  (.node 3 (.leaf (3))
  (.node 4 (.leaf (3))
  (.leaf (3)))))
def cfT : Tab ((V : Type) → Ops V → EqC V → OC V → Bool) :=
  (.node 2 (.node 1 (.leaf (cfL_0))
  (.leaf (cfL_1)))
  (.node 3 (.leaf (cfL_2))
  (.node 4 (.leaf (cfL_3))
  (.leaf (cfL_4)))))
abbrev nF : Nat := 5
/-- The module's assertions: bsc's run-time checks of `mutually_exclusive`, each `!(WF h && (WF y || …))`
    exactly as bsc's line (one rule on its first side), a group's checks as one `SufAsm`;
    a line `(WF h₁ || …) && (WF y || …)` as one such check per `hᵢ` (together exactly the line);
    and bsc's `conflict_free` checks, each `!(WF R && cfL_c)`. -/
def asmP (ops : Ops V) (E : EqC V) (oc : OC V) : Prop :=
  (∀ g, Nat.blt g nG = true → SufAsm (WF ops E oc) (grpT.get g)) ∧
  (∀ c, Nat.blt c nC = true → (WF ops E oc (chkHead.get c) && orL ((chkLst.get c).map (WF ops E oc))) = false) ∧
  ∀ c, Nat.blt c nF = true → (WF ops E oc (cfR.get c) && (cfT.get c) V ops E oc) = false
theorem cf_of_wf {ops : Ops V} {E : EqC V} {oc : OC V} {k : Nat} (h : WF ops E oc k = true) : CF ops E oc k = true :=
  ((Bool.and_eq_true _ _).mp h).1
theorem rd_of_cf {ops : Ops V} {E : EqC V} {oc : OC V} {k : Nat} (h : CF ops E oc k = true) : RD oc k = true :=
  ((Bool.and_eq_true _ _).mp h).1
theorem g_of_cf {ops : Ops V} {E : EqC V} {oc : OC V} {k : Nat} (h : CF ops E oc k = true) : (gT.get k) V ops E oc = true :=
  ((Bool.and_eq_true _ _).mp h).2

end

section
variable {V : Type}
/-- A conflict_free check's report: its step never makes it, and its enable is false where
    the check passes (`asm`). -/
theorem en_tcf {a b : Bool} (h : (a && b) = false) : (a && b) = true ↔ a = true ∧ false = true := by
  rw [h]; exact ⟨fun h' => absurd h' Bool.false_ne_true, fun h' => absurd h'.2 Bool.false_ne_true⟩
theorem cfA_0 (ops : Ops V) (E : EqC V) (oc : OC V) (hA : asmP ops E oc) :
    (WF ops E oc 1 && cfL_0 V ops E oc) = false := hA.2.2 0 rfl
theorem cfA_1 (ops : Ops V) (E : EqC V) (oc : OC V) (hA : asmP ops E oc) :
    (WF ops E oc 3 && cfL_1 V ops E oc) = false := hA.2.2 1 rfl
theorem cfA_2 (ops : Ops V) (E : EqC V) (oc : OC V) (hA : asmP ops E oc) :
    (WF ops E oc 3 && cfL_2 V ops E oc) = false := hA.2.2 2 rfl
theorem cfA_3 (ops : Ops V) (E : EqC V) (oc : OC V) (hA : asmP ops E oc) :
    (WF ops E oc 3 && cfL_3 V ops E oc) = false := hA.2.2 3 rfl
theorem cfA_4 (ops : Ops V) (E : EqC V) (oc : OC V) (hA : asmP ops E oc) :
    (WF ops E oc 3 && cfL_4 V ops E oc) = false := hA.2.2 4 rfl
end

/-! ## The hardware: per-port definitions, per-kind arm tables -/

section
variable {V : Type}

def en_reg_0_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [WF ops E oc 8]
def arg_reg_0_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : V := ops.f 19 ((oc (iReg 0)).ret Reg.read)
def en_reg_1_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [WF ops E oc 8]
def arg_reg_1_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : V := ops.f 20 ((oc (iReg 1)).ret Reg.read)
def en_reg_2_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [WF ops E oc 8]
def arg_reg_2_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : V := ops.f 18 ((oc (iReg 2)).ret Reg.read)
def en_reg_3_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [(WF ops E oc 2 && ops.g 11 ((oc (iReg 7)).ret Reg.read)), (WF ops E oc 3 && ops.g 29 ((oc (iReg 7)).ret Reg.read))]
def mT_0 : Tab ((V : Type) → Ops V → EqC V → OC V → Bool × V) :=
  (.node 1 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => (((WF ops E oc 2 && ops.g 11 ((oc (iReg 7)).ret Reg.read)), ops.f 4 (ops.tup ((oc (iReg 7)).ret Reg.read) (ops.tup ((oc (iReg 3)).ret Reg.read) (ops.tup ((oc (iReg 4)).ret Reg.read) (ops.tup ((oc (iReg 5)).ret Reg.read) ((oc (iReg 6)).ret Reg.read)))))) : Bool × V)))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => (((WF ops E oc 3 && ops.g 29 ((oc (iReg 7)).ret Reg.read)), (bif (ops.g 25 ((oc (iReg 7)).ret Reg.read)) && ((ops.g 26 ((oc (iReg 7)).ret Reg.read)) && ((ops.g 27 ((oc (iReg 7)).ret Reg.read)) && (ops.g 28 ((oc (iReg 7)).ret Reg.read)))) then ops.f 9 (ops.tup ((oc (iReg 7)).ret Reg.read) (ops.tup ((oc (iReg 3)).ret Reg.read) (ops.tup ((oc (iReg 4)).ret Reg.read) (ops.tup ((oc (iReg 5)).ret Reg.read) ((oc (iReg 6)).ret Reg.read))))) else ops.f 10 ((oc (iReg 7)).ret Reg.read))) : Bool × V))))
def mlist_0 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : List (Bool × V) :=
  (List.range' 0 2).map (fun t => (mT_0.get t) V ops E oc)
def arg_reg_3_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : V := pmux (mlist_0 V ops E oc) ops.z
def en_reg_4_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [(WF ops E oc 2 && ops.g 12 ((oc (iReg 7)).ret Reg.read)), (WF ops E oc 3 && ops.g 30 ((oc (iReg 7)).ret Reg.read))]
def mT_1 : Tab ((V : Type) → Ops V → EqC V → OC V → Bool × V) :=
  (.node 1 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => (((WF ops E oc 2 && ops.g 12 ((oc (iReg 7)).ret Reg.read)), ops.f 4 (ops.tup ((oc (iReg 7)).ret Reg.read) (ops.tup ((oc (iReg 3)).ret Reg.read) (ops.tup ((oc (iReg 4)).ret Reg.read) (ops.tup ((oc (iReg 5)).ret Reg.read) ((oc (iReg 6)).ret Reg.read)))))) : Bool × V)))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => (((WF ops E oc 3 && ops.g 30 ((oc (iReg 7)).ret Reg.read)), (bif (ops.g 25 ((oc (iReg 7)).ret Reg.read)) && ((ops.g 26 ((oc (iReg 7)).ret Reg.read)) && ((ops.g 27 ((oc (iReg 7)).ret Reg.read)) && (ops.g 28 ((oc (iReg 7)).ret Reg.read)))) then ops.f 9 (ops.tup ((oc (iReg 7)).ret Reg.read) (ops.tup ((oc (iReg 3)).ret Reg.read) (ops.tup ((oc (iReg 4)).ret Reg.read) (ops.tup ((oc (iReg 5)).ret Reg.read) ((oc (iReg 6)).ret Reg.read))))) else ops.f 10 ((oc (iReg 7)).ret Reg.read))) : Bool × V))))
def mlist_1 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : List (Bool × V) :=
  (List.range' 0 2).map (fun t => (mT_1.get t) V ops E oc)
def arg_reg_4_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : V := pmux (mlist_1 V ops E oc) ops.z
def en_reg_5_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [(WF ops E oc 2 && ops.g 13 ((oc (iReg 7)).ret Reg.read)), (WF ops E oc 3 && ops.g 31 ((oc (iReg 7)).ret Reg.read))]
def mT_2 : Tab ((V : Type) → Ops V → EqC V → OC V → Bool × V) :=
  (.node 1 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => (((WF ops E oc 2 && ops.g 13 ((oc (iReg 7)).ret Reg.read)), ops.f 4 (ops.tup ((oc (iReg 7)).ret Reg.read) (ops.tup ((oc (iReg 3)).ret Reg.read) (ops.tup ((oc (iReg 4)).ret Reg.read) (ops.tup ((oc (iReg 5)).ret Reg.read) ((oc (iReg 6)).ret Reg.read)))))) : Bool × V)))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => (((WF ops E oc 3 && ops.g 31 ((oc (iReg 7)).ret Reg.read)), (bif (ops.g 25 ((oc (iReg 7)).ret Reg.read)) && ((ops.g 26 ((oc (iReg 7)).ret Reg.read)) && ((ops.g 27 ((oc (iReg 7)).ret Reg.read)) && (ops.g 28 ((oc (iReg 7)).ret Reg.read)))) then ops.f 9 (ops.tup ((oc (iReg 7)).ret Reg.read) (ops.tup ((oc (iReg 3)).ret Reg.read) (ops.tup ((oc (iReg 4)).ret Reg.read) (ops.tup ((oc (iReg 5)).ret Reg.read) ((oc (iReg 6)).ret Reg.read))))) else ops.f 10 ((oc (iReg 7)).ret Reg.read))) : Bool × V))))
def mlist_2 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : List (Bool × V) :=
  (List.range' 0 2).map (fun t => (mT_2.get t) V ops E oc)
def arg_reg_5_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : V := pmux (mlist_2 V ops E oc) ops.z
def en_reg_6_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [(WF ops E oc 2 && ops.g 14 ((oc (iReg 7)).ret Reg.read)), (WF ops E oc 3 && ops.g 32 ((oc (iReg 7)).ret Reg.read))]
def mT_3 : Tab ((V : Type) → Ops V → EqC V → OC V → Bool × V) :=
  (.node 1 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => (((WF ops E oc 2 && ops.g 14 ((oc (iReg 7)).ret Reg.read)), ops.f 4 (ops.tup ((oc (iReg 7)).ret Reg.read) (ops.tup ((oc (iReg 3)).ret Reg.read) (ops.tup ((oc (iReg 4)).ret Reg.read) (ops.tup ((oc (iReg 5)).ret Reg.read) ((oc (iReg 6)).ret Reg.read)))))) : Bool × V)))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => (((WF ops E oc 3 && ops.g 32 ((oc (iReg 7)).ret Reg.read)), (bif (ops.g 25 ((oc (iReg 7)).ret Reg.read)) && ((ops.g 26 ((oc (iReg 7)).ret Reg.read)) && ((ops.g 27 ((oc (iReg 7)).ret Reg.read)) && (ops.g 28 ((oc (iReg 7)).ret Reg.read)))) then ops.f 9 (ops.tup ((oc (iReg 7)).ret Reg.read) (ops.tup ((oc (iReg 3)).ret Reg.read) (ops.tup ((oc (iReg 4)).ret Reg.read) (ops.tup ((oc (iReg 5)).ret Reg.read) ((oc (iReg 6)).ret Reg.read))))) else ops.f 10 ((oc (iReg 7)).ret Reg.read))) : Bool × V))))
def mlist_3 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : List (Bool × V) :=
  (List.range' 0 2).map (fun t => (mT_3.get t) V ops E oc)
def arg_reg_6_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : V := pmux (mlist_3 V ops E oc) ops.z
def en_reg_7_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [WF ops E oc 8]
def arg_reg_7_write (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : V := ops.f 17 ((oc (iReg 7)).ret Reg.read)
