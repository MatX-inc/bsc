def en_f2_0_enq (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [(WF ops E oc 0 && ops.g 0 ((oc (iReg 0)).ret Reg.read)), (WF ops E oc 1 && ops.g 6 ((oc (iReg 1)).ret Reg.read))]
def mT_4 : Tab ((V : Type) → Ops V → EqC V → OC V → Bool × V) :=
  (.node 1 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => (((WF ops E oc 0 && ops.g 0 ((oc (iReg 0)).ret Reg.read)), ops.f 0 ((oc (iReg 2)).ret Reg.read)) : Bool × V)))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => (((WF ops E oc 1 && ops.g 6 ((oc (iReg 1)).ret Reg.read)), ops.f 2 ((oc (iReg 1)).ret Reg.read)) : Bool × V))))
def mlist_4 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : List (Bool × V) :=
