    (fun hl => absurd hl (by decide))
    (fun hl => absurd hl (by decide))⟩
theorem eaAll_reg (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) : Tab.AllR (EAQ ops E hy u .reg) arms_reg 0 9 :=
  ⟨⟨⟨Tab.one (ea_reg_0 ops E hy u),
  Tab.one (ea_reg_1 ops E hy u)⟩,
  ⟨Tab.one (ea_reg_2 ops E hy u),
  Tab.one (ea_reg_3 ops E hy u)⟩⟩,
  ⟨⟨Tab.one (ea_reg_4 ops E hy u),
  Tab.one (ea_reg_5 ops E hy u)⟩,
  ⟨Tab.one (ea_reg_6 ops E hy u),
  ⟨Tab.one (ea_reg_7 ops E hy u),
  Tab.one (ea_reg_8 ops E hy u)⟩⟩⟩⟩
theorem eaAll_f2 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) : Tab.AllR (EAQ ops E hy u .f2) arms_f2 0 1 :=
  Tab.one (ea_f2_0 ops E hy u)
theorem eaAll_rwC (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) : Tab.AllR (EAQ ops E hy u .rwC) arms_rwC 0 25 :=
  ⟨⟨⟨⟨Tab.one (ea_rwC_0 ops E hy u),
  ⟨Tab.one (ea_rwC_1 ops E hy u),
  Tab.one (ea_rwC_2 ops E hy u)⟩⟩,
  ⟨Tab.one (ea_rwC_3 ops E hy u),
  ⟨Tab.one (ea_rwC_4 ops E hy u),
  Tab.one (ea_rwC_5 ops E hy u)⟩⟩⟩,
  ⟨⟨Tab.one (ea_rwC_6 ops E hy u),
  ⟨Tab.one (ea_rwC_7 ops E hy u),
  Tab.one (ea_rwC_8 ops E hy u)⟩⟩,
  ⟨Tab.one (ea_rwC_9 ops E hy u),
  ⟨Tab.one (ea_rwC_10 ops E hy u),
  Tab.one (ea_rwC_11 ops E hy u)⟩⟩⟩⟩,
  ⟨⟨⟨Tab.one (ea_rwC_12 ops E hy u),
  ⟨Tab.one (ea_rwC_13 ops E hy u),
  Tab.one (ea_rwC_14 ops E hy u)⟩⟩,
  ⟨Tab.one (ea_rwC_15 ops E hy u),
  ⟨Tab.one (ea_rwC_16 ops E hy u),
  Tab.one (ea_rwC_17 ops E hy u)⟩⟩⟩,
  ⟨⟨Tab.one (ea_rwC_18 ops E hy u),
  ⟨Tab.one (ea_rwC_19 ops E hy u),
  Tab.one (ea_rwC_20 ops E hy u)⟩⟩,
  ⟨⟨Tab.one (ea_rwC_21 ops E hy u),
  Tab.one (ea_rwC_22 ops E hy u)⟩,
  ⟨Tab.one (ea_rwC_23 ops E hy u),
  Tab.one (ea_rwC_24 ops E hy u)⟩⟩⟩⟩⟩
theorem eaAll_tasks (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) : Tab.AllR (EAQ ops E hy u .tasks) arms_tasks 0 1 :=
  Tab.one (ea_tasks_0 ops E hy u)
theorem eaAll (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) (κ : Kind) (i : Nat) (h : i < nk κ) :
    EAQ ops E hy u κ i ((arms κ).get i) := by
  cases κ
  · exact Tab.get_allR _ 0 _ (eaAll_reg ops E hy u) i (Nat.zero_le _) h
  · exact Tab.get_allR _ 0 _ (eaAll_f2 ops E hy u) i (Nat.zero_le _) h
  · exact Tab.get_allR _ 0 _ (eaAll_rwC ops E hy u) i (Nat.zero_le _) h
  · exact Tab.get_allR _ 0 _ (eaAll_tasks ops E hy u) i (Nat.zero_le _) h
end

/-! ## The certificate and the obligation -/

section
variable {V : Type}
def fp (ops : Ops V) (E : EqC V) : St → List (Σ j : I, (CI j).M)
  | .inl e => e.elim
  | .inr r => (sitesF (siteR ops E r.val) (kR r.val)).map (fun s => ⟨s.j, s.m⟩)

theorem usersOk (ops : Ops V) (E : EqC V) : ∀ (s : St), ∀ p ∈ fp ops E s, s ∈ users p.1 p.2 := by
  intro s p hp
  cases s with
  | inl e => exact e.elim
  | inr r =>
    obtain ⟨i, hi, rfl⟩ := mem_keys hp
    exact mem_users (hchk r i hi)

theorem fpOk (ops : Ops V) (E : EqC V) (u : St → Nat → V) : ∀ (oc : OC V) (w : Wires Empty V) (s : St),
    ∀ c ∈ trS (P ops E u) oc w s, (⟨c.1, c.2.1⟩ : Σ j : I, (CI j).M) ∈ fp ops E s := by
  intro oc w s c hc
  cases s with
  | inl e => exact e.elim
  | inr r => rw [trS_eq] at hc; exact callsOf_fn_ports _ _ _ c hc

theorem rdyR_ok (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) : ∀ (oc : OC V) (w : Wires Empty V) (r : Fin nR),
    Env (P ops E u) oc w → fire ops E oc w r = true → ∀ c ∈ (trR (P ops E u) oc r).1,
      ((P ops E u).CI c.1).ann.alwaysRdy c.2.1 = false → (oc c.1).rdy c.2.1 = true := by
  intro oc w r hE hf c hc ha
  rw [trR_eq] at hc
  exact rdyS ops E hy oc r.val (rlt r) _ ops.z hE.2.1 (pre_r hf) c hc ha

theorem onehot_ok (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V)
    (hC : EnvC (P ops E u) oc w) : onehotP ops E oc :=
  ⟨chain_0 ops E hy oc hC.1, chain_1 ops E hy oc hC.1, chain_2 ops E hy oc hC.1, chain_3 ops E hy oc hC.1, chain_4 ops E hy oc hC.1, trivial⟩

section
variable {V : Type}
/-- A rule calling a last-caller port uses the port's virtual slot. -/
theorem hvR (ops : Ops V) (E : EqC V) (u : St → Nat → V) : ∀ (oc : OC V) (r : Fin nR) (j : I) (cm : (CI j).M),
    lcJ j cm = true → Calls (P ops E u) (trR (P ops E u) oc r).1 j cm →
    (vbJ j cm, κv, 0) ∈ D.fpR.get ((G ops E u).rk r) := by
  intro oc r j cm hl ⟨x, hx⟩
  have hus : (.inr r : St) ∈ users j cm :=
    usersOk ops E (.inr r) ⟨j, cm⟩ (fpOk ops E u oc ⟨fun e => e.elim, fun e => e.elim⟩ (.inr r) ⟨j, (cm, x)⟩ (mem_proj j _ _ hx))
  obtain ⟨k, hk, e⟩ := List.mem_map.mp hus
  have h2 := List.all_eq_true.mp (vchk j cm hl) k hk
  simp only [Bool.and_eq_true] at h2
  have hkR : k < nR := Nat.blt_eq.mp h2.1
  
  have er : r.val = k := by rw [← Sum.inr.inj e]; exact Nat.mod_eq_of_lt hkR
  show (vbJ j cm, κv, 0) ∈ fpRT.get r.val
  have h := Tab.allB_spec _ fpRT 0 nR fpAll r.val (Nat.zero_le _) r.isLt
  rw [beq_iff_eq] at h
  rw [h, er]
  exact List.mem_append_right _ (List.contains_iff_mem.mp h2.2)
end
def cert (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) : CertL (P ops E u) :=
  LC.PairFacts.toCertL (P ops E u) (pairs ops E hy u) (fp ops E) users (usersOk ops E) (fpOk ops E u)
    (fun m => m.elim) (fun _ _ m => m.elim)
    (fun oc w r _ hf => resR_ok ops E hy u oc w r hf)
    (fun _ _ m => m.elim) (rdyR_ok ops E hy u)
    (fun oc w j cm hE hcm => by obtain ⟨κ, i, hi⟩ := j; exact (eaAll ops E hy u κ i hi hi oc w hE).1 cm hcm)
    (fun _ _ m => m.elim)
    (fun oc w j cm _ h => by obtain ⟨κ, i⟩ := j; cases κ <;> cases cm <;> cases h)
    (onehot_ok ops E hy u)
    lcJ lcOk (LC.lpOf (G ops E u)) (LC.lpRR_of_scan (glueOK ops E hy u) lcJ) (LC.lpMR_of_scan (glueOK ops E hy u) lcJ)
    (LC.lcMR_of_scan vbJ κv scanOK (glueOK ops E hy u) lcJ hkv (fun _ _ m => m.elim) (hvR ops E u))
    (LC.lcRR_of_scan vbJ κv scanOK (glueOK ops E hy u) lcJ hkv (hvR ops E u))
    (LC.lcMM_of_scan vbJ κv scanOK (glueOK ops E hy u) lcJ hkv (fun _ _ m => m.elim))
    (fun oc w j cm hE hl s hs hav x hx => by obtain ⟨κ, i, hi⟩ := j; exact (eaAll ops E hy u κ i hi hi oc w hE).2.1 cm hl s hs hav x hx)
    (fun oc w j cm hE hl s hs hon x hx hlt => by
      obtain ⟨κ, i, hi⟩ := j; exact (eaAll ops E hy u κ i hi hi oc w hE).2.2 cm hl s hs hon x hx hlt)

/-- **The certificate fixed before the skipped values**: rules, firing and hits do not mention
    `u`, and a step's calls are the same at every `u` (`trUS`). -/
def certU (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : CertUL (F ops E) where
  rules := (List.range nR).map rR
  fire := fire ops E
  hit := (pairs ops E hy (fun _ _ => ops.z)).hit
  cert u := cert ops E hy u
  rules_eq _ := rfl
  fire_eq _ := rfl
  hit_eq _ := rfl
  trU oc w s u u' _ hav := by
    cases s with
    | inl e => exact e.elim
    | inr r => exact (trS_eq ops E u oc w r).trans ((trUS ops E hy oc r.val (rlt r) _ _ ops.z (pre_r hav)).trans
        (trS_eq ops E u' oc w r).symm)

/-- **The module's obligation**: the order and every child's calls are fixed before the skipped
    values; for every value type, operators, constants and solver verdicts. -/
theorem obl [Inhabited V] (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : OblU (F ops E) :=
  oblU_of_certL (F ops E) (certU ops E hy)
end

/-! ## Acyclicity: read lists as filters of allOuts -/

def wireRk (b : Nat) : WireM → Nat := fun m => match m with
  | .wget | .whas => b
  | _ => 0
def wire0Rk (b : Nat) : Wire0M → Nat := fun m => match m with
  | .whas => b
  | _ => 0

def bnd_rwC : Tab Nat :=
  (.node 12 (.node 6 (.node 3 (.node 1 (.leaf (1))
  (.node 2 (.leaf (1))
  (.leaf (1))))
  (.node 4 (.leaf (1))
  (.node 5 (.leaf (1))
  (.leaf (1)))))
  (.node 9 (.node 7 (.leaf (1))
  (.node 8 (.leaf (1))
  (.leaf (1))))
  (.node 10 (.leaf (1))
  (.node 11 (.leaf (1))
  (.leaf (1))))))
  (.node 18 (.node 15 (.node 13 (.leaf (1))
  (.node 14 (.leaf (1))
  (.leaf (1))))
  (.node 16 (.leaf (1))
  (.node 17 (.leaf (1))
  (.leaf (1)))))
  (.node 21 (.node 19 (.leaf (1))
  (.node 20 (.leaf (1))
  (.leaf (1))))
  (.node 23 (.node 22 (.leaf (1))
  (.leaf (1)))
  (.node 24 (.leaf (1))
  (.leaf (1)))))))
def rkK : (κ : Kind) → Nat → (KI κ).M → Nat
  | .reg => fun _ _ => 0
  | .f2 => fun _ _ => 0
  | .rwC => fun i m => wireRk (bnd_rwC.get i) m
  | .tasks => fun _ _ => 0

def rk (y : Σ j : I, (CI j).M) : Nat := rkK y.1.1 y.1.2.val y.2
def mxRDT : Tab Nat :=
  (.node 5 (.node 2 (.node 1 (.leaf (0))
  (.leaf (0)))
  (.node 3 (.leaf (0))
  (.node 4 (.leaf (0))
  (.leaf (0)))))
  (.node 7 (.node 6 (.leaf (0))
  (.leaf (0)))
  (.node 8 (.leaf (0))
  (.node 9 (.leaf (0))
  (.leaf (0))))))
def allOuts : List (Σ j : I, (CI j).M) := allPorts [.reg, .f2, .rwC, .tasks] nk (fun κ => (KI κ).M) portsK
theorem mem_allOuts (y : Σ j : I, (CI j).M) : y ∈ allOuts :=
  mem_allPorts _ nk _ portsK (fun κ => by cases κ <;> simp) (fun κ m => by
    cases κ
    · exact ports_reg m
    · exact ports_f2 m
    · exact ports_rwC m
    · exact ports_tasks m
  ) y
def allIns : List Empty := []
theorem mem_allIns (p : Empty) : p ∈ allIns := p.elim
def outsBelow (r : Nat) : List (Σ j : I, (CI j).M) := allOuts.filter (fun y => Nat.blt (rk y) r)
def DK : (κ : Kind) → Nat → (KI κ).M → List (Σ j : I, (CI j).M)

  | .reg => fun _ _ => allOuts
  | .f2 => fun _ _ => allOuts
  | .rwC => fun i m => match m with | .wset => outsBelow (bnd_rwC.get i) | _ => allOuts
  | .tasks => fun _ _ => allOuts

theorem rdBnd : Tab.allB (fun k keys => Nat.beq (kT.get k) 0 ||
    Tab.allB (fun i p => alwaysRdyB p || Nat.ble (rk p) (mxRDT.get k)) keys 0 (kT.get k)) keyT 0 nS = true := by
  decide +kernel
theorem rdB (k : Nat) (hk : k < nS) : ∀ i, i < kR k → alwaysRdyB ((keyT.get k).get i) = false →
    rk ((keyT.get k).get i) ≤ mxRDT.get k := by
  intro i hi ha
  have h := sitesB_spec (fun k i p => alwaysRdyB p || Nat.ble (rk p) (mxRDT.get k)) rdBnd k hk i hi
  simp only [ha, Bool.false_or] at h
  exact Nat.le_of_ble_eq_true h

theorem all_congr' {α : Type} {f g : α → Bool} : ∀ (l : List α), (∀ a ∈ l, f a = g a) → l.all f = l.all g
  | [], _ => rfl
  | a :: l, h => by
    simp only [List.all_cons]
    rw [h a (List.mem_cons_self ..), all_congr' l (fun b hb => h b (List.mem_cons_of_mem _ hb))]

section
variable {V : Type}
theorem agO {oc oc' : OC V} {b : Nat} (hR : ∀ y, Nat.blt (rk y) b = true → AgreeO (oc y.1) (oc' y.1) y.2)
    (j : I) (m : (CI j).M) (h : Nat.blt (rk ⟨j, m⟩) b = true) : (oc j).ret m = (oc' j).ret m := (hR ⟨j, m⟩ h).2
theorem agR {oc oc' : OC V} {b : Nat} (hR : ∀ y, Nat.blt (rk y) b = true → AgreeO (oc y.1) (oc' y.1) y.2)
    (j : I) (m : (CI j).M) (h : Nat.blt (rk ⟨j, m⟩) b = true) : (oc j).rdy m = (oc' j).rdy m := (hR ⟨j, m⟩ h).1

theorem agRD {oc oc' : OC V} {b : Nat} (hR : ∀ y, Nat.blt (rk y) b = true → AgreeO (oc y.1) (oc' y.1) y.2)
    (k : Nat) (hk : k < nS) (hb : Nat.blt (mxRDT.get k) b = true) : RD oc k = RD oc' k := by
  unfold RD
  apply all_congr'
  intro i hi
  have hi' : i < kR k := by simp at hi; omega
  cases ha : alwaysRdyB ((keyT.get k).get i)
  · rw [(hR _ (blt_of_le_blt (rdB k hk i hi' ha) hb)).1]
  · rfl

theorem agWF_0 (ops : Ops V) (E : EqC V) {oc oc' : OC V} {b : Nat}
    (hR : ∀ y, Nat.blt (rk y) b = true → AgreeO (oc y.1) (oc' y.1) y.2) (hb : Nat.blt 0 b = true) :
    WF ops E oc 0 = WF ops E oc' 0 :=
  congr2 and (congr2 and (agRD hR 0 (by decide) (blt_of_le_blt (Nat.le_of_ble_eq_true rfl) hb)) (congr2 and (congrArg (ops.g 5) (congr2 ops.tup (agO hR (iReg 0) Reg.read (blt_of_le_blt (Nat.le_of_ble_eq_true rfl) hb)) (agO hR (iF2 0) FifoM.i_notFull (blt_of_le_blt (Nat.le_of_ble_eq_true rfl) hb)))) (congr2 and (congr2 or (congrArg not (congrArg (ops.g 0) (agO hR (iReg 0) Reg.read (blt_of_le_blt (Nat.le_of_ble_eq_true rfl) hb)))) (agR hR (iF2 0) FifoM.enq (blt_of_le_blt (Nat.le_of_ble_eq_true rfl) hb))) (rfl)))) (rfl)
theorem agWF_1 (ops : Ops V) (E : EqC V) {oc oc' : OC V} {b : Nat}
    (hR : ∀ y, Nat.blt (rk y) b = true → AgreeO (oc y.1) (oc' y.1) y.2) (hb : Nat.blt 0 b = true) :
    WF ops E oc 1 = WF ops E oc' 1 :=
  congr2 and (congr2 and (agRD hR 1 (by decide) (blt_of_le_blt (Nat.le_of_ble_eq_true rfl) hb)) (congr2 and (congrArg (ops.g 10) (congr2 ops.tup (agO hR (iReg 1) Reg.read (blt_of_le_blt (Nat.le_of_ble_eq_true rfl) hb)) (agO hR (iF2 0) FifoM.i_notFull (blt_of_le_blt (Nat.le_of_ble_eq_true rfl) hb)))) (congr2 and (congr2 or (congrArg not (congrArg (ops.g 6) (agO hR (iReg 1) Reg.read (blt_of_le_blt (Nat.le_of_ble_eq_true rfl) hb)))) (agR hR (iF2 0) FifoM.enq (blt_of_le_blt (Nat.le_of_ble_eq_true rfl) hb))) (rfl)))) (rfl)
theorem agWF_2 (ops : Ops V) (E : EqC V) {oc oc' : OC V} {b : Nat}
    (hR : ∀ y, Nat.blt (rk y) b = true → AgreeO (oc y.1) (oc' y.1) y.2) (hb : Nat.blt 0 b = true) :
    WF ops E oc 2 = WF ops E oc' 2 :=
  congr2 and (congr2 and (agRD hR 2 (by decide) (blt_of_le_blt (Nat.le_of_ble_eq_true rfl) hb)) (congrArg (ops.g 24) (rfl))) (rfl)
theorem agWF_3 (ops : Ops V) (E : EqC V) {oc oc' : OC V} {b : Nat}
    (hR : ∀ y, Nat.blt (rk y) b = true → AgreeO (oc y.1) (oc' y.1) y.2) (hb : Nat.blt 0 b = true) :
    WF ops E oc 3 = WF ops E oc' 3 :=
  congr2 and (congr2 and (agRD hR 3 (by decide) (blt_of_le_blt (Nat.le_of_ble_eq_true rfl) hb)) (congrArg (ops.g 42) (rfl))) (rfl)
def DQ_rwC (ops : Ops V) (E : EqC V) (i : Nat) (A : (V : Type) → Ops V → EqC V → OC V → Wires Empty V → Wires (KI .rwC).M V) : Prop :=
  ∀ (h : i < nk .rwC) (oc oc' : OC V) (w w' : Wires Empty V),
    ((∀ y, Nat.blt (rk y) (bnd_rwC.get i) = true → AgreeO (oc y.1) (oc' y.1) y.2) → AgreeW (A V ops E oc w) (A V ops E oc' w') WireM.wset)
theorem dq_rwC_0 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 0 arm_rwC_0 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_0 ops E hR rfl) (rfl)), rfl⟩
theorem dq_rwC_1 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 1 arm_rwC_1 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_0 ops E hR rfl) (rfl)), rfl⟩
theorem dq_rwC_2 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 2 arm_rwC_2 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_0 ops E hR rfl) (rfl)), congrArg (ops.f 1) (agO hR (iReg 0) Reg.read rfl)⟩
theorem dq_rwC_3 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 3 arm_rwC_3 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_0 ops E hR rfl) (rfl)), rfl⟩
theorem dq_rwC_4 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 4 arm_rwC_4 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_1 ops E hR rfl) (rfl)), rfl⟩
theorem dq_rwC_5 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 5 arm_rwC_5 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_1 ops E hR rfl) (rfl)), congrArg (ops.f 3) (agO hR (iReg 1) Reg.read rfl)⟩
theorem dq_rwC_6 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 6 arm_rwC_6 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_1 ops E hR rfl) (rfl)), rfl⟩
theorem dq_rwC_7 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 7 arm_rwC_7 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_2 ops E hR rfl) (rfl)), rfl⟩
theorem dq_rwC_8 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 8 arm_rwC_8 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_2 ops E hR rfl) (rfl)), congrArg (ops.f 5) (agO hR (iReg 7) Reg.read rfl)⟩
theorem dq_rwC_9 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 9 arm_rwC_9 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_2 ops E hR rfl) (rfl)), rfl⟩
theorem dq_rwC_10 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 10 arm_rwC_10 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_2 ops E hR rfl) (rfl)), congrArg (ops.f 6) (agO hR (iReg 7) Reg.read rfl)⟩
theorem dq_rwC_11 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 11 arm_rwC_11 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_2 ops E hR rfl) (rfl)), rfl⟩
theorem dq_rwC_12 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 12 arm_rwC_12 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_2 ops E hR rfl) (rfl)), congrArg (ops.f 7) (agO hR (iReg 7) Reg.read rfl)⟩
theorem dq_rwC_13 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 13 arm_rwC_13 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_2 ops E hR rfl) (rfl)), rfl⟩
theorem dq_rwC_14 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 14 arm_rwC_14 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_2 ops E hR rfl) (rfl)), congrArg (ops.f 8) (agO hR (iReg 7) Reg.read rfl)⟩
theorem dq_rwC_15 (ops : Ops V) (E : EqC V) : DQ_rwC ops E 15 arm_rwC_15 := fun h oc oc' w w' =>
  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_2 ops E hR rfl) (rfl)), rfl⟩
