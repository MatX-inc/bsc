  (.node 9 (.leaf (0))
  (.leaf (0))))))
def escRT : Tab Nat :=
  (.node 5 (.node 2 (.node 1 (.leaf (0))
  (.leaf (2)))
  (.node 3 (.leaf (0))
  (.node 4 (.leaf (4))
  (.leaf (0)))))
  (.node 7 (.node 6 (.leaf (0))
  (.leaf (0)))
  (.node 8 (.leaf (0))
  (.node 9 (.leaf (0))
  (.leaf (0))))))
def rcT : Tab Nat :=
  (.node 5 (.node 2 (.node 1 (.leaf (1))
  (.leaf (0)))
  (.node 3 (.leaf (2))
  (.node 4 (.leaf (0))
  (.leaf (3)))))
  (.node 7 (.node 6 (.leaf (4))
  (.leaf (5)))
  (.node 8 (.leaf (0))
  (.node 9 (.leaf (0))
  (.leaf (0))))))
def rinvT : Tab Nat :=
  (.node 3 (.node 1 (.leaf (0))
  (.node 2 (.leaf (0))
  (.leaf (2))))
  (.node 4 (.leaf (4))
  (.node 5 (.leaf (5))
  (.leaf (6)))))
def memT : Tab (List Nat) :=
  (.node 1 (.leaf ([4, 6]))
  (.leaf ([5, 6])))
def gidT : Tab (List Nat) :=
  (.node 5 (.node 2 (.node 1 (.leaf ([]))
  (.leaf ([])))
  (.node 3 (.leaf ([]))
  (.node 4 (.leaf ([]))
  (.leaf ([0])))))
  (.node 7 (.node 6 (.leaf ([1]))
  (.leaf ([0, 1])))
  (.node 8 (.leaf ([]))
  (.node 9 (.leaf ([]))
  (.leaf ([]))))))
def cmT : Tab Nat :=
  (.node 1 (.leaf (40))
  (.leaf (48)))
abbrev ng : Nat := 2
def D : Design where
  nM := 0
  nR := nR
  d := 7
  fpM := .leaf []
  fpR := fpRT
  kt := ktT
  nfI := .leaf 0
  nfO := .leaf 0
  ngI := .leaf 0
  ngO := .leaf 0
  h3ok := .leaf 0
  exM := .leaf 0
  exR := exRT
  exMR := .leaf 0
  escR := escRT
  rc := fun i => rcT.get i

/-! Gate bounds (design.md §11 item 6), each with this module's value (a table setting: the value used):
  * uses in one scan segment (the module: uses of its largest step): at most 4096, this module 22
  * slots in the state: at most 8192, this module 103
  * rule codes: at most 4096, this module 6
  * sites in one step: at most 4096, this module 22
  * users of one port (mux members): at most 3296, this module 4
  * members of one exception group: at most 3296, this module 2
  * callers of one last-caller port: at most 512, this module 3
  * escaped rule pairs: at most 64, this module 2
  * dynamic facts of one escaped pair: at most 4096, this module 4
  * facts of one module (escape, caller-exclusivity, readiness and invariance): at most 16384, this module 10
  * fields of one fact group (Hyps and Unconfirmed in groups gK): at most 128, this module 10
  * entries per table definition (C21): at most 128, setting used 128
  * source characters per table definition (C21): at most 20000, setting used 20000
  * users of a port listed entry by entry (en_list / en_lit threshold): at most 8, setting used 8
  * users of one port proved pair by pair (a conditional user, or a module with methods): at most 64, this module 2
-/
theorem segZ : D.segLast 0 ST.init = true := by decide +kernel
theorem scanOK : D.Ok := D.ok_of_chain [] segZ

def chB (j : I) : Bool := decide (j.1 = .tasks)
def posK : (κ : Kind) → (KI κ).M → Nat
  | .reg => fun _ => 0
  | .f2 => fun _ => 0
  | .rwC => fun _ => 0
  | .tasks => fun t => t.val

def stT : Tab Nat :=
  (.node 5 (.node 2 (.node 1 (.leaf (0))
  (.leaf (0)))
  (.node 3 (.leaf (1))
  (.node 4 (.leaf (1))
  (.leaf (5)))))
  (.node 7 (.node 6 (.leaf (5))
  (.leaf (5)))
  (.node 8 (.leaf (5))
  (.node 9 (.leaf (6))
  (.leaf (6))))))
def stF (g : Nat) : Nat := bif Nat.blt g nR then stT.get g else 6
theorem stMono : Tab.allB (fun g x => Nat.ble x 6 && Nat.ble x (bif Nat.blt (g + 1) nR then stT.get (g + 1) else 6)) stT 0 nR = true := by decide +kernel
theorem chainAll : Tab.allB (fun k keys =>
    incB ((((List.range' 0 (kT.get k)).map keys.get).filter (fun p => chB p.1)).map (fun p => posK p.1.1 p.2)) &&
    ((((List.range' 0 (kT.get k)).map keys.get).filter (fun p => chB p.1)).map (fun p => posK p.1.1 p.2)).all
      (fun x => Nat.ble (bif Nat.blt k nR then stF k else 0) x && Nat.blt x (bif Nat.blt k nR then stF (k + 1) else 0))) keyT 0 nS = true := by decide +kernel
/-- Chain intervals by the scan's step position (methods first, then rules by rank). -/
def cloG (g : Nat) : Nat := if g < D.nM then 0 else stF (g - D.nM)
def chiG (g : Nat) : Nat := if g < D.nM then 0 else stF (g - D.nM + 1)
theorem cloG_r (r : Nat) : cloG (D.nM + r) = stF r := by
  unfold cloG; rw [if_neg (Nat.not_lt.mpr (Nat.le_add_right _ _)), Nat.add_sub_cancel_left]
theorem chiG_r (r : Nat) : chiG (D.nM + r) = stF (r + 1) := by
  unfold chiG; rw [if_neg (Nat.not_lt.mpr (Nat.le_add_right _ _)), Nat.add_sub_cancel_left]
theorem cmonoG (g1 g2 : Nat) (h : g1 < g2) : chiG g1 ≤ cloG g2 := by
  have hm := mono_of_succ stF (stF_mono stT nR 6 stMono)
  unfold chiG cloG
  split <;> split
  · exact Nat.le_refl _
  · exact Nat.zero_le _
  · omega
  · exact hm _ _ (by omega)

section
variable {V : Type}
def G (ops : Ops V) (E : EqC V) (u : St → Nat → V) : Glue (P ops E u) D where
  mi := fun m => m.elim
  ruleAt := rR
  rk := fun r => r.val
  base := baseOf
  kind := fun j => kindN j.1
  code := fun j m => codeK j.1 m
  fx := fxF
  z := ops.z
  ch := chB
  pos := fun j m => posK j.1 m
  clo := cloG
  chi := chiG
end

def entK (p : Σ j : I, (CI j).M) : Ent := (baseOf p.1, kindN p.1.1, codeK p.1.1 p.2)

theorem fpAll : Tab.allB (fun k l => l == (List.range' 0 (kT.get k)).map (fun i => entK ((keyT.get k).get i)) ++ virtT.get k) fpRT 0 nR = true := by decide +kernel
theorem cmAll : Tab.allB (fun g l => Nat.beq (cmT.get g) (bits (l.map D.rc))) memT 0 ng = true := by decide +kernel
theorem hcm_ok : ∀ g, g < ng → cmT.get g = bits ((memT.get g).map D.rc) := cm_of_check memT cmT D.rc ng cmAll
theorem ghg : Tab.allB (fun x l => l.all (fun g => Nat.blt g ng && Nat.beq (Nat.land (Nat.shiftRight (cmT.get g) (D.rc x)) 1) 1)) gidT 0 nR = true := by decide +kernel
theorem hg_ok : ∀ x, x < nR → ∀ g ∈ gidT.get x, g < ng ∧ (cmT.get g).testBit (D.rc x) = true :=
  gid_of_check gidT cmT D.rc nR ng ghg
theorem ghT : Tab.allB (fun y n => subB n (orMask (gidT.get y) cmT.get)) exRT 0 nR = true := by decide +kernel
theorem hinj_ok : ∀ g, g < ng → ∀ x ∈ memT.get g, ∀ x1, x1 < D.nR → D.rc x1 = D.rc x → x1 = x :=
  chains_inj D rinvT.get memT ng (by decide +kernel) (by decide +kernel)
theorem hT_ok : ∀ y, y < nR → Sub (exRT.get y) (orMask (gidT.get y) cmT.get) :=
  fun y hy => sub_of_subB (Tab.allB_spec _ exRT 0 nR ghT y (Nat.zero_le _) hy)
theorem ports_reg : ∀ p : CRegM 1, p ∈ [Reg.read, Reg.write]
  | .rd ⟨0, _⟩ => by simp
  | .wr ⟨0, _⟩ => by simp
theorem ports_f2 : ∀ p : (KI .f2).M, p ∈ [FifoM.enq, FifoM.deq, FifoM.first, FifoM.notEmpty, FifoM.notFull, FifoM.i_notEmpty, FifoM.i_notFull, FifoM.clear] := by intro p; cases p <;> simp
theorem ports_rwC : ∀ p : (KI .rwC).M, p ∈ [WireM.wset, WireM.wget, WireM.whas] := by intro p; cases p <;> simp
theorem ports_tasks : ∀ p : (KI .tasks).M, p ∈ List.finRange nT := List.mem_finRange
def portsK : (κ : Kind) → List (KI κ).M
  | .reg => [Reg.read, Reg.write]
  | .f2 => [FifoM.enq, FifoM.deq, FifoM.first, FifoM.notEmpty, FifoM.notFull, FifoM.i_notEmpty, FifoM.i_notFull, FifoM.clear]
  | .rwC => [WireM.wset, WireM.wget, WireM.whas]
  | .tasks => List.finRange nT
def portsJ (j : I) : List (CI j).M := portsK j.1
theorem portsJ_ok (j : I) (m : (CI j).M) : m ∈ portsJ j := by
  obtain ⟨κ, i⟩ := j
  cases κ
  · exact ports_reg m
  · exact ports_f2 m
  · exact ports_rwC m
  · exact ports_tasks m

/-- The `Tasks` child, and a task port's statement number (0 elsewhere); statements are numbered in rank order. -/
def isT : Kind → Bool
  | .reg => false
  | .f2 => false
  | .rwC => false
  | .tasks => true
def tnum : (κ : Kind) → (KI κ).M → Nat
  | .reg => fun _ => 0
  | .f2 => fun _ => 0
  | .rwC => fun _ => 0
  | .tasks => fun t => t.val

section
variable {V : Type}
theorem testBit_leaf0 (k i : Nat) : ((Tab.leaf 0 : Tab Nat).get k).testBit i = false := by simp [Tab.get]

theorem fpR_ok (ops : Ops V) (E : EqC V) (u : St → Nat → V) (oc : OC V) (r : Fin nR) :
    (trR (P ops E u) oc r).1.map (G ops E u).ent <+ D.fpR.get ((G ops E u).rk r) := by
  rw [trR_eq]
  refine (fp_of_sites (G ops E u) _ _).trans ?_
  have h := Tab.allB_spec _ fpRT 0 nR fpAll r.val (Nat.zero_le _) r.isLt
  rw [beq_iff_eq] at h
  show (sitesF (siteR ops E r.val) (kR r.val)).map (G ops E u).entS <+ fpRT.get r.val
  rw [h, sitesF_map]
  exact List.sublist_append_left _ _

theorem zR_ok (ops : Ops V) (E : EqC V) (u : St → Nat → V) (oc : OC V) (r : Fin nR) :
    ∀ c ∈ (trR (P ops E u) oc r).1, (G ops E u).fx ((G ops E u).kind c.1) ((G ops E u).code c.1 c.2.1) = true → c.2.2 = (G ops E u).z := by
  rw [trR_eq]
  apply z_of_sites (G ops E u)
  intro s hs hf ρ'
  obtain ⟨i, hi, rfl⟩ := mem_sitesF hs
  exact ((Tab.get_allR _ 0 (kR r.val) (sqR ops E r.val (rlt r)) i (Nat.zero_le _) hi) ops.z).2 hf ρ'

theorem kind_reg (z : V) : KindOK (V := V) (KI .reg).ann (codeK .reg) (D.kc 0) (fxF 0) z :=
  kindOK_of_chk ports_reg (by decide +kernel) z
theorem kind_f2 (z : V) : KindOK (V := V) (KI .f2).ann (codeK .f2) (D.kc 1) (fxF 1) z :=
  kindOK_of_chk ports_f2 (by decide +kernel) z
theorem kind_rwC (z : V) : KindOK (V := V) (KI .rwC).ann (codeK .rwC) (D.kc 2) (fxF 2) z :=
  kindOK_of_chk ports_rwC (by decide +kernel) z
theorem chainS (ops : Ops V) (E : EqC V) (u : St → Nat → V) (k : Nat) (hk : k < nS) (x : V) :
    (∀ p ∈ (sitesF (siteS ops E k x) (kR k)).map (fun s => (⟨s.j, s.m⟩ : Σ j : I, (CI j).M)),
      (G ops E u).ch p.1 = true → (bif Nat.blt k nR then stF k else 0) ≤ (G ops E u).pos p.1 p.2 ∧
        (G ops E u).pos p.1 p.2 < (bif Nat.blt k nR then stF (k + 1) else 0)) ∧
    incB ((((sitesF (siteS ops E k x) (kR k)).map (fun s => (⟨s.j, s.m⟩ : Σ j : I, (CI j).M))).filter
      (fun p => (G ops E u).ch p.1)).map (fun p => (G ops E u).pos p.1 p.2)) = true := by
  rw [sitesF_map]
  exact chain_keys (G := G ops E u) _ _ _ _ (Tab.allB_spec _ keyT 0 nS chainAll k (Nat.zero_le _) hk)

/-- Exception group `l`: its rules never two fire. -/
def CHQ (ops : Ops V) (E : EqC V) (u : St → Nat → V) (g : Nat) (l : List Nat) : Prop :=
  ∀ oc w, Env (P ops E u) oc w → amoChain false (l.map (fun i => fire ops E oc w (rR i)))
theorem chT (ops : Ops V) (E : EqC V) (u : St → Nat → V) (hy : Hyps ops E) : Tab.AllR (CHQ ops E u) memT 0 ng :=
  ⟨Tab.one ((fun oc w hE => amoChain_of_pairsL (fun k => WF ops E oc k) (fun x y => WF ops E oc x = true → WF ops E oc y = true → False) (fun _ _ h => h) [4, 6] ⟨⟨fun h1 h2 => meX ops E oc hE.1 0 0 rfl rfl h1 h2, trivial⟩, trivial, trivial⟩ : CHQ ops E u 0 [4, 6])),
  Tab.one ((fun oc w hE => amoChain_of_pairsL (fun k => WF ops E oc k) (fun x y => WF ops E oc x = true → WF ops E oc y = true → False) (fun _ _ h => h) [5, 6] ⟨⟨fun h1 h2 => meX ops E oc hE.1 1 0 rfl rfl h1 h2, trivial⟩, trivial, trivial⟩ : CHQ ops E u 1 [5, 6]))⟩

/-- Ports' static `Follow`: a flagged (argument-less) port's calls carry `z`. -/
def okP (j : I) (a b : (CI j).M) : Bool :=
  folP (CI j).ann a b && (!decide (a = b) || !(CI j).ann.share a || fxP ⟨j, a⟩)
theorem okP_follow (z : V) : ∀ j (a b : (CI j).M × V), okP j a.1 b.1 = true →
    (fxP ⟨j, a.1⟩ = true → a.2 = z) → (fxP ⟨j, b.1⟩ = true → b.2 = z) → (CI j).ann.Follow a b := by
  intro j a b h ha hb
  simp only [okP, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not] at h
  obtain ⟨hf, hs⟩ := h
  simp only [folP, Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq, Bool.not_eq_true'] at hf
  obtain ⟨⟨h11, h12⟩, h13⟩ := hf
  refine ⟨fun hne => ?_, h12, h13, fun he hsh => ?_⟩
  · rcases h11 with h | h
    · exact absurd h hne
    · exact h
  · rcases hs with (h | h) | h
    · exact absurd he h
    · rw [hsh] at h; cases h
    · have e2 : fxP ⟨j, b.1⟩ = true := by rw [← he]; exact h
      rw [ha h, hb e2]

/-- Two task statements in number order may follow each other (`taskAnn`: the lower one runs first). -/
theorem okP_task (j : I) (a b : (CI j).M) (h : isT j.1 = true) (hab : tnum j.1 a < tnum j.1 b) : okP j a b = true := by
  obtain ⟨κ, i⟩ := j
  cases κ <;> simp only [isT, Bool.false_eq_true] at h
  have hab' : (a : Fin nT).val < (b : Fin nT).val := hab
  have hne : ¬ (a : Fin nT) = b := fun e => by rw [e] at hab'; exact Nat.lt_irrefl _ hab'
  have hne' : ¬ (b : Fin nT) = a := fun e => hne e.symm
  have hnl : ¬ (b : Fin nT) < a := fun e => Nat.lt_asymm hab' e
  simp [okP, folP, taskAnn, hne, hne', hnl]
/-- An escaped pair over numbered site tables, with flagged ports' calls carrying `z`; its bad site pairs
    keyed by first-step site (`badT`, leaves `(i, i2s)`), each site's partners in one pass (`subS`): linear in
    the facts (cost review r8-2 M1). A first-step task statement below `lo`, with every second-step one at
    least `lo` (`hc2`), is one comparison, independent of `nT` (cost review r8b-1 M1). -/
theorem okT_exceptZ (z : V) (ρ1 ρ2 : Nat → V) (site1 site2 : Nat → Site I (fun j => (CI j).M) V) (k1 k2 : Nat)
    (key1 key2 : Tab (Σ j, (CI j).M))
    (hkey1 : ∀ i, (⟨(site1 i).j, (site1 i).m⟩ : Σ j, (CI j).M) = key1.get i)
    (hkey2 : ∀ i, (⟨(site2 i).j, (site2 i).m⟩ : Σ j, (CI j).M) = key2.get i)
    (idx2 : (Σ j, (CI j).M) → List Nat) (hchk2 : ∀ i, i < k2 → i ∈ idx2 (key2.get i)) (badT : Tab (Nat × List Nat))
    (lo : Nat)
    (hz1 : ∀ c ∈ callsOf ρ1 (sitesF site1 k1), fxP ⟨c.1, c.2.1⟩ = true → c.2.2 = z)
    (hz2 : ∀ c ∈ callsOf ρ2 (sitesF site2 k2), fxP ⟨c.1, c.2.1⟩ = true → c.2.2 = z)
    (hc : Tab.allB (fun i p => (isT p.1.1 && Nat.blt (tnum p.1.1 p.2) lo) || (portsJ p.1).all (fun b => okP p.1 p.2 b ||
      subS (idx2 ⟨p.1, b⟩) (idxT badT i))) key1 0 k1 = true)
    (hc2 : Tab.allB (fun _ p => !isT p.1.1 || Nat.ble lo (tnum p.1.1 p.2)) key2 0 k2 = true)
    (hbad : Tab.All (fun e : Nat × List Nat =>
      AllL (fun i2 => (site1 e.1).cond ρ1 = true → (site2 i2).cond ρ2 = true → False) e.2) badT) :
    ∀ j, ∀ a ∈ proj j (callsOf ρ1 (sitesF site1 k1)), ∀ b ∈ proj j (callsOf ρ2 (sitesF site2 k2)), (CI j).ann.Follow a b := by
  intro j ⟨a1, a2⟩ ha b hb
  obtain ⟨s, hs, hc1, ha2⟩ := mem_proj_callsOf (I := I) (CM := fun j => (CI j).M) ρ1 j a1 a2 (sitesF site1 k1) ha
  rw [List.mem_filter] at hs
  obtain ⟨i1, hi1, rfl⟩ := mem_sitesF hs.1
  have e1 : key1.get i1 = ⟨j, a1⟩ := (hkey1 i1).symm.trans ((onPort_iff (I := I) (CM := fun j => (CI j).M) (V := V) j a1 _).mp hs.2)
  obtain ⟨s2, hs2, hc2', -⟩ := mem_proj_callsOf (I := I) (CM := fun j => (CI j).M) ρ2 j b.1 b.2 (sitesF site2 k2) hb
  rw [List.mem_filter] at hs2
  obtain ⟨i2, hi2k, rfl⟩ := mem_sitesF hs2.1
  have e2 : key2.get i2 = ⟨j, b.1⟩ := (hkey2 i2).symm.trans ((onPort_iff (I := I) (CM := fun j => (CI j).M) (V := V) j b.1 _).mp hs2.2)
  have hi2 : i2 ∈ idx2 ⟨j, b.1⟩ := e2 ▸ hchk2 i2 hi2k
  have hzF : okP j a1 b.1 = true → (CI j).ann.Follow (a1, a2) b := fun h' =>
    okP_follow z j (a1, a2) b h' (fun hf => hz1 ⟨j, (a1, a2)⟩ (mem_proj j _ _ ha) hf)
      (fun hf => hz2 ⟨j, b⟩ (mem_proj j _ _ hb) hf)
  have h := Tab.allB_spec _ key1 0 k1 hc i1 (Nat.zero_le _) hi1
  rw [e1, Bool.or_eq_true] at h
  rcases h with h | h
  · rw [Bool.and_eq_true] at h
    have h2 := Tab.allB_spec _ key2 0 k2 hc2 i2 (Nat.zero_le _) hi2k
    rw [e2, h.1, Bool.not_true, Bool.false_or] at h2
    exact hzF (okP_task j a1 b.1 h.1 (Nat.lt_of_lt_of_le (Eq.mp Nat.blt_eq h.2) (Nat.le_of_ble_eq_true h2)))
  have h' := List.all_eq_true.mp h b.1 (portsJ_ok j b.1)
  rw [Bool.or_eq_true] at h'
  rcases h' with h' | h'
  · exact hzF h'
  · obtain ⟨e, he, ek, hm⟩ := mem_idxT (subS_mem _ _ h' i2 hi2)
    have hf := AllL.mem (Tab.all_mem hbad e he) i2 hm
    rw [ek] at hf
    exact (hf hc1 hc2').elim
/-- `esc_of_pairs` with its table check needed only below `nR` (the escape table's last leaf may
    be a rule's). -/
theorem esc_of_pairsB (u : St → Nat → V) (ops : Ops V) (E : EqC V) (L : List (Nat × Nat))
    (hL : ∀ p ∈ L, ∀ oc w, Env (P ops E u) oc w → fire ops E oc w (rR p.1) = true → fire ops E oc w (rR p.2) = true →
      OkT (P ops E u) (trR (P ops E u) oc (rR p.1)).1 (trR (P ops E u) oc (rR p.2)).1)
    (hinj : ∀ p ∈ L, ∀ x1, x1 < D.nR → D.rc x1 = D.rc p.1 → x1 = p.1)
    (hT : ∀ i, i < D.nR → Sub (D.escR.get i) (bits ((L.filter (fun p => p.2 == i)).map (fun p => D.rc p.1)))) :
    ∀ oc w r1 r2, Env (P ops E u) oc w → (D.escR.get ((G ops E u).rk r2)).testBit (D.rc ((G ops E u).rk r1)) = true →
      fire ops E oc w r1 = true → fire ops E oc w r2 = true → OkT (P ops E u) (trR (P ops E u) oc r1).1 (trR (P ops E u) oc r2).1 := by
  intro oc w r1 r2 hE hb f1 f2
  obtain ⟨p, hp, e⟩ := List.mem_map.mp (mem_of_testBit_bits (hT _ r2.isLt _ hb))
  have hp' := List.mem_filter.mp hp
  have e2 : p.2 = r2.val := beq_iff_eq.mp hp'.2
  have e1 : r1.val = p.1 := hinj p hp'.1 _ r1.isLt e.symm
  have h := hL p hp'.1 oc w hE (by rw [← e1, rR_val]; exact f1) (by rw [e2, rR_val]; exact f2)
  rw [← e1, e2, rR_val, rR_val] at h
  exact h

def escB_0 : Tab (Nat × List Nat) :=
  (.leaf ((3, [2])))
theorem escChkS_0 : Tab.allB (fun i p => (isT p.1.1 && Nat.blt (tnum p.1.1 p.2) 0) || (portsJ p.1).all (fun b => okP p.1 p.2 b || subS (idxT (usesAt ⟨p.1, b⟩) 1) (idxT escB_0 i))) key_0 0 8 = true := by decide +kernel
theorem escChk_0 : Tab.allB (fun i p => (isT p.1.1 && Nat.blt (tnum p.1.1 p.2) 0) || (portsJ p.1).all (fun b => okP p.1 p.2 b || subS (idxT (usesAt ⟨p.1, b⟩) 1) (idxT escB_0 i))) (keyT.get 0) 0 (kT.get 0) = true := escChkS_0
theorem escT2S_0 : Tab.allB (fun _ p => !isT p.1.1 || Nat.ble 0 (tnum p.1.1 p.2)) key_1 0 7 = true := by decide +kernel
theorem escT2_0 : Tab.allB (fun _ p => !isT p.1.1 || Nat.ble 0 (tnum p.1.1 p.2)) (keyT.get 1) 0 (kT.get 1) = true := escT2S_0
theorem esc_0 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V)
    (hE : Env (P ops E u) oc w) (f1 : fire ops E oc w (rR 0) = true) (f2 : fire ops E oc w (rR 1) = true) :
    OkT (P ops E u) (trR (P ops E u) oc (rR 0)).1 (trR (P ops E u) oc (rR 1)).1 := by
  have hz1 := zR_ok ops E u oc (rR 0)
  have hz2 := zR_ok ops E u oc (rR 1)
  rw [trR_eq] at hz1 hz2 ⊢
  rw [trR_eq]
  exact okT_exceptZ ops.z _ _ (siteR ops E (rR 0).val) (siteR ops E (rR 1).val)
    (kR (rR 0).val) (kR (rR 1).val) (keyT.get (rR 0).val) (keyT.get (rR 1).val) (fun _ => rfl) (fun _ => rfl)
    (idx (.inr (rR 1))) (hchk (rR 1)) escB_0 0 hz1 hz2 escChk_0 escT2_0
    ⟨fun h1 h2 => hy.g0.esc_0 oc hE.1 f1 f2 ((congrArg (ops.g 0) (ev_0_1 ops E (u (.inr (rR 0))) oc ops.z)).symm.trans h1) ((congrArg (ops.g 6) (ev_1_0 ops E (u (.inr (rR 1))) oc ops.z)).symm.trans h2), trivial⟩
def escB_1 : Tab (Nat × List Nat) :=
  (.node 7 (.node 6 (.leaf ((5, [1])))
  (.leaf ((6, [2]))))
  (.node 8 (.leaf ((7, [3])))
  (.leaf ((8, [4])))))
theorem escChkS_1 : Tab.allB (fun i p => (isT p.1.1 && Nat.blt (tnum p.1.1 p.2) 1) || (portsJ p.1).all (fun b => okP p.1 p.2 b || subS (idxT (usesAt ⟨p.1, b⟩) 3) (idxT escB_1 i))) key_2 0 18 = true := by decide +kernel
theorem escChk_1 : Tab.allB (fun i p => (isT p.1.1 && Nat.blt (tnum p.1.1 p.2) 1) || (portsJ p.1).all (fun b => okP p.1 p.2 b || subS (idxT (usesAt ⟨p.1, b⟩) 3) (idxT escB_1 i))) (keyT.get 2) 0 (kT.get 2) = true := escChkS_1
theorem escT2S_1 : Tab.allB (fun _ p => !isT p.1.1 || Nat.ble 1 (tnum p.1.1 p.2)) key_3 0 22 = true := by decide +kernel
theorem escT2_1 : Tab.allB (fun _ p => !isT p.1.1 || Nat.ble 1 (tnum p.1.1 p.2)) (keyT.get 3) 0 (kT.get 3) = true := escT2S_1
theorem esc_1 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V)
    (hE : Env (P ops E u) oc w) (f1 : fire ops E oc w (rR 2) = true) (f2 : fire ops E oc w (rR 3) = true) :
    OkT (P ops E u) (trR (P ops E u) oc (rR 2)).1 (trR (P ops E u) oc (rR 3)).1 := by
  have hz1 := zR_ok ops E u oc (rR 2)
  have hz2 := zR_ok ops E u oc (rR 3)
  rw [trR_eq] at hz1 hz2 ⊢
  rw [trR_eq]
  exact okT_exceptZ ops.z _ _ (siteR ops E (rR 2).val) (siteR ops E (rR 3).val)
    (kR (rR 2).val) (kR (rR 3).val) (keyT.get (rR 2).val) (keyT.get (rR 3).val) (fun _ => rfl) (fun _ => rfl)
    (idx (.inr (rR 3))) (hchk (rR 3)) escB_1 1 hz1 hz2 escChk_1 escT2_1
    ⟨⟨⟨fun h1 h2 => hy.g0.esc_1 oc f1 f2 ((congrArg (ops.g 11) (ev_2_0 ops E (u (.inr (rR 2))) oc ops.z)).symm.trans h1) ((congrArg (ops.g 25) (ev_3_0 ops E (u (.inr (rR 3))) oc ops.z)).symm.trans h2), trivial⟩,
  ⟨fun h1 h2 => hy.g0.esc_2 oc f1 f2 ((congrArg (ops.g 12) (ev_2_0 ops E (u (.inr (rR 2))) oc ops.z)).symm.trans h1) ((congrArg (ops.g 26) (ev_3_0 ops E (u (.inr (rR 3))) oc ops.z)).symm.trans h2), trivial⟩⟩,
  ⟨⟨fun h1 h2 => hy.g0.esc_3 oc f1 f2 ((congrArg (ops.g 13) (ev_2_0 ops E (u (.inr (rR 2))) oc ops.z)).symm.trans h1) ((congrArg (ops.g 27) (ev_3_0 ops E (u (.inr (rR 3))) oc ops.z)).symm.trans h2), trivial⟩,
  ⟨fun h1 h2 => hy.g0.esc_4 oc f1 f2 ((congrArg (ops.g 14) (ev_2_0 ops E (u (.inr (rR 2))) oc ops.z)).symm.trans h1) ((congrArg (ops.g 28) (ev_3_0 ops E (u (.inr (rR 3))) oc ops.z)).symm.trans h2), trivial⟩⟩⟩
def escL : List (Nat × Nat) := [(0, 1), (2, 3)]
def escMemT : Tab (List Nat) :=
  (.leaf ([0, 2]))
theorem escInj : ∀ p ∈ escL, ∀ x1, x1 < D.nR → D.rc x1 = D.rc p.1 → x1 = p.1 := by
  have h := chains_inj D rinvT.get escMemT 1 (by decide +kernel) (by decide +kernel)
  intro p hp
  exact h 0 (by decide) p.1 (by revert p hp; decide)
theorem escTab : Tab.allB (fun i n => subB n (bits ((escL.filter (fun p => p.2 == i)).map (fun p => D.rc p.1)))) escRT 0 nR = true := by
  decide +kernel
theorem escT_ok : ∀ i, i < D.nR → Sub (D.escR.get i) (bits ((escL.filter (fun p => p.2 == i)).map (fun p => D.rc p.1))) :=
  fun i hi => sub_of_subB (Tab.allB_spec _ escRT 0 nR escTab i (Nat.zero_le _) hi)


theorem glueOK (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) : GlueOK (P ops E u) D (G ops E u) (fire ops E) where
  mi_lt m := m.elim
  rk_lt r := r.isLt
  rk_at r := rR_val r
  at_rk i hi := Nat.mod_eq_of_lt hi
  kind j h := by
    obtain ⟨κ, i⟩ := j
    cases κ
    · exact kind_reg _
    · exact kind_f2 _
    · exact kind_rwC _
    · simp [G, chB] at h
  kindC j h := by
    obtain ⟨κ, i⟩ := j
    cases κ
    · simp [G, chB] at h
    · simp [G, chB] at h
    · simp [G, chB] at h
    · exact kindOut_chain (fun _ => rfl) (by show (0 : Nat) ∈ [0]; simp) (by show (0 : Nat) ∈ [0]; simp)
  chAnn j h a b hlt := by
    obtain ⟨κ, i⟩ := j
    cases κ
    · simp [G, chB] at h
    · simp [G, chB] at h
    · simp [G, chB] at h
    · exact taskAnn_group hlt
  cmono g1 g2 h := cmonoG g1 g2 h
  cinM _ _ m := m.elim
  cinR oc r := by
    rw [trR_eq]
    have hc := chain_in_of_sites (G ops E u) (envR ops E (u (.inr r)) oc r.val) _ _ _ (chainS ops E u r.val (rlt r) ops.z).1
    have e0 : Nat.blt r.val nR = true := Nat.blt_eq.mpr r.isLt
    simp only [e0, cond_true] at hc
    intro c hcm hch
    have := hc c hcm hch
    show cloG (D.nM + r.val) ≤ _ ∧ _ < chiG (D.nM + r.val)
    rw [cloG_r, chiG_r]
    exact this
  cincM _ _ m := m.elim
  cincR oc r := by
    rw [trR_eq]
    exact chain_inc_of_sites (G ops E u) _ _ (chainS ops E u r.val (rlt r) ops.z).2
  chCode j h p := by
    obtain ⟨κ, i⟩ := j
    cases κ
    · simp [G, chB] at h
    · simp [G, chB] at h
    · simp [G, chB] at h
    · rfl
  fpM _ _ m := m.elim
  fpR oc r := fpR_ok ops E u oc r
  zM _ _ m := m.elim
  zR oc r := zR_ok ops E u oc r
  nfI m := m.elim
  nfO m := m.elim
  ngI m := m.elim
  ngO m := m.elim
  h3ok m := m.elim
  exM _ _ m := m.elim
  exR := exR_of_cmask (P ops E u) (G ops E u) (fire ops E) (fun r => r.isLt) rR_val memT gidT cmT ng
    (chT ops E u hy) hcm_ok hg_ok hinj_ok hT_ok
  exMR _ _ m := m.elim
  esc := esc_of_pairsB u ops E escL (fun p hp => AllL.mem (show AllL (fun p : Nat × Nat => ∀ oc w, Env (P ops E u) oc w → fire ops E oc w (rR p.1) = true → fire ops E oc w (rR p.2) = true → OkT (P ops E u) (trR (P ops E u) oc (rR p.1)).1 (trR (P ops E u) oc (rR p.2)).1) escL from ⟨esc_0 ops E hy u, esc_1 ops E hy u, trivial⟩) p hp) escInj escT_ok

/-- **The pair fields, from the scan.** -/
def pairs (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) : PairFacts (P ops E u) (G ops E u).rules (fire ops E) :=
  pairFacts_of_scan (P ops E u) scanOK (G ops E u) (fire ops E) (glueOK ops E hy u)
end

def vbRegT : Tab Nat :=
  (.node 4 (.node 2 (.node 1 (.leaf (0))
  (.leaf (0)))
  (.node 3 (.leaf (0))
  (.leaf (0))))
  (.node 6 (.node 5 (.leaf (0))
  (.leaf (0)))
  (.node 7 (.leaf (0))
  (.node 8 (.leaf (0))
  (.leaf (102))))))
/-! ## Last caller: the ports, their virtual scan slots, the order facts -/

/-- The last-caller ports: self-SBR primitive write ports two callers may drive in one cycle. -/
def lcK : (κ : Kind) → Nat → (KI κ).M → Bool
  | .reg => fun i m => match m with | .wr _ => [8].contains i | .rd _ => false
  | .f2 => fun _ _ => false
  | .rwC => fun _ _ => false
  | .tasks => fun _ _ => false
def lcJ (j : I) (cm : (CI j).M) : Bool := lcK j.1 j.2.val cm
/-- Each last-caller port's virtual slot (one per port, after the children's). -/
def vbK : (κ : Kind) → Nat → (KI κ).M → Nat
  | .reg => fun i _ => vbRegT.get i
  | .f2 => fun _ _ => 0
  | .rwC => fun _ _ => 0
  | .tasks => fun _ _ => 0
def vbJ (j : I) (cm : (CI j).M) : Nat := vbK j.1 j.2.val cm
abbrev κv : Nat := 4
theorem hkv : 0 ∈ (D.kc κv 0).cout := by decide +kernel
theorem vchk_reg : ∀ i, i < nk .reg → lcK .reg i Reg.write = true →
    (((usesK .reg).get i).us Reg.write).all (fun k => Nat.blt k nR && (virtT.get k).contains (vbK .reg i Reg.write, κv, 0)) = true := by
  decide +kernel
theorem vchk (j : I) (cm : (CI j).M) (hl : lcJ j cm = true) :
    (usL ⟨j, cm⟩).all (fun k => Nat.blt k nR && (virtT.get k).contains (vbJ j cm, κv, 0)) = true := by
  obtain ⟨κ, i, hi⟩ := j
  cases κ
  · revert hl
    exact regAll (Q := fun cm => lcK .reg i cm = true → (((usesK .reg).get i).us cm).all
      (fun k => Nat.blt k nR && (virtT.get k).contains (vbK .reg i cm, κv, 0)) = true)
      (fun h => absurd h (by simp [lcK])) (vchk_reg i hi) cm
  · simp [lcJ, lcK] at hl
  · simp [lcJ, lcK] at hl
  · simp [lcJ, lcK] at hl
theorem lcOk : ∀ (j : I) (cm : (CI j).M), lcJ j cm = true → (CI j).ann.sbr cm cm = true ∧ (CI j).ann.hasEn cm = true := by
  intro j cm hl
  obtain ⟨κ, i, hi⟩ := j
  cases κ
  · revert hl
    exact regAll (Q := fun cm => lcK .reg i cm = true → (KI .reg).ann.sbr cm cm = true ∧ (KI .reg).ann.hasEn cm = true)
      (fun h => absurd h (by simp [lcK])) (fun _ => ⟨by decide, by decide⟩) cm
  · simp [lcJ, lcK] at hl
  · simp [lcJ, lcK] at hl
  · simp [lcJ, lcK] at hl

/-! ## Enables and arguments: one lemma per child instance, dispatched by table -/

section
variable {V : Type}
/-- What `Cert.en` and `Cert.arg` say about child `⟨κ, i⟩` whose arm is `A`. -/
def EAQ (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) (κ : Kind) (i : Nat)
    (A : (V : Type) → Ops V → EqC V → OC V → Wires Empty V → Wires (KI κ).M V) : Prop :=
  ∀ (h : i < nk κ) (oc : OC V) (w : Wires Empty V), Env (P ops E u) oc w →
    (∀ cm : (KI κ).M, (KI κ).ann.hasEn cm = true →
      ((A V ops E oc w).en cm = true ↔ ∃ s ∈ users (⟨κ, ⟨i, h⟩⟩ : I) cm, On (P ops E u) (fire ops E) oc w s ∧
        Calls (P ops E u) (trS (P ops E u) oc w s) (⟨κ, ⟨i, h⟩⟩ : I) cm)) ∧
    (∀ cm : (KI κ).M, lcK κ i cm = false → ∀ s ∈ users (⟨κ, ⟨i, h⟩⟩ : I) cm, Av (P ops E u) (fire ops E) oc w s →
      ∀ x, (cm, x) ∈ proj (⟨κ, ⟨i, h⟩⟩ : I) (trS (P ops E u) oc w s) → (A V ops E oc w).arg cm = x) ∧
    (∀ cm : (KI κ).M, lcK κ i cm = true → ∀ s ∈ users (⟨κ, ⟨i, h⟩⟩ : I) cm, On (P ops E u) (fire ops E) oc w s →
      ∀ x, (cm, x) ∈ proj (⟨κ, ⟨i, h⟩⟩ : I) (trS (P ops E u) oc w s) →
      (∀ s' ∈ users (⟨κ, ⟨i, h⟩⟩ : I) cm, LC.lpOf (G ops E u) s < LC.lpOf (G ops E u) s' →
        On (P ops E u) (fire ops E) oc w s' → ¬ Calls (P ops E u) (trS (P ops E u) oc w s') (⟨κ, ⟨i, h⟩⟩ : I) cm) →
      (A V ops E oc w).arg cm = x)

/-- A flagged (argument-less value) port's calls carry `z`. -/
theorem zarg (ops : Ops V) (E : EqC V) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V) (j : I) (cm : (CI j).M)
    (hf : fxP ⟨j, cm⟩ = true) :
    ∀ s ∈ users j cm, Av (P ops E u) (fire ops E) oc w s → ∀ x, (cm, x) ∈ proj j (trS (P ops E u) oc w s) → ops.z = x := by
  intro s _ _ x hx
  cases s with
  | inl e => exact e.elim
  | inr r =>
    have hc := mem_proj j _ _ hx
    exact (zR_ok ops E u oc r ⟨j, (cm, x)⟩ hc hf).symm

/-- The task statements' child. -/
abbrev jT : I := ⟨.tasks, ⟨0, by decide⟩⟩
/-- Task statement `t`'s enable and argument facts (its one user). -/
def TQ (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) (t : Nat) (f : (V : Type) → Ops V → EqC V → OC V → Bool) : Prop :=
  ∀ (oc : OC V) (w : Wires Empty V), Env (P ops E u) oc w →
    (f V ops E oc = true ↔ ∃ s ∈ users jT (tP t), On (P ops E u) (fire ops E) oc w s ∧
      Calls (P ops E u) (trS (P ops E u) oc w s) jT (tP t)) ∧
    (∀ s ∈ users jT (tP t), Av (P ops E u) (fire ops E) oc w s →
      ∀ x, (tP t, x) ∈ proj jT (trS (P ops E u) oc w s) → (targT.get t) V ops E oc = x)

theorem tqAll (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) : Tab.AllR (TQ ops E hy u) tenT 0 nT :=
  ⟨⟨Tab.one ((have hx : idxT (((usesK .tasks).get 0).uses (tP 0)) (rR 1).val = [6] := by decide +kernel
    have hu : users jT (tP 0) = [.inr (rR 1)] := by decide +kernel
    fun oc w hE => ⟨en_one (P ops E u) (fire ops E) oc w jT (tP 0) (.inr (rR 1)) _ hu _
      (cRkIff ops E u oc w (rR 1) .tasks 0 (by decide) (tP 0) 6 hx rfl rfl) _ (en_tcf (cfA_0 ops E oc hE.1)),
    arg_users (P ops E u) (fire ops E) oc w jT (tP 0) _ _ ⟨fun hav x hx' =>
      aRk ops E u oc w (rR 1) .tasks 0 (by decide) (tP 0) 6 hx _ (fun _ => rfl) x hx', trivial⟩⟩)),
  ⟨Tab.one ((have hx : idxT (((usesK .tasks).get 0).uses (tP 1)) (rR 3).val = [18] := by decide +kernel
    have hu : users jT (tP 1) = [.inr (rR 3)] := by decide +kernel
    fun oc w hE => ⟨en_one (P ops E u) (fire ops E) oc w jT (tP 1) (.inr (rR 3)) _ hu _
      (cRkIff ops E u oc w (rR 3) .tasks 0 (by decide) (tP 1) 18 hx rfl rfl) _ (en_tcf (cfA_1 ops E oc hE.1)),
    arg_users (P ops E u) (fire ops E) oc w jT (tP 1) _ _ ⟨fun hav x hx' =>
      aRk ops E u oc w (rR 3) .tasks 0 (by decide) (tP 1) 18 hx _ (fun _ => rfl) x hx', trivial⟩⟩)),
  Tab.one ((have hx : idxT (((usesK .tasks).get 0).uses (tP 2)) (rR 3).val = [19] := by decide +kernel
    have hu : users jT (tP 2) = [.inr (rR 3)] := by decide +kernel
    fun oc w hE => ⟨en_one (P ops E u) (fire ops E) oc w jT (tP 2) (.inr (rR 3)) _ hu _
      (cRkIff ops E u oc w (rR 3) .tasks 0 (by decide) (tP 2) 19 hx rfl rfl) _ (en_tcf (cfA_2 ops E oc hE.1)),
    arg_users (P ops E u) (fire ops E) oc w jT (tP 2) _ _ ⟨fun hav x hx' =>
      aRk ops E u oc w (rR 3) .tasks 0 (by decide) (tP 2) 19 hx _ (fun _ => rfl) x hx', trivial⟩⟩))⟩⟩,
  ⟨Tab.one ((have hx : idxT (((usesK .tasks).get 0).uses (tP 3)) (rR 3).val = [20] := by decide +kernel
    have hu : users jT (tP 3) = [.inr (rR 3)] := by decide +kernel
    fun oc w hE => ⟨en_one (P ops E u) (fire ops E) oc w jT (tP 3) (.inr (rR 3)) _ hu _
      (cRkIff ops E u oc w (rR 3) .tasks 0 (by decide) (tP 3) 20 hx rfl rfl) _ (en_tcf (cfA_3 ops E oc hE.1)),
    arg_users (P ops E u) (fire ops E) oc w jT (tP 3) _ _ ⟨fun hav x hx' =>
      aRk ops E u oc w (rR 3) .tasks 0 (by decide) (tP 3) 20 hx _ (fun _ => rfl) x hx', trivial⟩⟩)),
  ⟨Tab.one ((have hx : idxT (((usesK .tasks).get 0).uses (tP 4)) (rR 3).val = [21] := by decide +kernel
    have hu : users jT (tP 4) = [.inr (rR 3)] := by decide +kernel
    fun oc w hE => ⟨en_one (P ops E u) (fire ops E) oc w jT (tP 4) (.inr (rR 3)) _ hu _
      (cRkIff ops E u oc w (rR 3) .tasks 0 (by decide) (tP 4) 21 hx rfl rfl) _ (en_tcf (cfA_4 ops E oc hE.1)),
    arg_users (P ops E u) (fire ops E) oc w jT (tP 4) _ _ ⟨fun hav x hx' =>
      aRk ops E u oc w (rR 3) .tasks 0 (by decide) (tP 4) 21 hx _ (fun _ => rfl) x hx', trivial⟩⟩)),
  Tab.one ((have hx : idxT (((usesK .tasks).get 0).uses (tP 5)) (rR 7).val = [0] := by decide +kernel
    have hu : users jT (tP 5) = [.inr (rR 7)] := by decide +kernel
    fun oc w hE => ⟨en_one (P ops E u) (fire ops E) oc w jT (tP 5) (.inr (rR 7)) _ hu _
      (cRkIff ops E u oc w (rR 7) .tasks 0 (by decide) (tP 5) 0 hx rfl rfl) _ (en_tchk (fun hw => ((Bool.and_eq_true _ _).mp (cf_of_wf hw)).2)),
    arg_users (P ops E u) (fire ops E) oc w jT (tP 5) _ _ ⟨fun hav x hx' =>
      aRk ops E u oc w (rR 7) .tasks 0 (by decide) (tP 5) 0 hx _ (fun _ => rfl) x hx', trivial⟩⟩))⟩⟩⟩
theorem ea_tasks_0 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) : EAQ ops E hy u .tasks 0 arm_tasks_0 := by
  intro h oc w hE
  refine ⟨fun cm _ => ?_, fun cm _ => ?_, fun cm hl => absurd hl (by simp [lcK])⟩
  · obtain ⟨t, ht⟩ := cm
    have e : (⟨t, ht⟩ : Fin nT) = tP t := Fin.ext (Nat.mod_eq_of_lt ht).symm
    have := (Tab.get_allR _ 0 nT (tqAll ops E hy u) t (Nat.zero_le _) ht oc w hE).1
    rw [← e] at this
    exact this
  · obtain ⟨t, ht⟩ := cm
    have e : (⟨t, ht⟩ : Fin nT) = tP t := Fin.ext (Nat.mod_eq_of_lt ht).symm
    have := (Tab.get_allR _ 0 nT (tqAll ops E hy u) t (Nat.zero_le _) ht oc w hE).2
    rw [← e] at this
    exact this

theorem ea_reg_0 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (u : St → Nat → V) : EAQ ops E hy u .reg 0 arm_reg_0 := by
  have hx_8_6_write : idxT (((usesK .reg).get 0).uses Reg.write) (rR 8).val = [6] := by decide +kernel
  intro h oc w hE
