def arg_f2_0_enq (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : V := pmux (mlist_4 V ops E oc) ops.z
def en_f2_0_deq (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [WF ops E oc 9]
def en_rwC_0_wset (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [WF ops E oc 0]
