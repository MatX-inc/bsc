theorem hqT (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : Tab.AllR (HQT ops E hy) sfT 0 nS :=
  ⟨⟨⟨Tab.one (hq_0 ops E hy),
  Tab.one (hq_1 ops E hy)⟩,
  ⟨Tab.one (hq_2 ops E hy),
  ⟨Tab.one (hq_3 ops E hy),
