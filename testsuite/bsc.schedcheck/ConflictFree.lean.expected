  fun hR => ⟨congrArg orL (congr2 List.cons (agWF_3 ops E hR rfl) (rfl)), rfl⟩
theorem dqAll_rwC (ops : Ops V) (E : EqC V) : Tab.AllR (DQ_rwC ops E) arms_rwC 0 25 :=
  ⟨⟨⟨⟨Tab.one (dq_rwC_0 ops E),
  ⟨Tab.one (dq_rwC_1 ops E),
  Tab.one (dq_rwC_2 ops E)⟩⟩,
  ⟨Tab.one (dq_rwC_3 ops E),
  ⟨Tab.one (dq_rwC_4 ops E),
  Tab.one (dq_rwC_5 ops E)⟩⟩⟩,
  ⟨⟨Tab.one (dq_rwC_6 ops E),
  ⟨Tab.one (dq_rwC_7 ops E),
  Tab.one (dq_rwC_8 ops E)⟩⟩,
  ⟨Tab.one (dq_rwC_9 ops E),
  ⟨Tab.one (dq_rwC_10 ops E),
  Tab.one (dq_rwC_11 ops E)⟩⟩⟩⟩,
  ⟨⟨⟨Tab.one (dq_rwC_12 ops E),
  ⟨Tab.one (dq_rwC_13 ops E),
  Tab.one (dq_rwC_14 ops E)⟩⟩,
  ⟨Tab.one (dq_rwC_15 ops E),
  ⟨Tab.one (dq_rwC_16 ops E),
  Tab.one (dq_rwC_17 ops E)⟩⟩⟩,
  ⟨⟨Tab.one (dq_rwC_18 ops E),
  ⟨Tab.one (dq_rwC_19 ops E),
  Tab.one (dq_rwC_20 ops E)⟩⟩,
  ⟨⟨Tab.one (dq_rwC_21 ops E),
  Tab.one (dq_rwC_22 ops E)⟩,
  ⟨Tab.one (dq_rwC_23 ops E),
  Tab.one (dq_rwC_24 ops E)⟩⟩⟩⟩⟩
end

theorem rkB_rwC : Tab.allB (fun _ b => Nat.blt b 2) bnd_rwC 0 (nk .rwC) = true := by decide +kernel

section
variable {V : Type}
def acyc (ops : Ops V) (E : EqC V) : Acyc (F ops E).base where
  D j p := DK j.1 j.2.val p
  Dw _ _ := []
  Do e := e.elim
  Dwo e := e.elim
  dep oc oc' w w' j p hD hW := by
    obtain ⟨κ, i, hi⟩ := j
    cases κ with
    | reg => exact dep_of_all (F ops E).base allOuts mem_allOuts allIns mem_allIns oc oc' w w' hD hW _ _
    | f2 => exact dep_of_all (F ops E).base allOuts mem_allOuts allIns mem_allIns oc oc' w w' hD hW _ _
    | rwC =>
      cases p with
      | wset => exact (Tab.get_allR _ 0 _ (dqAll_rwC ops E) i (Nat.zero_le _) hi hi oc oc' w w') (forall_filter allOuts mem_allOuts _ hD)
      | wget => exact dep_of_all (F ops E).base allOuts mem_allOuts allIns mem_allIns oc oc' w w' hD hW _ _
      | whas => exact dep_of_all (F ops E).base allOuts mem_allOuts allIns mem_allIns oc oc' w w' hD hW _ _
    | tasks => exact dep_of_all (F ops E).base allOuts mem_allOuts allIns mem_allIns oc oc' w w' hD hW _ _
  depo _ _ _ _ q := q.elim
  rk := rk
  N := 2
  rk_lt y := by
    obtain ⟨⟨κ, i, hi⟩, m⟩ := y
    cases κ with
    | reg => exact Nat.zero_lt_succ _
    | f2 => exact Nat.zero_lt_succ _
    | rwC =>
      have hb := Tab.allB_spec _ bnd_rwC 0 (nk .rwC) rkB_rwC i (Nat.zero_le _) hi
      cases m <;> first | exact Nat.zero_lt_succ _ | exact Nat.blt_eq.mp hb
    | tasks => exact Nat.zero_lt_succ _
  rk_ok j q p hpq y hy := by
    obtain ⟨κ, i, hi⟩ := j
    cases κ with
    | reg => rw [reg_nopath] at hpq; cases hpq
    | f2 => cases hpq
    | rwC => cases p <;> cases q <;> first | exact blt_true (List.mem_filter.mp hy).2 | cases hpq
    | tasks => cases hpq
  reach _ := []
  reach_w _ _ _ _ _ hp := by cases hp
  reach_o _ _ _ _ _ _ _ hp := by cases hp
  path_w q := q.elim
  path_o q := q.elim
end

/-! ## The built module and its top theorem -/

/-- No assumed leaf: every child is a library model with a proved contract. -/
structure Leaves (V : Type) (toB : V → Bool) where
  dummy : Unit := ()

section
variable {V : Type}
def implK (ops : Ops V) (lv : Leaves V ops.toB) : (κ : Kind) → Module V (KI κ)

  | .reg => Reg
  | .f2 => FIFO2 ops.ofBool
  | .rwC => RWire ops.ofBool true false
  | .tasks => Tasks nT

theorem built [Inhabited V] (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (lv : Leaves V ops.toB) :
    Built X ((F ops E).toModuleU (fun j => (implK ops lv j.1).toU)) :=
  Built.node (F ops E) (fun j => (implK ops lv j.1).toU)
    (fun ⟨κ, _⟩ => by
      cases κ
      · exact Built.leaf _ reg_realizes (creg_causal 1)
      · exact Built.leaf _ (fifo2_realizes _) (fifo2_causal _)
      · exact Built.leaf _ (rwire_realizes _ _ _) (rwire_causal _ _ _)
      · exact Built.leaf _ (tasks_realizes nT) (tasks_causal nT)
    )
    (fun ⟨κ, _⟩ => by
      cases κ
      · exact aliased_of_none _ _ (fun p q => rfl) (fun a p => rfl)
      · exact (fifo2_aliased ops.ofBool ops.toB hy.tob).toU
      · exact aliased_of_none _ _ (fun p q => by cases p <;> cases q <;> rfl) (fun a p => by cases a <;> cases p <;> rfl)
      · exact aliased_of_none _ _ (fun p q => rfl) (fun a p => rfl)
    )
    (obl ops E hy) (acyc ops E)

/-- **The module's top theorem**: the contract, with the run fixed before every skipped value
    of the tree, and every input has a hardware cycle. -/
theorem top [Inhabited V] (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (lv : Leaves V ops.toB) :
    RealizesU ((F ops E).toModuleU (fun j => (implK ops lv j.1).toU)) ∧
    ∀ s w, ((F ops E).toModuleU (fun j => (implK ops lv j.1).toU)).clean s = s → ∃ o s' g, ((F ops E).toModuleU (fun j => (implK ops lv j.1).toU)).hw s w o s' g :=
  (built ops E hy lv).top
end

end
end ConflictFree

#print axioms ConflictFree.obl
#print axioms ConflictFree.top


