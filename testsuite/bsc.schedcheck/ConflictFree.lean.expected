  ⟨Tab.one (hq_8 ops E hy),
  Tab.one (hq_9 ops E hy)⟩⟩⟩⟩
/-- A step that may run makes the same calls at any two skipped values of its step. -/
theorem trUS (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (oc : OC V) (k : Nat) (hk : k < nS) (v v' : Nat → V) (x : V)
    (hf : PRE ops E oc k = true) :
    callsOf (envS ops E v oc k x) (sitesF (siteS ops E k x) (kR k)) = callsOf (envS ops E v' oc k x) (sitesF (siteS ops E k x) (kR k)) :=
  callsOf_fn_congr _ _ _ _ (fun i hi =>
    Tab.get_allR _ 0 (kR k) (Tab.get_allR _ 0 nS (hqT ops E hy) k (Nat.zero_le _) hk) i (Nat.zero_le _) hi oc v v' x hf)
end

section
variable {V : Type}
theorem rd_at {oc : OC V} {k : Nat} (h : RD oc k = true) (i : Nat) (hi : i < kR k)
    (ha : alwaysRdyB ((keyT.get k).get i) = false) (hu : (ucT.get k).testBit i = false) :
    (oc ((keyT.get k).get i).1).rdy ((keyT.get k).get i).2 = true := by
  unfold RD at h
  have h2 := List.all_eq_true.mp h i (List.mem_range'.mpr ⟨i, hi, by omega⟩)
  simp only [ha, hu, Bool.false_or] at h2
  exact h2
theorem rdy_of_rdc {c c' r : Bool} (h : (!c || r) = true) (hc : c' = true) (e : c' = c) : r = true := by
  subst e; rw [hc] at h; simpa using h
/-- A taken guarded site of step `k` is ready: from CAN_FIRE (unconditional), from the guard's
    lifted readiness (a conditional call), or from the child's alias (a readiness read). -/
def RY (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (k i : Nat) (F : (V : Type) → Ops V → EqC V → V → SF V) : Prop :=
  ∀ (oc : OC V) (v : Nat → V) (x : V), (∀ j, AliasOK ops.toB (CI j).ann (oc j)) → PRE ops E oc k = true →
    (F V ops E x).1 (envS ops E v oc k x) = true → alwaysRdyB ((keyT.get k).get i) = false →
    (oc ((keyT.get k).get i).1).rdy ((keyT.get k).get i).2 = true
def RYT (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (k : Nat) (t : Tab ((V : Type) → Ops V → EqC V → V → SF V)) : Prop :=
  Tab.AllR (RY ops E hy k) t 0 (kT.get k)

theorem ry_0 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : RYT ops E hy 0 sf_0 :=
  ⟨⟨⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩,
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun oc v x _ hf hc ha => rdy_of_rdc (((Bool.and_eq_true _ _).mp ((Bool.and_eq_true _ _).mp (g_of_cf (cf_of_wf hf))).2).1) hc (congrArg (ops.g 0) (ev_0_1 ops E v oc x)))⟩⟩,
  ⟨⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩,
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩⟩⟩
theorem ry_1 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : RYT ops E hy 1 sf_1 :=
  ⟨⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun oc v x _ hf hc ha => rdy_of_rdc (((Bool.and_eq_true _ _).mp ((Bool.and_eq_true _ _).mp (g_of_cf (cf_of_wf hf))).2).1) hc (congrArg (ops.g 6) (ev_1_0 ops E v oc x)))⟩⟩,
  ⟨⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩,
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩⟩⟩
