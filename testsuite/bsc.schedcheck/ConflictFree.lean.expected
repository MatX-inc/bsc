def lcT_0 : Tab ((V : Type) → Ops V → EqC V → OC V → Bool × V) :=
  (.node 1 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => ((WF ops E oc 6, ops.f 16 ((oc (iReg 8)).ret Reg.read)) : Bool × V)))
  (.node 2 (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => ((WF ops E oc 5, ops.f 0 ((oc (iReg 2)).ret Reg.read)) : Bool × V)))
  (.leaf (fun V (ops : Ops V) (E : EqC V) (oc : OC V) => ((WF ops E oc 4, ops.f 15 ((oc (iReg 8)).ret Reg.read)) : Bool × V)))))
def lcsT_0 : Tab Nat :=
  (.node 1 (.leaf (6))
  (.node 2 (.leaf (5))
  (.leaf (4))))
def lclist_0 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) : List (Bool × V) :=
