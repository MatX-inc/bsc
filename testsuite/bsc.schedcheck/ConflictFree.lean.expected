def arg_rwC_10_wset (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : V := ops.f 6 ((oc (iReg 7)).ret Reg.read)
def en_rwC_11_wset (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [WF ops E oc 2]
def arg_rwC_11_wset (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : V := ops.k 5
def en_rwC_12_wset (ops : Ops V) (E : EqC V) (oc : OC V) (w : Wires Empty V) : Bool := orL [WF ops E oc 2]
