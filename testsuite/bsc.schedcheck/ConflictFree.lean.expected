  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩⟩⟩,
  ⟨⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩⟩,
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩⟩⟩⟩⟩
theorem ry_4 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : RYT ops E hy 4 sf_4 :=
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩⟩
theorem ry_5 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : RYT ops E hy 5 sf_5 :=
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩⟩
theorem ry_6 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : RYT ops E hy 6 sf_6 :=
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩⟩
theorem ry_7 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : RYT ops E hy 7 sf_7 :=
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))
theorem ry_8 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : RYT ops E hy 8 sf_8 :=
  ⟨⟨⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩,
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩⟩,
  ⟨⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩,
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide))⟩⟩⟩
theorem ry_9 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : RYT ops E hy 9 sf_9 :=
  ⟨Tab.one (fun _ _ _ _ _ _ ha => absurd ha (by decide)),
  Tab.one (fun oc v x _ hf _ ha => rd_at (rd_of_cf (cf_of_wf hf)) 1 (by decide) ha (by decide))⟩
theorem ryT (ops : Ops V) (E : EqC V) (hy : Hyps ops E) : Tab.AllR (RYT ops E hy) sfT 0 nS :=
  ⟨⟨⟨Tab.one (ry_0 ops E hy),
  Tab.one (ry_1 ops E hy)⟩,
  ⟨Tab.one (ry_2 ops E hy),
  ⟨Tab.one (ry_3 ops E hy),
  Tab.one (ry_4 ops E hy)⟩⟩⟩,
  ⟨⟨Tab.one (ry_5 ops E hy),
  Tab.one (ry_6 ops E hy)⟩,
  ⟨Tab.one (ry_7 ops E hy),
  ⟨Tab.one (ry_8 ops E hy),
  Tab.one (ry_9 ops E hy)⟩⟩⟩⟩
theorem rdyS (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (oc : OC V) (k : Nat) (hk : k < nS) (v : Nat → V) (x : V)
    (hal : ∀ j, AliasOK ops.toB (CI j).ann (oc j)) (hf : PRE ops E oc k = true) :
    ∀ c ∈ callsOf (envS ops E v oc k x) (sitesF (siteS ops E k x) (kR k)),
      (CI c.1).ann.alwaysRdy c.2.1 = false → (oc c.1).rdy c.2.1 = true := by
  intro c hc ha
  obtain ⟨s, hs, hcs, rfl⟩ := mem_callsOf_inv _ _ c hc
  obtain ⟨i, hi, rfl⟩ := mem_sitesF hs
  exact Tab.get_allR _ 0 (kR k) (Tab.get_allR _ 0 nS (ryT ops E hy) k (Nat.zero_le _) hk) i (Nat.zero_le _) hi oc v x hal hf hcs ha
end

/-! ## Decided checks over closed tables -/

/-- A check over each step's sites (steps without sites pass). -/
theorem sitesB_spec (f : Nat → Nat → (Σ j : I, (CI j).M) → Bool)
    (h : Tab.allB (fun k keys => Nat.beq (kT.get k) 0 || Tab.allB (f k) keys 0 (kT.get k)) keyT 0 nS = true)
    (k : Nat) (hk : k < nS) : ∀ i, i < kR k → f k i ((keyT.get k).get i) = true := by
  intro i hi
  have h1 := Tab.allB_spec _ keyT 0 nS h k (Nat.zero_le _) hk
  simp only [Bool.or_eq_true] at h1
  rcases h1 with h1 | h1
  · have := Nat.eq_of_beq_eq_true h1; simp only [kR] at hi; omega
  · exact Tab.allB_spec _ _ 0 (kT.get k) h1 i (Nat.zero_le _) hi

theorem chkAll : Tab.allB (fun k keys => Nat.beq (kT.get k) 0 ||
    Tab.allB (fun i p => (idxT (usesAt p) k).contains i) keys 0 (kT.get k)) keyT 0 nS = true := by decide +kernel
theorem hchkT (k : Nat) (hk : k < nS) : ∀ i, i < kR k → i ∈ idxT (usesAt ((keyT.get k).get i)) k := by
  intro i hi
  have h := sitesB_spec (fun k i p => (idxT (usesAt p) k).contains i) chkAll k hk i hi
  simpa using h
theorem hchk (r : Fin nR) : ∀ i, i < kR r.val → i ∈ idx (.inr r) ((keyT.get r.val).get i) :=
  hchkT r.val (rlt r)

section
variable {V : Type}

theorem onIff (ops : Ops V) (E : EqC V) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V) :
    ∀ s, On (P ops E u) (fire ops E) oc w s ↔ stepOn ops E oc s = true := by
  intro s; cases s with
  | inl e => exact e.elim
  | inr r => exact Iff.rfl

/-- A rule's site on a port: the rule calls the port when the site's condition holds. -/
theorem cR (ops : Ops V) (E : EqC V) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V) (r : Fin nR) (j : I) (cm : (CI j).M)
    (i0 : Nat) (hidx : idx (.inr r) ⟨j, cm⟩ = [i0]) (hi0 : Nat.blt i0 (kR r.val) = true)
    (hk0 : (keyT.get r.val).get i0 = ⟨j, cm⟩) (hc : (siteR ops E r.val i0).cond (envR ops E (u (.inr r)) oc r.val) = true) :
    Calls (P ops E u) (trS (P ops E u) oc w (.inr r)) j cm := by
  show ∃ x, (cm, x) ∈ proj j (trS (P ops E u) oc w (.inr r))
  rw [trS_eq]
  exact (calls_one _ (siteR ops E r.val) (kR r.val) (keyT.get r.val).get (fun _ => rfl) (idx (.inr r)) (hchk r) j cm i0
    hidx hi0 hk0).mpr hc
theorem cRk (ops : Ops V) (E : EqC V) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V) (r : Fin nR) (κ : Kind) (i : Nat)
    (hi : i < nk κ) (cm : (KI κ).M) (i0 : Nat) (hidx : idxT (((usesK κ).get i).uses cm) r.val = [i0])
    (hi0 : Nat.blt i0 (kR r.val) = true) (hk0 : (keyT.get r.val).get i0 = ⟨⟨κ, ⟨i, hi⟩⟩, cm⟩)
    (hc : (siteR ops E r.val i0).cond (envR ops E (u (.inr r)) oc r.val) = true) :
    Calls (P ops E u) (trS (P ops E u) oc w (.inr r)) ⟨κ, ⟨i, hi⟩⟩ cm :=
  cR ops E u oc w r ⟨κ, ⟨i, hi⟩⟩ cm i0 hidx hi0 hk0 hc
theorem aR (ops : Ops V) (E : EqC V) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V) (r : Fin nR) (j : I) (cm : (CI j).M)
    (i0 : Nat) (hidx : idx (.inr r) ⟨j, cm⟩ = [i0]) (v : V)
    (hv : (siteR ops E r.val i0).cond (envR ops E (u (.inr r)) oc r.val) = true → (siteR ops E r.val i0).arg (envR ops E (u (.inr r)) oc r.val) = v)
    (x : V) (hx : (cm, x) ∈ proj j (trS (P ops E u) oc w (.inr r))) : v = x := by
  rw [trS_eq] at hx
  exact arg_one _ (siteR ops E r.val) (kR r.val) (keyT.get r.val).get (fun _ => rfl) (idx (.inr r)) (hchk r) j cm i0 hidx v hv x hx
theorem aRk (ops : Ops V) (E : EqC V) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V) (r : Fin nR) (κ : Kind) (i : Nat)
    (hi : i < nk κ) (cm : (KI κ).M) (i0 : Nat) (hidx : idxT (((usesK κ).get i).uses cm) r.val = [i0]) (v : V)
    (hv : (siteR ops E r.val i0).cond (envR ops E (u (.inr r)) oc r.val) = true → (siteR ops E r.val i0).arg (envR ops E (u (.inr r)) oc r.val) = v)
    (x : V) (hx : (cm, x) ∈ proj (⟨κ, ⟨i, hi⟩⟩ : I) (trS (P ops E u) oc w (.inr r))) : v = x :=
  aR ops E u oc w r ⟨κ, ⟨i, hi⟩⟩ cm i0 hidx v hv x hx
theorem cRkIff (ops : Ops V) (E : EqC V) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V) (r : Fin nR) (κ : Kind)
    (i : Nat) (hi : i < nk κ) (cm : (KI κ).M) (i0 : Nat) (hidx : idxT (((usesK κ).get i).uses cm) r.val = [i0])
    (hi0 : Nat.blt i0 (kR r.val) = true) (hk0 : (keyT.get r.val).get i0 = ⟨⟨κ, ⟨i, hi⟩⟩, cm⟩) :
    Calls (P ops E u) (trS (P ops E u) oc w (.inr r)) ⟨κ, ⟨i, hi⟩⟩ cm ↔
      (siteR ops E r.val i0).cond (envR ops E (u (.inr r)) oc r.val) = true := by
  show (∃ x, (cm, x) ∈ proj (⟨κ, ⟨i, hi⟩⟩ : I) (trS (P ops E u) oc w (.inr r))) ↔ _
  rw [trS_eq]
  exact calls_one _ (siteR ops E r.val) (kR r.val) (keyT.get r.val).get (fun _ => rfl) (idx (.inr r)) (hchk r)
    (⟨κ, ⟨i, hi⟩⟩ : I) cm i0 hidx hi0 hk0
/-- A rule's call on a port was made: its site's condition held. -/
theorem aRkC (ops : Ops V) (E : EqC V) (u : St → Nat → V) (oc : OC V) (w : Wires Empty V) (r : Fin nR) (κ : Kind) (i : Nat)
    (hi : i < nk κ) (cm : (KI κ).M) (i0 : Nat) (hidx : idxT (((usesK κ).get i).uses cm) r.val = [i0])
    (x : V) (hx : (cm, x) ∈ proj (⟨κ, ⟨i, hi⟩⟩ : I) (trS (P ops E u) oc w (.inr r))) :
    (siteR ops E r.val i0).cond (envR ops E (u (.inr r)) oc r.val) = true := by
  rw [trS_eq] at hx
  obtain ⟨i', hi', hc, -⟩ := mem_proj_fn _ (siteR ops E r.val) (kR r.val) (keyT.get r.val).get (fun _ => rfl) (idx (.inr r))
    (hchk r) (⟨κ, ⟨i, hi⟩⟩ : I) cm x hx
  have e : idx (.inr r) ⟨⟨κ, ⟨i, hi⟩⟩, cm⟩ = [i0] := hidx
  rw [e, List.mem_singleton] at hi'
  subst hi'
  exact hc
end

/-! ## The muxes' one-hot chains, from the exclusions -/

section
variable {V : Type}

/-- A run-time check excludes its head with every rule of its list. -/
theorem chkC (ops : Ops V) (E : EqC V) (oc : OC V) (hA : asmP ops E oc) (c : Nat) (hc : Nat.blt c nC = true) :
    ∀ y ∈ chkLst.get c, WF ops E oc (chkHead.get c) = true → WF ops E oc y = true → False :=
  forall_of_check (hA.2.1 c hc)

def selq_0 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) (k : Nat) : Bool :=
  bif Nat.beq k 2 then (WF ops E oc 2 && ops.g 11 ((oc (iReg 7)).ret Reg.read)) else bif Nat.beq k 3 then (WF ops E oc 3 && ops.g 29 ((oc (iReg 7)).ret Reg.read)) else false
def msT_0 : Tab (Nat × Nat) :=
  (.node 1 (.leaf ((2, cvS [] [3])))
  (.leaf ((3, cvS [] []))))
theorem chain_0 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (oc : OC V) (hA : asmP ops E oc) :
    amoChain false ((mlist_0 V ops E oc).map Prod.fst) :=
  amoChain_of_cover (fun k => selq_0 V ops E oc k) (fun x y => selq_0 V ops E oc x = true → selq_0 V ops E oc y = true → False)
    (fun _ _ h => h) msT_0 [2, 3] (by decide +kernel) (by decide +kernel)
    ⟨cover_of (fun y hy => absurd hy (List.not_mem_nil)) ⟨fun h1 h2 => hy.g0.cx_0 oc hA ((Bool.and_eq_true _ _).mp h1).1 ((Bool.and_eq_true _ _).mp h1).2 ((Bool.and_eq_true _ _).mp h2).1 ((Bool.and_eq_true _ _).mp h2).2, trivial⟩,
  cover_of (fun y hy => absurd hy (List.not_mem_nil)) trivial⟩
def selq_1 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) (k : Nat) : Bool :=
  bif Nat.beq k 2 then (WF ops E oc 2 && ops.g 12 ((oc (iReg 7)).ret Reg.read)) else bif Nat.beq k 3 then (WF ops E oc 3 && ops.g 30 ((oc (iReg 7)).ret Reg.read)) else false
def msT_1 : Tab (Nat × Nat) :=
  (.node 1 (.leaf ((2, cvS [] [3])))
  (.leaf ((3, cvS [] []))))
theorem chain_1 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (oc : OC V) (hA : asmP ops E oc) :
    amoChain false ((mlist_1 V ops E oc).map Prod.fst) :=
  amoChain_of_cover (fun k => selq_1 V ops E oc k) (fun x y => selq_1 V ops E oc x = true → selq_1 V ops E oc y = true → False)
    (fun _ _ h => h) msT_1 [2, 3] (by decide +kernel) (by decide +kernel)
    ⟨cover_of (fun y hy => absurd hy (List.not_mem_nil)) ⟨fun h1 h2 => hy.g0.cx_1 oc hA ((Bool.and_eq_true _ _).mp h1).1 ((Bool.and_eq_true _ _).mp h1).2 ((Bool.and_eq_true _ _).mp h2).1 ((Bool.and_eq_true _ _).mp h2).2, trivial⟩,
  cover_of (fun y hy => absurd hy (List.not_mem_nil)) trivial⟩
def selq_2 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) (k : Nat) : Bool :=
  bif Nat.beq k 2 then (WF ops E oc 2 && ops.g 13 ((oc (iReg 7)).ret Reg.read)) else bif Nat.beq k 3 then (WF ops E oc 3 && ops.g 31 ((oc (iReg 7)).ret Reg.read)) else false
def msT_2 : Tab (Nat × Nat) :=
  (.node 1 (.leaf ((2, cvS [] [3])))
  (.leaf ((3, cvS [] []))))
theorem chain_2 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (oc : OC V) (hA : asmP ops E oc) :
    amoChain false ((mlist_2 V ops E oc).map Prod.fst) :=
  amoChain_of_cover (fun k => selq_2 V ops E oc k) (fun x y => selq_2 V ops E oc x = true → selq_2 V ops E oc y = true → False)
    (fun _ _ h => h) msT_2 [2, 3] (by decide +kernel) (by decide +kernel)
    ⟨cover_of (fun y hy => absurd hy (List.not_mem_nil)) ⟨fun h1 h2 => hy.g0.cx_2 oc hA ((Bool.and_eq_true _ _).mp h1).1 ((Bool.and_eq_true _ _).mp h1).2 ((Bool.and_eq_true _ _).mp h2).1 ((Bool.and_eq_true _ _).mp h2).2, trivial⟩,
  cover_of (fun y hy => absurd hy (List.not_mem_nil)) trivial⟩
def selq_3 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) (k : Nat) : Bool :=
  bif Nat.beq k 2 then (WF ops E oc 2 && ops.g 14 ((oc (iReg 7)).ret Reg.read)) else bif Nat.beq k 3 then (WF ops E oc 3 && ops.g 32 ((oc (iReg 7)).ret Reg.read)) else false
def msT_3 : Tab (Nat × Nat) :=
  (.node 1 (.leaf ((2, cvS [] [3])))
  (.leaf ((3, cvS [] []))))
theorem chain_3 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (oc : OC V) (hA : asmP ops E oc) :
    amoChain false ((mlist_3 V ops E oc).map Prod.fst) :=
  amoChain_of_cover (fun k => selq_3 V ops E oc k) (fun x y => selq_3 V ops E oc x = true → selq_3 V ops E oc y = true → False)
    (fun _ _ h => h) msT_3 [2, 3] (by decide +kernel) (by decide +kernel)
    ⟨cover_of (fun y hy => absurd hy (List.not_mem_nil)) ⟨fun h1 h2 => hy.g0.cx_3 oc hA ((Bool.and_eq_true _ _).mp h1).1 ((Bool.and_eq_true _ _).mp h1).2 ((Bool.and_eq_true _ _).mp h2).1 ((Bool.and_eq_true _ _).mp h2).2, trivial⟩,
  cover_of (fun y hy => absurd hy (List.not_mem_nil)) trivial⟩
def selq_4 (V : Type) (ops : Ops V) (E : EqC V) (oc : OC V) (k : Nat) : Bool :=
  bif Nat.beq k 0 then (WF ops E oc 0 && ops.g 0 ((oc (iReg 0)).ret Reg.read)) else bif Nat.beq k 1 then (WF ops E oc 1 && ops.g 6 ((oc (iReg 1)).ret Reg.read)) else false
def msT_4 : Tab (Nat × Nat) :=
  (.node 1 (.leaf ((0, cvS [] [1])))
  (.leaf ((1, cvS [] []))))
theorem chain_4 (ops : Ops V) (E : EqC V) (hy : Hyps ops E) (oc : OC V) (hA : asmP ops E oc) :
    amoChain false ((mlist_4 V ops E oc).map Prod.fst) :=
  amoChain_of_cover (fun k => selq_4 V ops E oc k) (fun x y => selq_4 V ops E oc x = true → selq_4 V ops E oc y = true → False)
    (fun _ _ h => h) msT_4 [0, 1] (by decide +kernel) (by decide +kernel)
    ⟨cover_of (fun y hy => absurd hy (List.not_mem_nil)) ⟨fun h1 h2 => hy.g0.cx_4 oc hA ((Bool.and_eq_true _ _).mp h1).1 ((Bool.and_eq_true _ _).mp h1).2 ((Bool.and_eq_true _ _).mp h2).1 ((Bool.and_eq_true _ _).mp h2).2, trivial⟩,
  cover_of (fun y hy => absurd hy (List.not_mem_nil)) trivial⟩
end

