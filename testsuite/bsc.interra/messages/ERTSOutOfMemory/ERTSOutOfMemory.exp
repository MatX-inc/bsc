# The allocation area equals the heap cap, so the first GC exhausts the heap.
# The cap must stay well below what this compile allocates, so that a GC runs.
if {$vtest == 1} {
    compile_verilog_fail ERTSOutOfMemory1.bs mkERTSOutOfMemory1 "+RTS -A4M -M4M -H4M -RTS"
    find_n_strings ERTSOutOfMemory1.bs.bsc-vcomp-out "Heap exhausted" 1

}
