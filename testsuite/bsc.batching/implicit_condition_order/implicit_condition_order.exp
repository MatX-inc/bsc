# Issue: a rule's or method's implicit conditions sat in a Set of PTerms whose
# Ord goes through Ord Id, so the && chain built for CAN_FIRE/WILL_FIRE/RDY
# came out in string-intern order in the Verilog, the Bluesim C++ and the .ba.
# Fix: the PSet behind Pred keeps its terms in first-insertion order, the
# order the evaluator met them, and the conjunction is built in that order.
# Pull request to follow.
# Probe: a rule with an explicit condition and implicit conditions from three
# FIFOs and two submodules' ActionValue methods, and a method with two more.
# The Verilog is the same with and without -reverse-intern-order, and
# compiled alone and behind ImplicitConditionOrderScramble, a module that
# declares the probe's five instance names the other way round, which a
# batch parses first so that p2 is interned before p1; in every compile the
# conjuncts are in the order the rule body meets them.
set src ImplicitConditionOrder.bsv
set mod sysImplicitConditionOrder

reverse_intern_same_verilog $src $mod

batching_verilog_pair $src $mod ImplicitConditionOrderTop.bsv mkImplicitConditionOrderTop {ImplicitConditionOrderScramble.bsv}

# In every compile the rule's conjuncts are in the order its body meets
# them, inQ.first, p1.pop, p2.pop, outQ.enq, sideQ.enq (before the fix the
# two RDY_pop terms came first, in intern order), and the method's are
# outQ.first, sideQ.first.  $mod.normal.v and $mod.oneshot.v are the plain
# compiles, $mod.v the batched one (the reversed one was overwritten by it).
foreach v [list $mod.normal.v $mod.oneshot.v $mod.v] {
    find_regexp $v {inQ\$EMPTY_N &&\n\s+p1_RDY_pop_AND_p2_RDY_pop_AND_outQ_i_notFull_A_ETC___d8 &&\n\s+enable &&\n\s+count < 8'd200 ;$}
    find_regexp $v {p1_RDY_pop_AND_p2_RDY_pop_AND_outQ_i_notFull_A_ETC___d8 =\n\s+p1\$RDY_pop && p2\$RDY_pop && outQ\$FULL_N && sideQ\$FULL_N ;$}
    find_regexp $v {assign RDY_peek = outQ\$EMPTY_N && sideQ\$EMPTY_N ;$}
}
