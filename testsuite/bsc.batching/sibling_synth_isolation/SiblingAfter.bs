package SiblingPkg(TargetIfc(..), ExtraIfc(..), mkTarget, mkExtraAfter) where

import Vector

sampleTime :: ActionValue (Bit 32)
sampleTime = $stime

interface TargetIfc =
    feed :: Bit 8 -> Action
    loadVec :: Vector 4 (Bit 4) -> Action
    peek :: Bit 16

widenPair :: (Bits a sa, Bits b sb, Add sa sb sc) => a -> b -> Bit sc
widenPair x y = pack x ++ pack y

{-# verilog mkTarget #-}
mkTarget :: Module TargetIfc
mkTarget =
  module
    rgA :: Reg (Bit 8) <- mkReg 0
    rgB :: Reg (Bit 8) <- mkReg 1
    rules
      "stepTarget": when True ==> do
        now <- sampleTime
        let comb :: Bit 16
            comb = widenPair rgA._read rgB._read
        rgA := truncate comb + now[7:0]
        rgB := rgB ^ rgA
    interface
      feed v = rgA := v
      loadVec vs = rgB := pack (vs !! 0) ++ pack (vs !! 1)
      peek = widenPair rgB._read rgA._read

interface ExtraIfc =
    pushExtra :: Bit 4 -> Action
    loadExtraVec :: Vector 4 (Bit 4) -> Action
    readExtra :: Bit 16

stitchFour :: (Bits a sa, Bits b sb, Bits c sc, Bits d sd,
               Add sa sb sab, Add sab sc sabc, Add sabc sd total) =>
              a -> b -> c -> d -> Bit total
stitchFour a b c d = ((pack a ++ pack b) ++ pack c) ++ pack d

{-# verilog mkExtraAfter #-}
mkExtraAfter :: Module ExtraIfc
mkExtraAfter =
  module
    regs :: Vector 4 (Reg (Bit 4)) <- replicateM (mkReg 0)
    rules
      "advanceExtra": when True ==> do
        now <- sampleTime
        let r0 = (regs !! 0)._read
            r1 = (regs !! 1)._read
            r2 = (regs !! 2)._read
            r3 = (regs !! 3)._read
            snap :: Bit 16
            snap = stitchFour r0 r1 r2 r3
        (regs !! 0) := snap[3:0] + now[3:0]
    interface
      pushExtra x = (regs !! 1) := x
      loadExtraVec vs = (regs !! 2) := vs !! 0
      readExtra =
        let r0 = (regs !! 0)._read
            r1 = (regs !! 1)._read
            r2 = (regs !! 2)._read
            r3 = (regs !! 3)._read
        in  stitchFour r3 r2 r1 r0
