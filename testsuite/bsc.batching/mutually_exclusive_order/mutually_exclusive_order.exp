# Issue: extractMEPairsSP (ASchedule.hs) oriented each mutually_exclusive
# pair with ordPair, Ord Id, so intern order chose the rule hosting the
# __me_check rule (its number), the check's && operand order and the R0001
# message's position and set order, in the Verilog, Bluesim C++ and .ba.
# Fix: a pair keeps the attribute's own order, the group named earlier
# first, deduplicated without regard to orientation.  Pull request to follow.
# Probe: an attribute names two rules against their declaration order; the
# -keep-fires Verilog is the same both ways and the check is on the first.
set src MutuallyExclusiveOrder.bsv
set mod sysMutuallyExclusiveOrder

reverse_intern_same_verilog $src $mod {-keep-fires}

# In both compiles the check is hosted on namedFirst, the group the
# attribute names first: the check rule carries that rule's number (the
# second rule, 1), namedFirst's predicate is the first && operand, the
# message sits at namedFirst's column in the attribute and names its set
# first.
foreach v [list $mod.normal.v $mod.v] {
    find_regexp $v {// rule __me_check_1$}
    find_regexp $v {if \(goNamedFirst && goDeclaredFirst\)}
    find_regexp $v {line 21, column 29: \(R0001\)}
    find_regexp $v {ME sets \[RL_namedFirst\] and}
}
