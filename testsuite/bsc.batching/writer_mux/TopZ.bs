package TopZ where

import ScrambleZ
import WriterMux

interface TopOut =
  out :: Bit 8

{-# verilog mkTopZ #-}
mkTopZ :: Module TopOut
mkTopZ = module
  dut <- mkGroundedMuxOrder
  let warm :: Bit 8
      warm = zz_scramble_01 8'd3 ^ zz_scramble_02 8'd5 ^ zz_scramble_03 8'd7
  r :: Reg (Bit 8) <- mkReg warm
  interface
    out = dut.out ^ r
