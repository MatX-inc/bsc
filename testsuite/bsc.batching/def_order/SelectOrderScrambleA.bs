package SelectOrderScrambleA where

import Vector

-- Same shape with j renamed m so k's generated select names are interned
-- here when compiled after SelectOrderScrambleB.
{-# verilog mkSelectOrderScrambleA #-}
mkSelectOrderScrambleA :: Module Empty
mkSelectOrderScrambleA =
  module
    va :: Vector 4 (Reg (UInt 8)) <- replicateM (mkReg 0)
    k  :: Reg (UInt 2) <- mkReg 0
    m  :: Reg (UInt 2) <- mkReg 1
    s  :: Reg (UInt 8) <- mkRegU
    rules
      "step": when True ==>
        action
          s := (select va k)._read + (select va m)._read
          k := k + 1
          m := m + 1
