package ForeignOrder where

-- a and b depend on the value of one foreign call and are used by two
-- others, so both are inlined into the foreign-call always block with no
-- dependency edge between them.
{-# verilog mkForeignOrder #-}
mkForeignOrder :: Module Empty
mkForeignOrder =
  module
    rules
      "r": when True ==>
        action
          t <- $time
          let a = t + 1
              b = t + 2
          $display "%d %d" a a
          $display "%d %d" b b
