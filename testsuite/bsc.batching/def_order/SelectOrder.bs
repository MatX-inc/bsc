package SelectOrder where

import Vector

-- Two independent dynamic selects from the same vector, each emitted as
-- its own always block; elaboration creates k's select before j's.
{-# verilog mkSelectOrder #-}
mkSelectOrder :: Module Empty
mkSelectOrder =
  module
    va :: Vector 4 (Reg (UInt 8)) <- replicateM (mkReg 0)
    k  :: Reg (UInt 2) <- mkReg 0
    j  :: Reg (UInt 2) <- mkReg 1
    s  :: Reg (UInt 8) <- mkRegU
    rules
      "step": when True ==>
        action
          s := (select va k)._read + (select va j)._read
          k := k + 1
          j := j + 1
