package EnableOrderTop where

import EnableOrderScrambleB
import EnableOrderScrambleA
import EnableOrder

-- Batch order B, A, probe: w2's names are interned before w1's.
{-# verilog mkEnableOrderTop #-}
mkEnableOrderTop :: Module Empty
mkEnableOrderTop =
    module
        _b :: EnableOrderScrambleB <- mkEnableOrderScrambleB
        _a :: EnableOrderScrambleA <- mkEnableOrderScrambleA
        _p :: EnableOrder <- mkEnableOrder
