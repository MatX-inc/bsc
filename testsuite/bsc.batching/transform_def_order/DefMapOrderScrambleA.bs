package DefMapOrderScrambleA where

import FIFO

{-# verilog mkDefMapOrderScrambleA #-}
mkDefMapOrderScrambleA :: Module Empty
mkDefMapOrderScrambleA =
    module
        fa :: FIFO (Bit 8) <- mkFIFO
        fy :: FIFO (Bit 8) <- mkFIFO
        fz :: FIFO (Bit 8) <- mkFIFO
        s :: Reg (Bit 2) <- mkReg 0
        x :: Reg (Bit 8) <- mkReg 0
        rules
            "rone": when True ==>
                case s of
                    0 -> fa.enq x
                    1 -> fy.enq x
                    _ -> fz.enq x
