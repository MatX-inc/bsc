# Round trips through the format 2 encoding (-check-bin-roundtrip): the
# signatures and the typechecked package of a full compile survive an
# encode, decode and re-encode
compile_pass RoundTrip.bs "-check-bin-roundtrip"
compile_pass RoundTripBSV.bsv "-check-bin-roundtrip"

# Front-end-only compiles, which write no .bo
proc front_end_pass { source mode {options ""} {nodeps 0} } {
    incr_stat "front_end_pass"
    if [bsc_compile $source "$mode $options" $nodeps] then {
        pass "`$source' passes $mode"
    } else {
        fail "`$source' should pass $mode"
    }
}

proc front_end_fail { source mode {options ""} {nodeps 0} } {
    incr_stat "front_end_fail"
    if [bsc_compile $source "$mode $options" $nodeps] then {
        fail "`$source' should fail $mode"
    } else {
        pass "`$source' fails $mode"
    }
}

# Copy a full compile's output, with the final -u message worded as
# -check-only words it
proc copy_as_checked { file1 file2 } {
    global srcdir
    global subdir
    set dir [file join [absolute $srcdir] $subdir]
    set in [open [file join $dir $file1] r]
    set text [read $in]
    close $in
    set out [open [file join $dir $file2] w]
    puts -nonewline $out [string map \
        {"All packages compiled (some with errors)." \
         "All packages checked (some with errors)." \
         "All packages are up to date." "All packages checked."} $text]
    close $out
}

# -signature-only writes the signature that the full compile stores
compile_pass FrontEndA.bs
front_end_pass FrontEndA.bs -signature-only "-check-bin-roundtrip"
if { [do_internal_checks] } {
    dumpbi FrontEndA.bo
    dumpbi FrontEndA.bi
    compare_file [make_dumpbi_output_name FrontEndA.bi] \
        [make_dumpbi_output_name FrontEndA.bo]
}

# imports are read from .bi files only
compile_pass FrontEndLib.bs
front_end_fail FrontEndUsesLib.bs -signature-only "" 1
find_regexp [make_bsc_output_name FrontEndUsesLib.bs] {S0004}

# -check-only typechecks against the .bi files
front_end_pass FrontEndB.bs -check-only "-check-bin-roundtrip"
if { [do_internal_checks] } {
    dumpbo FrontEndB.btp
    find_regexp [make_dumpbo_output_name FrontEndB.btp] {^Status: ok$}
}

# with the messages and status of a full compile
compile_fail FrontEndBad.bs
copy [make_bsc_output_name FrontEndBad.bs] FrontEndBad.bs.full-out
front_end_fail FrontEndBad.bs -check-only
compare_file [make_bsc_output_name FrontEndBad.bs] FrontEndBad.bs.full-out

# and, continuing after the error, a .btp with the poisoned definition
# (the final -u message says that the packages were checked)
compile_fail FrontEndBad.bs "-continue-after-errors"
copy_as_checked [make_bsc_output_name FrontEndBad.bs] FrontEndBad.bs.full-out
front_end_fail FrontEndBad.bs -check-only "-continue-after-errors"
compare_file [make_bsc_output_name FrontEndBad.bs] FrontEndBad.bs.full-out
if { [do_internal_checks] } {
    dumpbo FrontEndBad.btp
    find_regexp [make_dumpbo_output_name FrontEndBad.btp] {^Status: failed$}
    find_regexp [make_dumpbo_output_name FrontEndBad.btp] {primPoisonedDef}
}

front_end_fail FrontEndUsesLib.bs -check-only "" 1
find_regexp [make_bsc_output_name FrontEndUsesLib.bs] {S0004}

# and the errors that a full compile reports after typecheck: a foreign
# function imported twice (T0091), a local mutual recursion that cannot
# be converted (S0066), and an ambiguous constructor in the default of an
# unexported class, found when the .bo signatures are written (S0015)
foreach {source tag} {FrontEndForeign.bsv T0091 FrontEndLetrec.bs S0066 \
                      FrontEndDefault.bs S0015} {
    compile_fail_error $source $tag
    copy [make_bsc_output_name $source] $source.full-out
    front_end_fail $source -check-only
    compare_file [make_bsc_output_name $source] $source.full-out
}

# -u -check-only checks the imports it recompiles, as -u compiles them
compile_fail_error FrontEndUsesBodyErr.bs T0080
copy [make_bsc_output_name FrontEndUsesBodyErr.bs] FrontEndUsesBodyErr.bs.full-out
erase FrontEndBodyErr.bi
erase FrontEndBodyErr.btp
front_end_fail FrontEndUsesBodyErr.bs -check-only
compare_file [make_bsc_output_name FrontEndUsesBodyErr.bs] FrontEndUsesBodyErr.bs.full-out

# and, continuing after errors, warn about an import whose check failed as
# -u warns about a .bo with poisoned definitions (G0088)
erase FrontEndBodyErr.bi
erase FrontEndBodyErr.btp
front_end_fail FrontEndUsesBodyErr.bs -check-only "-continue-after-errors"
find_regexp [make_bsc_output_name FrontEndUsesBodyErr.bs] \
    {G0088\)\n  File FrontEndBodyErr.btp contains definitions}
find_n_strings [make_bsc_output_name FrontEndUsesBodyErr.bs] \
    "All packages checked (some with errors)." 1

# -u -check-only says that it checked, and does not check again an import
# whose .bi and .btp are current (a foreign import writes no .ba here)
erase FrontEndBdpi.bi
erase FrontEndBdpi.btp
front_end_pass FrontEndUsesBdpi.bs -check-only
find_n_strings [make_bsc_output_name FrontEndUsesBdpi.bs] "compiling ./FrontEndBdpi.bsv" 1
find_n_strings [make_bsc_output_name FrontEndUsesBdpi.bs] "All packages checked." 1
string_does_not_occur [make_bsc_output_name FrontEndUsesBdpi.bs] "up to date"
front_end_pass FrontEndUsesBdpi.bs -check-only
string_does_not_occur [make_bsc_output_name FrontEndUsesBdpi.bs] "FrontEndBdpi.bsv"

# Whether two files hold the same bytes
proc compare_bytes { file1 file2 } {
    global srcdir
    global subdir
    incr_stat "compare_bytes"
    set dir [file join [absolute $srcdir] $subdir]
    set data {}
    foreach f [list $file1 $file2] {
        if { ! [file exists [file join $dir $f]] } {
            fail "`$f' does not exist"
            return
        }
        set in [open [file join $dir $f] r]
        fconfigure $in -translation binary
        lappend data [read $in]
        close $in
    }
    if { [lindex $data 0] eq [lindex $data 1] } {
        pass "`$file1' has the bytes of `$file2'"
    } else {
        fail "`$file1' should have the bytes of `$file2'"
    }
}

# Whether the file has lines holding each of the strings once, in order
proc find_lines_in_order { filename strings } {
    set re ""
    foreach s $strings {
        find_n_strings $filename $s 1
        regsub -all {[][\\.*+?(){}^$|]} $s {\\&} esc
        if { $re ne "" } {
            append re {\n(.*\n)*}
        }
        append re ".*$esc.*"
    }
    find_regexp $filename $re
}

# -u -check-only gives each package it recompiles, the named one too, a
# -signature-only pass, which writes the .bi that later packages read and
# the .bup, and then checks the .bup, as -check-only X.bup does (-trace-bup
# reports each .bup read).  A chain FrontEndChainA <- FrontEndChainB <-
# FrontEndChainC, from scratch:
set chain_passes {
    "compiling ./FrontEndChainA.bs"
    "Interface file created: FrontEndChainA.bi"
    "Untyped package file created: FrontEndChainA.bup"
    "Typed package file created: FrontEndChainA.btp"
    "compiling ./FrontEndChainB.bs"
    "Interface file created: FrontEndChainB.bi"
    "Untyped package file created: FrontEndChainB.bup"
    "Typed package file created: FrontEndChainB.btp"
    "compiling FrontEndChainC.bs"
    "Interface file created: FrontEndChainC.bi"
    "Untyped package file created: FrontEndChainC.bup"
    "Typed package file created: FrontEndChainC.btp"
    "All packages checked."
}
set chain {FrontEndChainA FrontEndChainB FrontEndChainC}
foreach p $chain {
    foreach s {bi bup btp bo} {
        erase $p.$s
    }
}
front_end_pass FrontEndChainC.bs -check-only "-v -trace-bup"
find_lines_in_order [make_bsc_output_name FrontEndChainC.bs] $chain_passes
foreach p $chain {
    find_lines_in_order [make_bsc_output_name FrontEndChainC.bs] \
        [list "Untyped package file created: $p.bup" "bup read $p.bup" \
              "Typed package file created: $p.btp"]
}
# the front end runs once per package, so FrontEndChainA's warnings are
# reported once
find_n_strings [make_bsc_output_name FrontEndChainC.bs] "(P0223)" 1
find_n_strings [make_bsc_output_name FrontEndChainC.bs] "(T0160)" 1
nukedir frontend_u
mkdir frontend_u
foreach p $chain {
    foreach s {bi btp} {
        copy $p.$s frontend_u/$p.$s
    }
}

# then checks only the named package again
front_end_pass FrontEndChainC.bs -check-only
string_does_not_occur [make_bsc_output_name FrontEndChainC.bs] "FrontEndChainA"
string_does_not_occur [make_bsc_output_name FrontEndChainC.bs] "FrontEndChainB"
find_n_strings [make_bsc_output_name FrontEndChainC.bs] "compiling FrontEndChainC.bs" 1

# A .bup that -u wrote is checked by a standalone -check-only too (the
# flags fingerprint leaves out what -u sets only for printing)
foreach p $chain {
    front_end_pass $p.bup -check-only "" 1
}

# Every .bi is that of a standalone -signature-only compile, and every
# .btp records the messages, status and package of a standalone check of
# the .bup that compile writes (the .bup, and so the .btp's record of it,
# can differ: under -u the earlier packages have interned strings first)
foreach p $chain {
    front_end_pass $p.bs -signature-only "" 1
    compare_bytes frontend_u/$p.bi $p.bi
    front_end_pass $p.bup -check-only "" 1
    if { [do_internal_checks] } {
        dumpbo frontend_u/$p.btp
        dumpbo $p.btp
        compare_file [make_dumpbo_output_name frontend_u/$p.btp] \
            [make_dumpbo_output_name $p.btp]
    }
}

# A changed import gets both passes again, and what imports it is checked
# again
touch FrontEndChainA.bs
front_end_pass FrontEndChainC.bs -check-only "-v"
find_lines_in_order [make_bsc_output_name FrontEndChainC.bs] $chain_passes

# and so does an import missing only its .btp, or only its .bi
foreach s {btp bi} {
    erase FrontEndChainA.$s
    front_end_pass FrontEndChainC.bs -check-only "-v"
    find_lines_in_order [make_bsc_output_name FrontEndChainC.bs] $chain_passes
}

# A body error in the bottom package of a chain is reported by the check
# of its .bup, after its signature pass has written its .bi
foreach p {FrontEndBodyErr FrontEndUsesBodyErr FrontEndChainBodyErr} {
    foreach s {bi bup btp} {
        erase $p.$s
    }
}
front_end_fail FrontEndChainBodyErr.bs -check-only
find_lines_in_order [make_bsc_output_name FrontEndChainBodyErr.bs] \
    {"compiling ./FrontEndBodyErr.bs" "(T0080)"}
string_does_not_occur [make_bsc_output_name FrontEndChainBodyErr.bs] "FrontEndUsesBodyErr"
files_exist {FrontEndBodyErr.bi FrontEndBodyErr.bup}

# and, continuing after errors, the first signature pass that reads its
# .bi warns that its check failed: the middle package's
foreach p {FrontEndBodyErr FrontEndUsesBodyErr FrontEndChainBodyErr} {
    foreach s {bi bup btp} {
        erase $p.$s
    }
}
front_end_fail FrontEndChainBodyErr.bs -check-only "-continue-after-errors"
find_lines_in_order [make_bsc_output_name FrontEndChainBodyErr.bs] \
    {"compiling ./FrontEndBodyErr.bs" "(T0080)" "compiling ./FrontEndUsesBodyErr.bs"
     "(G0088)" "compiling FrontEndChainBodyErr.bs"
     "All packages checked (some with errors)."}

# The .btp does not depend on where the imported .bi files were found:
# two copies of the import closure, at different paths
nukedir frontend_paths
foreach d {frontend_paths/a frontend_paths/b/c frontend_paths/out_a frontend_paths/out_b} {
    mkdir $d
}
foreach d {frontend_paths/a frontend_paths/b/c} {
    foreach p {Prelude PreludeBSV Vector List Array} {
        copy [file join [get_bsdir] Libraries $p.bi] $d/$p.bi
    }
    copy FrontEndA.bi $d/FrontEndA.bi
}
front_end_pass FrontEndB.bs -check-only "-p frontend_paths/a -bdir frontend_paths/out_a" 1
front_end_pass FrontEndB.bs -check-only "-p frontend_paths/b/c -bdir frontend_paths/out_b" 1
compare_file frontend_paths/out_a/FrontEndB.btp frontend_paths/out_b/FrontEndB.btp

# -warn-redundant-provisos needs the package before context reduction,
# which the check of a .bup does not have, so it needs -check-only
# without -u
front_end_fail FrontEndB.bs -check-only "-warn-redundant-provisos"
find_regexp [make_bsc_output_name FrontEndB.bs] \
    {-warn-redundant-provisos needs a check of the source file}
front_end_pass FrontEndB.bs -check-only "-warn-redundant-provisos" 1
