# The .bo of a package must not depend on what else the process parsed or
# compiled before it.  Each probe is compiled on its own and then inside a
# `bsc -u` batch whose root also imports a scrambler package that the
# dependency pass parses first.  The scrambler mentions, in the opposite
# order from the probe's own text, the names whose string-intern order once
# decided an ordering inside the compiler, so the two compiles see
# different intern orders.  The dumps of the probe's .bo must agree.
#
# Each probe targets one closed leak (doc/engine-first-plan.md, P1 record):
#   TrieOrder  the instance trie enumerated candidate instances in TyCon
#              order on a Free query, and context reduction mints fresh
#              variables per candidate, so dictionary numbers followed it
#   JoinOrder  the context join grouped joinable predicates in class and
#              type order, so the order in which residuals were retried,
#              and so the order of the dictionary bindings, followed it
#   LetOrder   let nesting, definition order and binding groups were
#              topologically sorted with Id as the tie-break
#   LoopOrder  the imperative desugaring listed the variables a loop or
#              branch updates in Id order, which is the order of the tuple
#              it threads them through
#
#   NumOrder   the built-in Add rules rebuilt a cancelled sum from a bag
#              of terms in Type order, so a solved variable's type listed
#              the same terms in different orders
#
#   PosOrder   hash-consed CType nodes carried the positions of the first
#              file that built them, so a batched .bo named source files it
#              never imported; the dumps are compared whole, hash line
#              included, which is the .bo's bytes

# dumpbo is an internal tool: the suite only locates it for internal
# checks, so locate it here and report the comparison as unsupported
# when it is not installed
proc batching_find_dumpbo {} {
    global env
    global dumpbo
    if { [info exists dumpbo] } { return 1 }
    if { [info exists env(DUMPBO)] && [file exists $env(DUMPBO)] } {
        set dumpbo [absolute_filename $env(DUMPBO)]
        return 1
    }
    set found [which dumpbo]
    if { $found == 0 } { return 0 }
    set dumpbo $found
    return 1
}

# whole: 1 compares the whole dump, hash line included, which is the
# .bo's bytes; 0 excludes the hash line (kept for probes written while
# positions still leaked)
proc batching_pair { probe root scramble {whole 1} } {
    set bo "[file rootname $probe].bo"
    set oneshot "[file rootname $probe].oneshot.dumpbo-out"
    set have_dumpbo [batching_find_dumpbo]
    erase $bo
    erase "[file rootname $scramble].bo"
    erase "[file rootname $root].bo"
    compile_pass $probe {} 1
    if { $have_dumpbo } {
        dumpbo $bo
        move [make_dumpbo_output_name $bo] $oneshot
    }
    erase $bo
    compile_pass $root
    if { $have_dumpbo } {
        dumpbo $bo
        if { $whole } {
            compare_file [make_dumpbo_output_name $bo] $oneshot
        } else {
            compare_file_filtered [make_dumpbo_output_name $bo] $oneshot {-e /^Hash:/d}
        }
    } else {
        unsupported "`$bo' one-shot and batched dumps compared (dumpbo not found)"
    }
}

batching_pair TrieOrder.bsv TrieOrderRoot.bsv TrieOrderScramble.bsv
batching_pair JoinOrder.bsv JoinOrderRoot.bsv JoinOrderScramble.bsv
batching_pair LetOrder.bs LetOrderRoot.bs LetOrderScramble.bs
batching_pair LoopOrder.bsv LoopOrderRoot.bsv LoopOrderScramble.bsv
batching_pair NumOrder.bsv NumOrderRoot.bsv NumOrderScramble.bsv
batching_pair PosOrder.bsv PosOrderRoot.bsv PosOrderScramble.bsv
