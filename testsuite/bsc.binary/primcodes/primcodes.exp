# The .bo and .ba files write a primitive as its code (Prim.hs's table).
# dumpbo -prim-codes lists every primitive with its code after reading
# each code back; the listing must match its expected copy, so that a
# reordered or shifted table fails here instead of in a stale .bo.  Its
# first line is the table's hash, which ends the .bo and .ba format tags
# (GenBin.header, GenABin.header), so the tags are pinned here too.
#
# dumpbo is one of the extra tools (make -C src/comp install-extra), and
# the testsuite insists on it only under DO_INTERNAL_CHECKS=1, which CI
# does not set.  This check has to run wherever the tool is installed,
# so outside the internal checks it finds dumpbo the way which_dumpbo
# does (DUMPBO, which the testsuite's make sets to
# $(TEST_RELEASE)/bin/dumpbo for every run, then the PATH) and, like
# bsc.showrules, reports itself unsupported when the tool is not built:
# an auditable marker rather than a silent skip.

global env
global srcdir
global subdir

bsc_initialize

if { [do_internal_checks] } {
    global dumpbo
    set tool $dumpbo
} elseif { [info exists env(DUMPBO)] && [file exists $env(DUMPBO)] } {
    set tool [absolute_filename $env(DUMPBO)]
} else {
    set tool [which dumpbo]
}

if { $tool == 0 } {
    note "dumpbo is NOT available"
    unsupported "dumpbo: tool not built (make -C src/comp install-extra)"
} else {

    set here [absolute $srcdir]
    cd [file join $here $subdir]

    set output "primcodes.dumpbo-out"
    set cmd "$tool -prim-codes >& $output"
    verbose "Executing: $cmd" 4
    set status [exec_with_log "dumpbo" $cmd 2]
    if { $status == 0 } {
        pass "dumpbo -prim-codes"
    } else {
        fail "dumpbo -prim-codes"
    }

    cd $here

    compare_file $output
}
