`ifdef BSV_ASSIGNMENT_DELAY
`else
  `define BSV_ASSIGNMENT_DELAY
`endif

`ifdef BSV_POSITIVE_RESET
  `define BSV_RESET_VALUE 1'b1
  `define BSV_RESET_EDGE posedge
`else
  `define BSV_RESET_VALUE 1'b0
  `define BSV_RESET_EDGE negedge
`endif

module sysStaticOpMemoIfFold(CLK,
			     RST_N);
  input  CLK;
  input  RST_N;

  // register c
  reg c;
  wire c$D_IN, c$EN;

  // register c2
  reg c2;
  wire c2$D_IN, c2$EN;

  // register o
  reg [7 : 0] o;
  wire [7 : 0] o$D_IN;
  wire o$EN;

  // register r
  reg [1 : 0] r;
  wire [1 : 0] r$D_IN;
  wire r$EN;

  // register c
  assign c$D_IN = 1'b0 ;
  assign c$EN = 1'b0 ;

  // register c2
  assign c2$D_IN = 1'b0 ;
  assign c2$EN = 1'b0 ;

  // register o
  assign o$D_IN = { 6'd0, (c && r == 2'd0) ? 2'd2 : (c ? r + 2'd1 : 2'd1) } ;
  assign o$EN = 1'd1 ;

  // register r
  assign r$D_IN = 2'h0 ;
  assign r$EN = 1'b0 ;

  // handling of inlined registers

  always@(posedge CLK)
  begin
    if (RST_N == `BSV_RESET_VALUE)
      begin
        c <= `BSV_ASSIGNMENT_DELAY 1'd0;
	c2 <= `BSV_ASSIGNMENT_DELAY 1'd0;
	o <= `BSV_ASSIGNMENT_DELAY 8'd0;
	r <= `BSV_ASSIGNMENT_DELAY 2'd0;
      end
    else
      begin
        if (c$EN) c <= `BSV_ASSIGNMENT_DELAY c$D_IN;
	if (c2$EN) c2 <= `BSV_ASSIGNMENT_DELAY c2$D_IN;
	if (o$EN) o <= `BSV_ASSIGNMENT_DELAY o$D_IN;
	if (r$EN) r <= `BSV_ASSIGNMENT_DELAY r$D_IN;
      end
  end

  // synopsys translate_off
  `ifdef BSV_NO_INITIAL_BLOCKS
  `else // not BSV_NO_INITIAL_BLOCKS
  initial
  begin
    c = 1'h0;
    c2 = 1'h0;
    o = 8'hAA;
    r = 2'h2;
  end
  `endif // BSV_NO_INITIAL_BLOCKS
  // synopsys translate_on
endmodule  // sysStaticOpMemoIfFold

