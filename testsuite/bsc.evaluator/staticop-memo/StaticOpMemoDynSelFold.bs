-- fromMaybe of a dynamic selection whose two elements share a cell: the
-- memo delivers the shared result as one reference, and improveDynSel's
-- collapse of all-equal elements must still fire on it, as it does on
-- the structurally equal copies the unmemoized walk produced.
package StaticOpMemoDynSelFold(sysStaticOpMemoDynSelFold) where

import Vector

{-# verilog sysStaticOpMemoDynSelFold #-}
sysStaticOpMemoDynSelFold :: Module Empty
sysStaticOpMemoDynSelFold = module
  r :: Reg (Bit 2) <- mkReg 0
  c :: Reg Bool <- mkReg False
  sel :: Reg (Bit 1) <- mkReg 0
  o :: Reg (Bit 8) <- mkReg 0
  rules
    "go": when True ==> action
      let x :: Maybe (Bit 2)
          x = if r == 0 then Invalid else Valid (r + 1)
          v :: Vector 2 (Maybe (Bit 2))
          v = update (update newVector 0 (if c then x else Valid 1)) 1 (if c then x else Valid 1)
      o := zeroExtend (fromMaybe 2 (select v sel._read))
