# Tests for the evaluator metadata store (IExpandMeta): the -metadata-dump
# output on known packages, and the -metadata-scramble identity (the
# generated Verilog does not depend on the store's content).

# The dump prints every cell of the elaborated module with its site, its
# binder, its alias class and the chain of definition unfoldings it was
# created under.
# Positions in files other than the tests' own (Meta*.bsv) are reduced to
# the file name, so that a library edit does not move the expected output.
proc filter_dump { fname } {
    sed $fname $fname.filtered {} \
        {-e s/\\\[(Meta\[A-Za-z\]*\\.bsv):/@@\\1:/g -e s/\\\[(\[^]:\]+):\[0-9\]+:\[0-9\]+\\\]/\[\\1\]/g -e s/@@/\[/g}
}

if { $vtest == 1 } {

# the reference: the generated Verilog of a plain compile
erase MetaDump.bo
compile_verilog_pass MetaDump.bsv sysMetaDump
move sysMetaDump.v sysMetaDump.plain.v

# the store scrambled: the Verilog does not change and the dump is
# suppressed (no chain line, which every dump line marks with #)
erase MetaDump.bo
compile_verilog_pass MetaDump.bsv sysMetaDump {-metadata-scramble -metadata-dump}
compare_file sysMetaDump.v sysMetaDump.plain.v
find_n_strings MetaDump.bsv.bsc-vcomp-out {#} 0

# the dump: the Verilog does not change and the chains are as pinned
erase MetaDump.bo
erase sysMetaDump.v
compile_verilog_pass MetaDump.bsv sysMetaDump {-metadata-dump}
compare_file sysMetaDump.v sysMetaDump.plain.v
filter_dump MetaDump.bsv.bsc-vcomp-out
compare_file MetaDump.bsv.bsc-vcomp-out.filtered MetaDump.bsv.bsc-vcomp-out.expected

erase sysMetaDump.plain.v

# Binders and alias classes: every cell bound to a parameter (an
# argument, a let-bound value) or moved into a field or operand of a
# struct or another lazy application carries that binder, and cells
# that hold one value (a value that evaluates to another, a reference
# re-heaped under a condition, a value extracted from a tagged union
# and the operand cell its constructor application moved, which is not
# a kept cell and appears only as the root of that class) share a
# class, pinned by the dump of a package exercising each; the Verilog
# is unchanged by the flags.
erase MetaBinder.bo
compile_verilog_pass MetaBinder.bsv sysMetaBinder
move sysMetaBinder.v sysMetaBinder.plain.v

erase MetaBinder.bo
compile_verilog_pass MetaBinder.bsv sysMetaBinder {-metadata-scramble -metadata-dump}
compare_file sysMetaBinder.v sysMetaBinder.plain.v
find_n_strings MetaBinder.bsv.bsc-vcomp-out {#} 0

erase MetaBinder.bo
erase sysMetaBinder.v
compile_verilog_pass MetaBinder.bsv sysMetaBinder {-metadata-dump}
compare_file sysMetaBinder.v sysMetaBinder.plain.v
filter_dump MetaBinder.bsv.bsc-vcomp-out
compare_file MetaBinder.bsv.bsc-vcomp-out.filtered MetaBinder.bsv.bsc-vcomp-out.expected

erase sysMetaBinder.plain.v

}
