# Tests for the evaluator metadata store (IExpandMeta): the -metadata-dump
# output on known packages, the -metadata-scramble identity (the
# generated Verilog does not depend on the store's content), the
# -metadata-census output with its cross-checks, and the -metadata-out
# side file.

# The dump prints every cell of the elaborated module with its site, its
# binder, its alias class and the chain of definition unfoldings it was
# created under.
# Positions in files other than the tests' own (Meta*.bsv) are reduced to
# the file name, so that a library edit does not move the expected output.
# The census renders a site the same way where it names one.
proc filter_dump { fname } {
    sed $fname $fname.filtered {} \
        {-e s/\\\[(Meta\[A-Za-z\]*\\.bsv):/@@\\1:/g -e s/\\\[(\[^]:\]+):\[0-9\]+:\[0-9\]+\\\]/\[\\1\]/g -e s/@@/\[/g}
}

# The side file (-metadata-out), one line per root and per lifted def of
# a module, is pinned after the position filter of the dump, pointer
# normalisation (every __h<n> def name reduced to __h, every _<n> parent
# or alias root to _N) and line sorting: set equality per module.  The
# sort runs under the C locale, so the pinned order is the byte order
# whatever locale the harness or the caller's shell sets.
proc filter_side { fname } {
    global env
    sed $fname $fname.filtered {} \
        {-e s/\\\[(Meta\[A-Za-z\]*\\.bsv):/@@\\1:/g -e s/\\\[(\[^]:\]+):\[0-9\]+:\[0-9\]+\\\]/\[\\1\]/g -e s/@@/\[/g -e s/__h\[0-9\]+/__h/g -e s/(parent|alias)\ _\[0-9\]+/\\1\ _N/g}
    if { [info exists env(LC_ALL)] } { set lc_all_save $env(LC_ALL) }
    set env(LC_ALL) C
    sort $fname.filtered $fname.sorted
    if { [info exists lc_all_save] } {
        set env(LC_ALL) $lc_all_save
    } else {
        unset env(LC_ALL)
    }
}

# The ledger as -dmetadata prints it after the last ASPackage pass (its
# finalcleanup section: the sizes line and the events; the resolution
# of the final defs printed after them is left out, since the file
# carries no ids to resolve), under the stage name a .bxref written at
# the end of the Verilog backend carries, which is what dumpbxref
# --events prints for that file
proc final_ledger { fname out } {
    sed $fname $out {-e /^ledger\ after\ finalcleanup/,/^-----/!d -e /^-----/d -e /./!d -e /^resolved:/d -e /^\ \ /d -e s/finalcleanup/verilog/} {}
}

# The identifier records of a .bxref (dumpbxref --idents): one line per
# identifier of the generated module with its declaration positions and
# what it stands for, pinned after the position filter and the pointer
# normalisation of the side file and without the history field (the
# positions of the events on the way, which move with every event a
# pass gains).  -metadata-check holds the closure at the Verilog level
# in every run that writes the file, so an identifier that stands for
# nothing is one the pinned list names (a clock, a reset, a parameter).
proc filter_idents { fname } {
    sed $fname $fname.filtered {} \
        {-e s/\\\[(Meta\[A-Za-z\]*\.bsv):/@@\\1:/g -e s/\\\[(\[^]:\]+):\[0-9\]+:\[0-9\]+\\\]/\[\\1\]/g -e s/@@/\[/g -e s/__h\[0-9\]+/__h/g -e {s/\ \|\ history\ [0-9,]*$//}}
}

proc idents_golden { top {expected {}} } {
    if { $expected == "" } { set expected $top.idents.expected }
    if { [do_internal_checks] } {
        dumpbxref $top.bxref --idents
        move [make_dumpbxref_output_name $top.bxref] $top.idents
        filter_idents $top.idents
        compare_file $top.idents.filtered $expected
        erase $top.idents
        erase $top.idents.filtered
    }
}

# One module: its Verilog must be the same byte for byte for a plain
# compile, under the dump, under the scramble, under the census (with
# the ledger's closure checked at every stage), with the side file
# written and with the .bxref written; the dump, the census, the side
# file and the identifier records are as pinned.  "extra" names other
# flags of the census run.
proc metadata_golden { pkg top {extra {}} } {
    erase $pkg.bo
    compile_verilog_pass $pkg.bsv $top
    move $top.v $top.plain.v

    erase $pkg.bo
    compile_verilog_pass $pkg.bsv $top {-metadata-scramble -metadata-dump}
    compare_file $top.v $top.plain.v
    find_n_strings $pkg.bsv.bsc-vcomp-out {#} 0

    erase $pkg.bo
    erase $top.v
    compile_verilog_pass $pkg.bsv $top {-metadata-dump}
    compare_file $top.v $top.plain.v
    filter_dump $pkg.bsv.bsc-vcomp-out
    compare_file $pkg.bsv.bsc-vcomp-out.filtered $pkg.bsv.bsc-vcomp-out.expected

    erase $pkg.bo
    erase $top.v
    compile_verilog_pass $pkg.bsv $top "-metadata-census -metadata-check $extra"
    compare_file $top.v $top.plain.v
    filter_dump $pkg.bsv.bsc-vcomp-out
    compare_file $pkg.bsv.bsc-vcomp-out.filtered $pkg.bsv.census.expected

    erase $pkg.bo
    erase $top.v
    erase $top.metadata
    compile_verilog_pass $pkg.bsv $top {-metadata-out .}
    compare_file $top.v $top.plain.v
    filter_side $top.metadata
    compare_file $top.metadata.sorted $top.metadata.expected
    erase $top.metadata

    erase $pkg.bo
    erase $top.v
    erase $top.bxref
    compile_verilog_pass $pkg.bsv $top {-bxref -metadata-check}
    compare_file $top.v $top.plain.v
    idents_golden $top
    erase $top.bxref

    erase $top.plain.v
}

if { $vtest == 1 } {

# a static loop, a recursive function, implicit conditions, a method;
# the census run keeps the positions of method conditions, which the
# census checks against the chains of the method calls
metadata_golden MetaDump sysMetaDump -keep-method-conds

# Binders and alias classes: every cell bound to a parameter (an
# argument, a let-bound value) or moved into a field or operand of a
# struct or another lazy application carries that binder, and cells
# that hold one value (a value that evaluates to another, a reference
# re-heaped under a condition, a value extracted from a tagged union
# and the operand cell its constructor application moved, which is not
# a kept cell and appears only as the root of that class) share a
# class, pinned by the dump of a package exercising each; the census
# checks the name hints of the cells bound to a parameter against their
# binders
metadata_golden MetaBinder sysMetaBinder

# The side file of a module in which one expression (a + b) is built
# under two rules and a method, so that the rebuild's CSE identifies
# three cells as one def standing for three contexts (merged, and one
# alias class), the argument of a function is bound to its parameter
# (binder), a def's value is read by another def (parent), a value
# evaluates to another (alias) and a static loop counts its iterations.
metadata_golden MetaSide sysMetaSide

# The ledger the packages carry, on the side-file module: the plain
# Verilog, against which the runs below are compared
erase MetaSide.bo
compile_verilog_pass MetaSide.bsv sysMetaSide
move sysMetaSide.v sysMetaSide.plain.v

# -dmetadata: the ledger after the ISyntax stages, the APackage stages
# and the ASPackage stages (the table's sizes and its events, those of
# every pass since elaboration on the package's def, rule, method and
# instance ids, and after each group the resolution of each def and
# rule that stands for other ids), printed only when that dump is
# requested; -metadata-check asserts at every pass boundary, from
# iInlineFmt to finalCleanup, that the package's ids follow the events;
# the Verilog does not change
erase MetaSide.bo
erase MetaSide.ledger
compile_verilog_pass MetaSide.bsv sysMetaSide {-dmetadata=MetaSide.ledger -metadata-check}
compare_file sysMetaSide.v sysMetaSide.plain.v
compare_file MetaSide.ledger
erase MetaSide.ledger

# -bxref: the module's cross-reference file, sysMetaSide.bxref, written
# beside the .ba with the metadata table and the ledger as it stands
# after the Verilog backend.  The Verilog does not change, and the .ba
# is byte for byte the plain compile's: the file is a companion of the
# .ba, not a part of it.  dumpbxref renders the table line for line as
# the side file of the same run (both through filter_side) and the
# events as -dmetadata prints them after the last ASPackage pass (the
# finalcleanup section of the ledger expectation above, under the
# file's stage name).
erase MetaSide.bo
erase sysMetaSide.ba
compile_verilog_pass MetaSide.bsv sysMetaSide {-elab}
compare_file sysMetaSide.v sysMetaSide.plain.v
move sysMetaSide.ba sysMetaSide.plain.ba
erase MetaSide.bo
erase sysMetaSide.bxref
erase sysMetaSide.metadata
compile_verilog_pass MetaSide.bsv sysMetaSide {-bxref -elab -metadata-out .}
compare_file sysMetaSide.v sysMetaSide.plain.v
compare_file sysMetaSide.ba sysMetaSide.plain.ba
if { [do_internal_checks] } {
    dumpbxref sysMetaSide.bxref --table
    filter_side [make_dumpbxref_output_name sysMetaSide.bxref]
    filter_side sysMetaSide.metadata
    compare_file sysMetaSide.bxref.dumpbxref-out.sorted sysMetaSide.metadata.sorted
    dumpbxref sysMetaSide.bxref --events
    final_ledger MetaSide.ledger.expected MetaSide.ledger.final
    compare_file [make_dumpbxref_output_name sysMetaSide.bxref] MetaSide.ledger.final
    erase MetaSide.ledger.final
}
erase sysMetaSide.metadata
erase sysMetaSide.bxref
erase sysMetaSide.ba
erase sysMetaSide.plain.ba
erase sysMetaSide.plain.v

# The known-answer goldens, one shape of chain each.
# a vector map: element i is built in iteration i of the map
metadata_golden MetaVecMap sysMetaVecMap

# nested static loops: inner iterations under the outer iteration
metadata_golden MetaNested sysMetaNested

# a loop re-entered from its own body: a zipWith over a vector of vectors
# runs the library's zipWith loop inside an iteration of itself, so one
# static loop site is on a chain twice, as two dynamic instances; the
# census counts the site's nested instances and its nesting depth
metadata_golden MetaReenter sysMetaReenter

# a local recursive binding (a primFix loop)
metadata_golden MetaFix sysMetaFix

# two functions recursive through each other
metadata_golden MetaMutual sysMetaMutual

# one expression built under two rules: a CSE merge, whose def stands
# for two contexts
metadata_golden MetaCSE sysMetaCSE

# a cross-package call site against the same call inside the package
erase MetaCrossLib.bo
compile_pass MetaCrossLib.bsv
metadata_golden MetaCross sysMetaCross

# The ledger goldens, one small package per event shape, pinned as
# -dmetadata prints the ledger after iDropRules, after aDropUndet and
# after finalCleanup (the events of every pass since elaboration and
# the resolution of each def and rule that stands for other ids), with
# -metadata-check asserting at every pass boundary that the ids of the
# package follow the events, and the .bxref of the same run carrying
# the events the dump printed after the last ASPackage pass; the
# Verilog does not change with any of the flags.  "extra" names other
# flags of both compiles.
proc ledger_golden { pkg top {extra {}} } {
    erase $pkg.bo
    compile_verilog_pass $pkg.bsv $top "$extra"
    move $top.v $top.plain.v

    erase $pkg.bo
    erase $pkg.ledger
    erase $top.bxref
    compile_verilog_pass $pkg.bsv $top "-dmetadata=$pkg.ledger -metadata-check -bxref $extra"
    compare_file $top.v $top.plain.v
    compare_file $pkg.ledger
    if { [do_internal_checks] } {
        dumpbxref $top.bxref --events
        final_ledger $pkg.ledger $pkg.ledger.final
        compare_file [make_dumpbxref_output_name $top.bxref] $pkg.ledger.final
        erase $pkg.ledger.final
    }
    idents_golden $top
    erase $pkg.ledger
    erase $top.bxref
    erase $top.plain.v
}

# the Fmt defs of a display, inlined into its foreign call by iInlineFmt
ledger_golden MetaFmt sysMetaFmt

# a def used once, inlined into its user by iInline
ledger_golden MetaInline sysMetaInline

# two defs the transform stage's CSE merges after its local rewrite
ledger_golden MetaMerge sysMetaMerge

# a rule split on its condition: one rule per arm, from the root
ledger_golden MetaSplit sysMetaSplit

# a condition lifted into a conditional expression, which the second
# transform stage makes a def created from the rule
ledger_golden MetaLift sysMetaLift

# a rule that never fires, dropped by iDropRules
ledger_golden MetaDrop sysMetaDrop

# The ledger of aConv and the ASyntax passes, one small package per
# event shape of plan section 15, pinned the same way: the finalcleanup
# block holds the events of state generation and the backend passes and
# the resolution of each def of the final package.

# a method-call port def: the write port of a register written by two
# rules and a method is a mux whose selector, value and output defs
# aState creates from the rules and the method, and whose output def
# aRenameIO renames to the Verilog port name
ledger_golden MetaPort sysMetaPort

# a CAN_FIRE signal: the CAN_FIRE and WILL_FIRE defs of two conflicting
# rules, created from the rules by the schedule stage, the CAN_FIRE
# inlined into the WILL_FIRE by aExpand
ledger_golden MetaFire sysMetaFire

# a def inlined by aExpand: a chain of single-use defs inlined into the
# write port that uses them
ledger_golden MetaExpand sysMetaExpand

# a renamed instance port: a FIFO's enqueue and dequeue port defs,
# renamed from method notation to the Verilog port names
ledger_golden MetaRename sysMetaRename

# a def created by aOpt: under -opt-if-mux the condition of an if turned
# into a mux becomes a def of its own, created from the def optimized
ledger_golden MetaOpt sysMetaOpt -opt-if-mux

# a merge in aConv where the source name won over the CSE name: a
# function argument bound to a parameter and used twice keeps the
# parameter's name through the ISyntax passes, is merged into the CSE
# def of its expression and gives the CSE def its name back
ledger_golden MetaNamed sysMetaNamed

# a mutually exclusive pair: the scheduler adds a rule whose assumption
# checks the exclusion at run time, created (Schedule) from the first
# rule of the pair and dropped (State) once its CAN_FIRE and WILL_FIRE
# stand for it; beside it a conflict-free pair, whose condition wires
# are instances created (AddCFConditionWires) and dropped
# (InlineWires), and a preempting pair, which adds no id
ledger_golden MetaExclusive sysMetaExclusive

# a starved rule, dropped (DumpSchedule) under -remove-starved-rules
# after the schedule stage made its CAN_FIRE and WILL_FIRE; the write
# port's mux and enable, built with an arm for its uses, are created
# (State) from the rule that stays alone
ledger_golden MetaStarved sysMetaStarved -remove-starved-rules

# The identifier records at the Verilog level (plan section 16), on the
# packages above: a method's ports stand for the method (MetaPort), an
# instance and its ports for the instance (MetaRename), a rule's firing
# signals for the rule (MetaFire), the defs inlined into an identifier
# for their records (MetaExpand), and the clock and the reset for
# nothing, pinned.

# a module parameter: pinned among the unresolved identifiers
ledger_golden MetaParam sysMetaParam

# -remove-dollar: the instance ports are spelled without '$', and each
# record names the id of the final package it was printed from
erase MetaRename.bo
erase sysMetaRename.bxref
compile_verilog_pass MetaRename.bsv sysMetaRename {-bxref -metadata-check -remove-dollar}
idents_golden sysMetaRename sysMetaRename.nodollar.idents.expected
erase sysMetaRename.bxref

}
