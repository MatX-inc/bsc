# Per-fragment compilation: one .ba, one .bir, one .o.
#
# The gate is BYTE IDENTITY.  A fragment built ALONE -- its own .bir,
# no bindings, nothing of the design -- must produce exactly the
# object the design build writes, and the design must then reuse it
# rather than recompile.  Anything weaker passes while the object
# quietly depends on its design: symbols would be filed under names
# no other design looks for and reuse would silently MISS, which is
# how every defect in this area has behaved (reset-table ordinals, a
# region's slot order, a shared body baking its call-site origin).
#
# The object's NAME is part of the contract: `mkLeaf.o', predictable
# from the .bir without asking the compiler.  That is what lets a
# build system name a fragment's object, and it is only sound because
# a module type compiles to exactly one object -- which the compiler
# checks and refuses to violate.
#
# EVERY synthesized module gets one, the top included: a top is a
# module whose interface happens to be Empty, not a special case, so
# `sysFragObj.o' exists alongside `mkLeaf.o' and the design is
# assembled from the two.  That is the last gate here -- 2 of 2
# reused -- and it is what makes a design build a LINK over objects
# rather than a compile of the whole thing.  It also has to hold
# whatever the top contains, which is why the top's object is checked
# for byte identity the same way the child's is.
#
# mkLeaf is instantiated at k=3 and k=7 and both must still behave
# correctly from the one shared body, since the value now reaches it
# through the arena rather than through the code.
#
# The trs binary comes from $TRS or the PATH; UNSUPPORTED when absent
# or built without the jit feature.

proc trs_fragobj_test { trs name top } {
    global srcdir subdir bsc

    bsc_initialize
    set here [absolute $srcdir]
    cd [file join $here $subdir]

    set log "$name.fo-out"
    set flags "-no-show-timestamps -no-show-version"
    set trsbir [file join [file dirname $bsc] trs-bir]
    set work "$name.wk"
    file delete -force $work
    file mkdir $work

    if { [catch {exec sh -c "$bsc $flags -sim -u -g $top -g mkLeaf $name.bsv > $log 2>&1 && $trsbir mkLeaf.ba >> $log 2>&1 && $trsbir $top.ba >> $log 2>&1 && $trs link $top.bir -o $work/design >> $log 2>&1"}] } {
        fail "trs fragobj compile/export/link of $name (log `$log')"
        cd $here
        return
    }

    # the design build, writing its objects out
    if { [catch {exec sh -c "$trs compile $work/design.bir --obj-out $work/indesign -o $work/design.so >> $log 2>&1"}] } {
        fail "trs fragobj design compile of $name (log `$log')"
        cd $here
        return
    }
    # named for the module and nothing else -- no hash to look up --
    # and the TOP gets one too, on the same terms
    set got [glob -nocomplain -tails -directory $work/indesign *.o]
    if { ![file exists $work/indesign/mkLeaf.o] } {
        fail "trs fragobj: the design did not write mkLeaf.o (got: $got)"
        cd $here
        return
    }
    pass "trs fragobj $name: the object is named mkLeaf.o"
    if { ![file exists $work/indesign/$top.o] } {
        fail "trs fragobj: the design did not write $top.o -- a top is a\
              module like any other (got: $got)"
        cd $here
        return
    }
    pass "trs fragobj $name: the top gets an object too, $top.o"

    # built ALONE: its own directory, its own link, no bindings
    set d "$work/alone"
    file mkdir $d
    file copy -force mkLeaf.bir $d/mkLeaf.bir
    set ok 1
    if { [catch {exec sh -c "cd $d && $trs link --fragment mkLeaf.bir -o frag >> ../../$log 2>&1 && $trs compile --fragment frag.bir --obj-out . >> ../../$log 2>&1"}] } {
        fail "trs fragobj standalone build of mkLeaf.o (log `$log')"
        set ok 0
    } elseif { ![file exists $d/mkLeaf.o] } {
        fail "trs fragobj standalone build produced no mkLeaf.o"
        set ok 0
    } elseif { [catch {exec cmp -s $work/indesign/mkLeaf.o $d/mkLeaf.o}] } {
        fail "trs fragobj: mkLeaf.o built alone differs from the design's"
        set ok 0
    } else {
        pass "trs fragobj $name: built alone, with no bindings, byte-identical"
    }

    # the TOP, built as a fragment in its own tree.  Linking a top
    # with --fragment walks its instantiations, so this one build
    # yields the whole set -- which is the point: the objects a design
    # needs are the objects its modules compile to, nothing else.
    set t "$work/topalone"
    file mkdir $t
    foreach b [list $top mkLeaf] { file copy -force $b.bir $t/$b.bir }
    if { $ok } {
        if { [catch {exec sh -c "cd $t && $trs link --fragment $top.bir -o tf > link.out 2>&1 && $trs compile --fragment tf.bir --obj-out . > comp.out 2>&1"}] } {
            fail "trs fragobj: fragment build of the top (logs in `$t')"
            set ok 0
        } elseif { ![file exists $t/$top.o] } {
            fail "trs fragobj: the top's fragment build produced no $top.o"
            set ok 0
        } elseif { [catch {exec cmp -s $work/indesign/$top.o $t/$top.o}] } {
            fail "trs fragobj: $top.o differs built as a fragment"
            set ok 0
        } else {
            pass "trs fragobj $name: the top's object is byte-identical too"
        }
    }

    # and the design assembles ENTIRELY from objects -- every module
    # it contains, reused, nothing recompiled
    if { $ok } {
        file copy -force $d/mkLeaf.o $t/mkLeaf.o
        if { [catch {exec sh -c "$trs compile $work/design.bir --obj-in $t -o $work/design.so 2> $work/reuse.txt"}] } {
            fail "trs fragobj reuse compile of $name (log `$work/reuse.txt')"
            set ok 0
        } else {
            set fh [open $work/reuse.txt]; set reuse [read $fh]; close $fh
            if { [regexp {2 of 2 fragment objects reused} $reuse] } {
                pass "trs fragobj $name: the design assembles from objects alone"
            } else {
                fail "trs fragobj $name: expected 2 of 2 reused, got: $reuse"
                set ok 0
            }
        }
    }

    # honesty: two instantiations, one body, still the right answers
    if { $ok } {
        if { [catch {exec sh -c "cp $work/design.so $work/design.exe.so 2>/dev/null; TRS=$trs $work/design > $name.trs-run-out 2>&1"}] } {
            fail "trs fragobj artifact run of $name"
        } else {
            compare_file $name.trs-run-out $top.out.expected "trs_fragobj"
        }
    }

    if { $ok } {
        file delete -force $work
        foreach f [glob -nocomplain $top.bir mkLeaf.bir $log \
                        $name.trs-run-out] { file delete -force $f }
    }
    cd $here
}

global env
set trs_cmd "trs"
if { [info exists env(TRS)] } { set trs_cmd $env(TRS) }

if { [catch {exec sh -c "command -v $trs_cmd"}] } {
    unsupported "trs per-fragment compilation (trs not installed)"
} elseif { [catch {exec sh -c "$trs_cmd features | grep -qw jit"}] } {
    unsupported "trs per-fragment compilation (trs built without the jit feature)"
} else {
    trs_fragobj_test $trs_cmd FragObj sysFragObj
}
