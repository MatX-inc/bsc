# trs emission determinism: linking the same .bir must produce
# byte-identical pre-O3 LLVM IR (TRS_JIT_DUMP_PRE) and a
# byte-identical model .so on every invocation — HashMap iteration
# order must never reach emission (jit.rs pinned corder +
# topo-ordered hoist preludes + en_slots sort; the mechanism and
# history are in src/trs/docs/CPHASE-PLAN.md, increment 0).
#
# CountShare is the chained-fold shared-cone shape whose EMITTED SIZE
# was order-dependent before the topo fix (2^k-1 arm re-expansion of
# countOnes-style folds); HoistDivTrap covers guarded hoisted
# division (the trap guard must survive prelude reordering).  Each
# artifact also runs once against a golden .out.expected so the
# specimen designs stay honest.
#
# The trs binary comes from $TRS or the PATH; UNSUPPORTED when
# absent (the trs backend is optional tooling).

proc trs_det_test { trs name top } {
    global srcdir subdir bsc

    bsc_initialize
    set here [absolute $srcdir]
    cd [file join $here $subdir]

    set nlinks 3
    set log "$name.det-out"
    set flags "-no-show-timestamps -no-show-version"

    # Everything the comparison builds goes in a scratch directory
    # that is removed whole, so a per-run product cannot become
    # litter in a tracked source directory by being left out of a
    # cleanup list -- which is how three `.so$i' copies once escaped.
    # `work_*/' is already in the suite's clean patterns
    # (cleanonly.mk), so the one kept as failure evidence goes with a
    # `make clean' too.  The runs cd into it, so a `trs' named by a
    # relative path has to be resolved before we move.
    set work "work_$name"
    file delete -force $work
    file mkdir $work
    if { [string match "*/*" $trs] } { set trs [file normalize $trs] }

    # trs-bir writes the .bir, and installs beside bsc
    set trsbir [file join [file dirname $bsc] trs-bir]
    if { [catch {exec sh -c "$bsc $flags -sim -u -g $top $name.bs > $log 2>&1 && $bsc $flags -sim -e $top -o $top.ref >> $log 2>&1 && $trsbir $top.ba >> $log 2>&1"}] } {
        fail "trs determinism compile/export of $name (log `$log')"
        cd $here
        return
    }

    # Every run builds under the SAME artifact name and the result is
    # copied aside afterwards.  The linker stamps a shared object with
    # its own output path, so artifacts built as art1/art2/art3 would
    # differ in that stamp alone and the comparison below could never
    # hold -- the thing under test is the codegen, not the filename.
    for {set i 1} {$i <= $nlinks} {incr i} {
        if { [catch {exec sh -c "cd $work && $trs link ../$top.bir -o $name.det > /dev/null 2>&1 && TRS_JIT_DUMP_PRE=1 $trs compile $name.det.bir > /dev/null 2> $name.ir$i && cp $name.det.so $name.so$i"}] } {
            fail "trs determinism link/compile of $name (run `$i')"
            cd $here
            return
        }
    }

    set ok 1
    for {set i 2} {$i <= $nlinks} {incr i} {
        if { [catch {exec cmp -s $work/$name.ir1 $work/$name.ir$i}] } {
            fail "pre-O3 IR identical across links of $name (run `$i' differs)"
            set ok 0
        }
        if { [catch {exec cmp -s $work/$name.so1 $work/$name.so$i}] } {
            fail "artifact .so identical across links of $name (run `$i' differs)"
            set ok 0
        }
    }
    if { $ok } {
        pass "pre-O3 IR and artifact .so identical across links of $name"
    }

    # artifact honesty: one run against the golden output
    if { [catch {exec sh -c "cd $work && TRS=$trs ./$name.det > $name.trs-run-out 2>&1"}] } {
        fail "trs artifact run of $name"
        set ok 0
    } else {
        if { [compare_file $work/$name.trs-run-out $top.out.expected "trs_determinism"] } {
            set ok 0
        }
    }

    # The scratch directory holds everything the comparison built;
    # keep it when something failed, because the IR dumps are the
    # evidence.  Everything else this test puts in the source
    # directory -- the bsc products included, named one by one rather
    # than swept with a `sys*' glob that would take the goldens with
    # them -- goes unconditionally, so a pass leaves the directory
    # exactly as it found it.
    set scratch [glob -nocomplain \
        $name.det* $name.bo $top.ba $top.ref* $top.bir* \
        $top.cxx $top.h $top.o model_$top.cxx model_$top.h model_$top.o]
    foreach f $scratch { file delete -force $f }
    if { $ok } { file delete -force $work }
    cd $here
}

global env
set trs_cmd "trs"
if { [info exists env(TRS)] } { set trs_cmd $env(TRS) }

if { [catch {exec sh -c "command -v $trs_cmd"}] } {
    unsupported "trs emission determinism (trs not installed)"
} elseif { [catch {exec sh -c "$trs_cmd features | grep -qw jit"}] } {
    # `trs link` emits the model .so (and the TRS_JIT_DUMP_PRE IR the
    # identity checks compare) only when trs was built with the jit
    # feature (LLVM_SYS_181_PREFIX at build time).  A plain
    # `make install-src` installs the interpreter-only trs, whose links
    # produce a wrapper and no .so at all -- so probe the feature set
    # and mark the directory UNSUPPORTED rather than failing on absent
    # files.
    unsupported "trs emission determinism (trs built without the jit feature)"
} else {
    trs_det_test $trs_cmd CountShare sysCountShare
    trs_det_test $trs_cmd HoistDivTrap sysHoistDivTrap
}
