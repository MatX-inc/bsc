package ReplayIncrementalChild where

import ReplayIncrementalHelper

interface ReplayIncremental =
    put :: Bit 8 -> Action {-# arg_names = [value] #-}
    result :: Bit 8

{-# synthesize mkReplayIncrementalChild #-}
mkReplayIncrementalChild :: Module ReplayIncremental
mkReplayIncrementalChild = module
    saved :: Reg (Bit 8) <- mkReg 0
    interface ReplayIncremental
        put value = saved := replayIncrement value
        result = saved
