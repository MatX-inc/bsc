package Evidence where

interface Evidence =
    result :: Bit 8

{-# properties mkEvidence = { synthesize, alwaysReady } #-}
mkEvidence :: Module Evidence
mkEvidence = module
    saved :: Reg (Bit 8) <- mkReg 0
    interface
#ifdef UNPROVED
        result = saved when saved == 0
#else
        result = saved
#endif
