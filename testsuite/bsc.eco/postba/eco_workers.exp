# Proposal generation, candidate evaluation and plan replay in worker
# processes: the pool mechanics, then the public example flow run sequentially
# and with ECO_WORKERS=3, whose flow results, search artifacts, finish outputs
# and branch replay must be byte-identical.
namespace eval eco_workers {
 set here [file dirname [file normalize [info script]]]
 set bluehs [which bluehs]
 if {[info exists ::env(ECO_BLUEHS)]} {set bluehs $::env(ECO_BLUEHS)}
 set sdk [file normalize [file join $here .. .. .. eco-sdk]]
 if {[info exists ::env(ECO_SDK)]} {set sdk $::env(ECO_SDK)}
 set yosys [which yosys]
 if {[info exists ::env(ECO_YOSYS)]} {set yosys $::env(ECO_YOSYS)}
 set sourceFlag "-i[file join $sdk lib]"
 if {$bluehs == 0 || ![file executable $bluehs] || ![file exists [file join $sdk build.manifest]] || $yosys == 0 || ![file executable $yosys]} {
  unsupported "ECO workers: matched bluehs/Yosys unavailable"
 } else {
  set root [file normalize [file join [pwd] eco-workers-[pid]-[clock clicks]]]
  file mkdir $root
  set log [file join $root pool.log]
  if {[catch {exec $bluehs $sourceFlag [file join $here ASTWorkers.hs] [file join $root pool] >$log 2>@1} message]} {
   fail "ECO workers: pool mechanics"
   set f [open $log];verbose -log [read $f] 0;close $f
  } else {pass "ECO workers: pool mechanics"}
  set example [file join $here .. .. .. util eco examples run.sh]
  set ok 1
  # Both runs use the same output path, so receipts binding path-dependent files compare too.
  foreach {name workers} {sequential {} workers 3} {
   set out [file join $root run]
   set log [file join $root "$name.log"]
   set command [list env]
   if {$workers eq {}} {lappend command -u ECO_WORKERS} else {lappend command ECO_WORKERS=$workers}
   lappend command bash $example [which_bsc] $bluehs $sdk $yosys $::env(BLUESPECDIR) $out
   if {[catch {exec {*}$command >$log 2>@1} message]} {
    fail "ECO workers: example flow $name";set f [open $log];verbose -log [read $f] 0;close $f;set ok 0
   } else {pass "ECO workers: example flow $name"}
   file rename $out [file join $root $name]
  }
  if {$ok} {
   set a [file join $root sequential];set b [file join $root workers]
   set same 1;set compared 0
   # every file the search, finish and branch replay produced, except the
   # receipts that bind the native captures (which bsc names per run)
   set files [list [file join flow mkFanoutLoss.v] [file join flow summary.txt]]
   foreach dir [list [file join flow ordinary-search] finished replayed-branch replayed-flow] {
    if {![file isdirectory [file join $a $dir]]} continue
    foreach fa [exec find [file join $a $dir] -type f] {lappend files [string range $fa [expr {[string length $a] + 1}] end]}
   }
   foreach f $files {
    if {[string match *.outcome $f] || [string match *.log $f]} continue
    if {[lsearch -exact {finish-order.report receipt.json report.json upstream-qualification.json} [file tail $f]] >= 0} continue
    set fa [file join $a $f];set fb [file join $b $f]
    if {![file isfile $fa]} continue
    incr compared
    if {![file exists $fb] || [catch {exec cmp -s $fa $fb}]} {set same 0;verbose -log "differs: $fa" 0}
   }
   if {$same && $compared > 0} {pass "ECO workers: search, finish and replay outputs byte-identical"} else {fail "ECO workers: search, finish and replay outputs byte-identical"}
   set candidates [glob -nocomplain -directory [file join $a flow ordinary-search] candidate-*.ast]
   set records [glob -nocomplain -directory [file join $b flow ordinary-search] *.outcome]
   set proposals [glob -nocomplain -directory [file join $b flow ordinary-search proposals] -type d *]
   set leftovers [list]
   foreach round $proposals {foreach f [glob -nocomplain -directory $round *] {if {![string match *.outcome $f]} {lappend leftovers $f}}}
   if {[llength $candidates] == 0 || ([llength $records] > 0 && [llength $proposals] > 0 && [llength $leftovers] == 0)} {pass "ECO workers: worker processes proposed and evaluated the candidates"} else {fail "ECO workers: worker processes proposed and evaluated the candidates"}
   set replays [list];set proofs [list]
   foreach dir {replayed-branch replayed-flow} {
    lappend replays {*}[glob -nocomplain -directory [file join $b $dir] proof-*.outcome]
    lappend proofs {*}[glob -nocomplain -directory [file join $a $dir] proof-*.json]
   }
   if {[llength $proofs] == 0 || [llength $replays] > 0} {pass "ECO workers: worker processes replayed the plan's proofs"} else {fail "ECO workers: worker processes replayed the plan's proofs"}
  }
 }
}
