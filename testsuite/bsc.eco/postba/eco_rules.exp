namespace eval eco_rules {
    set here [file dirname [file normalize [info script]]]
    set bluehs [which bluehs]
    if {[info exists ::env(ECO_BLUEHS)]} {set bluehs $::env(ECO_BLUEHS)}
    set sdk [file normalize [file join $here .. .. .. eco-sdk]]
    if {[info exists ::env(ECO_SDK)]} {set sdk $::env(ECO_SDK)}
    set sourceFlag "-i[file join $sdk lib]"
    set yosys [which yosys]
    if {[info exists ::env(ECO_YOSYS)]} {set yosys $::env(ECO_YOSYS)}
    if {$bluehs == 0 || ![file executable $bluehs] || ![file exists [file join $sdk build.manifest]]} {
        unsupported "ECO rules: matched bluehs runtime unavailable"
    } else {
        set root [file normalize [file join [pwd] eco-rules-[pid]-[clock clicks]]]
        file mkdir $root
        foreach name {TransformTest TransformProofTest} {
            set script [file join $here .. .. eco ast "$name.hs"]
            set args {}
            if {$name eq "TransformProofTest"} {
                if {$yosys == 0 || ![file executable $yosys]} {
                    unsupported "ECO rules: Yosys unavailable"; continue
                }
                set args [list $yosys [file join $root $name]]
            }
            set log [file join $root "$name.log"]
            if {[catch {exec $bluehs $sourceFlag $script {*}$args >$log 2>@1} message]} {
                fail "ECO rules: $name"
                set f [open $log]; verbose -log [read $f] 0; close $f
            } else {pass "ECO rules: $name"}
        }
    }
}
