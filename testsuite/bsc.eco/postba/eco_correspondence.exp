namespace eval eco_correspondence {
    set here [file dirname [file normalize [info script]]]
    set bluehs [which bluehs]
    if {[info exists ::env(ECO_BLUEHS)]} {set bluehs $::env(ECO_BLUEHS)}
    set sdk [file normalize [file join $here .. .. .. eco-sdk]]
    if {[info exists ::env(ECO_SDK)]} {set sdk $::env(ECO_SDK)}
    set sourceFlag "-i[file join $sdk lib]"
    set yosys [which yosys]
    if {[info exists ::env(ECO_YOSYS)]} {set yosys $::env(ECO_YOSYS)}
    if {$bluehs == 0 || ![file executable $bluehs] || ![file exists [file join $sdk build.manifest]] || $yosys == 0 || ![file executable $yosys]} {
        unsupported "ECO correspondence: matched bluehs/Yosys unavailable"
    } else {
        set root [file normalize [file join [pwd] eco-correspondence-[pid]-[clock clicks]]]
        set log "$root.log"
        if {[catch {exec $bluehs $sourceFlag [file join $here Correspondence.hs] $yosys $root >$log 2>@1} message]} {
            fail "ECO correspondence: typed width roles, exact leaf permutations and proof controls"
            set f [open $log]; verbose -log [read $f] 0; close $f
        } else {pass "ECO correspondence: typed width roles, exact leaf permutations and proof controls"}
    }
}

namespace eval eco_value_names {
    set here [file dirname [file normalize [info script]]]
    set bluehs [which bluehs]
    if {[info exists ::env(ECO_BLUEHS)]} {set bluehs $::env(ECO_BLUEHS)}
    set sdk [file normalize [file join $here .. .. .. eco-sdk]]
    if {[info exists ::env(ECO_SDK)]} {set sdk $::env(ECO_SDK)}
    set sourceFlag "-i[file join $sdk lib]"
    set yosys [which yosys]
    if {[info exists ::env(ECO_YOSYS)]} {set yosys $::env(ECO_YOSYS)}
    if {$bluehs == 0 || ![file executable $bluehs] || ![file exists [file join $sdk build.manifest]] || $yosys == 0 || ![file executable $yosys]} {
        unsupported "ECO value names: matched bluehs/Yosys unavailable"
    } else {
        set root [file normalize [file join [pwd] eco-value-names-[pid]-[clock clicks]]]
        set log "$root.log"
        if {[catch {exec $bluehs $sourceFlag [file join $here ValueNames.hs] $yosys $root >$log 2>@1} message]} {
            fail "ECO value names: value-only effect arguments and protected identity controls"
            set f [open $log]; verbose -log [read $f] 0; close $f
        } else {pass "ECO value names: value-only effect arguments and protected identity controls"}
    }
}
