# Native AST synthesis-translated reporting; original emitted RTL is not parsed.
namespace eval eco_translated_metrics {
 set here [file dirname [file normalize [info script]]]
 set bluehs [which bluehs]
 if {[info exists ::env(ECO_BLUEHS)]} {set bluehs $::env(ECO_BLUEHS)}
 set sdk [file normalize [file join $here .. .. .. eco-sdk]]
 if {[info exists ::env(ECO_SDK)]} {set sdk $::env(ECO_SDK)}
 set sourceFlag "-i[file join $sdk lib]"
 if {$bluehs == 0 || ![file executable $bluehs] || ![file exists [file join $sdk build.manifest]]} {
  unsupported "ECO translated metrics: matched bluehs unavailable"
 } else {
  set root [file normalize [file join [pwd] eco-translated-metrics-[pid]-[clock clicks]]]
  file mkdir $root
  set log [file join $root pure.log]
  if {[catch {exec $bluehs $sourceFlag [file join $here ASTTranslatedMetric.hs] pure [file join $root pure] >$log 2>@1} message]} {
   fail "ECO translated metrics: native toggle, comment and structural controls"
   set f [open $log]; verbose -log [read $f] 0; close $f
  } else {pass "ECO translated metrics: native toggle, comment and structural controls"}
  set contexts {}; set ok 1
  foreach side {old new} {
   set dir [file join $root $side];file mkdir $dir
   set args [list [which_bsc] -u -cpp -verilog -elab -no-show-timestamps -g mkTranslatedMetric -bdir $dir -vdir $dir -info-dir $dir -eco-capture [file join $dir capture]]
   if {$side eq "new"} {lappend args -Xcpp -DECO_NEW}
   lappend args [file join $here TranslatedMetric.bs]
   if {[catch {exec {*}$args >$dir/capture.log 2>@1} message]} {
    fail "ECO translated metrics: BH capture $side";verbose -log $message 0;set ok 0
   } else {pass "ECO translated metrics: BH capture $side"}
   lappend contexts [file join $dir capture mkTranslatedMetric.eco-ast]
  }
  if {$ok} {
   set log [file join $root captures.log]
   if {[catch {exec $bluehs $sourceFlag [file join $here ASTTranslatedMetric.hs] captures {*}$contexts [file join $root checks] >$log 2>@1} message]} {
    fail "ECO translated metrics: authenticated translated and whole-file counts"
    set f [open $log];verbose -log [read $f] 0;close $f
   } else {pass "ECO translated metrics: authenticated translated and whole-file counts"}
   set log [file join $root cli.log]
   if {[catch {exec $bluehs $sourceFlag [file join $sdk scripts measure-translated.hs] {*}$contexts [file join $root cli] >$log 2>@1} message]} {
    fail "ECO translated metrics: packaged CLI";set f [open $log];verbose -log [read $f] 0;close $f
   } else {pass "ECO translated metrics: packaged CLI"}
  }
 }
}
