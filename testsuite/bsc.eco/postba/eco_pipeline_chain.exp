namespace eval eco_pipeline_chain {
    set here [file dirname [file normalize [info script]]]
    set bluehs [which bluehs]
    if {[info exists ::env(ECO_BLUEHS)]} {set bluehs $::env(ECO_BLUEHS)}
    set sdk [file normalize [file join $here .. .. .. eco-sdk]]
    if {[info exists ::env(ECO_SDK)]} {set sdk $::env(ECO_SDK)}
    set yosys [which yosys]
    if {[info exists ::env(ECO_YOSYS)]} {set yosys $::env(ECO_YOSYS)}
    if {$bluehs == 0 || ![file executable $bluehs] || ![file exists [file join $sdk build.manifest]] || $yosys == 0 || ![file executable $yosys]} {
        unsupported "ECO pipeline chain: matched bluehs/Yosys unavailable"
    } else {
        set root [file normalize [file join [pwd] eco-pipeline-chain-[pid]-[clock clicks]]]
        set log "$root.log"
        if {[catch {exec $bluehs "-i[file join $sdk lib]" [file join $here PipelineChain.hs] $yosys $root >$log 2>@1} message]} {
            fail "ECO pipeline chain: typed roles, whole-group alpha proofs and negative controls"
            set f [open $log]; verbose -log [read $f] 0; close $f
        } else {pass "ECO pipeline chain: typed roles, whole-group alpha proofs and negative controls"}
    }
}
