# Generic native-AST candidate and proof/replay checks; no MatX source here.
namespace eval eco_alias_orientation {
    if {[eco_sdk_env "ECO alias orientation" yosys]} {
        set root [file normalize [file join [pwd] eco-alias-orientation-[pid]-[clock clicks]]]
        file mkdir $root
        set script [file join $here ASTAliasOrientation.hs]
        eco_run_script "ECO alias orientation: directed candidate/proof/replay" [file join $root directed.log] $script [file join $root run] $script $yosys
    }
}
