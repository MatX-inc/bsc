namespace eval eco_matching {
    set here [file dirname [file normalize [info script]]]
    set bluehs [which bluehs]
    if {[info exists ::env(ECO_BLUEHS)]} {set bluehs $::env(ECO_BLUEHS)}
    set sdk [file normalize [file join $here .. .. .. eco-sdk]]
    if {[info exists ::env(ECO_SDK)]} {set sdk $::env(ECO_SDK)}
    set sourceFlag "-i[file join $sdk lib]"
    if {$bluehs == 0 || ![file executable $bluehs] || ![file exists [file join $sdk build.manifest]]} {
        unsupported "ECO matching: matched bluehs runtime unavailable"
    } else {
        set root [file normalize [file join [pwd] eco-matching-[pid]-[clock clicks]]]
        file mkdir $root
        set scripts [list [file join $here ASTPlan.hs] [file join $here Audit.hs] [file join $here .. rename Rename.hs]]
        foreach name {MatchTest GraphTest AggressiveTest LocalRolesTest} {
            lappend scripts [file join $here .. .. eco match "$name.hs"]
        }
        foreach script $scripts {
            set label [file rootname [file tail $script]]
            set log [file join $root "$label.log"]
            if {[catch {exec $bluehs $sourceFlag $script >$log 2>@1} message]} {
                fail "ECO matching: $label"
                set f [open $log]; verbose -log [read $f] 0; close $f
            } else {pass "ECO matching: $label"}
        }
    }
}
