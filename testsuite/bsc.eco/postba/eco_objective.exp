# External translated objective; all deployed candidates retain complete RTL.
namespace eval eco_objective {
 if {[eco_sdk_env "ECO objective" yosys]} {
  set root [file normalize [file join [pwd] eco-objective-[pid]-[clock clicks]]]
  file mkdir $root
  eco_run_script "ECO objective: search, proof and tamper controls" [file join $root directed.log] [file join $here ASTObjective.hs] [file join $root directed]
  set captures {};set ok 1
  foreach side {old new filtered} {
   set dir [file join $root $side];file mkdir $dir
   set args [list [which_bsc] -u -cpp -verilog -elab -no-show-timestamps -keep-fires -keep-inlined-boundaries -no-inline-bool -no-opt-sched -no-opt-aggressive-inline -no-opt-join-defs -no-opt-AndOr -g mkObjectiveFlow -bdir $dir -vdir $dir -info-dir $dir -eco-capture [file join $dir capture]]
   if {$side ne "old"} {lappend args -Xcpp -DECO_NEW}
   if {$side eq "filtered"} {
    set filter [file join $dir append-comment.sh]
    set f [open $filter w];puts $f {#!/bin/sh};puts $f {set -eu}
    puts $f {printf '\n// Additional filter information\n' >> "$1"}
    close $f;file attributes $filter -permissions 0755
    lappend args -verilog-filter $filter
   }
   lappend args [file join $here ObjectiveFlow.bs]
   if {[catch {exec {*}$args >$dir/capture.log 2>@1} message]} {
    fail "ECO objective: BH capture $side";verbose -log $message 0;set ok 0
   } else {pass "ECO objective: BH capture $side"}
   lappend captures [file join $dir capture mkObjectiveFlow.replay]
  }
  if {$ok} {
   set flow [file join $root flow]
   if {[eco_run_script "ECO objective: translated flow and branch selection" [file join $root flow.log] [file join $here ASTObjectiveFlow.hs] [which_bsc] {*}$captures $::env(BLUESPECDIR) [file join $sdk build.manifest] $yosys $flow]} {
    set selected "$flow-TranslatedNormalized"
    eco_run_script "ECO objective: packaged objective-aware full-flow replay" [file join $root cli-replay.log] [file join $sdk scripts replay.hs] --flow "$selected.config" $selected [file join $root cli-replay]
    eco_run_script "ECO objective: packaged translated capture flow" [file join $root cli-capture.log] [file join $sdk scripts captures.hs] --objective translated-normalized --invariants defer "$flow-cli.config"
    eco_run_script "ECO objective: translated accepted-prefix selection" [file join $root cli-select.log] [file join $sdk scripts select.hs] --translated "$selected.config" [file join $root cli-select] $selected
   }
  }
 }
}
