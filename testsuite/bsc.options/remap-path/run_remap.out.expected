IDENTICAL Foo.bo
IDENTICAL Bar.bo
IDENTICAL mkFoo.bmod
IDENTICAL mkFoo.bsched
CLEAN dirA/Foo.bo
CLEAN dirA/Bar.bo
CLEAN dirA/mkFoo.bmod
CLEAN dirA/mkFoo.bsched
REPEATABLE mkFoo.bmod
REPEATABLE mkFoo.bsched
NO-TRAILING-SLASH dirC/mkFoo.bmod
CLEAN dirC/mkFoo.bmod
IDENTICAL-ABS mkFoo.bmod
NO-TRAILING-SLASH dirC/mkFoo.bsched
CLEAN dirC/mkFoo.bsched
IDENTICAL-ABS mkFoo.bsched
