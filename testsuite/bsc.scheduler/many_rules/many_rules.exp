# Scheduling of modules with many rules.
#
# The conflict maps and the rule-pair disjointness tests visit only the
# rules that share a state instance (and, for disjointness, rules that
# both use foreign functions or that a mutually_exclusive pragma names),
# rather than all pairs of rules.

if {$vtest == 1} {

# Lock the computed schedule (blocker lists, urgency choices, and the
# arbitrary-choice warnings) for a dense conflict clique, where every
# rule pair genuinely interacts.
compile_verilog_schedule_pass DenseRules.bsv mkDenseRules
compare_file_filter_ids DenseRules.bsv.bsc-sched-out

# Lock the schedule when rule predicates share support (bits of one
# module parameter) without the rules sharing any state instance.
compile_verilog_schedule_pass GuardedRules.bsv mkGuardedRules
compare_file_filter_ids GuardedRules.bsv.bsc-sched-out

# Lock the schedule for a tile grid: local, constant-degree
# interaction (the common shape of real designs).
compile_verilog_schedule_pass GridRules.bsv mkGridRules
compare_file_filter_ids GridRules.bsv.bsc-sched-out

# The same three schedules with every rule pair tested and scanned
# (-hack-all-rule-pairs).  The .bo files are erased so that -u
# recompiles.
erase_many *.bo
compile_verilog_schedule_pass DenseRules.bsv mkDenseRules "-hack-all-rule-pairs"
compare_file_filter_ids DenseRules.bsv.bsc-sched-out
compile_verilog_schedule_pass GuardedRules.bsv mkGuardedRules "-hack-all-rule-pairs"
compare_file_filter_ids GuardedRules.bsv.bsc-sched-out
compile_verilog_schedule_pass GridRules.bsv mkGridRules "-hack-all-rule-pairs"
compare_file_filter_ids GridRules.bsv.bsc-sched-out

}
