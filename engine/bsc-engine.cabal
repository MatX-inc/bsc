cabal-version: 3.14
name:          bsc-engine
version:       2026.1
synopsis:      The bsc orchestration engine (doc/engine-first-plan.md): P1, the Bluespec libraries as one Shake graph
description:
  The coordinator of delivery-plan phase P1: builds src/Libraries (Base1,
  Base2, Base3-*) as one package graph with one non-recursive bsc worker per
  package, fed by bscdeps (the machine-readable discovery interface), and
  reproduces the Makefiles' Prelude bootstrap, Contexts.defines, bloogle,
  tconcheck and install steps. A Hooks package like the compiler components,
  so that it gets the generated Warmup and the project's determinism settings.
license:       BSD-3-Clause
build-type:    Hooks
tested-with:   GHC == 9.14.1

custom-setup
  setup-depends:
    base        >=4.18.3.0,
    Cabal       ^>=3.16,
    Cabal-hooks ^>=3.16,
    bsc-setup

executable bsc-engine
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:
    BscEngine.Libraries
    Warmup
  build-depends:
    base        >=4.18.3.0,
    containers  >=0.6.7,
    directory   >=1.3.8.5,
    filepath    >=1.4.301.0,
    shake       ^>=0.19.9,
  default-language: GHC2021
  default-extensions:
    BangPatterns,
    FlexibleContexts,
    FlexibleInstances,
    TypeSynonymInstances,
  ghc-options: -Wall -Wno-name-shadowing -Wno-unused-matches -threaded -rtsopts "-with-rtsopts=-I0 -qg"
