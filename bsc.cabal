common common_exes
  import: common_all, common_deps
  build-depends: bsc
  hs-source-dirs: src/comp/app
  -- Every program's Warmup is written by the hooks (SetupHooks.hs).
  other-modules: Warmup
  autogen-modules: Warmup
  ghc-options: -rtsopts "-with-rtsopts=-H256m -K10m -i1"

executable bsc
  import: common_exes
  ghc-options: -main-is Main_bsc
  main-is: bsc.hs

executable bluetcl
  import: common_exes
  c-sources:
    src/comp/app/bluetcl_shim.c,
  main-is: bluetcl_Main.hs
  other-modules: Bluetcl

executable bsc2bsv
  import: common_exes
  ghc-options: -main-is Main_bsc2bsv
  main-is: bsc2bsv.hs

executable bsv2bsc
  import: common_exes
  ghc-options: -main-is Main_bsv2bsc
  main-is: bsv2bsc.hs

executable dumpba
  import: common_exes
  ghc-options: -main-is Main_dumpba
  main-is: dumpba.hs

executable dumpbo
  import: common_exes
  ghc-options: -main-is Main_dumpbo
  main-is: dumpbo.hs

executable showrules
  import: common_exes
  ghc-options: -main-is Main_showrules
  main-is: showrules.hs

executable vcdcheck
  import: common_exes
  ghc-options: -main-is Main_vcdcheck
  main-is: vcdcheck.hs

executable tconcheck
  import: common_exes
  build-depends:
    containers >=0.6.7,
  ghc-options: -main-is Main_tconcheck
  main-is: tconcheck.hs

executable fstcheck
  import: common_exes
  build-depends:
    regex-compat ^>=0.95.2.2,
  ghc-options: -main-is Main_fstcheck
  main-is: fstcheck.hs

executable fstscopes
  import: common_exes
  ghc-options: -main-is Main_fstscopes
  main-is: fstscopes.hs

executable bo2bloogle
  import: common_exes
  build-depends:
    bytestring >=0.11.5.4,
    mtl >=2.3.1,
  ghc-options: -main-is Main_bo2bloogle
  main-is: bo2bloogle.hs
