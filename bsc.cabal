cabal-version: 3.14

name: bsc
version: 2026.1
synopsis: Bluespec Compiler (BSC)
description: Toolchain for the Bluespec Hardware Definition Language
homepage: https://github.com/B-Lang-org/bsc
license: BSD-3-Clause
license-file: COPYING
author: Bluespec, Inc.
maintainer: TODO
copyright: TODO
build-type: Hooks

custom-setup
  setup-depends:
    base        >=4.18.3.0,
    Cabal       ^>=3.16,
    Cabal-hooks ^>=3.16,
    directory   >=1.3.8.5,
    filepath    >=1.4.301.0,
    process     >=1.6.19.0,

-- Shared settings of the four sublibraries. The carve into
-- bsc-core / bsc-semantic / bsc-verilog / bsc-bluesim is derived from
-- the module import graph at this revision (doc/engine-first-plan.md,
-- section 2): a module reached from exactly one producer's entry modules
-- belongs to that producer; anything shared sinks to bsc-core. The
-- public library below re-exports every module, so executables and
-- external consumers are unchanged.
common lib-defaults
  build-depends:
    array        >=0.5.8.0,
    base         >=4.18.3.0,
    -- Warmup imports the rule-bearing modules of the packages listed here, so
    -- the hidden ones update-warmup.sh reports have to be named too.
    ghc-bignum   >=1.3,
    bytestring   >=0.11.5.4,
    containers   >=0.6.7,
    deepseq      >=1.4.8.1,
    directory    >=1.3.8.5,
    filepath     >=1.4.301.0,
    integer-gmp  >=1.1,
    mtl          >=2.3.1,
    old-locale   ^>=1.0.0.7,
    old-time     ^>=1.1.1.0,
    process      >=1.6.19.0,
    regex-compat ^>=0.95.2.2,
    split        ^>=0.2.5,
    strict-concurrency ^>=0.2.4.3,
    syb          ^>=0.7.2,
    text         >=2.0.2,
    time         >=1.12.2,
    unix         >=2.8.6.0,
  default-language: GHC2021
  default-extensions:
    BangPatterns,
    FlexibleContexts,
    FlexibleInstances,
    TypeSynonymInstances,
  -- From GHC 9.10 on, update-warmup.sh also reports ghc-internal, whose
  -- modules the generated Warmup then imports.
  if impl(ghc >= 9.10)
    build-depends: ghc-internal
  ghc-options: -Wall -Wno-orphans -Wno-name-shadowing -Wno-unused-matches
  hs-source-dirs:
    src/Parsec,
    src/comp,
    src/comp/GHC/posix,
    src/comp/Libs,
    src/vendor/htcl,
    src/vendor/stp/HaskellIfc,
    src/vendor/yices/v2.6/HaskellIfc,

