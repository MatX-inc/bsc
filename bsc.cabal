common common_exes
  build-depends:
    base >=4.18.3.0,
    bsc,
  default-language: GHC2021
  ghc-options: -rtsopts "-with-rtsopts=-H256m -K10m -i1"
  hs-source-dirs: src/comp/app

executable bsc
  import: common_exes
  build-depends:
    containers >=0.6.7,
    directory  >=1.3.8.5,
    filepath   >=1.4.301.0,
    mtl        >=2.3.1,
    old-time   ^>=1.1.1.0,
    process    >=1.6.19.0,
    time       >=1.12.2,
    unix       >=2.8.6.0,
  ghc-options: -main-is Main_bsc
  main-is: bsc.hs

executable bluetcl
  import: common_exes
  build-depends:
    containers   >=0.6.7,
    mtl          >=2.3.1,
    regex-compat ^>=0.95.2.2,
    syb          ^>=0.7.2,
    unix         >=2.8.6.0,
  c-sources: src/comp/app/bluetcl_shim.c
  default-extensions:
    BangPatterns,
    FlexibleContexts,
    FlexibleInstances,
    TypeSynonymInstances,
  main-is: bluetcl_Main.hs
  other-modules:
    BlueTcl

executable bsc2bsv
  import: common_exes
  ghc-options: -main-is Main_bsc2bsv
  main-is: bsc2bsv.hs

-- The P1 dependency-discovery interface (doc/engine-first-plan.md): the
-- package closure `bsc -u` would walk, as machine-readable lines, for an
-- external build coordinator.  A thin client over the library's Depend.
executable bscdeps
  import: common_exes
  build-depends:
    directory >=1.3.8.5,
  ghc-options: -main-is Main_bscdeps
  main-is: bscdeps.hs

executable bsv2bsc
  import: common_exes
  ghc-options: -main-is Main_bsv2bsc
  main-is: bsv2bsc.hs

executable dumpba
  import: common_exes
  build-depends:
    bytestring >=0.11.5.4
  ghc-options: -main-is Main_dumpba
  main-is: dumpba.hs

executable dumpbo
  import: common_exes
  build-depends:
    bytestring >=0.11.5.4
  ghc-options: -main-is Main_dumpbo
  main-is: dumpbo.hs

executable fstcheck
  import: common_exes
  build-depends:
    regex-compat ^>=0.95.2.2,
  ghc-options: -main-is Main_fstcheck
  main-is: fstcheck.hs

executable fstscopes
  import: common_exes
  ghc-options: -main-is Main_fstscopes
  main-is: fstscopes.hs

executable showrules
  import: common_exes
  build-depends:
    bytestring   >=0.11.5.4,
    containers   >=0.6.7,
    old-time     ^>=1.1.1.0,
    regex-compat ^>=0.95.2.2,
    split        ^>=0.2.5,
  ghc-options: -main-is Main_showrules
  main-is: showrules.hs

executable vcdcheck
  import: common_exes
  build-depends:
    bytestring   >=0.11.5.4,
    containers   >=0.6.7,
    regex-compat ^>=0.95.2.2,
  ghc-options: -main-is Main_vcdcheck
  main-is: vcdcheck.hs

test-suite bluetcl-tests
  build-depends:
    base      >=4.18.3.0,
    directory >=1.3.8.5,
    filepath  >=1.4.301.0,
    process   >=1.6.19.0,
  build-tool-depends: bsc:bsc, bsc:bluetcl
  default-language: GHC2021
  hs-source-dirs: testsuite
  main-is: RunTests.hs
  type: exitcode-stdio-1.0

test-suite smoke
  build-depends:
    base      >=4.18.3.0,
    directory >=1.3.8.5,
    filepath  >=1.4.301.0,
    process   >=1.6.19.0,
  build-tool-depends: bsc:bsc, bsc:bluetcl
  default-language: GHC2021
  hs-source-dirs: testsuite
  main-is: RunTests.hs
  type: exitcode-stdio-1.0

test-suite utils
  build-depends:
    base      >=4.18.3.0,
    directory >=1.3.8.5,
    filepath  >=1.4.301.0,
    process   >=1.6.19.0,
  build-tool-depends: bsc:bsc, bsc:bluetcl, bsc:showrules, bsc:vcdcheck, bsc:dumpbo
  default-language: GHC2021
  hs-source-dirs: testsuite
  main-is: RunTests.hs
  type: exitcode-stdio-1.0
