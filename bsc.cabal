cabal-version:      3.0
-- Proof-of-concept cabalization of the bsc compiler internals.
--
-- The library below contains every module that feeds the bsc, bluetcl and
-- utility executables (the same source pool that src/comp/Makefile compiles),
-- so that GHCi can load the *compiled* compiler and utilities can be plain
-- runghc scripts (see util/bluehs/).
--
-- Before building:
--   * the vendored solver libraries must exist:
--       make -C src/vendor/stp install PREFIX=$(pwd)/inst
--       make -C src/vendor/yices install PREFIX=$(pwd)/inst
--     (a normal `make install-src` build has already done this)
--   * the generated modules must exist:
--       (cd src/comp && ./update-build-version.sh && ./update-build-system.sh)
--
-- The exposed-modules list is generated; regenerate with
--   util/bluehs/gen-cabal-modules.py
name:               bsc
version:            2026.1
synopsis:           Bluespec Compiler internals as a library
license:            BSD-3-Clause
license-file:       COPYING
build-type:         Simple

library
    default-language: GHC2021
    hs-source-dirs:
        src/comp
        src/comp/Libs
        src/comp/GHC/posix
        src/Parsec
