cabal-version: 3.16

-- The Bluespec compiler as one cabal package: the library is every module of
-- src/comp with the vendored Parsec, Tcl and solver bindings, and each program
-- is an executable over it, its entry module under src/comp/app. doc/cabal.md
-- describes the build; SetupHooks.hs is the package's own Hooks module.
name: bsc
version: 2026.7
synopsis: Bluespec Compiler (BSC)
description: Toolchain for the Bluespec Hardware Definition Language
homepage: https://github.com/B-Lang-org/bsc
license: BSD-3-Clause
license-file: COPYING
author: Bluespec, Inc.
maintainer: bsc-dev@groups.io
category: Hardware
build-type: Hooks
-- The install stamp, HEAD and the version name: a commit or a tag alone is
-- then a changed source (doc/cabal.md section 2).
extra-source-files:
  build/cabal-head
  -- The scripts the hooks run, so that a source distribution carries them.
  platform.sh
  src/comp/update-build-version.sh
-- The GHCs CI builds with (.github/workflows/ci.yml).
tested-with:
  GHC == 9.4.7,
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.2,
  GHC == 9.14.1

custom-setup
  setup-depends:
    base        >=4.17.2.0 && <4.23,
    Cabal       ^>=3.16,
    Cabal-hooks ^>=3.16,
    directory   >=1.3.7.1 && <1.4,
    filepath    >=1.4.2.2 && <1.6,
    process     >=1.6.17.0 && <1.7,

-- Shared by the library and every program.
common common_all
  default-language: GHC2021
  -- An imported module that is not listed fails the build, naming it.
  ghc-options: -Werror=missing-home-modules
  ghc-options: -Wtabs -fmax-pmcheck-models=800
  ghc-options: -Wall -Wno-orphans -Wno-name-shadowing -Wno-unused-matches
  -- Deterministic object code where GHC has the flag (from 9.12.1).
  -- cabal.project puts it on every package of the build and compiles in
  -- parallel under the same condition; this copy is for a build of the
  -- package without the project file.
  if impl(ghc >= 9.12)
    ghc-options: -fobject-determinism

-- The library's packages, visible to every program as the make build's
-- PACKAGES were to each of its programs, so a program's stanza names none.
common common_deps
  build-depends:
    -- Warmup imports the exposed modules of every package named here
    -- (doc/cabal.md), so hidden boot packages such as ghc-bignum and
    -- ghc-internal are named too. The bounds run from GHC 9.4.7's boot
    -- libraries, the floor (INSTALL.md), to the next major versions after GHC
    -- 9.14.1's, the newest CI builds with (tested-with); a newer GHC needs
    -- them raised.
    array        >=0.5.4.0 && <0.6,
    base         >=4.17.2.0 && <4.23,
    bytestring   >=0.11.5.2 && <0.13,
    containers   >=0.6.7 && <0.9,
    deepseq      >=1.4.8.0 && <1.6,
    directory    >=1.3.7.1 && <1.4,
    filepath     >=1.4.2.2 && <1.6,
    ghc-bignum   >=1.3 && <1.5,
    integer-gmp  >=1.1 && <1.2,
    mtl          >=2.2.2 && <2.4,
    old-locale   ^>=1.0.0.7,
    old-time     ^>=1.1.1.0,
    process      >=1.6.17.0 && <1.7,
    regex-compat ^>=0.95.2.2,
    split        ^>=0.2.5,
    strict-concurrency ^>=0.2.4.3,
    syb          ^>=0.7.2,
    text         >=2.0.2 && <2.2,
    time         >=1.12.2 && <1.16,
    unix         >=2.7.3 && <2.9,
  if impl(ghc >= 9.10)
    build-depends: ghc-internal <9.1500

library
  import: common_all, common_deps
  -- Written by the hooks (SetupHooks.hs) into the autogen directory.
  autogen-modules: Warmup, BuildVersion
  hs-source-dirs:
    src/comp
    src/comp/Libs
    src/comp/GHC/posix
    src/Parsec
    src/vendor/htcl
    src/vendor/stp/HaskellIfc
    src/vendor/yices/v2.6/HaskellIfc
  -- The solvers, linked by name and from no directory: `make install-src`
  -- names the vendored copies in LIBRARY_PATH, any other build links the
  -- copies it has (doc/cabal.md section 2). At run time they resolve beside
  -- the binary, lib/SAT, through the rpath below, which the programs inherit.
  extra-libraries: stp, yices
  if os(osx)
    extra-libraries: c++
    ld-options: -Wl,-rpath,@loader_path/../lib/SAT
  else
    extra-libraries: stdc++
    ld-options: -Wl,-rpath,$ORIGIN/../lib/SAT
  -- FSTRead reads FST waves through the vendored libfst (the src/vendor/libfst
  -- submodule), compiled into the library with the flat accessors for its
  -- fstHier record in src/comp/fstscopes_hier.c; fstapi.c's <config.h> comes
  -- from src/libfst_config, and libfst needs zlib on every platform.
  extra-libraries: z
  include-dirs:
    src/libfst_config,
    src/vendor/libfst/src,
  c-sources:
    src/vendor/htcl/haskell.c,
    src/comp/fstscopes_hier.c,
    src/vendor/libfst/src/fastlz.c,
    src/vendor/libfst/src/fstapi.c,
    src/vendor/libfst/src/lz4.c,
  -- Every module of the library, the generated two included
  -- (autogen-modules above).
  exposed-modules:
    AAddSchedAssumps
    AAddScheduleDefs
