cabal-version: 3.14

-- The Bluespec compiler as one cabal package: the library is every module of
-- src/comp with the vendored Parsec, Tcl and solver bindings, and each program
-- is a one-module executable over it. doc/cabal.md describes the build;
-- SetupHooks.hs is the package's own Hooks module.
name: bsc
version: 2026.1
synopsis: Bluespec Compiler (BSC)
description: Toolchain for the Bluespec Hardware Definition Language
homepage: https://github.com/B-Lang-org/bsc
license: BSD-3-Clause
license-file: COPYING
author: Bluespec, Inc.
maintainer: bsc-dev@groups.io
copyright: Bluespec, Inc.
build-type: Hooks
tested-with: GHC == 9.14.1

custom-setup
  setup-depends:
    base        >=4.18.3.0,
    Cabal       ^>=3.16,
    Cabal-hooks ^>=3.16,
    directory,
    filepath,
    process,

library
  hs-source-dirs:
    src/comp
    src/comp/Libs
    src/comp/GHC/posix
    src/Parsec
    src/vendor/htcl
    src/vendor/stp/HaskellIfc
    src/vendor/yices/v2.6/HaskellIfc
  build-depends:
    -- The hook generates Warmup from the exposed modules of every package
    -- named here (doc/cabal.md), so hidden boot packages such as ghc-bignum
    -- and ghc-internal have to be named too.
    array        >=0.5.8.0,
    base         >=4.18.3.0,
    ghc-bignum   >=1.3,
    bytestring   >=0.11.5.4,
    containers   >=0.6.7,
    deepseq      >=1.4.8.1,
    directory    >=1.3.8.5,
    filepath     >=1.4.301.0,
    integer-gmp  >=1.1,
    mtl          >=2.3.1,
    old-locale   ^>=1.0.0.7,
    old-time     ^>=1.1.1.0,
    process      >=1.6.19.0,
    regex-compat ^>=0.95.2.2,
    split        ^>=0.2.5,
    strict-concurrency ^>=0.2.4.3,
    syb          ^>=0.7.2,
    text         >=2.0.2,
    time         >=1.12.2,
    unix         >=2.8.6.0,
  if impl(ghc >= 9.10)
    build-depends: ghc-internal
  default-language: GHC2021
  default-extensions:
    BangPatterns,
    FlexibleContexts,
    FlexibleInstances,
    TypeSynonymInstances,
  ghc-options: -Wall -Wno-orphans -Wno-name-shadowing -Wno-unused-matches
  -- Deterministic object code when the compiler offers it (GHC 9.14+):
  -- parity with src/comp/Makefile's probe, as a condition rather than a floor.
  if impl(ghc >= 9.14)
    ghc-options: -fobject-determinism
  if os(osx)
    extra-libraries: c++
  else
    extra-libraries: stdc++
  -- FSTRead reads FST waves through the vendored libfst (the src/vendor/libfst
  -- submodule), compiled into the library with the flat accessors for its
  -- fstHier record in src/comp/fstscopes_hier.c; fstapi.c's <config.h> comes
  -- from src/libfst_config, and libfst needs zlib on every platform.
  extra-libraries: z
  include-dirs:
    src/libfst_config,
    src/vendor/libfst/src,
  c-sources:
    src/vendor/htcl/haskell.c,
    src/comp/fstscopes_hier.c,
    src/vendor/libfst/src/fastlz.c,
    src/vendor/libfst/src/fstapi.c,
    src/vendor/libfst/src/lz4.c,
  -- Every module of the library, the generated three included (the hooks
  -- declare those autogen). The hooks refuse to configure when a module
  -- under src/comp is missing here (SetupHooks.hs, moduleListSetupHooks).
  exposed-modules:
    AAddSchedAssumps
    AAddScheduleDefs
    ABin
    ABinUtil
    ACheck
    ACleanup
    AConv
    ADropDefs
    ADropUndet
