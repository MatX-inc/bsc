common common_exes
  build-depends:
    base >=4.18.3.0,
    bsc,
  default-language: GHC2021
  ghc-options: -rtsopts "-with-rtsopts=-H256m -K10m -i1"

-- Programs whose entry module is not in this tree yet (a later step of
-- the line adds it): bo2bloogle, tconcheck, fstcheck, fstscopes

executable bsc
  import: common_exes
  build-depends:
    containers >=0.6.7,
    directory >=1.3.8.5,
    filepath >=1.4.301.0,
    mtl >=2.3.1,
    old-time ^>=1.1.1.0,
    process >=1.6.19.0,
    time >=1.12.2,
    unix >=2.8.6.0,
  hs-source-dirs: src/comp/app
  ghc-options: -main-is Main_bsc
  main-is: bsc.hs
  other-modules: Warmup

executable bluetcl
  import: common_exes
  build-depends:
    containers >=0.6.7,
    mtl >=2.3.1,
    regex-compat ^>=0.95.2.2,
    syb ^>=0.7.2,
    unix >=2.8.6.0,
  c-sources:
    src/comp/app/bluetcl_shim.c,
  default-extensions:
    BangPatterns,
    FlexibleContexts,
    FlexibleInstances,
    TypeSynonymInstances,
  hs-source-dirs: src/comp/app
  main-is: bluetcl_Main.hs
  other-modules:
    Bluetcl
    Warmup

executable bsc2bsv
  import: common_exes
  hs-source-dirs: src/comp/app
  ghc-options: -main-is Main_bsc2bsv
  main-is: bsc2bsv.hs
  other-modules: Warmup

