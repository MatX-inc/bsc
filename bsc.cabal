    -- SAT solver shared libraries (built by src/vendor/{stp,yices}/Makefile)
    -- NOTE: the -L directories for these are machine-absolute and live in
    -- cabal.project.local (ghc-pkg rejects relative library-dirs at registration)
    extra-libraries: stp yices
    -- Tcl: HTcl.hs uses CApiFFI against tcl.h; haskell.c provides the two
    -- C helpers HTcl.hs ccall-imports (normally in vendor/htcl/libhtcl.a)
    pkgconfig-depends: tcl >= 8.5
    c-sources: src/vendor/htcl/haskell.c
    -- Mirrors src/comp/Makefile GHCFLAGS (GHC 9.x branch).
    -- CAUTION: do not add extra -W flags here; six modules carry in-file
    -- blanket {-# OPTIONS_GHC -Werror #-} (GenBin, GenABin, BinData, Error,
    -- AVerilogUtil, HTcl), so new warnings become build failures.
    ghc-options:
        -Wall
        -Wno-orphans
        -Wno-name-shadowing
        -Wno-unused-matches
        -Wtabs
        -fmax-pmcheck-models=800

-- Shared by the executables below; the library carries the SAT/Tcl link info
common exe-deps
    default-language: GHC2021
    hs-source-dirs: src/exe
    build-depends:
        base, bsc, containers, array, mtl, unix, regex-compat, bytestring,
        directory, process, filepath, time, old-time, old-locale, split, syb,
        integer-gmp, text, deepseq, strict-concurrency
    ghc-options:
        -Wall
        -Wno-orphans
        -Wno-name-shadowing
        -Wno-unused-matches
    -- macOS release packaging rewrites dylib install names in place
    if os(osx)
        ghc-options: -optl-headerpad_max_install_names

-- Larger -K for profiling: -fprof-auto wraps every closure entry in a
-- cost-centre frame, inflating peak stack ~10x (see src/comp/Makefile)
flag prof-rts
    description: Bake profiling-sized RTS defaults into the executables
    default: False
    manual: True

executable bsc
    import: exe-deps
    main-is: bsc.hs
    ghc-options: -main-is Main_bsc -rtsopts
    if flag(prof-rts)
        ghc-options: "-with-rtsopts=-H256m -K256m -i1"
    else
        ghc-options: "-with-rtsopts=-H256m -K10m -i1"

executable bluetcl
    import: exe-deps
    main-is: bluetcl.hs
    c-sources: src/exe/bluetcl_Main.c
    ghc-options: -no-hs-main
    pkgconfig-depends: tcl >= 8.5
