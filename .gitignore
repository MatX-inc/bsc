# Note: Only the most general ignore patterns are in this file.
#       There are area-specific .gitignore files for the source
#       directories etc.

# Ignore editor backup files
*~

# Ignore the inst directory
inst

# And the build directory
build

.vagrant/
vagrant-out/

# The cabal build (cabal.project, bsc.cabal)
dist-newstyle/
.ghc.environment.*
cabal.project.local
# Determinism ladder hash lists, toolchain records, and results (doc/cabal.md).
/*.sha256
/*.toolchain
determinism-results/
