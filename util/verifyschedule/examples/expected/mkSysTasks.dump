module mkSysTasks (package SysTasks), from mkSysTasks.ba
inputs:  
outputs: 

children:
  cyc : RegN   [read CF read, read SB write, write SBR write]
    read (value)
      copy -: result cyc$read :: Bit 8
    write (action)
      copy -: enable cyc$EN_write arg cyc$write_1 :: Bit 8
  note : RWire   [[wget, whas] CF [wget, whas], wset SBR [wget, whas], wset C wset]
    wset (action)
      copy -: enable note$EN_wset arg note$wset_1 :: Bit 8
    whas (value), sees same-cycle wset
      copy -: result note$whas :: Bit 1
    wget (value), sees same-cycle wset
      copy -: result note$wget :: Bit 8
    wire: note$wget = note$wset_1 within the cycle
    wire: note$whas = note$EN_wset within the cycle

execution order:
  1. RL_first_r   [rule first_r ("SysTasks.bsv", line 17, column 9)]
       fires on WILL_FIRE_RL_first_r, can fire CAN_FIRE_RL_first_r
       guard CAN_FIRE_RL_first_r
       reads cyc.read  (hint: used when 1'b1)
       calls note.wset when 1'd1 with cyc_BITS_6_TO_0_CONCAT_0___d3
       task #0 $display when 1'd1 with "first: cyc=%0d", cyc___d1
  2. RL_second_r   [rule second_r ("SysTasks.bsv", line 22, column 9)]
       fires on WILL_FIRE_RL_second_r, can fire CAN_FIRE_RL_second_r
       guard CAN_FIRE_RL_second_r
       reads cyc.read  (hint: used when 1'b1)
       reads note.wget  (hint: used when note_whas____d5)
       reads note.whas  (hint: used when 1'b1)
       calls cyc.write when 1'd1 with cyc_PLUS_1___d4
       task #1 $display when note_whas____d5 with "second: note=%0d", note_wget____d6
       task #2 $write when 1'd1 with "tick\n"
       task #3 $finish when cyc_EQ_5___d7 with 32'd0

system-task calls of the hardware, in the order of its always block:
  task #0: $display [Prelude.$display ("SysTasks.bsv", line 19, column 7)] when WILL_FIRE_RL_first_r
  task #1: $display [Prelude.$display ("SysTasks.bsv", line 25, column 10)] when WILL_FIRE_RL_second_r && note_whas____d5
  task #2: $write [Prelude.$write ("SysTasks.bsv", line 26, column 7)] when WILL_FIRE_RL_second_r
  task #3: $finish [Prelude._finish_ ("SysTasks.bsv", line 28, column 10)] when WILL_FIRE_RL_second_r && cyc_EQ_5___d7

use conditions (recomputed):

orders checked:
  schedule: RL_first_r RL_second_r

disjoint guards (bsc):     -
urgency blocking (r, by):  -
mutually_exclusive (user): -
exported C:                -
exported CF:               -
unrealizable CF swaps:     -
exported SB/SBR:           
enables (method, EN):      -
ready (method, RDY):       -
unspecified values:        A

disjointness bsc relied on but did not record:
