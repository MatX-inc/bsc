       calls _i_notFull_RL_emitB$EN_outQ.wset when 1'b1 with ! NOT_limit_EQ_9_2___d13
       check WILL_FIRE_RL_emitA && limit_EQ_9___d12 && _enq_RL_emitA$EN_outQ.wget
