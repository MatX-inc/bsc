module mkWireResult (package WireResult), from mkWireResult.ba
inputs:  put_x :: Bit 4 EN_put :: Bit 1
outputs: get :: Bit 4 RDY_get :: Bit 1 RDY_put :: Bit 1

children:
  r : RegN   [read CF read, read SB write, write SBR write]
    read (value)
      copy -: result r$read :: Bit 4
    write (action)
      copy -: enable r$EN_write arg r$write_1 :: Bit 4
  w : RWire   [[wget, whas] CF [wget, whas], wset SBR [wget, whas], wset C wset]
    wset (action)
      copy -: enable w$EN_wset arg w$wset_1 :: Bit 4
    whas (value), sees same-cycle wset
      copy -: result w$whas :: Bit 1
    wget (value), sees same-cycle wset
      copy -: result w$wget :: Bit 4
    wire: w$wget = w$wset_1 within the cycle
    wire: w$whas = w$EN_wset within the cycle

execution order:
  1. get   [value method get ("WireResult.bsv", line 14, column 8)]
       fires on WILL_FIRE_get, can fire CAN_FIRE_get
       reads r.read  (hint: used when 1'b1)
       reads w.wget  (hint: used when w_whas____d2)
       reads w.whas  (hint: used when 1'b1)
       output RDY_get = CAN_FIRE_get
       output get = r___d1 + IF_w_whas_THEN_w_wget_ELSE_0___d4  (when WhenOutput "RDY_get" WhenNotInput "EN_put")
  2. put   [method put]
       fires on WILL_FIRE_put, can fire CAN_FIRE_put
       guard CAN_FIRE_put
       calls r.write when 1'd1 with put_x
       calls w.wset when 1'd1 with put_x
       output RDY_put = CAN_FIRE_put

