#!/bin/sh
# Launcher for the bluehs tools that works from any directory.
#
# Invoke directly:            util/bluehs/bluehs dumpbo foo.bo
# or via the bin/ symlinks:   util/bluehs/bin/dumpbo foo.bo
# (the symlink name selects the tool)
#
#   bluehs [-<ghc flag>]... <tool|script.hs> [args...]
#
# A named tool is the program of that name in bsc.cabal, run by runghc
# instead of being compiled: its entry file is under src/comp/app, or under
# src/comp for the programs whose entry module lives there.  runghc
# executes the file's `main` whatever the module is called, so the entry
# files the cabal executables use (module Main_dumpbo and friends) are also
# the scripts, with no second copy to keep in step.  Any path to a .hs file
# works too (one that starts with - needs ./).  Flags before the tool or
# script go to GHC, one word each, as runghc takes them: -i<dir> adds a
# directory to the import path, for a script whose modules are split across
# files, -v1 names every module GHC interprets, a flag's value is attached
# (-package<pkg>) or passed as --ghc-arg=<arg>, and -- ends them.
#
# The same file runs from a source checkout and from an installed
# distribution (mk-dist.sh), and chooses by what surrounds it:
#   checkout      - <repo>/util/bluehs/bluehs, the ghc on PATH, and the
#                   repo's .ghc.environment.* for that ghc's version
#   distribution  - <dist>/bin/bluehs, the bundled GHC, and <dist>/hs/bsc.env
#
# Sets up three things a compiled binary would not need:
#   GHC_ENVIRONMENT - the GHC package environment naming the compiled bsc
#                     library, so runghc finds it from any cwd
#   BLUESPECDIR     - defaulted to the bsc install beside the library
#                     (showrules/vcdcheck use it for %-expansion and default
#                     .ba search paths); a compiled binary derives it from its
#                     own location, which runghc cannot do because the script
#                     is not installed
#   LD_LIBRARY_PATH - the solvers for GHC's loader, which opens a package's
#                     extra-libraries by their link names before the
#                     package's own object loads: from the package's library
#                     directories, which name none (doc/cabal.md section 3),
#                     then from the dynamic linker's search path, which this
#                     names the installed copies for. On macOS the variable
#                     does not survive the shell wrappers around ghc (SIP
#                     strips it),
#                     so there the library's own rpath resolves the solvers
#                     (cabal.project) and the loader's warning about the
#                     preload it could not do is silenced on the command line

SELF=$(readlink -f "$0")
HERE=$(dirname "$SELF")

NAME=$(basename "$0")
# GHC flags lead; they stay in place in "$@" for runghc
FLAGS=0
if [ "$NAME" = "bluehs" ]; then
    for a do
        case "$a" in
            --) FLAGS=$((FLAGS + 1)); break ;;
            -?*) FLAGS=$((FLAGS + 1)) ;;
            *) break ;;
        esac
    done
    if [ $# -le $FLAGS ]; then
        echo "usage: bluehs [-<ghc flag>]... <tool|script.hs> [args...]" >&2
        exit 1
    fi
    eval "TOOL=\${$((FLAGS + 1))}"
else
    TOOL="$NAME"
fi

if [ -f "$HERE/../hs/bsc.env" ]; then
    DIST=$(dirname "$HERE")
    APP=$DIST/scripts
    APP_MORE=
    RUNGHC=$DIST/hs/ghc/bin/runghc
    ENVFILE=$DIST/hs/bsc.env
    DEFAULT_BLUESPECDIR=$(dirname "$DIST")/lib
    SAT=$DIST/SAT
else
    REPO=$(dirname "$(dirname "$(dirname "$SELF")")")
    APP=$REPO/src/comp/app
    APP_MORE=$REPO/src/comp
    RUNGHC=runghc
    # The environment file is per GHC version, and the library in it was
    # built by that GHC, so match the version of the ghc that runghc will use
    # rather than taking whichever file is there.
    VERSION=$(ghc --numeric-version 2>/dev/null)
    if [ -z "$VERSION" ]; then
        echo "bluehs: no ghc on PATH" >&2
        exit 1
    fi
    ENVFILE=$(ls "$REPO"/.ghc.environment.*-"$VERSION" 2>/dev/null | head -1)
    if [ ! -f "$ENVFILE" ]; then
        echo "bluehs: no .ghc.environment.*-$VERSION at $REPO --- run util/bluehs/setup.sh with ghc $VERSION" >&2
        exit 1
    fi
    DEFAULT_BLUESPECDIR=$REPO/inst/lib
    SAT=$REPO/inst/lib/SAT
fi

case "$TOOL" in
    *.hs) SCRIPT="$TOOL" ;;
    *)    SCRIPT="$APP/$TOOL.hs"
          [ -f "$SCRIPT" ] || [ -z "$APP_MORE" ] || SCRIPT="$APP_MORE/$TOOL.hs" ;;
esac
if [ ! -f "$SCRIPT" ]; then
    echo "bluehs: no such tool or script: $TOOL" >&2
    exit 1
fi

GHC_ENVIRONMENT="$ENVFILE" export GHC_ENVIRONMENT
BLUESPECDIR="${BLUESPECDIR:-$DEFAULT_BLUESPECDIR}" export BLUESPECDIR
LD_LIBRARY_PATH="$SAT${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" export LD_LIBRARY_PATH

# runghc gets the flags, then the script in place of the tool name; the
# launcher's own --ghc-arg comes first, which also ends runghc's reading of
# its own options, so a user's -f<flag> reaches GHC rather than being taken
# for the ghc to run
if [ "$NAME" = "bluehs" ]; then
    k=0
    for a do
        [ $k -eq 0 ] && set --
        k=$((k + 1))
        if [ $k -eq $((FLAGS + 1)) ]; then
            set -- "$@" "$SCRIPT"
        else
            set -- "$@" "$a"
        fi
    done
else
    set -- "$SCRIPT" "$@"
fi
exec "$RUNGHC" --ghc-arg=-Wno-missed-extra-shared-lib "$@"
