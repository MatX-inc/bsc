#!/bin/sh
# Launcher for the bluehs tools that works from any directory.
#
# Invoke directly:            util/bluehs/bluehs dumpbo foo.bo
# or via the bin/ symlinks:   util/bluehs/bin/dumpbo foo.bo
# (the symlink name selects the tool)
#
#   bluehs [-<ghc flag>]... <tool|script.hs> [args...]
#
# A named tool is the program of that name in bsc.cabal, run by runghc
# instead of being compiled: its entry file is under src/comp/app, or under
# src/comp for the programs whose entry module lives there.  runghc
# executes the file's `main` whatever the module is called, so the entry
# files the cabal executables use (module Main_dumpbo and friends) are also
# the scripts, with no second copy to keep in step.  Any path to a .hs file
# works too (one that starts with - needs ./).  Flags before the tool or
# script go to GHC, one word each, as runghc takes them: -i<dir> adds a
# directory to the import path, for a script whose modules are split across
# files, -v1 names every module GHC interprets, a flag's value is attached
# (-package<pkg>) or passed as --ghc-arg=<arg>, and -- ends them.
#
# Scripts can run compiled instead of interpreted. Three ways in:
#   BLUEHS_COMPILE=1       compile the script and its -i modules with the GHC
#                          beside runghc into a cache (BLUEHS_CACHE, default
#                          ~/.cache/bluehs) keyed by the GHC, the environment
#                          file and every source, and run the binary; later
#                          runs with the same sources find it there. Leading
#                          flags other than -i keep the interpreter, as does
#                          a failed compile (its log stays in the cache).
#   --compile-to=FILE      compile only, to FILE, for a build system that
#                          wants the binary as its own step
#   --run=FILE             run a binary from --compile-to with the launcher's
#                          environment (BLUESPECDIR, the solvers)
# A binary is linked with the larger nursery (-A256m) the ECO flow measured
# as worthwhile; the interpreter is unchanged.
#
# The same file runs from a source checkout and from an installed
# distribution (mk-dist.sh), and chooses by what surrounds it:
#   checkout      - <repo>/util/bluehs/bluehs, the ghc on PATH, and the
#                   repo's .ghc.environment.* for that ghc's version
#   distribution  - <dist>/bin/bluehs, the bundled GHC, and <dist>/hs/bsc.env
#
# Sets up three things a compiled binary would not need:
#   GHC_ENVIRONMENT - the GHC package environment naming the compiled bsc
#                     library, so runghc finds it from any cwd
#   BLUESPECDIR     - defaulted to the bsc install beside the library
#                     (showrules/vcdcheck use it for %-expansion and default
#                     .ba search paths); a compiled binary derives it from its
#                     own location, which runghc cannot do because the script
#                     is not installed
#   LD_LIBRARY_PATH - the solvers for GHC's loader, which opens a package's
#                     extra-libraries by their link names before the
#                     package's own object loads: from the package's library
#                     directories, which name none (doc/cabal.md section 2),
#                     then from the dynamic linker's search path, which this
#                     names the installed copies for. On macOS the variable
#                     does not survive the shell wrappers around ghc (SIP
#                     strips it),
#                     so there the library's own rpath resolves the solvers
#                     (cabal.project) and the loader's warning about the
#                     preload it could not do is silenced on the command line

SELF=$(readlink -f "$0")
HERE=$(dirname "$SELF")

NAME=$(basename "$0")
# The launcher's own option comes first; the GHC flags follow it
MODE=interpret
BINARY=
if [ "$NAME" = "bluehs" ]; then
    case "${1:-}" in
        --compile-to=?*) MODE=compile; BINARY=${1#--compile-to=}; shift ;;
        --run=?*) MODE=binary; BINARY=${1#--run=}; shift ;;
    esac
fi
[ "$MODE" = interpret ] && [ -n "${BLUEHS_COMPILE:-}" ] && MODE=cache
# GHC flags lead; they stay in place in "$@" for runghc
FLAGS=0
if [ "$MODE" = binary ]; then
    TOOL=
elif [ "$NAME" = "bluehs" ]; then
    for a do
        case "$a" in
            --) FLAGS=$((FLAGS + 1)); break ;;
            -?*) FLAGS=$((FLAGS + 1)) ;;
            *) break ;;
        esac
    done
    if [ $# -le $FLAGS ]; then
        echo "usage: bluehs [-<ghc flag>]... <tool|script.hs> [args...]" >&2
        exit 1
    fi
    eval "TOOL=\${$((FLAGS + 1))}"
else
    TOOL="$NAME"
fi

if [ -f "$HERE/../hs/bsc.env" ]; then
    DIST=$(dirname "$HERE")
    APP=$DIST/scripts
    APP_MORE=
    RUNGHC=$DIST/hs/ghc/bin/runghc
    ENVFILE=$DIST/hs/bsc.env
    DEFAULT_BLUESPECDIR=$(dirname "$DIST")/lib
    SAT=$DIST/SAT
    GHCBIN=$DIST/hs/ghc/bin/ghc
    # the bundled GHC keeps only the dynamic way of its libraries
    WAY=-dynamic
else
    DIST=
    REPO=$(dirname "$(dirname "$(dirname "$SELF")")")
    APP=$REPO/src/comp/app
    APP_MORE=$REPO/src/comp
    RUNGHC=runghc
    # The environment file is per GHC version, and the library in it was
    # built by that GHC, so match the version of the ghc that runghc will use
    # rather than taking whichever file is there.
    VERSION=$(ghc --numeric-version 2>/dev/null)
    if [ -z "$VERSION" ]; then
        echo "bluehs: no ghc on PATH" >&2
        exit 1
    fi
    ENVFILE=$(ls "$REPO"/.ghc.environment.*-"$VERSION" 2>/dev/null | head -1)
    if [ ! -f "$ENVFILE" ]; then
        echo "bluehs: no .ghc.environment.*-$VERSION at $REPO --- run util/bluehs/setup.sh with ghc $VERSION" >&2
        exit 1
    fi
    DEFAULT_BLUESPECDIR=$REPO/inst/lib
    SAT=$REPO/inst/lib/SAT
    GHCBIN=ghc
    WAY=
fi

if [ "$MODE" != binary ]; then
    case "$TOOL" in
        *.hs) SCRIPT="$TOOL" ;;
        *)    SCRIPT="$APP/$TOOL.hs"
              [ -f "$SCRIPT" ] || [ -z "$APP_MORE" ] || SCRIPT="$APP_MORE/$TOOL.hs" ;;
    esac
    if [ ! -f "$SCRIPT" ]; then
        echo "bluehs: no such tool or script: $TOOL" >&2
        exit 1
    fi
fi

GHC_ENVIRONMENT="$ENVFILE" export GHC_ENVIRONMENT
# the GHC this launcher runs or compiled the script with, for a script that
# identifies its runtime (a compiled binary cannot take it from its own path)
case "$GHCBIN" in */*) BLUEHS_GHC=$GHCBIN ;; *) BLUEHS_GHC=$(command -v "$GHCBIN" 2>/dev/null || echo "$GHCBIN") ;; esac
export BLUEHS_GHC
BLUESPECDIR="${BLUESPECDIR:-$DEFAULT_BLUESPECDIR}" export BLUESPECDIR
LD_LIBRARY_PATH="$SAT${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" export LD_LIBRARY_PATH

if [ "$MODE" = binary ]; then
    # A distribution's binary is linked dynamically against the libraries
    # under hs/, with their paths at compile time as its runpath; naming them
    # here lets the same binary run with the distribution somewhere else (a
    # build system's sandbox), since LD_LIBRARY_PATH is searched first.
    if [ -n "${DIST:-}" ]; then
        LIBDIRS=$(find "$DIST/hs" -name '*.so' -printf '%h\n' 2>/dev/null | LC_ALL=C sort -u | paste -sd: -)
        [ -z "$LIBDIRS" ] || LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$LIBDIRS" export LD_LIBRARY_PATH
    fi
    exec "$BINARY" "$@"
fi

# runghc gets the flags, then the script in place of the tool name; the
# launcher's own --ghc-arg comes first, which also ends runghc's reading of
# its own options, so a user's -f<flag> reaches GHC rather than being taken
# for the ghc to run
if [ "$NAME" = "bluehs" ]; then
    k=0
    for a do
        [ $k -eq 0 ] && set --
        k=$((k + 1))
        if [ $k -eq $((FLAGS + 1)) ]; then
            set -- "$@" "$SCRIPT"
        else
            set -- "$@" "$a"
        fi
    done
else
    set -- "$SCRIPT" "$@"
fi

# Compiled modes. The GHC flags the launcher compiles with are the -i ones;
# a script's own module name is passed as -main-is when it is not Main (the
# named tools). The solvers are linked from the installed copies, which the
# binary then finds through LD_LIBRARY_PATH above, as the interpreter does.
if [ "$MODE" != interpret ]; then
    IFLAGS=""; IDIRS=""; n=0; compilable=1
    for a do
        n=$((n + 1))
        [ $n -gt $FLAGS ] && break
        case "$a" in
            --) ;;
            -i)  IFLAGS="$IFLAGS -i" ;;
            -i*) IFLAGS="$IFLAGS $a"; IDIRS="$IDIRS ${a#-i}" ;;
            *)   compilable=0 ;;
        esac
    done
    MAINIS=$(sed -n 's/^module[[:space:]]*\([A-Za-z0-9_.]*\).*/\1/p' "$SCRIPT" | head -1)
    if [ -n "$MAINIS" ] && [ "$MAINIS" != Main ]; then MAINIS="-main-is $MAINIS"; else MAINIS=""; fi
    compile() {  # output, build directory
        # shellcheck disable=SC2086
        "$GHCBIN" --make -O1 -v0 $WAY $IFLAGS $MAINIS -outputdir "$2" -o "$1" \
            -L"$SAT" -rtsopts -with-rtsopts=-A256m -Wno-missed-extra-shared-lib "$SCRIPT"
    }
    if [ "$MODE" = compile ]; then
        if [ $compilable -eq 0 ]; then
            echo "bluehs: --compile-to takes -i flags only" >&2
            exit 1
        fi
        compile "$BINARY" "$BINARY.build" && rm -rf "$BINARY.build"
        exit $?
    fi
    if [ $compilable -eq 1 ] && command -v "$GHCBIN" >/dev/null 2>&1 && command -v sha256sum >/dev/null 2>&1; then
        # The modules under the -i directories are compiled once per cache
        # entry and shared by every script that uses them; the entry's lock
        # serialises the compiles of scripts sharing it.
        LIBKEY=$( { "$GHCBIN" --numeric-version; printf '%s\n%s\n' "$ENVFILE" "$IFLAGS"; cat "$ENVFILE"
                    for d in $IDIRS; do find "$d" -name '*.hs' -type f 2>/dev/null | LC_ALL=C sort | while read -r f; do printf '%s\n' "$f"; cat "$f"; done; done
                  } | sha256sum | cut -c1-32 )
        KEY=$( { printf '%s\n%s\n' "$LIBKEY" "$MAINIS"; cat "$SCRIPT"; } | sha256sum | cut -c1-32 )
        ENTRY=${BLUEHS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/bluehs}/$LIBKEY
        BIN=$ENTRY/$KEY/bin
        if [ ! -x "$BIN" ]; then
            mkdir -p "$ENTRY/$KEY"
            waited=0
            while ! mkdir "$ENTRY/lock" 2>/dev/null; do
                sleep 2; waited=$((waited + 2))
                [ $waited -ge 1800 ] && { rm -rf "$ENTRY/lock"; break; }
            done
            if [ ! -x "$BIN" ]; then
                if compile "$BIN.tmp" "$ENTRY/build" > "$ENTRY/$KEY/compile.log" 2>&1; then
                    mv "$BIN.tmp" "$BIN"
                    printf '%s\n' "$SCRIPT" > "$ENTRY/$KEY/script"
                else
                    echo "bluehs: compile failed, interpreting instead (log: $ENTRY/$KEY/compile.log)" >&2
                fi
            fi
            rmdir "$ENTRY/lock" 2>/dev/null
        fi
        if [ -x "$BIN" ]; then
            # the binary takes the script's own arguments
            k=0
            for a do
                [ $k -eq 0 ] && set --
                k=$((k + 1))
                [ $k -le $((FLAGS + 1)) ] && continue
                set -- "$@" "$a"
            done
            exec "$BIN" "$@"
        fi
    fi
fi
exec "$RUNGHC" --ghc-arg=-Wno-missed-extra-shared-lib "$@"
