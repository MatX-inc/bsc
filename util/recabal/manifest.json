      "ghc-options": "-rtsopts \"-with-rtsopts=-H256m -K10m -i1\""
    },
    "programs": [
      {
        "name": "bsc",
        "main": "src/comp/app/bsc.hs",
        "build-depends": [
          "containers >=0.6.7",
          "directory >=1.3.8.5",
          "filepath >=1.4.301.0",
          "mtl >=2.3.1",
          "old-time ^>=1.1.1.0",
          "process >=1.6.19.0",
          "time >=1.12.2",
          "unix >=2.8.6.0"
        ]
      },
      {
        "name": "bluetcl",
        "main": "src/comp/app/bluetcl_Main.hs",
        "main-is-module": "Main",
        "build-depends": [
          "containers >=0.6.7",
          "mtl >=2.3.1",
          "regex-compat ^>=0.95.2.2",
          "syb ^>=0.7.2",
          "unix >=2.8.6.0"
        ],
        "c-sources": [
          "src/comp/app/bluetcl_shim.c"
        ],
        "default-extensions": [
          "BangPatterns",
          "FlexibleContexts",
          "FlexibleInstances",
          "TypeSynonymInstances"
        ],
        "other-modules": [
          "Bluetcl"
        ]
      },
      {
        "name": "bsc2bsv",
        "main": "src/comp/app/bsc2bsv.hs"
      },
      {
        "name": "bsv2bsc",
        "main": "src/comp/app/bsv2bsc.hs"
      },
      {
