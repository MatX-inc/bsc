-- Generated by util/recabal/gen.py from util/recabal/manifest.json; do not
-- edit by hand (CI regenerates and diffs).  Machine-local settings go in
-- cabal.project.local, which is ignored by git.
packages:
  .
  components/setup
  components/htcl
  components/waveforms
  components/core
  components/stp
  components/yices
  components/sat
  components/aopt
  components/bo
  components/ba
  components/parse
  components/typecheck
  components/elab
  components/schedule
  components/verilog
  components/bluesim
  components/bluetcl

-- Parity with the make build (src/comp/Makefile GHCOPTLEVEL = -O2), for every
-- package of the project.
optimization: 2

-- One GHC job server shared by every package's ghc --make -j
-- (doc/recabalization-brief.md, 3.1; R8 is the fallback: jobs: 1 and -j per
-- package).  cabal-install 3.18 with GHC 9.14.1 declines the semaphore
-- (version mismatch warning) and falls back to plain -j per package, which
-- oversubscribes but is correct; the setting is kept for a matching pair.
jobs: $ncpus
semaphore: True

-- Lets bare ghci/runghc/ghc resolve the compiled bsc libraries from any cwd
-- inside the repo (GHC searches upward for .ghc.environment.*).  Harmless to
-- the make build: src/comp/Makefile compiles with -hide-all-packages plus
-- explicit -package flags, which override the environment file.
write-ghc-environment-files: always

-- The hooks library is the one exception to optimization: 2 (brief 3.1; F6
-- and R2: an optimized build of it failed to link, and it is not
-- performance-sensitive).
package bsc-setup
  optimization: 0

-- Parallel GHC inside every local package; -fobject-determinism is set in
-- each package's .cabal, conditional on the compiler offering it (9.14+),
-- so the condition travels with the package.
program-options
  ghc-options: -j

-- program-options reaches local packages only.  The Hackage dependencies are
-- compiled into the store without the packages' own ghc-options, so the
-- determinism flag reaches them from the one stanza that applies to
-- non-local packages, under the same condition as in the .cabal files.
if impl(ghc >= 9.14)
  package *
    ghc-options: -fobject-determinism
