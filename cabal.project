packages: .

-- The Hackage index the dependencies resolve against: the commit, not the
-- build date, fixes their versions. Moving it is a change of its own
-- (doc/cabal.md).
index-state: 2026-10-15T20:00:00Z

-- -O2, as the compiler has always been built.
optimization: 2

-- One GHC job server shared by every ghc --make -j, so the effective
-- parallelism stays the number of slots as the build splits into packages.
-- cabal-install and GHC must speak the same semaphore protocol: cabal-install
-- 3.16 speaks v1, which GHC 9.8 through 9.14.1 implement; 3.18 speaks only
-- v2, which GHC reports from 9.14.2 and 10.2, and with an older GHC it warns
-- and falls back to plain -j per package. Build with cabal-install 3.16.1.0
-- until GHC moves (doc/cabal.md).
jobs: $ncpus
semaphore: True

-- Lets bare ghci/runghc/ghc resolve the build's packages and the compiled
-- library from any cwd inside the repo (GHC searches upward for
-- .ghc.environment.*); src/comp/.ghci relies on it.
write-ghc-environment-files: always

-- Parallel GHC inside the package. -fobject-determinism is not set here:
-- bsc.cabal carries it under impl(ghc >= 9.12), so the condition travels
-- with the package.
program-options
  ghc-options: -j

-- program-options reaches local packages only. The Hackage dependencies are
-- compiled into the store without the package's own ghc-options, so the
-- determinism flag reaches them from the one stanza that applies to
-- non-local packages, under the same condition as in bsc.cabal.
if impl(ghc >= 9.12)
  package *
    ghc-options: -fobject-determinism

-- The library's shared object records the solvers as dependencies and
-- resolves them beside itself, lib/SAT, through the rpath the programs get
-- from bsc.cabal's ld-options. Cabal 3.16 passes a library's ld-options to
-- the programs' links but not to the library's own, so the shared object
-- takes the rpath from here, where ghc-options reach every invocation (an
-- -optl flag does nothing at a compile). ghci and runghc need it: the build
-- tree's lib/SAT points where the solvers were linked from (SetupHooks.hs),
-- and an installed tree has lib/SAT itself.
if os(osx)
  program-options
    ghc-options: -optl-Wl,-rpath,@loader_path/../lib/SAT
else
  program-options
    ghc-options: -optl-Wl,-rpath,$ORIGIN/../lib/SAT
