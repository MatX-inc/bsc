@@ -390,6 +395,34 @@ iExpand errh flags symt alldefs atf_cache is_noinlined_func pps def@(IDef mi _ _
       -- if preserving method conditions, then remove the book-keeping info
       imod = removeInlinedPositions flags imod0
 
+  -- MEASUREMENT ONLY: record every heap def's name and binder position
+  heappos <- lookupEnv "BSC_HEAPPOS_DIR"
+  case heappos of
+    Just dir | not (null dir) -> do
+        cwd <- getCurrentDirectory
+        pid <- getProcessID
+        tab <- readIORef binderOrigTable
+        let base i = let s = getIdBaseString i
+                         r = reverse s
+                         r' = dropWhile (`elem` "0123456789") r
+                     in  if take 3 r' == "h__" then reverse (drop 3 r') else s
+            orig b q seen = case M.lookup (b, q) tab of
+                              Just os | not (S.null os) && not (S.member q seen) ->
+                                  let o = S.findMin os
+                                      (o', n') = orig b o (S.insert q seen)
+                                  in  (o', max (S.size os) n')
+                              _ -> (q, 0 :: Int)
+            ln (IDef i _ _ _) =
+              let p = getIdPosition i
+                  (o, n) = orig (base i) p S.empty
+              in  intercalate "\t" [cwd, getIdBaseString mi, getIdBaseString i,
+                                    getPositionFile p, show (getPositionLine p),
+                                    show (getPositionColumn p), show (pos_is_stdlib p),
+                                    getPositionFile o, show (getPositionLine o),
+                                    show (getPositionColumn o), show (pos_is_stdlib o), show n]
+        appendFile (dir ++ "/" ++ show pid ++ ".tsv") (unlines (map ln defs1))
+    _ -> return ()
+
