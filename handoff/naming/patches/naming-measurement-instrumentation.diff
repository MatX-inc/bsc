+
+-- MEASUREMENT ONLY
+keepBinderPos :: Bool
+keepBinderPos = unsafePerformIO (fmap (maybe False (not . null)) (lookupEnv "BSC_HEAPPOS_DIR"))
+{-# NOINLINE keepBinderPos #-}
+
+binderOrigTable :: IORef (M.Map (String, Position) (S.Set Position))
+binderOrigTable = unsafePerformIO (newIORef M.empty)
+{-# NOINLINE binderOrigTable #-}
+
+binderPos :: Position -> Id -> Id
+binderPos pos i
+  | keepBinderPos =
+      unsafePerformIO $ do
+        let old = getIdPosition i
+        modifyIORef' binderOrigTable (M.insertWith S.union (getIdBaseString i, pos) (S.singleton old))
+        return (setIdPosition pos i)
+  | otherwise = setIdPosition pos i
+{-# NOINLINE binderPos #-}
