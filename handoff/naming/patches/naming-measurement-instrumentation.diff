@@ -31,6 +31,11 @@ import Data.Graph
 import System.IO(Handle, BufferMode(..), IOMode(..), stdout, stderr,
                  hSetBuffering, hIsOpen, hIsClosed)
 import System.FilePath(isRelative)
+import System.Environment(lookupEnv)
