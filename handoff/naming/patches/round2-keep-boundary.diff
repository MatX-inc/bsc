+-- EXPERIMENT: a cell that a moved library binder would have named stays a
+-- kept definition, unnamed, when no name can be inferred
+improveCellName e (Just i)
+  | isJust (getIdInlinedPositions i) = do
+      mn <- inferName e
+      return (Just (fromMaybe (mkId noPosition (mkFString "")) mn))
 improveCellName e _ = inferName e
 
