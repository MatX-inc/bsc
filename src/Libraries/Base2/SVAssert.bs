-- Concurrent (SVA-style) assertions for Bluespec Haskell.
--
-- A property is an ordinary elaboration-time value built from the
-- combinators below.  `svaAssert`, `svaAssume` and `svaCover` lower it
-- by backend:
--   * Verilog: the compiler's SVA primitives, printed as a native
--     `assert property (...)` (or, under -sva-immediate, an immediate
--     assertion for tools without SVA support).
--   * Bluesim: the FSM checkers of the `SVA` package, which execute the
--     property cycle by cycle and run the pass/fail actions.
--
--   svaAssert "ack_follows_req" (req |=> ack)
--   svaAssert "grant_within_4" (req |-> delayRange 1 4 True gnt)

package SVAssert(
    Seq, Prop, IsSeq(..), IsProp(..),
    sExpr, (##), delay, delayRange, delayUnbound,
    rep, repRange, repUnbound, sOr, sIntersect, firstMatch,
    (|->), (|=>), pNot, pAnd, pOr,
    svaAssert, svaAssume, svaCover, svaAssertWith,
    toSvaSeq, toSvaProp
  ) where

import List
import SVA

infixr 7 ##
infixr 1 |->
infixr 1 |=>

-- Sequences: when a match starts and ends is relative to the cycle its
-- first element is sampled on.
data Seq = SExpr Bool
         | SDelay Integer (Maybe Integer) Seq Seq   -- s1 ##[lo:hi] s2; Nothing is $
         | SRep Integer (Maybe Integer) Seq         -- s [*lo:hi]; Nothing is $
         | SOr Seq Seq
         | SIntersect Seq Seq
         | SFirstMatch Seq

data Prop = PSeq Seq
          | PNot Prop
          | PAnd Prop Prop
          | POr Prop Prop
          | PImplies Seq Prop                       -- overlapping implication

class IsSeq a where
    toSeq :: a -> Seq

instance IsSeq Bool where
    toSeq b = SExpr b

instance IsSeq (Reg Bool) where
    toSeq r = SExpr r._read

instance IsSeq Seq where
    toSeq s = s

class IsProp a where
    toProp :: a -> Prop

instance IsProp Bool where
    toProp b = PSeq (SExpr b)

instance IsProp (Reg Bool) where
    toProp r = PSeq (SExpr r._read)

instance IsProp Seq where
    toProp s = PSeq s

instance IsProp Prop where
    toProp p = p

sExpr :: Bool -> Seq
sExpr b = SExpr b

-- a ##1 b
(##) :: (IsSeq a, IsSeq b) => a -> b -> Seq
(##) a b = SDelay 1 (Just 1) (toSeq a) (toSeq b)

-- a ##n b
delay :: (IsSeq a, IsSeq b) => Integer -> a -> b -> Seq
delay n a b = SDelay n (Just n) (toSeq a) (toSeq b)

-- a ##[lo:hi] b
delayRange :: (IsSeq a, IsSeq b) => Integer -> Integer -> a -> b -> Seq
delayRange lo hi a b = SDelay lo (Just hi) (toSeq a) (toSeq b)

-- a ##[lo:$] b
delayUnbound :: (IsSeq a, IsSeq b) => Integer -> a -> b -> Seq
delayUnbound lo a b = SDelay lo Nothing (toSeq a) (toSeq b)

-- s [*n]
rep :: (IsSeq a) => Integer -> a -> Seq
rep n s = SRep n (Just n) (toSeq s)

-- s [*lo:hi]
repRange :: (IsSeq a) => Integer -> Integer -> a -> Seq
repRange lo hi s = SRep lo (Just hi) (toSeq s)

-- s [*lo:$]
repUnbound :: (IsSeq a) => Integer -> a -> Seq
repUnbound lo s = SRep lo Nothing (toSeq s)

sOr :: (IsSeq a, IsSeq b) => a -> b -> Seq
sOr a b = SOr (toSeq a) (toSeq b)

sIntersect :: (IsSeq a, IsSeq b) => a -> b -> Seq
sIntersect a b = SIntersect (toSeq a) (toSeq b)

firstMatch :: (IsSeq a) => a -> Seq
firstMatch s = SFirstMatch (toSeq s)

-- s |-> p
(|->) :: (IsSeq a, IsProp b) => a -> b -> Prop
(|->) s p = PImplies (toSeq s) (toProp p)

-- s |=> p, i.e. (s ##1 true) |-> p
(|=>) :: (IsSeq a, IsProp b) => a -> b -> Prop
(|=>) s p = PImplies (SDelay 1 (Just 1) (toSeq s) (SExpr True)) (toProp p)

pNot :: (IsProp a) => a -> Prop
pNot p = PNot (toProp p)

pAnd :: (IsProp a, IsProp b) => a -> b -> Prop
pAnd a b = PAnd (toProp a) (toProp b)

pOr :: (IsProp a, IsProp b) => a -> b -> Prop
pOr a b = POr (toProp a) (toProp b)

-- ----------------------------------------------------------------------
-- Verilog: the compiler's property primitives

toSvaSeq :: Seq -> SvaSeq
toSvaSeq (SExpr b) = primSvaExpr (pack b)
toSvaSeq (SDelay lo (Just hi) a b) =
    primSvaDelay (fromInteger lo) (fromInteger hi) (toSvaSeq a) (toSvaSeq b)
toSvaSeq (SDelay lo Nothing a b) = primSvaDelayUnbound (fromInteger lo) (toSvaSeq a) (toSvaSeq b)
toSvaSeq (SRep lo (Just hi) s) = primSvaRep (fromInteger lo) (fromInteger hi) (toSvaSeq s)
toSvaSeq (SRep lo Nothing s) = primSvaRepUnbound (fromInteger lo) (toSvaSeq s)
toSvaSeq (SOr a b) = primSvaSeqOr (toSvaSeq a) (toSvaSeq b)
toSvaSeq (SIntersect a b) = primSvaSeqIntersect (toSvaSeq a) (toSvaSeq b)
toSvaSeq (SFirstMatch s) = primSvaFirstMatch (toSvaSeq s)

toSvaProp :: Prop -> SvaProp
toSvaProp (PSeq s) = primSvaPropSeq (toSvaSeq s)
toSvaProp (PNot p) = primSvaNot (toSvaProp p)
toSvaProp (PAnd a b) = primSvaAnd (toSvaProp a) (toSvaProp b)
toSvaProp (POr a b) = primSvaOr (toSvaProp a) (toSvaProp b)
toSvaProp (PImplies s p) = primSvaImplies (toSvaSeq s) (toSvaProp p)

-- a property with no sequence operators, which -sva-immediate can print as is
booleanProp :: Prop -> Bool
booleanProp (PSeq (SExpr _)) = True
booleanProp (PSeq _) = False
booleanProp (PNot p) = booleanProp p
booleanProp (PAnd a b) = booleanProp a && booleanProp b
booleanProp (POr a b) = booleanProp a && booleanProp b
booleanProp (PImplies (SExpr _) p) = booleanProp p
booleanProp (PImplies _ _) = False

-- ----------------------------------------------------------------------
-- Bluesim: lower to the SVA package's checker modules, following the
-- same desugaring the BSV frontend applies (delays become concatenation
-- chains through `true`, ranges become disjunctions of fixed delays).

seqTrue :: Seq
seqTrue = SExpr True

lowerSeq :: Seq -> Module Sequence
lowerSeq (SExpr b) = mkSeqExpr b
lowerSeq (SDelay lo mhi s1 s2) =
    case mhi of
      Just hi ->
        if lo > hi then error ("SVAssert: delay lower bound " +++ integerToString lo +++
                               " exceeds upper bound " +++ integerToString hi)
        else if lo < hi then mkSeqOr (lowerSeq (SDelay lo (Just lo) s1 s2))
                                     (lowerSeq (SDelay (lo + 1) (Just hi) s1 s2))
        else if lo == 0 then mkSeqFuse (lowerSeq s1) (lowerSeq s2)
        else if lo == 1 then mkSeqConcat (lowerSeq s1) (lowerSeq s2)
        else mkSeqConcat (lowerSeq s1) (lowerSeq (SDelay (lo - 1) (Just (lo - 1)) seqTrue s2))
      Nothing ->
        if lo == 0 then mkSeqOr (lowerSeq (SDelay 0 (Just 0) s1 s2))
                                (lowerSeq (SDelay 1 Nothing s1 s2))
        else mkSeqConcat (lowerSeq s1)
                         (mkSeqConcat (lowerSeq (SRep (lo - 1) Nothing seqTrue)) (lowerSeq s2))
lowerSeq (SRep lo mhi s) =
    case mhi of
      Just hi ->
        if lo > hi then error ("SVAssert: repetition lower bound " +++ integerToString lo +++
                               " exceeds upper bound " +++ integerToString hi)
        else if lo < hi then mkSeqOr (lowerSeq (SRep lo (Just lo) s))
                                     (lowerSeq (SRep (lo + 1) (Just hi) s))
        else if lo == 0 then mkSeqNull
        else if lo == 1 then lowerSeq s
        else mkSeqConcat (lowerSeq s) (lowerSeq (SRep (lo - 1) (Just (lo - 1)) s))
      Nothing ->
        if lo == 0 then mkSeqOr (lowerSeq (SRep 0 (Just 0) s)) (lowerSeq (SRep 1 Nothing s))
        else if lo == 1 then mkSeqUnbound (lowerSeq s)
        else mkSeqConcat (lowerSeq (SRep (lo - 1) (Just (lo - 1)) s)) (lowerSeq (SRep 1 Nothing s))
lowerSeq (SOr a b) = mkSeqOr (lowerSeq a) (lowerSeq b)
lowerSeq (SIntersect a b) = mkSeqIntersect (lowerSeq a) (lowerSeq b)
lowerSeq (SFirstMatch s) = mkSeqFirstMatch (lowerSeq s)

lowerProp :: Prop -> Module Property
lowerProp (PSeq s) = mkPropSeq (lowerSeq s)
lowerProp (PNot p) = do
    m <- lowerProp p
    mkPropNot m
lowerProp (PAnd a b) = do
    x <- lowerProp a
    y <- lowerProp b
    mkPropAnd x y
lowerProp (POr a b) = do
    x <- lowerProp a
    y <- lowerProp b
    mkPropOr x y
lowerProp (PImplies s p) = do
    -- one copy of the consequent per cycle the antecedent can complete on
    ps <- replicateM (longestPathProp p) (lowerProp p)
    mkPropImplies (lowerSeq s) ps

-- How many cycles a match can span: bounds the number of concurrent
-- attempts the checkers need.
longestPathSeq :: Seq -> Integer
longestPathSeq (SExpr _) = 1
longestPathSeq (SDelay lo mhi s1 s2) =
    longestPathSeq s1 + (case mhi of { Just hi -> hi; Nothing -> lo }) + longestPathSeq s2 - 1
longestPathSeq (SRep lo mhi s) = longestPathSeq s * (case mhi of { Just hi -> hi; Nothing -> lo })
longestPathSeq (SOr a b) = max (longestPathSeq a) (longestPathSeq b)
longestPathSeq (SIntersect a b) = max (longestPathSeq a) (longestPathSeq b)
longestPathSeq (SFirstMatch s) = longestPathSeq s

longestPathProp :: Prop -> Integer
longestPathProp (PSeq s) = longestPathSeq s
longestPathProp (PNot p) = longestPathProp p
longestPathProp (PAnd a b) = max (longestPathProp a) (longestPathProp b)
longestPathProp (POr a b) = max (longestPathProp a) (longestPathProp b)
longestPathProp (PImplies s _) = longestPathSeq s

-- ----------------------------------------------------------------------

data SvaKind = SvaAssertK | SvaAssumeK | SvaCoverK

-- Assert `p` on every cycle.  In Verilog the simulator or formal tool
-- reports violations; in Bluesim a failure prints a message.
svaAssert :: (IsProp p) => String -> p -> Module Empty
svaAssert name p =
    svaStatement SvaAssertK name (toProp p) noAction
        ($display ("[SVA] assertion \"" +++ name +++ "\" failed"))

-- As `svaAssert`, running `onPass` / `onFail` when an attempt completes.
-- The actions only run in Bluesim; a Verilog simulator reports the
-- assertion itself.
svaAssertWith :: (IsProp p) => String -> p -> Action -> Action -> Module Empty
svaAssertWith name p onPass onFail = svaStatement SvaAssertK name (toProp p) onPass onFail

-- Constrain the environment: formal tools assume `p`; Bluesim checks it
-- like an assertion.
svaAssume :: (IsProp p) => String -> p -> Module Empty
svaAssume name p =
    svaStatement SvaAssumeK name (toProp p) noAction
        ($display ("[SVA] assumption \"" +++ name +++ "\" violated"))

-- Record that `p` can be matched; Bluesim reports the first match.
svaCover :: (IsProp p) => String -> p -> Module Empty
svaCover name p =
    svaStatement SvaCoverK name (toProp p)
        ($display ("[SVA] cover \"" +++ name +++ "\" hit")) noAction

svaTask :: SvaKind -> String -> SvaProp -> Action
svaTask SvaAssertK = $SVA
svaTask SvaAssumeK = $SVAssume
svaTask SvaCoverK = $SVACover

svaPrefix :: SvaKind -> String
svaPrefix SvaAssertK = "svaAssert_"
svaPrefix SvaAssumeK = "svaAssume_"
svaPrefix SvaCoverK = "svaCover_"

svaStatement :: SvaKind -> String -> Prop -> Action -> Action -> Module Empty
svaStatement kind name p onPass onFail =
    if genVerilog && (not svaImmediate || booleanProp p) then
        addRules $
          rules
            {-# ASSERT fire when enabled #-}
            (svaPrefix kind +++ name):
              when True ==> svaTask kind name (toSvaProp p)
    else if genVerilog then
        svaImmediateFSM kind name p
    else
        svaFSM kind name p onPass onFail

-- Under -sva-immediate a temporal property is checked by the FSM
-- checkers in the design, and the assertion the tool sees is a plain
-- boolean they drive (a failure shows one cycle after the violation).
svaImmediateFSM :: SvaKind -> String -> Prop -> Module Empty
svaImmediateFSM kind name p =
    module
      failed :: Reg Bool <- mkReg False
      hit :: Reg Bool <- mkReg False
      props <- replicateM (longestPathProp p) (lowerProp p)
      a :: Assertion <- mkAssertAlways props (hit := True) (failed := True)
      let flag = case kind of
                   SvaCoverK -> hit
                   _ -> not failed
      addRules $
        rules
          {-# ASSERT no implicit conditions #-}
          {-# ASSERT fire when enabled #-}
          (svaPrefix kind +++ name +++ "_check"):
            when True ==> do
              _ <- a.advance
              return ()
          {-# ASSERT fire when enabled #-}
          (svaPrefix kind +++ name):
            when True ==> svaTask kind name (primSvaPropSeq (primSvaExpr (pack flag)))

svaFSM :: SvaKind -> String -> Prop -> Action -> Action -> Module Empty
svaFSM kind name p onPass onFail =
    module
      seen :: Reg Bool <- mkReg False
      -- a cover reports its first match only
      let onPass' = case kind of
                      SvaCoverK -> if seen then noAction
                                   else do
                                     seen := True
                                     onPass
                      _ -> onPass
      props <- replicateM (longestPathProp p) (lowerProp p)
      a :: Assertion <- mkAssertAlways props onPass' onFail
      addRules $
        rules
          {-# ASSERT no implicit conditions #-}
          {-# ASSERT fire when enabled #-}
          (svaPrefix kind +++ name):
            when True ==> do
              _ <- a.advance
              return ()
