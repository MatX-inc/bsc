clock CLK posedge
  run "" domain 0 segment 1
  run "" domain 0 segment 5
  run "" domain 0 segment 3
  run "" domain 0 segment 0
  run "s" domain 0 segment 1
  run "s" domain 0 segment 2
  run "" domain 0 segment 2
  run "" domain 0 segment 4
  run "" domain 0 segment 6
  run "" domain 0 segment 7
  tick "" pw2 port clk
  tick "" pw1 port clk
  tick "s" w2 port clk
  tick "s" w1 port clk
  tick "s" acc port _clk__1 reset
  tick "" cnt port _clk__1 reset
  alternative in "" when And(Ult(cnt.read#0(), 8'd10), Extract(cnt.read#0(), 32'd0, 32'd0))
    run "" domain 0 segment 1
    run "" domain 0 segment 5
    run "" domain 0 segment 3
    run "" domain 0 segment 0
    run "" domain 0 segment 2
    run "" domain 0 segment 4
    run "" domain 0 segment 6
    run "s" domain 0 segment 1
    run "" domain 0 segment 7
    run "s" domain 0 segment 2
