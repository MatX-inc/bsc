clock CLK posedge
  run "" domain 0 segment 1
  run "" domain 0 segment 3
  run "" domain 0 segment 0
  run "s1" domain 0 segment 1
  run "s2" domain 0 segment 1
  run "" domain 0 segment 2
  run "" domain 0 segment 4
  run "" domain 0 segment 5
  run "s1" domain 0 segment 2
  run "s2" domain 0 segment 2
  tick "s2" w2 port clk
  tick "s2" w1 port clk
  tick "s1" w2 port clk
  tick "s1" w1 port clk
  tick "s1" acc port _clk__1 reset
  tick "s2" acc port _clk__1 reset
  tick "" cnt port _clk__1 reset
  alternative in "" when And(Ult(cnt.read#0(), 8'd8), Extract(cnt.read#0(), 32'd0, 32'd0))
    run "" domain 0 segment 1
    run "" domain 0 segment 3
    run "" domain 0 segment 0
    run "s2" domain 0 segment 1
    run "" domain 0 segment 4
    run "s2" domain 0 segment 2
    run "" domain 0 segment 2
    run "s1" domain 0 segment 1
    run "" domain 0 segment 5
    run "s1" domain 0 segment 2
  alternative in "" when And(Ult(cnt.read#0(), 8'd8), Not(Extract(cnt.read#0(), 32'd0, 32'd0)))
    run "" domain 0 segment 1
    run "" domain 0 segment 3
    run "" domain 0 segment 0
    run "s1" domain 0 segment 1
    run "" domain 0 segment 2
    run "s1" domain 0 segment 2
    run "" domain 0 segment 4
    run "s2" domain 0 segment 1
    run "" domain 0 segment 5
    run "s2" domain 0 segment 2
