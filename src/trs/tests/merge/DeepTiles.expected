clock CLK posedge
  run "" domain 0 segment 3
  run "" domain 0 segment 1
  run "" domain 0 segment 2
  run "" domain 0 segment 0
  run "m0" domain 0 segment 1
  run "m0.l0" domain 0 segment 1
  run "m0.l1" domain 0 segment 1
  run "m1" domain 0 segment 1
  run "m1.l0" domain 0 segment 1
  run "m1.l1" domain 0 segment 1
  run "" domain 0 segment 4
  run "" domain 0 segment 7
  run "m1" domain 0 segment 2
  run "m1.l0" domain 0 segment 2
  run "m1.l1" domain 0 segment 2
  run "" domain 0 segment 5
  run "m0" domain 0 segment 2
  run "m0.l0" domain 0 segment 2
  run "m0.l1" domain 0 segment 2
  run "" domain 0 segment 6
  tick "" gc port clk_in
  tick "m0.l0" a port _clk__1 reset
  tick "m0.l0" b port _clk__1 reset
  tick "m0.l1" a port _clk__1 reset
  tick "m0.l1" b port _clk__1 reset
  tick "m0" seen port _clk__1 reset
  tick "m1.l0" a port _clk__1 reset
  tick "m1.l0" b port _clk__1 reset
  tick "m1.l1" a port _clk__1 reset
  tick "m1.l1" b port _clk__1 reset
  tick "m1" seen port _clk__1 reset
  tick "" gc port clk reset
  tick "" slow port _clk__1 reset gated gc.CLK_GATE_OUT gate
  tick "" cnt port _clk__1 reset
clock CLK negedge
  tick "" gc port clk_in
