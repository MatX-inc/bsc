TOP:=$(shell pwd)/../..
WANT_TCL=yes

include $(TOP)/platform.mk

TMPDIR=/tmp

# -----
# System tools

INSTALL ?= install

RM = rm -f
LN = ln -sf

FIND = find

# -----
# Options

# Set this to 1 if the source files are not in Git or the Git tool
# is not available.  The variable is used by "update-build-version.sh"
# which will not try running Git if the value is 1.
#
NOGIT ?= 0
export NOGIT

# With NOGIT=1, the build version will be update to a null value.
# If you want to pre-create the file and avoid overwriting it,
# then set this variable to 1.
#
NOUPDATEBUILDVERSION ?= 0
export NOUPDATEBUILDVERSION

# -----
# Paths and environment

# PREFIX is where things are installed
PREFIX?=$(TOP)/inst
BINDIR=$(PREFIX)/bin

# Where package information is installed
LICDIR=$(PREFIX)/LICENSES

# Top-level of where intermediate GHC files are stored
BUILDDIR=$(TOP)/build/comp

# Parsec
PARSEC_HS = ../Parsec

# STP
STP_HS = ../vendor/stp/include_hs
STP_INC_FLAGS = -I../vendor/stp/include
STP_LIB_FLAGS = -L../vendor/stp/lib -lstp

# Yices
YICES_HS = ../vendor/yices/include_hs
YICES_INC_FLAGS = -I../vendor/yices/include
YICES_LIB_FLAGS = -L../vendor/yices/lib -lyices

# HTCL
HTCL_HS = ../vendor/htcl
HTCL_INC_FLAGS = -L$(HTCL_HS)
HTCL_LIB_FLAGS = -lhtcl
# HTcl.hs needs macro definitions
HTCL_INC_FLAGS += $(addprefix -D,$(TCL_DEFS))

# -----
# Cabal build
#
# The Haskell build is driven by cabal against bsc.cabal at the repo
# root: the compiler internals are one library, and bsc/bluetcl are
# executables linking it.  Module-level parallelism comes from the
# `ghc-options: -j` in the generated cabal.project.local (GHCJOBS is no
# longer consulted; GHC uses all cores).  Once the required GHC is >= 9.8,
# `cabal build --semaphore` (-jsem) is the better mechanism: one job pool
# shared between cabal's package-level and GHC's module-level parallelism.

CABAL ?= cabal

# BSC_BUILD maps onto cabal configuration
ifeq ($(BSC_BUILD),PROF)
$(info ----- Profiling build options -----)
CABALFLAGS = --enable-profiling -f prof-rts
else
ifeq ($(BSC_BUILD),DEBUG)
$(info ----- Debug build options -----)
CABALFLAGS = --ghc-options='-dcore-lint -debug'
else
ifeq ($(BSC_BUILD),NOOPT)
$(info ----- Unoptimized build options -----)
CABALFLAGS = --ghc-options=-O0
else
CABALFLAGS =
endif
endif
endif

# Machine-local cabal configuration: absolute solver -L dirs (ghc-pkg
# rejects relative library dirs at registration) and GHC parallelism.
# util/bluehs/setup.sh generates the same file.
$(TOP)/cabal.project.local:
	@echo "-- Generated by src/comp/Makefile (machine-local; not for commit)" > $@
	@echo "package bsc" >> $@
	@echo "  extra-lib-dirs: $(TOP)/src/vendor/stp/lib" >> $@
	@echo "  extra-lib-dirs: $(TOP)/src/vendor/yices/lib" >> $@
	@echo "  ghc-options: -j +RTS -A64m -RTS" >> $@

# The package list used for LICENSE.ghc_pkgs generation (the library's
# build-depends; keep in sync with bsc.cabal)
PACKAGES = \
	base \
	containers \
	array \
	mtl \
	unix \
	regex-compat \
	bytestring \
	directory \
	process \
	filepath \
	time \
	old-time \
	old-locale \
	split \
	syb \
	integer-gmp \
	text \
	deepseq \
	strict-concurrency \


# -----
# Targets

BSCEXES = bsc
TCLEXES = bluetcl
UTILEXES = bo2bloogle fstcheck fstscopes
# Build-consistency checkers: installed as part of the normal install
# (not just install-extra), because the library build runs them
CHECKEXES = tconcheck

EXES = $(BSCEXES) $(TCLEXES) $(UTILEXES) $(CHECKEXES)

.PHONY: all
all: $(EXES)

BuildVersion.hs:
	./update-build-version.sh

BuildSystem.hs:
	./update-build-system.sh

BUILDSTART = @echo $@ start `date`
BUILDDONE = @echo $@ done `date`; echo

.PHONY: bsc
bsc: $(TOP)/cabal.project.local
	$(BUILDSTART)
        # to force updating of BuildVersion/BuildSystem when necessary
	./update-build-version.sh
	./update-build-system.sh
	cd $(TOP) && $(CABAL) build $(CABALFLAGS) exe:bsc
	cp -f `cd $(TOP) && $(CABAL) list-bin $(CABALFLAGS) bsc` bsc
	$(BUILDDONE)

# fstscopes, fstcheck and tconcheck are cabal executables (see bsc.cabal;
# the FST pair compiles the src/vendor/libfst sources into the binary)
.PHONY: bo2bloogle fstscopes fstcheck tconcheck
bo2bloogle fstscopes fstcheck tconcheck: $(TOP)/cabal.project.local
	$(BUILDSTART)
	cd $(TOP) && $(CABAL) build $(CABALFLAGS) exe:$@
	cp -f `cd $(TOP) && $(CABAL) list-bin $(CABALFLAGS) $@` $@
	$(BUILDDONE)

.PHONY: bluetcl
bluetcl: $(TOP)/cabal.project.local
	$(BUILDSTART)
	./update-build-version.sh
	./update-build-system.sh
	cd $(TOP) && $(CABAL) build $(CABALFLAGS) exe:bluetcl
	cp -f `cd $(TOP) && $(CABAL) list-bin $(CABALFLAGS) bluetcl` bluetcl
	$(BUILDDONE)

# -----
# GHC package info

# If BSC_BUILD_PKGINFO is non-empty,
# generate and install a LICENSES/LICENSE.ghc_pkgs file

ifeq ($(BSC_BUILD_PKGINFO),)
PKGINFO=
else
PKGINFO=$(LICDIR)/LICENSE.ghc_pkgs

.PHONY: $(PKGINFO)
$(PKGINFO):
	mkdir -p -m 755 $(LICDIR)
	./make-ghc-pkg-info.sh $(PACKAGES) > $(PKGINFO)
endif

# -----
# Install targets

.PHONY: install
install: $(BSCEXES) $(TCLEXES) $(UTILEXES) $(CHECKEXES) install-bsc install-bluetcl install-utils install-checkers

# Until the need for BLUESPECDIR and LD_LIBRARY_PATH to be set is removed
# put the binaries in a "core" subdirectory and a wrapper script in "bin"
$(BINDIR)/core/%: %
	mkdir -p -m 755 $(BINDIR)/core
	$(INSTALL) -m 755 $(@F) $(BINDIR)/core/$(@F)

$(BINDIR)/%: wrapper.sh $(BINDIR)/core/%
	mkdir -p -m 755 $(BINDIR)
	$(INSTALL) -m 755 wrapper.sh $(BINDIR)/$(@F)

.PHONY: install-bsc
install-bsc: $(addprefix $(BINDIR)/,$(BSCEXES))
install-bsc: $(addprefix $(BINDIR)/core/,$(BSCEXES))
install-bsc: $(PKGINFO)

.PHONY: install-bluetcl
install-bluetcl: $(addprefix $(BINDIR)/,$(TCLEXES))
install-bluetcl: $(addprefix $(BINDIR)/core/,$(TCLEXES))
install-bluetcl: $(PKGINFO)

.PHONY: install-utils
install-utils: $(addprefix $(BINDIR)/,$(UTILEXES))
install-utils: $(addprefix $(BINDIR)/core/,$(UTILEXES))
install-utils: $(PKGINFO)

.PHONY: install-checkers
install-checkers: $(addprefix $(BINDIR)/,$(CHECKEXES))
install-checkers: $(addprefix $(BINDIR)/core/,$(CHECKEXES))
install-checkers: $(PKGINFO)

# ----
# Other targets

tags:   *hs */*hs bluewish.hs
	$(FIND) . $(PARSEC_HS) $(STP_HS) $(YICES_HS) $(HTCL_HS) \
		-type f -name \*hs | xargs hasktags
	mv tags tags.tmpfile
	sort tags.tmpfile > tags
	$(RM) tags.tmpfile

# -----
# Clean targets

.PHONY: clean
clean:
	$(RM) -rf $(EXES) $(BUILDDIR)

.PHONY: full_clean
full_clean: clean
	$(RM) -f BuildSystem.hs BuildVersion.hs
	$(RM) tags TAGS

# -----
