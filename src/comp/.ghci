-- Extensions: bsc.cabal's default-extensions, so the interpreted modules
-- parse as the compiled ones do whatever the GHC's default language (they
-- are all in GHC2021, which GHC 9.2 and later apply without a flag).
:set -XBangPatterns -XFlexibleContexts -XFlexibleInstances -XTypeSynonymInstances
:set -XForeignFunctionInterface
:set -XUndecidableInstances

-- Packages: the cabal build writes a GHC environment file at the repository
-- root naming every package it built against, which ghci loads from any
-- directory below it. The compiled library is named here for the three
-- modules the hooks generate (BuildVersion, BuildSystem, Warmup), which have
-- no source in the tree; every module that has one is interpreted from it,
-- since GHC takes a home module over a package's.
:set -package bsc

-- Haskell source
:set -i../comp:../comp/app:../comp/Libs:../comp/GHC:../comp/GHC/posix:../Parsec

-- Shared libraries and FFI bindings
:set -i../vendor/stp/include_hs
:set -i../vendor/yices/include_hs
:set -i../vendor/htcl

:set -I/usr/include/tcl
:set -L../vendor/htcl
:set -lhtcl

:set -L../vendor/stp/lib
:set -lstp

:set -L../vendor/yices/lib
:set -lyices

-- Faster compilation times
:set -j
